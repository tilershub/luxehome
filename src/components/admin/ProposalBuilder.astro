      ['Issued revisions', 'An issued proposal is locked. Corrections create a numbered revision; an accepted proposal is not silently overwritten.'],
    ];
    const acceptanceBody = `<p class="pdf-lead">This proposal is valid through ${formatDate(proposal.valid_until)}. Acceptance confirms the approved scope, final value and payment milestones.</p><div class="pdf-card-grid terms-grid">${terms.map((item, index) => `<div class="pdf-card"><span>${String(index + 1).padStart(2, '0')}</span><h3>${esc(item[0])}</h3><p>${esc(item[1])}</p></div>`).join('')}</div><div class="acceptance"><b>CLIENT ACCEPTANCE</b><div><span>Client name and signature</span><span>Acceptance date</span></div></div>`;

    pagesRoot.innerHTML = `<div class="pdf-sheet"><article class="pdf-page cover-page">${cover}</article></div>`
      + pdfPage(2, '01 / Project summary', 'The complete picture, at a glance.', summary)
      + pdfPage(3, '02 / Approved design', `${proposal.design_name || 'Selected design'}, adapted to the measured room.`, gallery, 'gallery-page')
      + pdfPage(4, '03 / Construction scope', 'One accountable team, from strip-out to handover.', scopeBody)
      + pdfPage(5, '04 / Materials and finishes', 'Specified openly. Approved before purchase.', materialsBody)
      + pdfPage(6, '05 / Indicative programme', 'Six weeks, sequenced around quality checks.', timelineBody)
      + pdfPage(7, '06 / Quality control', 'Critical work is checked before it is covered.', qualityBody)
      + pdfPage(8, '07 / Warranty and aftercare', 'Responsibilities recorded at handover.', warrantyBody)
      + pdfPage(9, '08 / Final quotation', 'One contract value. Five visible milestones.', paymentBody)
      + pdfPage(10, '09 / Acceptance', 'Thirty days to decide with the complete picture.', acceptanceBody);
    previewTitle.textContent = `${proposal.proposal_number || 'Draft proposal'} / R${proposal.revision}`;
  }

  function openPreview() {
    const proposal = current?.status === 'draft' ? readForm() : current;
    if (!proposal) return;
    current = proposal;
    renderPdfPages(proposal);
    preview.hidden = false;
    document.body.classList.add('preview-open');
    preview.scrollTo({ top: 0 });
  }

  function closePreview() {
    preview.hidden = true;
    document.body.classList.remove('preview-open');
  }

  async function imageToDataUrl(source: string) {
    if (source.startsWith('data:image/')) return source;
    const response = await fetch(source, { mode: 'cors' });
    if (!response.ok) throw new Error(`Could not load design image (${response.status}).`);
    const blob = await response.blob();
    return await new Promise<string>((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result));
      reader.onerror = () => reject(new Error('Could not prepare a design image for the PDF.'));
      reader.readAsDataURL(blob);
    });
  }

  async function downloadPdf() {
    if (downloadBusy) return;
    const proposal = current?.status === 'draft' ? readForm() : current;
    if (!proposal) return;
    const errors = validateForIssue(proposal);
    if (errors.length) {
      notify(`Complete ${errors.join(', ')} before downloading the final PDF.`, true);
      return;
    }
    downloadBusy = true;
    const button = document.getElementById('preview-download') as HTMLButtonElement | null;
    const originalText = button?.textContent || '';
    try {
      if (button) {
        button.disabled = true;
        button.textContent = 'Preparing images...';
      }
      const localImages = await Promise.all(proposal.selected_image_urls.map(imageToDataUrl));
      const captureProposal = normaliseProposal({ ...proposal, selected_image_urls: localImages });
      renderPdfPages(captureProposal);
      preview.hidden = false;
      preview.classList.add('capturing');
      await document.fonts.ready;
      await Promise.all(Array.from(pagesRoot.querySelectorAll('img')).map(async (image) => {
        if (!image.complete) await image.decode();
        if (!image.naturalWidth) throw new Error('A selected design image could not be rendered.');
      }));

      const pages = Array.from(pagesRoot.querySelectorAll<HTMLElement>('.pdf-page'));
      const [{ default: html2canvas }, { jsPDF }] = await Promise.all([
        import('html2canvas'),
        import('jspdf'),
      ]);
      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4', compress: true });
      for (let index = 0; index < pages.length; index += 1) {
        if (button) button.textContent = `Rendering page ${index + 1} of ${pages.length}...`;
        const canvas = await html2canvas(pages[index], {
          backgroundColor: '#F7F3EB',
          scale: 1.65,
          useCORS: true,
          logging: false,
          width: 794,
          height: 1123,
          windowWidth: 794,
          windowHeight: 1123,
        });
        if (index > 0) pdf.addPage('a4', 'portrait');
        pdf.addImage(canvas.toDataURL('image/jpeg', 0.9), 'JPEG', 0, 0, 210, 297, undefined, 'FAST');
        canvas.width = 1;
        canvas.height = 1;
      }
      const fileName = `${proposal.proposal_number || 'LUXEhome-Proposal'}-R${proposal.revision}.pdf`;
      pdf.save(fileName);
      notify('Proposal PDF downloaded.');
    } catch (error) {
      notify(error instanceof Error ? error.message : 'Could not create the PDF.', true);
    } finally {
      preview.classList.remove('capturing');
      renderPdfPages(proposal);
      if (button) {
        button.disabled = false;
        button.textContent = originalText || 'Download PDF';
      }
      downloadBusy = false;
    }
  }

  document.getElementById('preview-close')?.addEventListener('click', closePreview);
  document.getElementById('preview-download')?.addEventListener('click', downloadPdf);
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !preview.hidden) closePreview();
  });

  loadData();
</script>

