            <div class="section-heading"><span>07</span><div><h3>Project investment</h3><p>Present the complete outcome and its component value, not a list of disconnected rates.</p></div></div>
            ${arrayRows('prices', current.price_items, [
              { key: 'category', label: 'Investment category' },
              { key: 'description', label: 'What the client receives', textarea: true, wide: true },
              { key: 'amount_lkr', label: 'Amount (LKR)', type: 'number', min: 0, step: 1000 },
