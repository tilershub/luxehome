              <label>Tax (LKR)<input id="p-tax" type="number" min="0" step="1000" value="${current.tax_lkr}"></label>
              <label>Other adjustment (LKR)<input id="p-adjustment" type="number" step="1000" value="${current.adjustment_lkr}"></label>
              <label>Initiation credit already paid (LKR)<input id="p-initiation-credit" type="number" min="0" step="1000" value="${current.initiation_credit_lkr}"></label>
