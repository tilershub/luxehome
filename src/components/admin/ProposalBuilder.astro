    const investmentRows = priceItems.map((item) => `<div class="table-row"><strong>${esc(item.category)}</strong><span>${esc(item.description)}</span><b>${formatLkr(item.amount_lkr)}</b></div>`).join('');
    const investmentBody = `<p class="pdf-lead">The investment covers the coordinated result described in this proposal—from design resolution and construction management to testing and handover.</p><div class="pdf-table investment-table"><div class="table-head"><b>CATEGORY</b><b>CLIENT DELIVERABLE</b><b>AMOUNT</b></div>${investmentRows}</div><div class="investment investment-v2"><b>FINAL PROJECT INVESTMENT</b><strong>${formatLkr(proposal.contract_value_lkr)}</strong><span>Approved scope · One bathroom · Revision R${proposal.revision}</span></div><div class="investment-adjustments"><span>Subtotal ${formatLkr(investment.subtotal || proposal.contract_value_lkr)}</span><span>Discount ${formatLkr(investment.discount)}</span><span>Tax ${formatLkr(investment.tax)}</span><span>Adjustment ${formatLkr(investment.adjustment)}</span></div><div class="pdf-strip sage"><b>INITIATION CREDIT</b><p>The ${formatLkr(proposal.initiation_credit_lkr)} project-initiation payment already received is credited against the first construction milestone. It is not added on top of the final contract value.</p></div>`;

    const paymentBody = `<p class="pdf-lead">Each payment is connected to a visible project milestone. The schedule totals ${payment.percentageTotal}% and the first payment reflects the initiation credit already received.</p><div class="pdf-table payment-table payment-table-v2"><div class="table-head"><b>MILESTONE</b><b>WHEN DUE / EVIDENCE</b><b>AMOUNT</b></div>${payment.rows.slice(0, 8).map((row, index) => `<div class="table-row"><strong>${String(index + 1).padStart(2, '0')} · ${esc(row.stage)}<small>${row.percentage}% of contract</small></strong><span>${esc(row.due_milestone)}<small>${esc(row.evidence)}</small></span><b>${formatLkr(row.amount_due_lkr)}${row.credit_applied_lkr ? `<small>after ${formatLkr(row.credit_applied_lkr)} credit</small>` : ''}</b></div>`).join('')}</div><div class="pdf-strip gold"><b>PAYMENT CONTROL</b><p>Milestone payments are due when the stated stage is reached. Overdue payments may pause work and move subsequent programme dates.</p></div>`;

    const warrantyBody = `<p class="pdf-lead">LUXEhome workmanship is covered for 24 months from documented handover. Product and supplier warranties remain separate and follow their own written conditions.</p><div class="pdf-table warranty-table"><div class="table-head"><b>COVER</b><b>PERIOD</b><b>BASIS</b></div>${warranties.slice(0, 6).map((item) => `<div class="table-row"><strong>${esc(item.item)}</strong><b>${esc(item.period)}</b><span>${esc(item.basis)}</span></div>`).join('')}</div><div class="warranty-contact"><span>HOW TO REPORT A CONCERN</span><h3>${esc(proposal.warranty_claim_contact)}</h3><p>Provide the proposal number, photos or video and reasonable access for assessment. The documented handover date begins the workmanship period.</p></div><div class="pdf-strip"><b>NOT COVERED</b><p>${esc(proposal.warranty_exclusions.join(' '))}</p></div>`;

    const acceptanceTerms = [
      ['Proposal validity', `This proposal is valid through ${formatDate(proposal.valid_until)}. Price, availability and programme may require reconfirmation after expiry.`],
      ['Approved revision', `Only ${proposal.proposal_number || 'this proposal'} / R${proposal.revision}, its written scope and documented selections form the appointment.`],
      ['Variations', proposal.variation_terms],
      ['Commencement', 'Procurement and mobilisation begin after signed acceptance and the cleared first milestone payment.'],
    ];
    const acceptanceBody = `<p class="pdf-lead">Acceptance confirms the design direction, selected fixtures and finishes, construction scope, final investment, payment milestones and warranty basis recorded in this revision.</p><div class="pdf-card-grid terms-grid">${acceptanceTerms.map((item, index) => `<div class="pdf-card"><span>${String(index + 1).padStart(2, '0')}</span><h3>${esc(item[0])}</h3><p>${esc(item[1])}</p></div>`).join('')}</div><div class="acceptance"><b>CLIENT ACCEPTANCE</b><p>${esc(proposal.client_name)} · ${esc(proposal.property_location)}</p><div><span>Client name and signature</span><span>Acceptance date</span></div></div><div class="prepared-by"><span>PREPARED BY</span><b>${esc(proposal.prepared_by)}</b><p>LUXEhome · Complete bathroom design and construction · luxehome.lk · 077 450 3744</p></div>`;

    pagesRoot.innerHTML = `<div class="pdf-sheet"><article class="pdf-page cover-page">${cover}</article></div>`
      + pdfPage(2, '01 / Project overview', 'The complete decision, at a glance.', summary)
      + pdfPage(3, '02 / Design vision', 'A defined outcome—not a list of products.', vision, 'vision-page')
      + pdfPage(4, '03 / Approved 3D design', `${proposal.design_name || 'Project design'}, resolved before construction.`, gallery, 'gallery-page')
      + pdfPage(5, '04 / Fixtures and fittings', 'Selected for the finished experience.', fixtureVisuals, 'fixture-visual-page')
      + pdfPage(6, '05 / Fixture schedule', 'Brands, models and performance recorded.', fixtureSchedule, 'fixture-schedule-page')
      + pdfPage(7, '06 / Materials and finishes', 'A coordinated palette with a purpose.', finishSchedule, 'finish-page')
      + pdfPage(8, '07 / Brands and quality', 'Known systems. Visible quality gates.', brandQuality, 'brand-quality-page')
      + pdfPage(9, '08 / Construction scope', 'One accountable team, from site protection to handover.', scopeBody)
      + pdfPage(10, '09 / Project boundaries', 'Clear exclusions, assumptions and variations.', boundaries, 'boundaries-page')
      + pdfPage(11, '10 / Project timeline', `${proposal.estimated_duration} sequenced around quality checks.`, timelineBody)
      + pdfPage(12, '11 / Project investment', 'The value of the complete coordinated result.', investmentBody, 'investment-page')
      + pdfPage(13, '12 / Payment milestones', 'Six visible stages. One hundred percent accounted for.', paymentBody, 'payment-page')
      + pdfPage(14, '13 / Warranty and aftercare', '24-month workmanship with clear support boundaries.', warrantyBody, 'warranty-page')
      + pdfPage(15, '14 / Acceptance', 'Approve the complete picture.', acceptanceBody, 'acceptance-page');
    previewTitle.textContent = `${proposal.proposal_number || 'Draft proposal'} / R${proposal.revision}`;
    updatePreviewScale();
  }

  function updatePreviewScale() {
    const availableWidth = Math.max(280, window.innerWidth - (window.innerWidth <= 760 ? 16 : 40));
    pagesRoot.style.setProperty('--pdf-preview-scale', String(Math.min(0.72, availableWidth / 794)));
  }

  function openPreview() {
    const proposal = current?.status === 'draft' ? readForm() : current;
    if (!proposal) return;
    current = proposal;
    renderPdfPages(proposal);
    preview.hidden = false;
    document.body.classList.add('preview-open');
    preview.scrollTo({ top: 0 });
  }

  function closePreview() {
    preview.hidden = true;
    document.body.classList.remove('preview-open');
  }

  async function imageToDataUrl(source: string) {
    if (source.startsWith('data:image/')) return source;
    const response = await fetch(source, { mode: 'cors' });
    if (!response.ok) throw new Error(`Could not load design image (${response.status}).`);
    const blob = await response.blob();
    return await new Promise<string>((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result));
      reader.onerror = () => reject(new Error('Could not prepare a design image for the PDF.'));
      reader.readAsDataURL(blob);
    });
  }

  async function downloadPdf() {
    if (downloadBusy) return;
    const proposal = current?.status === 'draft' ? readForm() : current;
    if (!proposal) return;
    const issues = validateForIssue(proposal);
    if (issues.length) {
      showValidationIssues(issues, proposal, 'downloading the final PDF');
      return;
    }
    downloadBusy = true;
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('#preview-download, [data-download]'));
    const originalLabels = buttons.map((button) => button.textContent || 'Download PDF');
    try {
      buttons.forEach((button) => {
        button.disabled = true;
        button.textContent = 'Preparing images...';
      });
      downloadProgress.hidden = false;
      downloadProgressText.textContent = 'Preparing design and product images...';
      const imageSources = Array.from(new Set([
        ...proposal.selected_image_urls,
        ...proposal.image_items.map((item) => item.url),
        ...proposal.fixtures.map((item) => item.image_url || ''),
        ...proposal.materials.map((item) => item.image_url || ''),
      ].filter(Boolean)));
      const preparedImages = await Promise.all(imageSources.map(async (source) => [source, await imageToDataUrl(source)] as const));
      const preparedImageMap = new Map(preparedImages);
      const captureProposal = normaliseProposal({
        ...proposal,
        selected_image_urls: proposal.selected_image_urls.map((source) => preparedImageMap.get(source) || source),
        image_items: proposal.image_items.map((item) => ({ ...item, url: preparedImageMap.get(item.url) || item.url })),
        fixtures: proposal.fixtures.map((item) => ({ ...item, image_url: item.image_url ? preparedImageMap.get(item.image_url) || item.image_url : undefined })),
        materials: proposal.materials.map((item) => ({ ...item, image_url: item.image_url ? preparedImageMap.get(item.image_url) || item.image_url : undefined })),
      });
      renderPdfPages(captureProposal);
      preview.hidden = false;
      document.body.classList.add('preview-open');
      preview.classList.add('capturing');
      await document.fonts.ready;
      await Promise.all(Array.from(pagesRoot.querySelectorAll('img')).map(async (image) => {
        if (!image.complete) await image.decode();
        if (!image.naturalWidth) throw new Error('A selected design image could not be rendered.');
      }));

      const pages = Array.from(pagesRoot.querySelectorAll<HTMLElement>('.pdf-page'));
      const [{ default: html2canvas }, { jsPDF }] = await Promise.all([
        import('html2canvas'),
        import('jspdf'),
      ]);
      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4', compress: true });
      for (let index = 0; index < pages.length; index += 1) {
        const progressMessage = `Rendering page ${index + 1} of ${pages.length}...`;
        downloadProgressText.textContent = progressMessage;
        buttons.forEach((button) => { button.textContent = progressMessage; });
        await new Promise<void>((resolve) => window.requestAnimationFrame(() => resolve()));
        const canvas = await html2canvas(pages[index], {
          backgroundColor: '#F7F3EB',
          scale: 1.45,
          useCORS: true,
          logging: false,
          width: 794,
          height: 1123,
          windowWidth: 794,
          windowHeight: 1123,
        });
        if (index > 0) pdf.addPage('a4', 'portrait');
        pdf.addImage(canvas.toDataURL('image/jpeg', 0.86), 'JPEG', 0, 0, 210, 297, undefined, 'FAST');
        canvas.width = 1;
        canvas.height = 1;
      }
      const filePart = (text: string, fallback: string) => text.trim().replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').slice(0, 45) || fallback;
      const fileName = `LUXEhome-Proposal-${filePart(proposal.client_name, 'Client')}-${filePart(proposal.property_location, 'Project')}-${filePart(proposal.proposal_number || 'Draft', 'Draft')}-R${proposal.revision}.pdf`;
      pdf.save(fileName);
      notify('Proposal PDF downloaded.');
    } catch (error) {
      notify(error instanceof Error ? error.message : 'Could not create the PDF.', true);
    } finally {
      preview.classList.remove('capturing');
      renderPdfPages(proposal);
      buttons.forEach((button, index) => {
        button.disabled = false;
        button.textContent = originalLabels[index];
      });
      downloadProgress.hidden = true;
      downloadBusy = false;
    }
  }

  document.getElementById('preview-close')?.addEventListener('click', closePreview);
  document.getElementById('preview-download')?.addEventListener('click', downloadPdf);
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !preview.hidden) closePreview();
  });
  window.addEventListener('resize', updatePreviewScale);
  window.addEventListener('beforeunload', (event) => {
    if (!formDirty) return;
    event.preventDefault();
    event.returnValue = '';
  });

  loadData();
</script>

