    const displayedContractValue = current.price_items.some((item) => Number(item.amount_lkr) > 0) ? investment.total : current.contract_value_lkr;
    const payment = calculatePaymentSchedule(displayedContractValue, current.initiation_credit_lkr, current.payment_schedule);
