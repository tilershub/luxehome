  function investmentSummary(investment: ReturnType<typeof calculateProposalInvestment>, displayedTotal: number) {
    return `<div><span>Category subtotal</span><strong>${formatLkr(investment.subtotal || displayedTotal)}</strong></div>
      <div><span>Discount</span><strong>-${formatLkr(investment.discount)}</strong></div>
      <div><span>Tax and adjustment</span><strong>${formatLkr(investment.tax + investment.adjustment)}</strong></div>
      <div class="total"><span>Final contract value</span><strong>${formatLkr(displayedTotal)}</strong></div>`;
  }

  function paymentSummary(payment: ReturnType<typeof calculatePaymentSchedule>) {
    return `${payment.rows.map((row, index) => `<div class="${index === 0 && row.credit_applied_lkr ? 'credit' : ''}">
      <span>${esc(row.stage)} · ${row.percentage}%${row.credit_applied_lkr ? ` · credit ${formatLkr(row.credit_applied_lkr)}` : ''}</span>
      <strong>${formatLkr(row.amount_due_lkr)}</strong>
    </div>`).join('')}
      <div class="payment-total ${Math.abs(payment.percentageTotal - 100) < 0.0001 ? 'valid' : 'invalid'}"><span>Schedule total</span><strong>${payment.percentageTotal}% · ${formatLkr(payment.amountDueTotal)}</strong></div>`;
  }

  function collectRows<T>(name: string, keys: string[]): T[] {
    return Array.from(app.querySelectorAll<HTMLElement>(`[data-array="${name}"] .editable-row`)).map((row) => {
      const result: Record<string, string> = {};
      keys.forEach((keyName) => {
        const field = row.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-key="${keyName}"]`);
        result[keyName] = field?.value.trim() || '';
      });
      return result as T;
    }).filter((row) => keys.some((keyName) => Boolean((row as Record<string, unknown>)[keyName])));
  }

  function value(id: string) {
    return (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value.trim() || '';
  }

  function readForm() {
    if (!current) return null;
    const imageItems = collectRows<ProposalImageItem>('images', ['url', 'view', 'title', 'caption'])
      .filter((item) => item.url)
      .map((item, index) => ({
        ...item,
        view: item.view || (index === 0 ? 'Cover' : 'Design view'),
        title: item.title || (index === 0 ? 'Hero design view' : `Approved 3D view ${index + 1}`),
        caption: item.caption || 'Approved project design visual',
      }));
    const priceItems = collectRows<ProposalPriceItem>('prices', ['category', 'description', 'amount_lkr']).map((item) => ({
      ...item,
      amount_lkr: Math.max(0, Number(item.amount_lkr) || 0),
    }));
    const discount = Math.max(0, Number(value('p-discount')) || 0);
    const tax = Math.max(0, Number(value('p-tax')) || 0);
    const adjustment = Number(value('p-adjustment')) || 0;
    const investment = calculateProposalInvestment(priceItems, discount, tax, adjustment);
    const fallbackContractValue = Number(value('p-contract-value')) || current.contract_value_lkr || 0;
    const contractValue = priceItems.some((item) => item.amount_lkr > 0) ? investment.total : fallbackContractValue;
    const issuedAt = value('p-issued-at') || new Date().toISOString().slice(0, 10);
    const validityDays = Math.max(1, Number(value('p-validity-days')) || current.validity_days || 14);
    return normaliseProposal({
      ...current,
      source_inspection_id: value('p-source') || null,
      client_name: value('p-client-name'),
      client_phone: value('p-client-phone'),
      client_email: value('p-client-email'),
      property_location: value('p-location'),
      project_type: (value('p-project-type') || 'renovation') as 'renovation' | 'new',
      project_title: value('p-project-title') || 'Bathroom project proposal',
      bathroom_name: value('p-bathroom-name') || 'Main bathroom',
      room_dimensions: value('p-room-dimensions'),
      room_sqm: value('p-room-sqm') ? Number(value('p-room-sqm')) : null,
      client_brief: value('p-client-brief'),
      site_findings: value('p-site-findings'),
      design_vision: value('p-design-vision'),
      value_points: value('p-value-points').split('\n').map((line) => line.trim()).filter(Boolean),
      design_id: value('p-design') || null,
      design_name: value('p-design-name'),
      video_url: value('p-video'),
      image_items: imageItems,
      selected_image_urls: imageItems.map((item) => item.url),
      fixtures: collectRows<ProposalFixture>('fixtures', ['category', 'name', 'brand', 'model', 'dimensions', 'finish', 'quantity', 'specification', 'warranty', 'value_note', 'image_url']).map((item) => ({
        ...item,
        quantity: Math.max(1, Number(item.quantity) || 1),
        included: true,
      })),
      scope_items: collectRows<ProposalScopeItem>('scope', ['title', 'description']).map((item) => ({ ...item, included: true })),
      exclusions: value('p-exclusions').split('\n').map((line) => line.trim()).filter(Boolean),
      assumptions: value('p-assumptions').split('\n').map((line) => line.trim()).filter(Boolean),
      client_supplied_items: value('p-client-supplied').split('\n').map((line) => line.trim()).filter(Boolean),
      variation_terms: value('p-variation-terms'),
      materials: collectRows<ProposalMaterial>('materials', ['system', 'brand', 'product_code', 'colour', 'size', 'finish', 'specification', 'value_note', 'image_url']).map(withProposalBrandLogos),
      timeline: collectRows<ProposalTimelineItem>('timeline', ['week', 'title', 'start_date', 'end_date', 'description', 'milestone']).map((item) => ({
        ...item,
        start_date: item.start_date || undefined,
        end_date: item.end_date || undefined,
      })),
      estimated_duration: value('p-estimated-duration') || '3–4 weeks',
      proposed_start_date: value('p-start-date') || null,
      proposed_handover_date: value('p-handover-date') || null,
      programme_extension_days: Math.max(0, Number(value('p-extension-days')) || 0),
      quality_items: collectRows<ProposalQualityItem>('quality', ['title', 'description']),
      warranties: collectRows<ProposalWarranty>('warranties', ['item', 'period', 'basis']),
      warranty_exclusions: value('p-warranty-exclusions').split('\n').map((line) => line.trim()).filter(Boolean),
      warranty_claim_contact: value('p-warranty-contact'),
      price_items: priceItems,
      discount_lkr: discount,
      tax_lkr: tax,
      adjustment_lkr: adjustment,
      payment_schedule: collectRows<ProposalPaymentItem>('payments', ['stage', 'percentage', 'due_milestone', 'evidence']).map((item) => ({
        ...item,
        percentage: Math.max(0, Number(item.percentage) || 0),
      })),
      contract_value_lkr: contractValue,
      initiation_credit_lkr: Number(value('p-initiation-credit')) || 0,
      validity_days: validityDays,
      issued_at: issuedAt,
      valid_until: addCalendarDays(issuedAt, validityDays),
      commencement_days: 7,
      prepared_by: value('p-prepared-by') || 'LUXEhome Project Team',
      internal_notes: value('p-internal-notes'),
    });
  }

  function syncStepUi(scrollToSection = false) {
    if (!current) return;
    activeStep = Math.min(proposalSteps.length, Math.max(1, activeStep));
    app.querySelectorAll<HTMLElement>('[data-proposal-step]').forEach((section) => {
      section.classList.toggle('is-active', Number(section.dataset.proposalStep) === activeStep);
    });
    app.querySelectorAll<HTMLButtonElement>('[data-step-nav]').forEach((button) => {
      const step = Number(button.dataset.stepNav);
      const complete = stepComplete(current as ProposalRecord, step);
      button.classList.toggle('active', step === activeStep);
      button.classList.toggle('complete', complete);
      if (step === activeStep) button.setAttribute('aria-current', 'step');
      else button.removeAttribute('aria-current');
      const check = button.querySelector('i');
      if (check) check.textContent = complete ? '✓' : '';
    });
    const numberNode = document.getElementById('active-step-number');
    const labelNode = document.getElementById('active-step-label');
    if (numberNode) numberNode.textContent = String(activeStep);
    if (labelNode) labelNode.textContent = proposalSteps[activeStep - 1];

    const previous = document.getElementById('mobile-prev') as HTMLButtonElement | null;
    const next = document.getElementById('mobile-next') as HTMLButtonElement | null;
    const approve = document.getElementById('mobile-approve') as HTMLButtonElement | null;
    const locked = current.status !== 'draft';
    if (previous) previous.disabled = activeStep === 1;
    if (next) {
      next.hidden = !locked && activeStep === proposalSteps.length;
      next.disabled = activeStep === proposalSteps.length;
    }
    if (approve) approve.hidden = activeStep !== proposalSteps.length;

    if (scrollToSection) {
      app.querySelector<HTMLButtonElement>(`[data-step-nav="${activeStep}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      document.getElementById(`proposal-step-${activeStep}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function activateStep(step: number) {
    const formValue = readForm();
    if (formValue) current = formValue;
    activeStep = step;
    syncStepUi(true);
  }

  const PROPOSAL_IMAGE_MAX_EDGE = 2200;
  const PROPOSAL_IMAGE_QUALITY = 0.86;

  async function proposalImageToWebp(file: File) {
    if (file.type === 'image/webp') return file;
    let bitmap: ImageBitmap | HTMLImageElement;
    try {
      bitmap = await createImageBitmap(file);
    } catch {
      bitmap = await new Promise<HTMLImageElement>((resolve, reject) => {
        const image = new Image();
        const source = URL.createObjectURL(file);
        image.onload = () => { URL.revokeObjectURL(source); resolve(image); };
        image.onerror = () => { URL.revokeObjectURL(source); reject(new Error('Could not read this image. Try a JPEG or PNG.')); };
        image.src = source;
      });
    }
    const width = 'naturalWidth' in bitmap ? bitmap.naturalWidth : bitmap.width;
    const height = 'naturalHeight' in bitmap ? bitmap.naturalHeight : bitmap.height;
    const scale = Math.min(1, PROPOSAL_IMAGE_MAX_EDGE / Math.max(width, height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.round(width * scale));
    canvas.height = Math.max(1, Math.round(height * scale));
    const context = canvas.getContext('2d');
    if (!context) throw new Error('Image conversion is not available on this device.');
    context.imageSmoothingQuality = 'high';
    context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    if ('close' in bitmap && typeof bitmap.close === 'function') bitmap.close();
    const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/webp', PROPOSAL_IMAGE_QUALITY));
    if (!blob) throw new Error('WebP conversion is not supported on this device.');
    const base = (file.name.replace(/\.[^.]+$/, '') || 'proposal-image').replace(/[^a-z0-9-]+/gi, '-').toLowerCase();
    return new File([blob], `${base}.webp`, { type: 'image/webp' });
  }

  async function uploadProposalImage(file: File) {
    if (file.size > 26_214_400) throw new Error('Please choose an image under 25 MB.');
    const webp = await proposalImageToWebp(file);
    const path = `proposals/${new Date().toISOString().slice(0, 10)}/${Date.now()}-${crypto.randomUUID()}.webp`;
    const { error } = await sb.storage.from('luxehome-media').upload(path, webp, {
      cacheControl: '31536000',
      contentType: 'image/webp',
    });
    if (error) throw error;
    return sb.storage.from('luxehome-media').getPublicUrl(path).data.publicUrl;
  }

  function bindEditor(locked: boolean) {
    document.getElementById('proposal-back')?.addEventListener('click', () => {
      if (!locked && formDirty && !window.confirm('Discard the unsaved changes in this draft?')) return;
      history.replaceState(null, '', '/admin/proposals');
      renderList();
    });

    app.querySelectorAll<HTMLButtonElement>('[data-step-nav]').forEach((button) => button.addEventListener('click', () => {
      activateStep(Number(button.dataset.stepNav));
    }));
    document.getElementById('mobile-prev')?.addEventListener('click', () => activateStep(activeStep - 1));
    document.getElementById('mobile-next')?.addEventListener('click', () => activateStep(activeStep + 1));

    if (!locked) {
      const form = document.getElementById('proposal-form');
      form?.addEventListener('input', () => { formDirty = true; });
      form?.addEventListener('change', () => { formDirty = true; });
    }

    document.getElementById('p-source')?.addEventListener('change', (event) => {
      if (!current) return;
      current = readForm();
      const inspection = inspections.find((item) => item.id === (event.target as HTMLSelectElement).value);
      if (current && inspection) {
        current.source_inspection_id = inspection.id;
        current.client_name = inspection.name || current.client_name;
        current.client_phone = inspection.phone || current.client_phone;
        current.client_email = inspection.email || current.client_email;
        current.property_location = inspection.location || current.property_location;
        current.client_brief ||= inspection.notes || '';
      }
      activeStep = 1;
      formDirty = true;
      renderEditor();
      syncStepUi(true);
    });

    document.getElementById('p-design')?.addEventListener('change', (event) => {
      if (!current) return;
      current = readForm();
      const design = designs.find((item) => item.id === (event.target as HTMLSelectElement).value);
      if (current && design) {
        current.design_id = design.id;
        current.design_name = design.name;
        current.design_collection = design.collection || '';
        current.video_url = design.video_3d_url || '';
        current.image_items = designMedia(design.id).slice(0, 5).map((item, index) => ({
          url: item.url,
          view: index === 0 ? 'Cover' : item.label,
          title: item.label,
          caption: index === 0 ? 'The complete approved design direction.' : `This view confirms the ${item.label.toLowerCase()} design and finish coordination.`,
        }));
        current.selected_image_urls = current.image_items.map((item) => item.url);
        const selectedMaterials = materialRowsForDesign(design.id);
        current.materials = selectedMaterials.length ? selectedMaterials : structuredClone(DEFAULT_MATERIALS);
        current.fixtures = fixtureRowsForDesign(design.id);
        current.design_vision ||= `A complete ${design.name} bathroom adapted to the measured room, balancing calm visual character, practical circulation and durable construction.`;
      }
      activeStep = 2;
      formDirty = true;
      renderEditor();
      syncStepUi(true);
    });

    const refreshFinancials = () => {
      const formValue = readForm();
      if (!formValue) return;
      const calculatedInvestment = calculateProposalInvestment(formValue.price_items, formValue.discount_lkr, formValue.tax_lkr, formValue.adjustment_lkr);
      const contractNode = document.getElementById('p-contract-value') as HTMLInputElement | null;
      if (contractNode) contractNode.value = String(formValue.contract_value_lkr);
      const investmentNode = document.getElementById('investment-summary');
      if (investmentNode) investmentNode.innerHTML = investmentSummary(calculatedInvestment, formValue.contract_value_lkr);
      const paymentNode = document.getElementById('payment-summary');
      if (paymentNode) paymentNode.innerHTML = paymentSummary(calculatePaymentSchedule(formValue.contract_value_lkr, formValue.initiation_credit_lkr, formValue.payment_schedule));
    };
    app.querySelectorAll<HTMLInputElement>('[data-array="prices"] input, [data-array="payments"] input, #p-discount, #p-tax, #p-adjustment, #p-initiation-credit').forEach((input) => input.addEventListener('input', refreshFinancials));
    const refreshValidity = () => {
      const valid = document.getElementById('p-valid-until') as HTMLInputElement | null;
      if (valid) valid.value = addCalendarDays(value('p-issued-at'), Math.max(1, Number(value('p-validity-days')) || 14));
    };
    document.getElementById('p-issued-at')?.addEventListener('change', refreshValidity);
    document.getElementById('p-validity-days')?.addEventListener('input', refreshValidity);

    if (!locked) {
      document.getElementById('p-design-image-upload')?.addEventListener('change', async (event) => {
        const input = event.target as HTMLInputElement;
        const files = Array.from(input.files || []);
        if (!files.length || !current) return;
        current = readForm();
        if (!current) return;
        const remaining = Math.max(0, 6 - current.image_items.length);
        if (!remaining) {
          notify('This proposal already has the maximum six design images.', true);
          input.value = '';
          return;
        }
        input.disabled = true;
        const selected = files.slice(0, remaining);
        try {
          for (let index = 0; index < selected.length; index += 1) {
            notify(`Uploading 3D image ${index + 1} of ${selected.length}...`);
            const imageUrl = await uploadProposalImage(selected[index]);
            const position = current.image_items.length;
            current.image_items.push({
              url: imageUrl,
              view: position === 0 ? 'Cover' : 'Design view',
              title: selected[index].name.replace(/\.[^.]+$/, '') || `3D view ${position + 1}`,
              caption: position === 0 ? 'The complete approved design direction.' : 'Approved project design visual.',
            });
          }
          current.selected_image_urls = current.image_items.map((item) => item.url);
          formDirty = true;
          renderEditor();
          notify(`${selected.length} design image${selected.length === 1 ? '' : 's'} added.`);
        } catch (error) {
          notify(error instanceof Error ? error.message : 'Image upload failed.', true);
        } finally {
          input.disabled = false;
          input.value = '';
        }
      });

      app.querySelectorAll<HTMLInputElement>('[data-row-image-upload]').forEach((input) => input.addEventListener('change', async () => {
        const file = input.files?.[0];
        const row = input.closest<HTMLElement>('.editable-row');
        const keyName = input.dataset.rowKey || 'image_url';
        if (!file || !row) return;
        input.disabled = true;
        try {
          notify('Uploading proposal image...');
          const imageUrl = await uploadProposalImage(file);
          const urlField = row.querySelector<HTMLInputElement>(`[data-key="${keyName}"]`);
          if (urlField) urlField.value = imageUrl;
          const previewKey = `${input.dataset.rowImageUpload}-${input.dataset.rowIndex}-${keyName}`;
          const oldPreview = row.querySelector<HTMLElement>(`[data-row-image-preview="${previewKey}"]`);
          if (oldPreview) {
            const image = document.createElement('img');
            image.dataset.rowImagePreview = previewKey;
            image.src = imageUrl;
            image.alt = 'Proposal item preview';
            oldPreview.replaceWith(image);
          }
          formDirty = true;
          notify('Image added to the proposal item.');
        } catch (error) {
          notify(error instanceof Error ? error.message : 'Image upload failed.', true);
        } finally {
          input.disabled = false;
          input.value = '';
        }
      }));

      app.querySelectorAll<HTMLElement>('[data-add]').forEach((button) => button.addEventListener('click', () => {
        if (!current) return;
        current = readForm();
        const name = button.dataset.add;
        if (!current || !name) return;
        if (name === 'images') current.image_items.push({ url: '', view: current.image_items.length ? 'Design view' : 'Cover', title: '', caption: '' });
        if (name === 'fixtures') current.fixtures.push({ category: '', name: '', brand: '', model: '', dimensions: '', finish: '', quantity: 1, specification: '', warranty: 'Manufacturer terms', value_note: '', image_url: '', included: true });
        if (name === 'scope') current.scope_items.push({ title: '', description: '', included: true });
        if (name === 'materials') current.materials.push({ system: '', brand: '', specification: '' });
        if (name === 'timeline') current.timeline.push({ week: '', title: '', description: '' });
        if (name === 'quality') current.quality_items.push({ title: '', description: '' });
        if (name === 'prices') current.price_items.push({ category: '', description: '', amount_lkr: 0 });
        if (name === 'payments') current.payment_schedule.push({ stage: '', percentage: 0, due_milestone: '', evidence: '' });
        if (name === 'warranties') current.warranties.push({ item: '', period: '', basis: '' });
        formDirty = true;
        renderEditor();
      }));
      app.querySelectorAll<HTMLElement>('[data-remove]').forEach((button) => button.addEventListener('click', () => {
        if (!current) return;
        current = readForm();
        const name = button.dataset.remove;
        const index = Number(button.dataset.index);
        if (!current || !name || Number.isNaN(index)) return;
        if (name === 'images') current.image_items.splice(index, 1);
        if (name === 'fixtures') current.fixtures.splice(index, 1);
        if (name === 'scope') current.scope_items.splice(index, 1);
        if (name === 'materials') current.materials.splice(index, 1);
        if (name === 'timeline') current.timeline.splice(index, 1);
        if (name === 'quality') current.quality_items.splice(index, 1);
        if (name === 'prices') current.price_items.splice(index, 1);
        if (name === 'payments') current.payment_schedule.splice(index, 1);
        if (name === 'warranties') current.warranties.splice(index, 1);
        formDirty = true;
        renderEditor();
      }));
    }

    const save = () => saveDraft(false);
    document.getElementById('proposal-save')?.addEventListener('click', save);
    document.getElementById('mobile-save')?.addEventListener('click', save);
    document.getElementById('proposal-approve')?.addEventListener('click', approveProposal);
    document.getElementById('mobile-approve')?.addEventListener('click', approveProposal);
    document.getElementById('proposal-preview-button')?.addEventListener('click', openPreview);
    document.getElementById('mobile-preview')?.addEventListener('click', openPreview);
    document.getElementById('proposal-download-button')?.addEventListener('click', downloadPdf);
    document.getElementById('mobile-download')?.addEventListener('click', downloadPdf);
    document.getElementById('proposal-mark-sent')?.addEventListener('click', () => updateStatus('sent'));
    document.getElementById('proposal-mark-accepted')?.addEventListener('click', () => updateStatus('accepted'));
    document.getElementById('proposal-revision')?.addEventListener('click', createRevision);
    syncStepUi(false);
  }

  function proposalPayload(proposal: ProposalRecord) {
    const {
      id, created_at, updated_at, ...payload
    } = proposal;
    if (!payload.proposal_number) delete payload.proposal_number;
    return payload;
  }

  async function saveDraft(silent: boolean, nested = false) {
    if (mutationBusy && !nested) return null;
    if (!nested) setMutationBusy(true);
    try {
    const formValue = readForm();
    if (!formValue) return null;
    if (!formValue.client_name) {
      current = formValue;
      activeStep = 1;
      renderEditor();
      notify('Enter the client name before saving.', true);
      window.setTimeout(() => document.getElementById('p-client-name')?.focus(), 0);
      return null;
    }
    current = formValue;
    let saved: ProposalRecord | null = null;
    if (current.id) {
      const { data, error } = await sb.from('lx_proposals').update(proposalPayload(current)).eq('id', current.id).select('*').single();
      if (error) {
        notify(error.message, true);
        return null;
      }
      saved = normaliseProposal(data as Partial<ProposalRecord>);
    } else {
      const { data, error } = await sb.from('lx_proposals').insert(proposalPayload(current)).select('*').single();
      if (error) {
        notify(error.message, true);
        return null;
      }
      saved = normaliseProposal(data as Partial<ProposalRecord>);
    }
    current = saved;
    const index = proposals.findIndex((proposal) => proposal.id === saved?.id);
    if (index >= 0) proposals[index] = saved;
    else proposals.unshift(saved);
    history.replaceState(null, '', `/admin/proposals?id=${saved.id}`);
    formDirty = false;
    if (!silent) {
      notify('Draft saved.');
      renderEditor();
    }
    return saved;
    } finally {
      if (!nested) setMutationBusy(false);
    }
  }

  interface ProposalValidationIssue {
    label: string;
    step: number;
    focusId?: string;
  }

  function validateForIssue(proposal: ProposalRecord) {
    const issues: ProposalValidationIssue[] = [];
    if (!proposal.client_name) issues.push({ label: 'client name', step: 1, focusId: 'p-client-name' });
    if (!proposal.property_location) issues.push({ label: 'property location', step: 1, focusId: 'p-location' });
    if (!proposal.project_title) issues.push({ label: 'proposal title', step: 1, focusId: 'p-project-title' });
    if (!proposal.design_name) issues.push({ label: 'design name', step: 2, focusId: 'p-design-name' });
    if (!proposal.design_vision) issues.push({ label: 'design vision', step: 2, focusId: 'p-design-vision' });
    if (!proposal.value_points.length) issues.push({ label: 'at least one client value point', step: 2, focusId: 'p-value-points' });
    if (proposal.image_items.length < 3) issues.push({ label: 'at least three project 3D images', step: 2 });
    const includedFixtures = proposal.fixtures.filter((item) => item.included !== false);
    if (!includedFixtures.length) issues.push({ label: 'fixture and fitting schedule', step: 3 });
    if (includedFixtures.some((item) => !item.name || !item.brand || !item.image_url || !item.specification || !item.value_note)) {
      issues.push({ label: 'fixture names, brands, images, specifications and benefits', step: 3 });
    }
    if (!proposal.materials.length) issues.push({ label: 'materials and finishes', step: 4 });
    if (proposal.materials.some((item) => !item.system || !item.brand || !item.specification || !item.value_note)) {
      issues.push({ label: 'material brands, specifications and benefits', step: 4 });
    }
    if (!proposal.materials.some((item) => item.image_url)) issues.push({ label: 'at least one material or finish image', step: 4 });
    if (!proposal.scope_items.some((item) => item.included !== false && item.title && item.description)) issues.push({ label: 'construction scope', step: 5 });
    if (!proposal.timeline.length || !proposal.quality_items.length) issues.push({ label: 'timeline and quality controls', step: 6 });
    if (proposal.contract_value_lkr <= 0) issues.push({ label: 'final contract value', step: 7, focusId: 'p-contract-value' });
    const calculatedPayments = calculatePaymentSchedule(proposal.contract_value_lkr, proposal.initiation_credit_lkr, proposal.payment_schedule);
    if (Math.abs(calculatedPayments.percentageTotal - 100) >= 0.0001) issues.push({ label: 'a payment schedule totaling 100%', step: 8 });
    if (proposal.payment_schedule.some((item) => !item.stage || !item.due_milestone)) issues.push({ label: 'payment stage names and due milestones', step: 8 });
    if (proposal.initiation_credit_lkr > (calculatedPayments.rows[0]?.gross_amount_lkr || 0)) {
      issues.push({ label: 'an initiation credit no higher than the first payment milestone', step: 7, focusId: 'p-initiation-credit' });
    }
    if (!proposal.warranties.length || !proposal.warranty_claim_contact) issues.push({ label: 'warranty and claim contact details', step: 9, focusId: 'p-warranty-contact' });
    return issues;
  }

  function showValidationIssues(issues: ProposalValidationIssue[], proposal: ProposalRecord, action: string) {
    current = proposal;
    activeStep = issues[0]?.step || 1;
    closePreview();
    renderEditor();
    notify(`Complete ${issues.map((issue) => issue.label).join(', ')} before ${action}.`, true);
    const focusId = issues[0]?.focusId;
    if (focusId) window.setTimeout(() => document.getElementById(focusId)?.focus(), 0);
  }

  async function approveProposal() {
    if (mutationBusy) return;
    current = readForm();
    if (!current) return;
    const issues = validateForIssue(current);
    if (issues.length) {
      showValidationIssues(issues, current, 'approval');
      return;
    }
    setMutationBusy(true);
    try {
      const saved = await saveDraft(true, true);
      if (!saved?.id) return;
      const approvedAt = new Date().toISOString();
      const { data, error } = await sb.from('lx_proposals').update({ status: 'approved', approved_at: approvedAt }).eq('id', saved.id).select('*').single();
      if (error) return notify(error.message, true);
      current = normaliseProposal(data as Partial<ProposalRecord>);
      proposals = proposals.map((proposal) => proposal.id === current?.id ? current : proposal);
      formDirty = false;
      notify('Proposal approved and locked.');
      renderEditor();
    } finally {
      setMutationBusy(false);
    }
  }

  async function updateStatus(status: 'sent' | 'accepted') {
    if (!current?.id || mutationBusy) return;
    setMutationBusy(true);
    try {
      const timestampKey = status === 'sent' ? 'sent_at' : 'accepted_at';
      const { data, error } = await sb.from('lx_proposals').update({ status, [timestampKey]: new Date().toISOString() }).eq('id', current.id).select('*').single();
      if (error) return notify(error.message, true);
      current = normaliseProposal(data as Partial<ProposalRecord>);
      proposals = proposals.map((proposal) => proposal.id === current?.id ? current : proposal);
      notify(`Proposal marked ${status}.`);
      renderEditor();
    } finally {
      setMutationBusy(false);
    }
  }

  async function createRevision() {
    if (!current?.id || !current.proposal_number || mutationBusy) return;
    setMutationBusy(true);
    try {
      const revisions = proposals.filter((proposal) => proposal.proposal_number === current?.proposal_number).map((proposal) => proposal.revision);
      const nextRevision = Math.max(current.revision, ...revisions) + 1;
      const issuedAt = new Date().toISOString().slice(0, 10);
      const revisionValidityDays = current.proposal_template_version >= 2 ? 14 : current.validity_days;
      const revision = normaliseProposal({
        ...current,
        id: undefined,
        revision: nextRevision,
        revision_of: current.id,
        status: 'draft',
        issued_at: issuedAt,
        validity_days: revisionValidityDays,
        valid_until: addCalendarDays(issuedAt, revisionValidityDays),
        approved_at: null,
        sent_at: null,
        accepted_at: null,
        created_at: undefined,
        updated_at: undefined,
      });
      const { data, error } = await sb.from('lx_proposals').insert(proposalPayload(revision)).select('*').single();
      if (error) return notify(error.message, true);
      current = normaliseProposal(data as Partial<ProposalRecord>);
      proposals.unshift(current);
      activeStep = 1;
      formDirty = false;
      history.replaceState(null, '', `/admin/proposals?id=${current.id}`);
      notify(`Revision R${nextRevision} created.`);
      renderEditor();
    } finally {
      setMutationBusy(false);
    }
  }

  function collectionLabel(value: string) {
    const labels: Record<string, string> = {
      flora: 'Flora Collection', island: 'Island Collection', heritage: 'Heritage Collection', gems: 'Ceylon Gems Collection',
      standard: 'Standard Collection', premium: 'Premium Collection', signature: 'Signature Collection',
    };
    return labels[value] || value || 'LUXEhome Collection';
  }

  function safeUrl(value: string) {
    return attr(value.startsWith('http') || value.startsWith('/') || value.startsWith('data:image/') ? value : '');
  }

  function materialBrand(item: ProposalMaterial) {
    const logos = (item.logo_urls || []).map((logoUrl) => `<img src="${safeUrl(logoUrl)}" alt="${attr(item.brand)} logo">`).join('');
    const luxeWordmark = /\bluxehome\b/i.test(item.brand)
      ? '<span class="material-luxe-logo"><b>LUXE</b><i>home</i></span>'
      : '';
    const marks = logos || luxeWordmark;
    return `<span class="material-brand">${marks ? `<span class="material-brand-logos">${marks}</span>` : ''}<span>${esc(item.brand)}</span></span>`;
  }

  function pdfHeader(page: number, eyebrow: string, title: string) {
    return `<header class="pdf-header"><div class="pdf-wordmark"><b>LUXE</b><i>home</i></div><small>${esc(current?.proposal_number || 'DRAFT')} &nbsp;|&nbsp; REVISION R${current?.revision || 0}</small></header>
      <div class="pdf-heading"><span>${esc(eyebrow)}</span><h2>${esc(title)}</h2></div>
      <footer><span>LUXEhome &nbsp;|&nbsp; Complete bathroom design and construction &nbsp;|&nbsp; luxehome.lk &nbsp;|&nbsp; 077 450 3744</span><b>${String(page).padStart(2, '0')}</b></footer>`;
  }

  function pdfPage(page: number, eyebrow: string, title: string, body: string, className = '') {
    return `<div class="pdf-sheet"><article class="pdf-page ${className}">${pdfHeader(page, eyebrow, title)}<main>${body}</main></article></div>`;
  }

