<section class="proposal-workspace">
  <div id="proposal-app" class="proposal-app">
    <div class="proposal-loading">Loading proposals...</div>
  </div>
</section>

<div id="proposal-preview" class="proposal-preview" hidden>
  <div class="preview-toolbar">
    <div>
      <span>PDF preview</span>
      <strong id="preview-title">Project proposal</strong>
    </div>
    <div class="preview-actions">
      <button id="preview-download" type="button">Download PDF</button>
      <button id="preview-close" type="button" class="secondary">Close</button>
    </div>
  </div>
  <div id="proposal-pdf-pages" class="proposal-pdf-pages"></div>
</div>

<div id="proposal-toast" class="proposal-toast" role="status" aria-live="polite"></div>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { LUXE_SUPABASE_KEY as key, LUXE_SUPABASE_URL as url } from '../../lib/luxe-supabase';
  import {
    addCalendarDays,
    calculateProposalPayments,
    createProposalDraft,
    DEFAULT_MATERIALS,
    formatLkr,
    type ProposalMaterial,
    type ProposalQualityItem,
    type ProposalRecord,
    type ProposalScopeItem,
    type ProposalTimelineItem,
    type ProposalWarranty,
  } from '../../lib/proposals';

  interface InspectionRow {
    id: string;
    name: string;
    phone: string;
    email?: string | null;
    location?: string | null;
    notes?: string | null;
    status?: string | null;
    created_at?: string;
  }

  interface DesignRow {
    id: string;
    name: string;
    slug: string;
    collection?: string | null;
    cover_image_url?: string | null;
    video_3d_url?: string | null;
    published?: boolean;
  }

  interface DrawingRow {
    design_id: string;
    kind?: string | null;
    image_url: string;
    caption?: string | null;
    sort_order?: number | null;
  }

  interface MaterialRow {
    design_id: string;
    category?: string | null;
    brand?: string | null;
    item?: string | null;
    usage_label?: string | null;
    image_url?: string | null;
    sort_order?: number | null;
  }

  interface FixtureRow {
    design_id: string;
    category?: string | null;
    name?: string | null;
    brand?: string | null;
    spec?: string | null;
    image_url?: string | null;
    included?: boolean | null;
    sort_order?: number | null;
  }

  const app = document.getElementById('proposal-app') as HTMLElement;
  const preview = document.getElementById('proposal-preview') as HTMLElement;
  const pagesRoot = document.getElementById('proposal-pdf-pages') as HTMLElement;
  const toastNode = document.getElementById('proposal-toast') as HTMLElement;
  const previewTitle = document.getElementById('preview-title') as HTMLElement;
  const sb = createClient(url, key);

  let proposals: ProposalRecord[] = [];
  let inspections: InspectionRow[] = [];
  let designs: DesignRow[] = [];
  let drawings: DrawingRow[] = [];
  let designMaterials: MaterialRow[] = [];
  let fixtures: FixtureRow[] = [];
  let current: ProposalRecord | null = null;
  let activeFilter = 'all';
  let downloadBusy = false;

  const drawingKinds = new Set([
    'render_1', 'render_2', 'render_3', 'render_4',
    'vanity', 'water_closet', 'shower', 'shower_cubicle', 'ceiling',
  ]);

  const esc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[character] || character));

  const attr = (value: unknown) => esc(value).replace(/`/g, '&#96;');

  const cleanArray = <T>(value: unknown, fallback: T[]): T[] => Array.isArray(value) ? value as T[] : structuredClone(fallback);

  function notify(message: string, error = false) {
    toastNode.textContent = message;
    toastNode.classList.toggle('error', error);
    toastNode.classList.add('show');
    window.setTimeout(() => toastNode.classList.remove('show'), 3200);
  }

  function normaliseProposal(row: Partial<ProposalRecord>): ProposalRecord {
    const fallback = createProposalDraft();
    return {
      ...fallback,
      ...row,
      revision: Number(row.revision ?? 0),
      contract_value_lkr: Number(row.contract_value_lkr ?? 0),
      initiation_credit_lkr: Number(row.initiation_credit_lkr ?? 50_000),
      validity_days: Number(row.validity_days ?? 30),
      commencement_days: Number(row.commencement_days ?? 7),
      room_sqm: row.room_sqm ? Number(row.room_sqm) : null,
      selected_image_urls: cleanArray<string>(row.selected_image_urls, []),
      scope_items: cleanArray<ProposalScopeItem>(row.scope_items, fallback.scope_items),
      exclusions: cleanArray<string>(row.exclusions, fallback.exclusions),
      materials: cleanArray<ProposalMaterial>(row.materials, fallback.materials),
      timeline: cleanArray<ProposalTimelineItem>(row.timeline, fallback.timeline),
      quality_items: cleanArray<ProposalQualityItem>(row.quality_items, fallback.quality_items),
      warranties: cleanArray<ProposalWarranty>(row.warranties, fallback.warranties),
    };
  }

  function effectiveStatus(proposal: ProposalRecord) {
    if (!['accepted', 'declined'].includes(proposal.status)
      && proposal.valid_until
      && proposal.valid_until < new Date().toISOString().slice(0, 10)) return 'expired';
    return proposal.status;
  }

  function statusLabel(status: string) {
    return status.charAt(0).toUpperCase() + status.slice(1);
  }

  function formatDate(value?: string | null) {
    if (!value) return 'Not set';
    return new Intl.DateTimeFormat('en-LK', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(`${value.slice(0, 10)}T00:00:00`));
  }

  async function loadData() {
    if (import.meta.env.DEV && new URLSearchParams(location.search).get('sample') === '1') {
      designs = [{ id: 'dev-moonstone', name: 'Moonstone', slug: 'moonstone', collection: 'gems', cover_image_url: '/images/designs/pichcha/pichcha-cover-v2.webp', video_3d_url: 'https://luxehome.lk/designs/moonstone', published: true }];
      drawings = [
        ['vanity', '/images/designs/pichcha/pichcha-long-vanity-v2.webp'],
        ['water_closet', '/images/designs/pichcha/pichcha-water-closet-focus-v2.webp'],
        ['shower', '/images/designs/pichcha/pichcha-shower-fixture-v2.webp'],
        ['shower_cubicle', '/images/designs/pichcha/pichcha-shower-cubicle-v2.webp'],
      ].map(([kind, image_url], index) => ({ design_id: 'dev-moonstone', kind, image_url, sort_order: index }));
      current = normaliseProposal({
        ...createProposalDraft(),
        proposal_number: 'LX-P-2026-0001',
        client_name: 'Sample Homeowner',
        client_phone: '077 000 0000',
        property_location: 'Nugegoda, Sri Lanka',
        room_dimensions: '3,000 x 3,000 mm',
        room_sqm: 9,
        client_brief: 'A calm, highly functional private retreat with better circulation, generous vanity storage and a glass shower enclosure.',
        site_findings: 'Measured site conditions, approved final layout and written material selections govern the construction quotation.',
        design_id: 'dev-moonstone',
        design_name: 'Moonstone',
        design_collection: 'gems',
        selected_image_urls: [
          '/images/designs/pichcha/pichcha-cover-v2.webp',
          '/images/designs/pichcha/pichcha-long-vanity-v2.webp',
          '/images/designs/pichcha/pichcha-water-closet-focus-v2.webp',
          '/images/designs/pichcha/pichcha-shower-fixture-v2.webp',
          '/images/designs/pichcha/pichcha-shower-cubicle-v2.webp',
        ],
        video_url: 'https://luxehome.lk/designs/moonstone',
        contract_value_lkr: 3_250_000,
      });
      renderEditor();
      return;
    }

    const { data: { session } } = await sb.auth.getSession();
    if (!session) {
      location.assign('/admin');
      return;
    }

    const [proposalResult, inspectionResult, designResult] = await Promise.all([
      sb.from('lx_proposals').select('*').order('updated_at', { ascending: false }),
      sb.from('lx_site_inspections').select('id,name,phone,email,location,notes,status,created_at').order('created_at', { ascending: false }).limit(200),
      sb.from('lx_designs').select('id,name,slug,collection,cover_image_url,video_3d_url,published,lx_spaces!inner(slug)').eq('published', true).eq('lx_spaces.slug', 'bathrooms').order('sort_order'),
    ]);

    if (proposalResult.error) {
      app.innerHTML = `<div class="module-error"><strong>Proposal module unavailable</strong><p>${esc(proposalResult.error.message)}</p></div>`;
      return;
    }

    proposals = (proposalResult.data || []).map((row) => normaliseProposal(row as Partial<ProposalRecord>));
    inspections = (inspectionResult.data || []) as InspectionRow[];
    designs = (designResult.data || []) as DesignRow[];

    const designIds = designs.map((design) => design.id);
    if (designIds.length) {
      const [drawingResult, materialResult, fixtureResult] = await Promise.all([
        sb.from('lx_design_drawings').select('design_id,kind,image_url,caption,sort_order').in('design_id', designIds).order('sort_order'),
        sb.from('lx_design_materials').select('design_id,category,brand,item,usage_label,image_url,sort_order').in('design_id', designIds).order('sort_order'),
        sb.from('lx_design_fixtures').select('design_id,category,name,brand,spec,image_url,included,sort_order').in('design_id', designIds).order('sort_order'),
      ]);
      drawings = (drawingResult.data || []) as DrawingRow[];
      designMaterials = (materialResult.data || []) as MaterialRow[];
      fixtures = (fixtureResult.data || []) as FixtureRow[];
    }

    const requestedId = new URLSearchParams(location.search).get('id');
    if (requestedId) {
      const found = proposals.find((proposal) => proposal.id === requestedId);
      if (found) {
        current = normaliseProposal(found);
        renderEditor();
        return;
      }
    }
    renderList();
  }

  function renderList() {
    current = null;
    const counts = ['draft', 'approved', 'sent', 'accepted', 'expired'].reduce<Record<string, number>>((result, status) => {
      result[status] = proposals.filter((proposal) => effectiveStatus(proposal) === status).length;
      return result;
    }, {});
    const visible = proposals.filter((proposal) => activeFilter === 'all' || effectiveStatus(proposal) === activeFilter);

    app.innerHTML = `
      <div class="proposal-list-head">
        <div><p class="mini-eyebrow">Sales documents</p><h2>Project proposals</h2><p>Create the complete decision PDF promised after a paid initiation and measured site visit.</p></div>
        <button id="new-proposal" class="primary-action" type="button">+ Create proposal</button>
      </div>
      <div class="proposal-stats">
        ${[
          ['Drafts', counts.draft || 0], ['Approved', counts.approved || 0], ['Sent', counts.sent || 0], ['Accepted', counts.accepted || 0],
        ].map(([label, value]) => `<div><strong>${value}</strong><span>${label}</span></div>`).join('')}
      </div>
      <div class="proposal-filters" role="tablist">
        ${['all', 'draft', 'approved', 'sent', 'accepted', 'expired'].map((status) => `<button type="button" data-filter="${status}" class="${activeFilter === status ? 'active' : ''}">${statusLabel(status)}</button>`).join('')}
      </div>
      <div class="proposal-list">
        ${visible.length ? visible.map((proposal) => {
          const status = effectiveStatus(proposal);
          return `<button class="proposal-card" type="button" data-proposal-id="${proposal.id}">
            <div class="proposal-card-top"><span class="status status-${status}">${statusLabel(status)}</span><small>${esc(proposal.proposal_number || 'New proposal')} / R${proposal.revision}</small></div>
            <strong>${esc(proposal.client_name || 'Unnamed client')}</strong>
            <p>${esc(proposal.design_name || 'Design not selected')} - ${esc(proposal.property_location || 'Location not entered')}</p>
            <div class="proposal-card-bottom"><span>${formatLkr(proposal.contract_value_lkr)}</span><span>Valid through ${formatDate(proposal.valid_until)}</span></div>
          </button>`;
        }).join('') : '<div class="empty-state"><strong>No proposals in this view.</strong><p>Create the first proposal or change the status filter.</p></div>'}
      </div>`;

    document.getElementById('new-proposal')?.addEventListener('click', () => {
      current = createProposalDraft();
      renderEditor();
    });
    app.querySelectorAll<HTMLElement>('[data-filter]').forEach((button) => button.addEventListener('click', () => {
      activeFilter = button.dataset.filter || 'all';
      renderList();
    }));
    app.querySelectorAll<HTMLElement>('[data-proposal-id]').forEach((button) => button.addEventListener('click', () => {
      const proposal = proposals.find((item) => item.id === button.dataset.proposalId);
      if (!proposal) return;
      current = normaliseProposal(proposal);
      history.replaceState(null, '', `/admin/proposals?id=${current.id}`);
      renderEditor();
    }));
  }

  function designMedia(designId?: string | null) {
    if (!designId) return [] as Array<{ url: string; label: string }>;
    const design = designs.find((item) => item.id === designId);
    const candidates: Array<{ url: string; label: string }> = [];
    if (design?.cover_image_url) candidates.push({ url: design.cover_image_url, label: 'Cover / whole room' });
    drawings
      .filter((item) => item.design_id === designId && item.image_url && drawingKinds.has(item.kind || ''))
      .forEach((item) => candidates.push({
        url: item.image_url,
        label: item.caption || String(item.kind || 'Design view').replaceAll('_', ' '),
      }));
    return candidates.filter((item, index, list) => list.findIndex((candidate) => candidate.url === item.url) === index);
  }

  function materialRowsForDesign(designId: string) {
    const materials = designMaterials.filter((item) => item.design_id === designId).map<ProposalMaterial>((item) => ({
      system: item.category || 'Material',
      brand: item.brand || item.item || 'Approved selection',
      specification: [item.item, item.usage_label].filter(Boolean).join(' - ') || 'Final selection recorded before purchase',
      image_url: item.image_url || undefined,
    }));
    const fixtureMaterials = fixtures
      .filter((item) => item.design_id === designId && item.included !== false)
      .map<ProposalMaterial>((item) => ({
        system: item.category || 'Fixture',
        brand: [item.brand, item.name].filter(Boolean).join(' - ') || 'Approved fixture',
        specification: item.spec || 'Model and finish recorded before purchase',
        image_url: item.image_url || undefined,
      }));
    return [...materials, ...fixtureMaterials].slice(0, 8);
  }

  function arrayRows<T extends Record<string, unknown>>(name: string, rows: T[], fields: Array<{ key: keyof T; label: string; textarea?: boolean }>, limit: number) {
    return `<div class="editable-list" data-array="${name}">
      ${rows.slice(0, limit).map((row, index) => `<div class="editable-row" data-index="${index}">
        <div class="editable-row-fields">${fields.map((field) => `<label>${esc(field.label)}${field.textarea
          ? `<textarea data-key="${String(field.key)}">${esc(row[field.key])}</textarea>`
          : `<input data-key="${String(field.key)}" value="${attr(row[field.key])}">`}</label>`).join('')}</div>
        <button type="button" class="remove-row" data-remove="${name}" data-index="${index}" aria-label="Remove ${name} row">Remove</button>
      </div>`).join('')}
      <button type="button" class="add-row" data-add="${name}" ${rows.length >= limit ? 'disabled' : ''}>+ Add item</button>
      <small>Maximum ${limit} items in this proposal layout.</small>
    </div>`;
  }

  function renderEditor() {
    if (!current) return renderList();
    const locked = current.status !== 'draft';
    const selectedDesign = designs.find((design) => design.id === current?.design_id);
    const media = designMedia(current.design_id);
    const payment = calculateProposalPayments(current.contract_value_lkr, current.initiation_credit_lkr);
    const displayNumber = current.proposal_number || 'Assigned when saved';

    app.innerHTML = `
      <div class="editor-head">
        <button id="proposal-back" class="text-button" type="button">Back to proposals</button>
        <div class="editor-title"><div><span class="status status-${effectiveStatus(current)}">${statusLabel(effectiveStatus(current))}</span><small>${esc(displayNumber)} / R${current.revision}</small></div><h2>${esc(current.client_name || 'New project proposal')}</h2><p>${locked ? 'Issued snapshot - create a revision to change scope or price.' : 'Draft autosaves only when you press Save draft.'}</p></div>
        <div class="editor-actions">
          ${locked ? `
            <button id="proposal-preview-button" type="button" class="secondary-action">Preview</button>
            <button id="proposal-download-button" type="button" class="primary-action">Download PDF</button>
            ${current.status === 'approved' ? '<button id="proposal-mark-sent" type="button" class="secondary-action">Mark sent</button>' : ''}
            ${['approved', 'sent'].includes(current.status) ? '<button id="proposal-mark-accepted" type="button" class="secondary-action">Mark accepted</button>' : ''}
            <button id="proposal-revision" type="button" class="secondary-action">Create revision</button>
          ` : `
            <button id="proposal-preview-button" type="button" class="secondary-action">Preview</button>
            <button id="proposal-save" type="button" class="secondary-action">Save draft</button>
            <button id="proposal-approve" type="button" class="primary-action">Approve and lock</button>
          `}
        </div>
      </div>

      <div class="editor-progress">
        ${['Client', 'Design', 'Scope', 'Materials', 'Programme', 'Price'].map((label, index) => `<a href="#proposal-step-${index + 1}"><span>${String(index + 1).padStart(2, '0')}</span>${label}</a>`).join('')}
      </div>

      <form id="proposal-form" class="proposal-form" ${locked ? 'data-locked="true"' : ''}>
        <section class="form-section" id="proposal-step-1">
          <div class="section-heading"><span>01</span><div><h3>Client and measured site</h3><p>Start from a paid initiation or enter the client manually.</p></div></div>
          <div class="form-grid">
            <label class="wide">Project initiation record<select id="p-source" ${locked ? 'disabled' : ''}><option value="">Manual proposal</option>${inspections.map((inspection) => `<option value="${inspection.id}" ${inspection.id === current?.source_inspection_id ? 'selected' : ''}>${esc(inspection.name)} - ${esc(inspection.location || 'No location')} (${esc(inspection.status || 'new')})</option>`).join('')}</select></label>
            <label>Client name<input id="p-client-name" required value="${attr(current.client_name)}" ${locked ? 'disabled' : ''}></label>
            <label>Phone / WhatsApp<input id="p-client-phone" value="${attr(current.client_phone)}" ${locked ? 'disabled' : ''}></label>
            <label>Email<input id="p-client-email" type="email" value="${attr(current.client_email)}" ${locked ? 'disabled' : ''}></label>
            <label>Property location<input id="p-location" required value="${attr(current.property_location)}" ${locked ? 'disabled' : ''}></label>
            <label>Project type<select id="p-project-type" ${locked ? 'disabled' : ''}><option value="renovation" ${current.project_type === 'renovation' ? 'selected' : ''}>Renovation</option><option value="new" ${current.project_type === 'new' ? 'selected' : ''}>New bathroom</option></select></label>
            <label>Bathroom name<input id="p-bathroom-name" value="${attr(current.bathroom_name)}" placeholder="Main bathroom" ${locked ? 'disabled' : ''}></label>
            <label>Measured dimensions<input id="p-room-dimensions" value="${attr(current.room_dimensions)}" placeholder="3,000 x 3,000 mm" ${locked ? 'disabled' : ''}></label>
            <label>Floor area (sqm)<input id="p-room-sqm" type="number" step="0.1" min="0" value="${current.room_sqm || ''}" ${locked ? 'disabled' : ''}></label>
            <label class="wide">Client brief<textarea id="p-client-brief" ${locked ? 'disabled' : ''}>${esc(current.client_brief)}</textarea></label>
            <label class="wide">Measured site findings<textarea id="p-site-findings" ${locked ? 'disabled' : ''}>${esc(current.site_findings)}</textarea></label>
          </div>
        </section>

        <section class="form-section" id="proposal-step-2">
          <div class="section-heading"><span>02</span><div><h3>Approved design media</h3><p>Only real images already attached to the selected CMS design are available.</p></div></div>
          <div class="form-grid">
            <label>Bathroom design<select id="p-design" ${locked ? 'disabled' : ''}><option value="">Select a published design</option>${designs.map((design) => `<option value="${design.id}" ${design.id === current?.design_id ? 'selected' : ''}>${esc(design.name)} - ${esc(design.collection || 'collection')}</option>`).join('')}</select></label>
            <label>3D walkthrough URL<input id="p-video" type="url" value="${attr(current.video_url || selectedDesign?.video_3d_url || '')}" ${locked ? 'disabled' : ''}></label>
          </div>
          <div class="media-count"><strong id="media-selected-count">${current.selected_image_urls.length}</strong><span>of 5 design images selected</span></div>
          <div class="media-grid">
            ${media.length ? media.map((item) => `<label class="media-choice"><input type="checkbox" name="proposal-image" value="${attr(item.url)}" ${current?.selected_image_urls.includes(item.url) ? 'checked' : ''} ${locked ? 'disabled' : ''}><img src="${attr(item.url)}" alt=""><span>${esc(item.label)}</span></label>`).join('') : '<div class="media-empty">No real design images are attached to this design yet. Add them in Designs before approving the proposal.</div>'}
          </div>
        </section>

        <fieldset ${locked ? 'disabled' : ''}>
          <section class="form-section" id="proposal-step-3">
            <div class="section-heading"><span>03</span><div><h3>Construction scope</h3><p>The issued version records inclusions and exclusions permanently.</p></div></div>
            ${arrayRows('scope', current.scope_items, [{ key: 'title', label: 'Scope title' }, { key: 'description', label: 'Included work', textarea: true }], 6)}
            <label class="standalone-label">Exclusions - one item per line<textarea id="p-exclusions">${esc(current.exclusions.join('\n'))}</textarea></label>
          </section>

          <section class="form-section" id="proposal-step-4">
            <div class="section-heading"><span>04</span><div><h3>Materials and finishes</h3><p>Selected CMS materials are copied into the proposal snapshot and remain editable while it is a draft.</p></div></div>
            ${arrayRows('materials', current.materials, [{ key: 'system', label: 'System' }, { key: 'brand', label: 'Brand / selection' }, { key: 'specification', label: 'Specification', textarea: true }], 8)}
          </section>

          <section class="form-section" id="proposal-step-5">
            <div class="section-heading"><span>05</span><div><h3>Programme, quality and warranties</h3><p>These defaults can be adjusted to the measured project before approval.</p></div></div>
            <h4>Indicative programme</h4>
            ${arrayRows('timeline', current.timeline, [{ key: 'week', label: 'Week' }, { key: 'title', label: 'Stage' }, { key: 'description', label: 'Work', textarea: true }], 6)}
            <h4>Quality checks</h4>
            ${arrayRows('quality', current.quality_items, [{ key: 'title', label: 'Check' }, { key: 'description', label: 'Control', textarea: true }], 6)}
            <h4>Applicable warranties</h4>
            ${arrayRows('warranties', current.warranties, [{ key: 'item', label: 'Item' }, { key: 'period', label: 'Period' }, { key: 'basis', label: 'Basis', textarea: true }], 8)}
          </section>

          <section class="form-section" id="proposal-step-6">
            <div class="section-heading"><span>06</span><div><h3>Final quotation and terms</h3><p>Enter one final contract value; milestone amounts are calculated automatically.</p></div></div>
            <div class="form-grid">
              <label>Final contract value (LKR)<input id="p-contract-value" type="number" min="0" step="1000" value="${current.contract_value_lkr || ''}"></label>
              <label>Initiation credit already paid (LKR)<input id="p-initiation-credit" type="number" min="0" step="1000" value="${current.initiation_credit_lkr}"></label>
              <label>Issue date<input id="p-issued-at" type="date" value="${current.issued_at}"></label>
              <label>Valid through<input id="p-valid-until" type="date" value="${current.valid_until}" readonly></label>
            </div>
            <div id="payment-summary" class="payment-summary">
              ${paymentSummary(payment)}
            </div>
            <label class="standalone-label">Internal notes - never shown in the client PDF<textarea id="p-internal-notes">${esc(current.internal_notes)}</textarea></label>
          </section>
        </fieldset>
      </form>
      <div class="mobile-save-bar">${locked
        ? '<button id="mobile-download" type="button">Download PDF</button>'
        : '<button id="mobile-save" type="button">Save draft</button><button id="mobile-approve" type="button">Approve</button>'}</div>`;

    bindEditor(locked);
  }

  function paymentSummary(payment: ReturnType<typeof calculateProposalPayments>) {
    return `
      <div><span>50% commencement allocation</span><strong>${formatLkr(payment.commencementAllocation)}</strong></div>
      <div class="credit"><span>Less initiation credit</span><strong>-${formatLkr(payment.initiationCredit)}</strong></div>
      <div><span>Amount due to commence</span><strong>${formatLkr(payment.commencementDue)}</strong></div>
      <div><span>Waterproofing - 20% before flood test</span><strong>${formatLkr(payment.waterproofing)}</strong></div>
      <div><span>Tiling - 10%</span><strong>${formatLkr(payment.tiling)}</strong></div>
      <div><span>Fixtures, mirror and accessories - 10%</span><strong>${formatLkr(payment.fixtures)}</strong></div>
      <div><span>Final completion - 10%</span><strong>${formatLkr(payment.final)}</strong></div>`;
  }

  function collectRows<T>(name: string, keys: string[]): T[] {
    return Array.from(app.querySelectorAll<HTMLElement>(`[data-array="${name}"] .editable-row`)).map((row) => {
      const result: Record<string, string> = {};
      keys.forEach((keyName) => {
        const field = row.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-key="${keyName}"]`);
        result[keyName] = field?.value.trim() || '';
      });
      return result as T;
    }).filter((row) => keys.some((keyName) => Boolean((row as Record<string, unknown>)[keyName])));
  }

  function value(id: string) {
    return (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value.trim() || '';
  }

  function readForm() {
    if (!current) return null;
    const imageUrls = Array.from(app.querySelectorAll<HTMLInputElement>('input[name="proposal-image"]:checked')).map((input) => input.value);
    return normaliseProposal({
      ...current,
      source_inspection_id: value('p-source') || null,
      client_name: value('p-client-name'),
      client_phone: value('p-client-phone'),
      client_email: value('p-client-email'),
      property_location: value('p-location'),
      project_type: (value('p-project-type') || 'renovation') as 'renovation' | 'new',
      bathroom_name: value('p-bathroom-name') || 'Main bathroom',
      room_dimensions: value('p-room-dimensions'),
      room_sqm: value('p-room-sqm') ? Number(value('p-room-sqm')) : null,
      client_brief: value('p-client-brief'),
      site_findings: value('p-site-findings'),
      design_id: value('p-design') || null,
      video_url: value('p-video'),
      selected_image_urls: imageUrls,
      scope_items: collectRows<ProposalScopeItem>('scope', ['title', 'description']),
      exclusions: value('p-exclusions').split('\n').map((line) => line.trim()).filter(Boolean),
      materials: collectRows<ProposalMaterial>('materials', ['system', 'brand', 'specification']),
      timeline: collectRows<ProposalTimelineItem>('timeline', ['week', 'title', 'description']),
      quality_items: collectRows<ProposalQualityItem>('quality', ['title', 'description']),
      warranties: collectRows<ProposalWarranty>('warranties', ['item', 'period', 'basis']),
      contract_value_lkr: Number(value('p-contract-value')) || 0,
      initiation_credit_lkr: Number(value('p-initiation-credit')) || 0,
      validity_days: 30,
      issued_at: value('p-issued-at') || new Date().toISOString().slice(0, 10),
      valid_until: value('p-valid-until') || addCalendarDays(value('p-issued-at'), 30),
      commencement_days: 7,
      internal_notes: value('p-internal-notes'),
    });
  }

  function bindEditor(locked: boolean) {
    document.getElementById('proposal-back')?.addEventListener('click', () => {
      history.replaceState(null, '', '/admin/proposals');
      renderList();
    });

    document.getElementById('p-source')?.addEventListener('change', (event) => {
      if (!current) return;
      current = readForm();
      const inspection = inspections.find((item) => item.id === (event.target as HTMLSelectElement).value);
      if (current && inspection) {
        current.source_inspection_id = inspection.id;
        current.client_name = inspection.name || current.client_name;
        current.client_phone = inspection.phone || current.client_phone;
        current.client_email = inspection.email || current.client_email;
        current.property_location = inspection.location || current.property_location;
        current.client_brief ||= inspection.notes || '';
      }
      renderEditor();
    });

    document.getElementById('p-design')?.addEventListener('change', (event) => {
      if (!current) return;
      current = readForm();
      const design = designs.find((item) => item.id === (event.target as HTMLSelectElement).value);
      if (current && design) {
        current.design_id = design.id;
        current.design_name = design.name;
        current.design_collection = design.collection || '';
        current.video_url = design.video_3d_url || '';
        current.selected_image_urls = designMedia(design.id).slice(0, 5).map((item) => item.url);
        const selectedMaterials = materialRowsForDesign(design.id);
        current.materials = selectedMaterials.length ? selectedMaterials : structuredClone(DEFAULT_MATERIALS);
      }
      renderEditor();
      document.getElementById('proposal-step-2')?.scrollIntoView({ behavior: 'smooth' });
    });

    app.querySelectorAll<HTMLInputElement>('input[name="proposal-image"]').forEach((input) => input.addEventListener('change', () => {
      const checked = Array.from(app.querySelectorAll<HTMLInputElement>('input[name="proposal-image"]:checked'));
      if (checked.length > 5) {
        input.checked = false;
        notify('Choose no more than five design images.', true);
      }
      const total = app.querySelectorAll('input[name="proposal-image"]:checked').length;
      const counter = document.getElementById('media-selected-count');
      if (counter) counter.textContent = String(total);
      app.querySelectorAll<HTMLInputElement>('input[name="proposal-image"]:not(:checked)').forEach((option) => option.disabled = total >= 5);
    }));

    const refreshPayments = () => {
      const contractValue = Number(value('p-contract-value')) || 0;
      const credit = Number(value('p-initiation-credit')) || 0;
      const node = document.getElementById('payment-summary');
      if (node) node.innerHTML = paymentSummary(calculateProposalPayments(contractValue, credit));
    };
    document.getElementById('p-contract-value')?.addEventListener('input', refreshPayments);
    document.getElementById('p-initiation-credit')?.addEventListener('input', refreshPayments);
    document.getElementById('p-issued-at')?.addEventListener('change', () => {
      const valid = document.getElementById('p-valid-until') as HTMLInputElement | null;
      if (valid) valid.value = addCalendarDays(value('p-issued-at'), 30);
    });

    if (!locked) {
      app.querySelectorAll<HTMLElement>('[data-add]').forEach((button) => button.addEventListener('click', () => {
        if (!current) return;
        current = readForm();
        const name = button.dataset.add;
        if (!current || !name) return;
        if (name === 'scope') current.scope_items.push({ title: '', description: '' });
        if (name === 'materials') current.materials.push({ system: '', brand: '', specification: '' });
        if (name === 'timeline') current.timeline.push({ week: '', title: '', description: '' });
        if (name === 'quality') current.quality_items.push({ title: '', description: '' });
        if (name === 'warranties') current.warranties.push({ item: '', period: '', basis: '' });
        renderEditor();
      }));
      app.querySelectorAll<HTMLElement>('[data-remove]').forEach((button) => button.addEventListener('click', () => {
        if (!current) return;
        current = readForm();
        const name = button.dataset.remove;
        const index = Number(button.dataset.index);
        if (!current || !name || Number.isNaN(index)) return;
        if (name === 'scope') current.scope_items.splice(index, 1);
        if (name === 'materials') current.materials.splice(index, 1);
        if (name === 'timeline') current.timeline.splice(index, 1);
        if (name === 'quality') current.quality_items.splice(index, 1);
        if (name === 'warranties') current.warranties.splice(index, 1);
        renderEditor();
      }));
    }

    const save = () => saveDraft(false);
    document.getElementById('proposal-save')?.addEventListener('click', save);
    document.getElementById('mobile-save')?.addEventListener('click', save);
    document.getElementById('proposal-approve')?.addEventListener('click', approveProposal);
    document.getElementById('mobile-approve')?.addEventListener('click', approveProposal);
    document.getElementById('proposal-preview-button')?.addEventListener('click', openPreview);
    document.getElementById('proposal-download-button')?.addEventListener('click', downloadPdf);
    document.getElementById('mobile-download')?.addEventListener('click', downloadPdf);
    document.getElementById('proposal-mark-sent')?.addEventListener('click', () => updateStatus('sent'));
    document.getElementById('proposal-mark-accepted')?.addEventListener('click', () => updateStatus('accepted'));
    document.getElementById('proposal-revision')?.addEventListener('click', createRevision);
  }

  function proposalPayload(proposal: ProposalRecord) {
    const {
      id, created_at, updated_at, ...payload
    } = proposal;
    if (!payload.proposal_number) delete payload.proposal_number;
    return payload;
  }

  async function saveDraft(silent: boolean) {
    const formValue = readForm();
    if (!formValue) return null;
    if (!formValue.client_name) {
      notify('Enter the client name before saving.', true);
      document.getElementById('p-client-name')?.focus();
      return null;
    }
    current = formValue;
    let saved: ProposalRecord | null = null;
    if (current.id) {
      const { data, error } = await sb.from('lx_proposals').update(proposalPayload(current)).eq('id', current.id).select('*').single();
      if (error) {
        notify(error.message, true);
        return null;
      }
      saved = normaliseProposal(data as Partial<ProposalRecord>);
    } else {
      const { data, error } = await sb.from('lx_proposals').insert(proposalPayload(current)).select('*').single();
      if (error) {
        notify(error.message, true);
        return null;
      }
      saved = normaliseProposal(data as Partial<ProposalRecord>);
    }
    current = saved;
    const index = proposals.findIndex((proposal) => proposal.id === saved?.id);
    if (index >= 0) proposals[index] = saved;
    else proposals.unshift(saved);
    history.replaceState(null, '', `/admin/proposals?id=${saved.id}`);
    if (!silent) notify('Draft saved.');
    renderEditor();
    return saved;
  }

  function validateForIssue(proposal: ProposalRecord) {
    const errors: string[] = [];
    if (!proposal.client_name) errors.push('client name');
    if (!proposal.property_location) errors.push('property location');
    if (!proposal.design_id || !proposal.design_name) errors.push('published bathroom design');
    if (proposal.selected_image_urls.length !== 5) errors.push('exactly five real design images');
    if (proposal.contract_value_lkr <= 0) errors.push('final contract value');
    if (proposal.initiation_credit_lkr > calculateProposalPayments(proposal.contract_value_lkr, proposal.initiation_credit_lkr).commencementAllocation) errors.push('an initiation credit no higher than the 50% commencement allocation');
    if (!proposal.scope_items.length) errors.push('construction scope');
    if (!proposal.materials.length) errors.push('materials');
    return errors;
  }

  async function approveProposal() {
    current = readForm();
    if (!current) return;
    const errors = validateForIssue(current);
    if (errors.length) {
      notify(`Complete ${errors.join(', ')} before approval.`, true);
      return;
    }
    const saved = await saveDraft(true);
    if (!saved?.id) return;
    const approvedAt = new Date().toISOString();
    const { data, error } = await sb.from('lx_proposals').update({ status: 'approved', approved_at: approvedAt }).eq('id', saved.id).select('*').single();
    if (error) return notify(error.message, true);
    current = normaliseProposal(data as Partial<ProposalRecord>);
    proposals = proposals.map((proposal) => proposal.id === current?.id ? current : proposal);
    notify('Proposal approved and locked.');
    renderEditor();
  }

  async function updateStatus(status: 'sent' | 'accepted') {
    if (!current?.id) return;
    const timestampKey = status === 'sent' ? 'sent_at' : 'accepted_at';
    const { data, error } = await sb.from('lx_proposals').update({ status, [timestampKey]: new Date().toISOString() }).eq('id', current.id).select('*').single();
    if (error) return notify(error.message, true);
    current = normaliseProposal(data as Partial<ProposalRecord>);
    proposals = proposals.map((proposal) => proposal.id === current?.id ? current : proposal);
    notify(`Proposal marked ${status}.`);
    renderEditor();
  }

  async function createRevision() {
    if (!current?.id || !current.proposal_number) return;
    const revisions = proposals.filter((proposal) => proposal.proposal_number === current?.proposal_number).map((proposal) => proposal.revision);
    const nextRevision = Math.max(current.revision, ...revisions) + 1;
    const issuedAt = new Date().toISOString().slice(0, 10);
    const revision = normaliseProposal({
      ...current,
      id: undefined,
      revision: nextRevision,
      revision_of: current.id,
      status: 'draft',
      issued_at: issuedAt,
      valid_until: addCalendarDays(issuedAt, 30),
      approved_at: null,
      sent_at: null,
      accepted_at: null,
      created_at: undefined,
      updated_at: undefined,
    });
    const { data, error } = await sb.from('lx_proposals').insert(proposalPayload(revision)).select('*').single();
    if (error) return notify(error.message, true);
    current = normaliseProposal(data as Partial<ProposalRecord>);
    proposals.unshift(current);
    history.replaceState(null, '', `/admin/proposals?id=${current.id}`);
    notify(`Revision R${nextRevision} created.`);
    renderEditor();
  }

  function collectionLabel(value: string) {
    const labels: Record<string, string> = {
      flora: 'Flora Collection', island: 'Island Collection', heritage: 'Heritage Collection', gems: 'Ceylon Gems Collection',
      standard: 'Standard Collection', premium: 'Premium Collection', signature: 'Signature Collection',
    };
    return labels[value] || value || 'LUXEhome Collection';
  }

  function safeUrl(value: string) {
    return attr(value.startsWith('http') || value.startsWith('/') || value.startsWith('data:image/') ? value : '');
  }

  function pdfHeader(page: number, eyebrow: string, title: string) {
    return `<header class="pdf-header"><div class="pdf-wordmark"><b>LUXE</b><i>home</i></div><small>${esc(current?.proposal_number || 'DRAFT')} &nbsp;|&nbsp; REVISION R${current?.revision || 0}</small></header>
