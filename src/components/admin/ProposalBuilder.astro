      renderLegacyPdfPages(proposal);
      return;
    }

    current = proposal;
    const images = proposal.image_items.length
      ? proposal.image_items
      : proposal.selected_image_urls.map((url, index) => ({
        url,
        view: index === 0 ? 'Cover' : 'Design view',
        title: index === 0 ? 'Hero design view' : `Approved 3D view ${index + 1}`,
        caption: 'Approved project design visual',
      }));
    const includedFixtures = proposal.fixtures.filter((item) => item.included !== false).slice(0, 10);
    const materials = proposal.materials.slice(0, 10);
    const scope = proposal.scope_items.filter((item) => item.included !== false).slice(0, 10);
