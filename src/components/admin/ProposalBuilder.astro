<section class="proposal-workspace">
  <div id="proposal-app" class="proposal-app">
    <div class="proposal-loading">Loading proposals...</div>
  </div>
</section>

<div id="proposal-preview" class="proposal-preview" hidden>
  <div class="preview-toolbar">
    <div>
      <span>PDF preview</span>
      <strong id="preview-title">Project proposal</strong>
    </div>
    <div class="preview-actions">
      <button id="preview-download" type="button">Download PDF</button>
      <button id="preview-close" type="button" class="secondary">Close</button>
    </div>
  </div>
  <div id="proposal-pdf-pages" class="proposal-pdf-pages"></div>
</div>

<div id="proposal-download-progress" class="proposal-download-progress" role="status" aria-live="polite" hidden>
  <div>
    <span class="progress-spinner" aria-hidden="true"></span>
    <small>Creating client PDF</small>
    <strong id="proposal-download-progress-text">Preparing proposal...</strong>
  </div>
</div>

<div id="proposal-toast" class="proposal-toast" role="status" aria-live="polite"></div>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { LUXE_SUPABASE_KEY as key, LUXE_SUPABASE_URL as url } from '../../lib/luxe-supabase';
  import {
    addCalendarDays,
    applyCurrentWarrantyPolicy,
    calculatePaymentSchedule,
    calculateProposalInvestment,
    calculateProposalPayments,
    createProposalDraft,
    DEFAULT_MATERIALS,
    formatLkr,
    PROPOSAL_BRANDS,
    withProposalBrandLogos,
    type ProposalFixture,
    type ProposalImageItem,
    type ProposalMaterial,
    type ProposalPaymentItem,
    type ProposalPriceItem,
    type ProposalQualityItem,
    type ProposalRecord,
    type ProposalScopeItem,
    type ProposalTimelineItem,
    type ProposalWarranty,
  } from '../../lib/proposals';

  interface InspectionRow {
    id: string;
    name: string;
    phone: string;
    email?: string | null;
    location?: string | null;
    notes?: string | null;
    status?: string | null;
    created_at?: string;
  }

  interface DesignRow {
    id: string;
    name: string;
    slug: string;
    collection?: string | null;
    cover_image_url?: string | null;
    video_3d_url?: string | null;
    published?: boolean;
  }

  interface DrawingRow {
    design_id: string;
    kind?: string | null;
    image_url: string;
    caption?: string | null;
    sort_order?: number | null;
  }

  interface MaterialRow {
    design_id: string;
    category?: string | null;
    brand?: string | null;
    item?: string | null;
    usage_label?: string | null;
    image_url?: string | null;
    sort_order?: number | null;
  }

  interface FixtureRow {
    design_id: string;
    category?: string | null;
    name?: string | null;
    brand?: string | null;
    model_code?: string | null;
    finish?: string | null;
    quantity?: number | null;
    spec?: string | null;
    warranty_period?: string | null;
    notes?: string | null;
    image_url?: string | null;
    included?: boolean | null;
    sort_order?: number | null;
  }

  const app = document.getElementById('proposal-app') as HTMLElement;
  const preview = document.getElementById('proposal-preview') as HTMLElement;
  const pagesRoot = document.getElementById('proposal-pdf-pages') as HTMLElement;
  const toastNode = document.getElementById('proposal-toast') as HTMLElement;
  const previewTitle = document.getElementById('preview-title') as HTMLElement;
  const downloadProgress = document.getElementById('proposal-download-progress') as HTMLElement;
  const downloadProgressText = document.getElementById('proposal-download-progress-text') as HTMLElement;
  const sb = createClient(url, key);

  let proposals: ProposalRecord[] = [];
  let inspections: InspectionRow[] = [];
  let designs: DesignRow[] = [];
  let drawings: DrawingRow[] = [];
  let designMaterials: MaterialRow[] = [];
  let fixtures: FixtureRow[] = [];
  let current: ProposalRecord | null = null;
  let activeFilter = 'all';
  let activeStep = 1;
  let formDirty = false;
  let mutationBusy = false;
  let downloadBusy = false;

  const proposalSteps = ['Project', 'Value + 3D', 'Fixtures', 'Finishes', 'Scope', 'Timeline', 'Investment', 'Payments', 'Warranty'];

  const drawingKinds = new Set([
    'render_1', 'render_2', 'render_3', 'render_4',
    'vanity', 'water_closet', 'shower', 'shower_cubicle', 'ceiling',
  ]);

  const esc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[character] || character));

  const attr = (value: unknown) => esc(value).replace(/`/g, '&#96;');

  const cleanArray = <T>(value: unknown, fallback: T[]): T[] => Array.isArray(value) ? value as T[] : structuredClone(fallback);

  function notify(message: string, error = false) {
    toastNode.textContent = message;
    toastNode.classList.toggle('error', error);
    toastNode.classList.add('show');
    window.setTimeout(() => toastNode.classList.remove('show'), 3200);
  }

  function isMobileEditor() {
    return window.matchMedia('(max-width: 760px)').matches;
  }

  function stepComplete(proposal: ProposalRecord, step: number) {
    if (step === 1) return Boolean(proposal.client_name && proposal.property_location && proposal.project_title);
    if (step === 2) return Boolean(proposal.design_name && proposal.design_vision && proposal.image_items.length >= 3);
    if (step === 3) return proposal.fixtures.some((item) => item.included !== false && item.name && item.brand);
    if (step === 4) return proposal.materials.some((item) => item.system && item.brand && item.specification);
    if (step === 5) return proposal.scope_items.some((item) => item.included !== false && item.title && item.description);
    if (step === 6) return Boolean(proposal.timeline.length && proposal.quality_items.length && proposal.estimated_duration);
    if (step === 7) return proposal.contract_value_lkr > 0;
    if (step === 8) return Math.abs(calculatePaymentSchedule(proposal.contract_value_lkr, proposal.initiation_credit_lkr, proposal.payment_schedule).percentageTotal - 100) < 0.0001;
    return Boolean(proposal.warranties.length && proposal.warranty_claim_contact);
  }

  function setMutationBusy(busy: boolean) {
    mutationBusy = busy;
    app.classList.toggle('is-busy', busy);
    [
      'proposal-save', 'mobile-save', 'proposal-approve', 'mobile-approve',
      'proposal-mark-sent', 'proposal-mark-accepted', 'proposal-revision',
    ].forEach((id) => {
      const button = document.getElementById(id) as HTMLButtonElement | null;
      if (button) button.disabled = busy;
    });
  }

  function normaliseProposal(row: Partial<ProposalRecord>): ProposalRecord {
    const fallback = createProposalDraft();
    const templateVersion = Number(row.proposal_template_version ?? fallback.proposal_template_version);
    const selectedImageUrls = cleanArray<string>(row.selected_image_urls, []);
    const imageItems = cleanArray<ProposalImageItem>(row.image_items, []).map((item, index) => ({
      url: item.url || selectedImageUrls[index] || '',
      view: item.view || (index === 0 ? 'Cover' : 'Design view'),
      title: item.title || (index === 0 ? 'Hero design view' : `Approved 3D view ${index + 1}`),
      caption: item.caption || 'Approved project design visual',
    })).filter((item) => item.url);
    return {
      ...fallback,
      ...row,
      proposal_template_version: templateVersion,
      revision: Number(row.revision ?? 0),
      contract_value_lkr: Number(row.contract_value_lkr ?? 0),
      initiation_credit_lkr: Number(row.initiation_credit_lkr ?? 50_000),
      discount_lkr: Number(row.discount_lkr ?? 0),
      tax_lkr: Number(row.tax_lkr ?? 0),
      adjustment_lkr: Number(row.adjustment_lkr ?? 0),
      programme_extension_days: Number(row.programme_extension_days ?? 14),
      validity_days: Number(row.validity_days ?? (templateVersion >= 2 ? 14 : 30)),
      commencement_days: Number(row.commencement_days ?? 7),
      room_sqm: row.room_sqm ? Number(row.room_sqm) : null,
      proposed_start_date: row.proposed_start_date || null,
      proposed_handover_date: row.proposed_handover_date || null,
      selected_image_urls: imageItems.length ? imageItems.map((item) => item.url) : selectedImageUrls,
      image_items: imageItems.length ? imageItems : selectedImageUrls.map((url, index) => ({
        url,
        view: index === 0 ? 'Cover' : 'Design view',
        title: index === 0 ? 'Hero design view' : `Approved 3D view ${index + 1}`,
        caption: 'Approved project design visual',
      })),
      value_points: cleanArray<string>(row.value_points, fallback.value_points),
      fixtures: cleanArray<ProposalFixture>(row.fixtures, fallback.fixtures).map((item) => ({
        ...item,
        quantity: Math.max(1, Number(item.quantity) || 1),
        included: item.included !== false,
      })),
      scope_items: cleanArray<ProposalScopeItem>(row.scope_items, fallback.scope_items).map((item) => ({ ...item, included: item.included !== false })),
      exclusions: cleanArray<string>(row.exclusions, fallback.exclusions),
      assumptions: cleanArray<string>(row.assumptions, fallback.assumptions),
      client_supplied_items: cleanArray<string>(row.client_supplied_items, fallback.client_supplied_items),
      materials: cleanArray<ProposalMaterial>(row.materials, fallback.materials).map(withProposalBrandLogos),
      timeline: cleanArray<ProposalTimelineItem>(row.timeline, fallback.timeline),
      quality_items: cleanArray<ProposalQualityItem>(row.quality_items, fallback.quality_items),
      warranties: applyCurrentWarrantyPolicy(
        cleanArray<ProposalWarranty>(row.warranties, fallback.warranties),
        row.status || fallback.status,
      ),
      warranty_exclusions: cleanArray<string>(row.warranty_exclusions, fallback.warranty_exclusions),
      price_items: cleanArray<ProposalPriceItem>(row.price_items, fallback.price_items).map((item) => ({
        ...item,
        amount_lkr: Math.max(0, Number(item.amount_lkr) || 0),
      })),
      payment_schedule: cleanArray<ProposalPaymentItem>(row.payment_schedule, templateVersion >= 2 ? fallback.payment_schedule : []).map((item) => ({
        ...item,
        percentage: Math.max(0, Number(item.percentage) || 0),
      })),
    };
  }

  function effectiveStatus(proposal: ProposalRecord) {
    if (!['accepted', 'declined'].includes(proposal.status)
      && proposal.valid_until
      && proposal.valid_until < new Date().toISOString().slice(0, 10)) return 'expired';
    return proposal.status;
  }

  function statusLabel(status: string) {
    return status.charAt(0).toUpperCase() + status.slice(1);
  }

  function formatDate(value?: string | null) {
    if (!value) return 'Not set';
    return new Intl.DateTimeFormat('en-LK', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(`${value.slice(0, 10)}T00:00:00`));
  }

  async function loadData() {
    if (import.meta.env.DEV && new URLSearchParams(location.search).get('sample') === '1') {
      designs = [{ id: 'dev-moonstone', name: 'Moonstone', slug: 'moonstone', collection: 'gems', cover_image_url: '/images/designs/pichcha/pichcha-cover-v2.webp', video_3d_url: 'https://luxehome.lk/designs/moonstone', published: true }];
      drawings = [
        ['vanity', '/images/designs/pichcha/pichcha-long-vanity-v2.webp'],
        ['water_closet', '/images/designs/pichcha/pichcha-water-closet-focus-v2.webp'],
        ['shower', '/images/designs/pichcha/pichcha-shower-fixture-v2.webp'],
        ['shower_cubicle', '/images/designs/pichcha/pichcha-shower-cubicle-v2.webp'],
      ].map(([kind, image_url], index) => ({ design_id: 'dev-moonstone', kind, image_url, sort_order: index }));
      current = normaliseProposal({
        ...createProposalDraft(),
        proposal_number: 'LX-P-2026-0001',
        client_name: 'Sample Homeowner',
        client_phone: '077 000 0000',
        property_location: 'Nugegoda, Sri Lanka',
        room_dimensions: '3,000 x 3,000 mm',
        room_sqm: 9,
        client_brief: 'A calm, highly functional private retreat with better circulation, generous vanity storage and a glass shower enclosure.',
        site_findings: 'Measured site conditions, approved final layout and written material selections govern the construction quotation.',
        design_vision: 'A quiet stone-and-oak bathroom with concealed services, generous storage and warm layered lighting, designed to feel composed while remaining practical for daily use.',
        design_id: 'dev-moonstone',
        design_name: 'Moonstone',
        design_collection: 'gems',
        selected_image_urls: [
          '/images/designs/pichcha/pichcha-cover-v2.webp',
          '/images/designs/pichcha/pichcha-long-vanity-v2.webp',
          '/images/designs/pichcha/pichcha-water-closet-focus-v2.webp',
          '/images/designs/pichcha/pichcha-shower-fixture-v2.webp',
          '/images/designs/pichcha/pichcha-shower-cubicle-v2.webp',
        ],
        video_url: 'https://luxehome.lk/designs/moonstone',
        fixtures: [
          { category: 'WC', name: 'Wall-mounted WC', brand: 'Swiss Bathware', model: 'Approved concealed model', dimensions: 'Project verified', finish: 'Gloss white', quantity: 1, specification: 'Wall-mounted WC with concealed cistern and service access', warranty: 'Manufacturer terms', value_note: 'Clears the floor visually and makes routine cleaning easier.', image_url: '/images/designs/pichcha/pichcha-water-closet-focus-v2.webp', included: true },
          { category: 'Shower', name: 'Pure Rain shower system', brand: 'Swiss Bathware', model: 'N50 / N70', dimensions: 'Project verified', finish: 'Brushed metal', quantity: 1, specification: 'Coordinated shower head, hand shower and concealed controls', warranty: 'Manufacturer terms', value_note: 'A coordinated concealed system keeps the wall calm and simplifies daily use.', image_url: '/images/fixtures/swiss-pure-rain-70.webp', included: true },
          { category: 'Vanity', name: 'Custom vanity and basin', brand: 'LUXEhome', model: 'Project made', dimensions: 'Measured to room', finish: 'Warm oak', quantity: 1, specification: 'Wall-mounted vanity with storage, solid top and selected basin', warranty: '24-month installation workmanship', value_note: 'Adds practical storage without making the room feel heavy.', image_url: '/images/designs/pichcha/pichcha-long-vanity-v2.webp', included: true },
          { category: 'Glass', name: 'Shower cubicle', brand: 'LUXEhome approved', model: 'Measured after tiling', dimensions: 'Site measured', finish: 'Clear tempered glass', quantity: 1, specification: 'Tempered-glass enclosure with coordinated hardware', warranty: 'Supplier terms', value_note: 'Contains water while preserving the open visual line through the room.', image_url: '/images/designs/pichcha/pichcha-shower-cubicle-v2.webp', included: true },
        ],
        materials: DEFAULT_MATERIALS.map((item, index) => ({
          ...item,
          image_url: index === 0 ? '/images/designs/pichcha/pichcha-shower-fixture-v2.webp' : index === 6 ? '/images/designs/pichcha/pichcha-cover-v2.webp' : item.image_url,
        })),
        price_items: [
          { category: 'Design and project coordination', description: 'Measured design, selection coordination, procurement planning and project supervision', amount_lkr: 325_000 },
          { category: 'Construction and concealed services', description: 'Site protection, demolition, civil work, plumbing, electrical and waterproofing', amount_lkr: 1_100_000 },
          { category: 'Finishes and installation', description: 'Tiling, ceiling, lighting, joinery, fixtures, glass, testing and handover', amount_lkr: 1_825_000 },
        ],
        contract_value_lkr: 3_250_000,
      });
      activeStep = 1;
      formDirty = false;
      renderEditor();
      return;
    }

    const { data: { session } } = await sb.auth.getSession();
    if (!session) {
      location.assign('/admin');
      return;
    }

    const [proposalResult, inspectionResult, designResult] = await Promise.all([
      sb.from('lx_proposals').select('*').order('updated_at', { ascending: false }),
      sb.from('lx_site_inspections').select('id,name,phone,email,location,notes,status,created_at').order('created_at', { ascending: false }).limit(200),
      sb.from('lx_designs').select('id,name,slug,collection,cover_image_url,video_3d_url,published,lx_spaces!inner(slug)').eq('published', true).eq('lx_spaces.slug', 'bathrooms').order('sort_order'),
    ]);

    if (proposalResult.error) {
      app.innerHTML = `<div class="module-error"><strong>Proposal module unavailable</strong><p>${esc(proposalResult.error.message)}</p></div>`;
      return;
    }

    proposals = (proposalResult.data || []).map((row) => normaliseProposal(row as Partial<ProposalRecord>));
    inspections = (inspectionResult.data || []) as InspectionRow[];
    designs = (designResult.data || []) as DesignRow[];

    const designIds = designs.map((design) => design.id);
    if (designIds.length) {
      const [drawingResult, materialResult, fixtureResult] = await Promise.all([
        sb.from('lx_design_drawings').select('design_id,kind,image_url,caption,sort_order').in('design_id', designIds).order('sort_order'),
        sb.from('lx_design_materials').select('design_id,category,brand,item,usage_label,image_url,sort_order').in('design_id', designIds).order('sort_order'),
        sb.from('lx_design_fixtures').select('design_id,category,name,brand,model_code,finish,quantity,spec,warranty_period,notes,image_url,included,sort_order').in('design_id', designIds).order('sort_order'),
      ]);
      drawings = (drawingResult.data || []) as DrawingRow[];
      designMaterials = (materialResult.data || []) as MaterialRow[];
      fixtures = (fixtureResult.data || []) as FixtureRow[];
    }

    const requestedId = new URLSearchParams(location.search).get('id');
    if (requestedId) {
      const found = proposals.find((proposal) => proposal.id === requestedId);
      if (found) {
        current = normaliseProposal(found);
        activeStep = 1;
        formDirty = false;
        renderEditor();
        return;
      }
    }
    renderList();
  }

  function renderList() {
    current = null;
    activeStep = 1;
    formDirty = false;
    const counts = ['draft', 'approved', 'sent', 'accepted', 'expired'].reduce<Record<string, number>>((result, status) => {
      result[status] = proposals.filter((proposal) => effectiveStatus(proposal) === status).length;
      return result;
    }, {});
    const visible = proposals.filter((proposal) => activeFilter === 'all' || effectiveStatus(proposal) === activeFilter);

    app.innerHTML = `
      <div class="proposal-list-head">
        <div><p class="mini-eyebrow">Sales documents</p><h2>Project proposals</h2><p>Create the complete decision PDF promised after a paid initiation and measured site visit.</p></div>
        <button id="new-proposal" class="primary-action" type="button">+ Create proposal</button>
      </div>
      <div class="proposal-stats">
        ${[
          ['Drafts', counts.draft || 0], ['Approved', counts.approved || 0], ['Sent', counts.sent || 0], ['Accepted', counts.accepted || 0],
        ].map(([label, value]) => `<div><strong>${value}</strong><span>${label}</span></div>`).join('')}
      </div>
      <div class="proposal-filters" role="tablist">
        ${['all', 'draft', 'approved', 'sent', 'accepted', 'expired'].map((status) => `<button type="button" data-filter="${status}" class="${activeFilter === status ? 'active' : ''}">${statusLabel(status)}</button>`).join('')}
      </div>
      <div class="proposal-list">
        ${visible.length ? visible.map((proposal) => {
          const status = effectiveStatus(proposal);
          return `<button class="proposal-card" type="button" data-proposal-id="${proposal.id}">
            <div class="proposal-card-top"><span class="status status-${status}">${statusLabel(status)}</span><small>${esc(proposal.proposal_number || 'New proposal')} / R${proposal.revision}</small></div>
            <strong>${esc(proposal.client_name || 'Unnamed client')}</strong>
            <p>${esc(proposal.design_name || 'Design not selected')} - ${esc(proposal.property_location || 'Location not entered')}</p>
            <div class="proposal-card-bottom"><span>${formatLkr(proposal.contract_value_lkr)}</span><span>Valid through ${formatDate(proposal.valid_until)}</span></div>
          </button>`;
        }).join('') : '<div class="empty-state"><strong>No proposals in this view.</strong><p>Create the first proposal or change the status filter.</p></div>'}
      </div>`;

    document.getElementById('new-proposal')?.addEventListener('click', () => {
      current = createProposalDraft();
      activeStep = 1;
      formDirty = false;
      renderEditor();
    });
    app.querySelectorAll<HTMLElement>('[data-filter]').forEach((button) => button.addEventListener('click', () => {
      activeFilter = button.dataset.filter || 'all';
      renderList();
    }));
    app.querySelectorAll<HTMLElement>('[data-proposal-id]').forEach((button) => button.addEventListener('click', () => {
      const proposal = proposals.find((item) => item.id === button.dataset.proposalId);
      if (!proposal) return;
      current = normaliseProposal(proposal);
      activeStep = 1;
      formDirty = false;
      history.replaceState(null, '', `/admin/proposals?id=${current.id}`);
      renderEditor();
    }));
  }

  function designMedia(designId?: string | null) {
    if (!designId) return [] as Array<{ url: string; label: string }>;
    const design = designs.find((item) => item.id === designId);
    const candidates: Array<{ url: string; label: string }> = [];
    if (design?.cover_image_url) candidates.push({ url: design.cover_image_url, label: 'Cover / whole room' });
    drawings
      .filter((item) => item.design_id === designId && item.image_url && drawingKinds.has(item.kind || ''))
      .forEach((item) => candidates.push({
        url: item.image_url,
        label: item.caption || String(item.kind || 'Design view').replaceAll('_', ' '),
      }));
    return candidates.filter((item, index, list) => list.findIndex((candidate) => candidate.url === item.url) === index);
  }

  function materialRowsForDesign(designId: string) {
    const materials = designMaterials.filter((item) => item.design_id === designId).map<ProposalMaterial>((item) => ({
      system: item.category || 'Material',
      brand: item.brand || item.item || 'Approved selection',
      specification: [item.item, item.usage_label].filter(Boolean).join(' - ') || 'Final selection recorded before purchase',
      image_url: item.image_url || undefined,
      value_note: item.usage_label || 'Selected to support the approved design, installation method and expected service life.',
    }));
    return materials.slice(0, 10).map(withProposalBrandLogos);
  }

  function fixtureRowsForDesign(designId: string) {
    return fixtures
      .filter((item) => item.design_id === designId && item.included !== false)
      .map<ProposalFixture>((item) => ({
        category: item.category || 'Fixture',
        name: item.name || 'Approved fixture',
        brand: item.brand || 'Approved brand',
        model: item.model_code || '',
        dimensions: '',
        finish: item.finish || '',
        quantity: Math.max(1, Number(item.quantity) || 1),
        specification: item.spec || 'Model and finish recorded before purchase',
        warranty: item.warranty_period || 'Manufacturer terms',
        value_note: item.notes || 'Selected to coordinate with the approved layout, finish palette and daily use.',
        image_url: item.image_url || undefined,
      }));
  }

  function arrayRows<T extends Record<string, unknown>>(
    name: string,
    rows: T[],
    fields: Array<{
      key: keyof T;
      label: string;
      textarea?: boolean;
      type?: 'text' | 'number' | 'url' | 'date' | 'image';
      min?: number;
      step?: number;
      placeholder?: string;
      wide?: boolean;
    }>,
    limit: number,
  ) {
    return `<div class="editable-list" data-array="${name}">
      ${rows.slice(0, limit).map((row, index) => `<div class="editable-row" data-index="${index}">
        <div class="editable-row-fields">${fields.map((field) => {
          const keyName = String(field.key);
          const rawValue = row[field.key] ?? '';
          if (field.type === 'image') return `<div class="row-image-field ${field.wide ? 'wide' : ''}">
            ${rawValue ? `<img data-row-image-preview="${name}-${index}-${keyName}" src="${safeUrl(String(rawValue))}" alt="${attr(field.label)} preview">` : `<span data-row-image-preview="${name}-${index}-${keyName}">No image selected</span>`}
            <label>${esc(field.label)} URL<input data-key="${keyName}" type="url" value="${attr(rawValue)}" placeholder="https://..."></label>
            <label class="row-upload-button">Upload image<input type="file" accept="image/*" data-row-image-upload="${name}" data-row-index="${index}" data-row-key="${keyName}"></label>
          </div>`;
          const inputType = field.type || (field.textarea ? 'textarea' : 'text');
          return `<label class="${field.wide ? 'wide' : ''}">${esc(field.label)}${inputType === 'textarea'
            ? `<textarea data-key="${keyName}" placeholder="${attr(field.placeholder || '')}">${esc(rawValue)}</textarea>`
            : `<input data-key="${keyName}" type="${inputType}" value="${attr(rawValue)}" ${field.min !== undefined ? `min="${field.min}"` : ''} ${field.step !== undefined ? `step="${field.step}"` : ''} placeholder="${attr(field.placeholder || '')}">`}</label>`;
        }).join('')}</div>
        <button type="button" class="remove-row" data-remove="${name}" data-index="${index}" aria-label="Remove ${name} row">Remove</button>
      </div>`).join('')}
      <button type="button" class="add-row" data-add="${name}" ${rows.length >= limit ? 'disabled' : ''}>+ Add item</button>
      <small>Maximum ${limit} items in this proposal layout.</small>
    </div>`;
  }

