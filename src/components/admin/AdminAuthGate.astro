<div id="admin-auth-gate" class="gate" aria-live="polite">
  <form id="admin-magic-form" class="card">
    <div class="wordmark"><strong>LUXE</strong><em>home</em><small>CMS</small></div>
    <p class="eyebrow">Protected administration</p>
    <h1>Sign in by email link.</h1>
    <p>We’ll send a secure, one-time sign-in link to an authorised administrator or editor.</p>
    <label>Email<input id="admin-magic-email" type="email" autocomplete="email" placeholder="name@example.com" required /></label>
    <button type="submit">Email me a sign-in link</button>
    <p id="admin-magic-status" class="status"></p>
    <a href="/">← Return to the website</a>
  </form>
</div>
<script>
  import { createClient } from '@supabase/supabase-js';
  import { LUXE_SUPABASE_KEY as key, LUXE_SUPABASE_URL as url } from '../../lib/luxe-supabase';
  import { sendAdminSignInLink } from '../../lib/luxe-admin-sign-in';
  const gate=document.getElementById('admin-auth-gate'),form=document.getElementById('admin-magic-form'),emailInput=document.getElementById('admin-magic-email'),status=document.getElementById('admin-magic-status');
  if(!url||!key){status.textContent='Supabase is not configured.'}
  else{
    const sb=createClient(url,key);
    const {data:{session}}=await sb.auth.getSession();
    if(session) gate.remove();
    else form.addEventListener('submit',async(event)=>{
      event.preventDefault();const email=emailInput.value.trim().toLowerCase();const button=form.querySelector('button');
      if(!email){status.textContent='Enter your authorised email address.';return}
      button.disabled=true;emailInput.disabled=true;status.textContent='Sending secure link…';
      const error=await sendAdminSignInLink(sb,email,location.origin+'/admin/');
      status.textContent=error?error.message:`Check ${email} and open the sign-in link on this device.`;
      emailInput.disabled=false;
      button.disabled=false;
    });
    window.addEventListener('admin-sign-out',async()=>{await sb.auth.signOut();location.assign('/admin')});
  }
</script>
<style>
  .gate{position:fixed;inset:0;z-index:9999;background:#f7f3eb;display:grid;place-items:center;padding:20px}.card{width:min(430px,100%);background:#fff;border:1px solid #2b322a18;border-radius:14px;padding:32px;box-shadow:0 25px 70px #2b322a18}.wordmark{font:26px Jost,sans-serif;letter-spacing:.04em}.wordmark em{font:italic 29px 'Cormorant Garamond',serif;color:#5c6b56}.wordmark small{display:block;font:10px Jost,sans-serif;letter-spacing:.2em;color:#8a9a84}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:10px;color:#5c6b56;margin:30px 0 6px}.card h1{font:500 42px/1.05 'Cormorant Garamond',serif;margin:0 0 12px}.card>p:not(.eyebrow):not(.status){color:#667064}.card label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.1em;margin-top:22px}.card input{width:100%;margin-top:6px;padding:13px;border:1px solid #2b322a28;border-radius:7px;background:#f7f3eb;font:15px Jost,sans-serif}.card button{width:100%;margin-top:13px;padding:13px;border:0;border-radius:7px;background:#5c6b56;color:#fff;font:600 13px Jost,sans-serif;cursor:pointer}.card button:disabled{opacity:.6}.status{min-height:2.8em;color:#5c6b56;font-size:12px}.card>a{color:#5c6b56;font-size:12px}
</style>
