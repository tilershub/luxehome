---
import type { CmsModule } from '../../lib/admin-cms';
const { module }=Astro.props as {module:CmsModule};
---
<div id="manager" data-module={JSON.stringify(module)}><div class="loading">Loading…</div></div>
<div id="cms-modal"></div><div id="toast"></div>
<script>
  import {createClient} from '@supabase/supabase-js';
  import {LUXE_SUPABASE_KEY as key,LUXE_SUPABASE_URL as url} from '../../lib/luxe-supabase';
  import {FIXTURE_CATEGORIES,MATERIAL_CATEGORIES} from '../../lib/luxe-config';
  const root=document.getElementById('manager'),modal=document.getElementById('cms-modal'),cfg=JSON.parse(root.dataset.module);
  let sb,rows=[],lookups={spaces:[],designs:[],catalogue:[]};
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const choiceLabel=v=>String(v??'').replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
  const toast=m=>{const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400)};
  const slugify=s=>String(s).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
  async function auth(){if(!url||!key){root.innerHTML='<p>Supabase is not configured.</p>';return false}sb||=createClient(url,key);const {data:{session}}=await sb.auth.getSession();if(session)return true;location.assign('/admin');return false}
  async function load(){
    if(!(await auth()))return;
    const allFields=[...cfg.fields,...(cfg.children||[]).flatMap(child=>child.fields)];
    const relationNames=[...new Set(allFields.filter(f=>f.type==='relation').map(f=>f.relation))];
    await Promise.all(relationNames.map(async name=>{
      if(name==='catalogue'){
        const {data,error}=await sb.from('lx_fixture_library')
          .select('id,section,category,item_name,brand,model_code,specification,image_url,active')
          .order('item_name');
        if(error)toast('Fixture library unavailable: '+error.message);
        lookups.catalogue=(data||[]).map(item=>({...item,name:[item.item_name,item.brand,item.model_code].filter(Boolean).join(' · ')}));
      }else{
        const table=name==='spaces'?'lx_spaces':'lx_designs';
        const columns=name==='spaces'?'id,name,slug':'id,name';
        const {data}=await sb.from(table).select(columns).order('name');
        lookups[name]=data||[];
      }
    }));
    const {data,error}=await sb.from(cfg.table).select('*').order(cfg.titleKey);
    if(error)return root.innerHTML=`<div class="panel"><h2>Module unavailable</h2><p>${esc(error.message)}</p></div>`;
    rows=data||[];
    if(new URLSearchParams(location.search).get('new')==='1'){history.replaceState(null,'',location.pathname);edit(null)}else list();
  }
  function cards(items){return items.length?items.map(r=>{const status=cfg.statusKey?r[cfg.statusKey]:null;const label=typeof status==='boolean'?(status?'Published':'Draft'):status;return `<article class="item" data-id="${esc(r.id)}"><div><strong>${esc(r[cfg.titleKey]||'Untitled')}</strong>${label!==null&&label!==undefined&&label!==''?`<small class="status-pill ${status===true||status==='published'?'live':''}">${esc(label)}</small>`:''}</div><button type="button">Edit</button></article>`}).join(''):'<div class="panel empty">No records yet.</div>'}
  function list(){root.innerHTML=`<div class="toolbar"><input id="search" placeholder="Search ${esc(cfg.label.toLowerCase())}"><button id="new-record">+ New</button></div><div id="rows">${cards(rows)}</div>`;const search=document.getElementById('search');search.oninput=()=>document.getElementById('rows').innerHTML=cards(rows.filter(r=>String(r[cfg.titleKey]||'').toLowerCase().includes(search.value.toLowerCase())));document.getElementById('new-record').onclick=()=>edit(null);bindCards()}
  function bindCards(){root.querySelectorAll('.item').forEach(el=>el.onclick=()=>edit(rows.find(r=>String(r.id)===el.dataset.id)))}
  function field(f,v,prefix=''){
    const name=prefix+f.key;
    if(f.type==='checkbox')return `<label class="check"><input name="${name}" type="checkbox" ${v?'checked':''}> ${esc(f.label)}</label>`;
    if(f.type==='textarea')return `<label>${esc(f.label)}<textarea name="${name}" ${f.required?'required':''}>${esc(v)}</textarea></label>`;
    if(f.type==='images'){
      const list=Array.isArray(v)?v:(v?String(v).split('\n').filter(Boolean):[]);
      return `<div class="image-field">
        <label>${esc(f.label)}<textarea name="${name}" placeholder="One photo URL per line">${esc(list.join('\n'))}</textarea></label>
        <span class="image-tools"><label class="upload-button">Add stage photos
          <input type="file" accept="image/*" multiple data-images-upload="${name}"></label>
          <span class="image-preview-empty" data-images-count="${name}">${list.length} image(s)</span>
        </span>
        <div class="cms-photo-thumbs" data-photo-thumbnails="${name}"></div>
        <small class="field-help">Select several images from your phone. Images are converted to WebP and you can remove individual photos below.</small>
      </div>`;
    }
    if(f.type==='lines')return `<label>${esc(f.label)}<textarea name="${name}" placeholder="One item per line">${esc(Array.isArray(v)?v.join('\n'):v)}</textarea></label>`;
    if(f.type==='select')return `<label>${esc(f.label)}<select name="${name}">${(f.options||[]).map(o=>`<option value="${esc(o)}" ${o===v?'selected':''}>${esc(choiceLabel(o))}</option>`).join('')}</select></label>`;
    if(f.type==='datalist'){const id=`options-${name}`;return `<label>${esc(f.label)}<input name="${name}" list="${id}" value="${esc(v)}" ${f.required?'required':''}><datalist id="${id}">${(f.options||[]).map(o=>`<option value="${esc(o)}"></option>`).join('')}</datalist><small class="field-help">Choose a suggestion or type your own category.</small></label>`}
    if(f.type==='image')return `<div class="image-field"><label>${esc(f.label)}<input name="${name}" type="url" value="${esc(v)}" placeholder="https://…"></label><span class="image-tools"><label class="upload-button">Upload photo<input type="file" accept="image/*" data-image-upload="${name}"></label>${v?`<img data-image-preview="${name}" src="${esc(v)}" alt="Preview">`:`<span data-image-preview="${name}" class="image-preview-empty">No image selected</span>`}</span><small class="field-help">Choose from your camera roll or take a photo — converted to WebP automatically.</small></div>`;
    if(f.type==='catalogue'){
      const options=lookups.fixtures||[];
      return `<label>Saved fixture / material<select name="${name}" data-catalog-picker><option value="">Custom / enter a new item</option>${options.map(o=>`<option value="${esc(o.id)}" ${o.id===v?'selected':''}>${esc([o.category,o.brand,o.item_name,o.model_code].filter(Boolean).join(' · '))}</option>`).join('')}</select><small class="field-help">Choose a saved item to copy its description, brand, model and image. You can then customize the selected project's copy.</small></label>`;
    }
    if(f.type==='relation'){const options=lookups[f.relation]||[];return `<label>${esc(f.label)}<select name="${name}" ${f.required?'required':''}><option value="">Not selected</option>${options.map(o=>`<option value="${o.id}" ${o.id===v?'selected':''}>${esc(o.name)}</option>`).join('')}</select></label>`}
    return `<label>${esc(f.label)}<input name="${name}" type="${f.type||'text'}" value="${esc(v)}" ${f.type==='number'?`step="${esc(f.step||'1')}"`:''} ${f.required?'required':''}></label>`;
  }
  function values(form,fields,prefix=''){const data={};fields.forEach(f=>{const el=form.elements[prefix+f.key];if(f.type==='checkbox')data[f.key]=el.checked;else if(f.type==='number')data[f.key]=el.value===''?null:Number(el.value);else if(f.type==='lines'||f.type==='images')data[f.key]=el.value.split('\n').map(x=>x.trim()).filter(Boolean);else data[f.key]=el.value||null});return data}
  async function edit(source){
    const fresh=!source,row=source||{};
    if(fresh && cfg.slug==='fixture-library')row.active=true;
    root.innerHTML=`<form id="editor" class="panel"><div class="formhead"><div><p class="eyebrow">${fresh?'Create':'Edit'} record</p><h2>${fresh?'New '+esc(cfg.label):esc(row[cfg.titleKey])}</h2></div><button type="button" id="back">Back to list</button></div>${cfg.slug==='media'?'<label class="media-upload">Upload image<input id="media-file" type="file" accept="image/*"></label>':''}<div class="fields">${cfg.fields.map(f=>field(f,row[f.key])).join('')}</div><div class="actions"><button class="save">Save</button>${fresh?'':`<button type="button" class="delete" id="delete">Delete</button>`}</div></form><div id="children"></div>`;
    const editor=document.getElementById('editor');document.getElementById('back').onclick=list;
    const nameInput=editor.elements.name,titleInput=editor.elements.title,slugInput=editor.elements.slug;
    (nameInput||titleInput)?.addEventListener('blur',()=>{if(slugInput&&!slugInput.value)slugInput.value=slugify((nameInput||titleInput).value)});
    bindImageUploads(editor,cfg.slug);
    document.getElementById('media-file')?.addEventListener('change',async e=>{
      const file=e.target.files?.[0];if(!file)return;
      e.target.disabled=true;toast('Converting to WebP…');
      try{
        const {url,size,was}=await uploadImage(file,'media');
        editor.elements.public_url.value=url;
        editor.elements.storage_path.value=new URL(url).pathname.split('/luxehome-media/').pop()||'';
        if(!editor.elements.name.value)editor.elements.name.value=file.name.replace(/\.[^.]+$/,'');
        toast(`Uploaded · ${prettyKB(was)} → ${prettyKB(size)} WebP`);
      }catch(err){toast(err.message||'Upload failed')}
      finally{e.target.disabled=false;e.target.value=''}
    });
    editor.onsubmit=async e=>{e.preventDefault();const payload=values(editor,cfg.fields);let query=fresh?sb.from(cfg.table).insert(payload).select().single():sb.from(cfg.table).update(payload).eq('id',row.id).select().single();const {data,error}=await query;if(error)return toast(error.message);toast('Saved');await load();const saved=rows.find(item=>String(item.id)===String(data.id));if(saved)edit(saved)};
    document.getElementById('delete')?.addEventListener('click',async()=>{if(!confirm('Delete this record?'))return;const {error}=await sb.from(cfg.table).delete().eq('id',row.id);if(error)return toast(error.message);toast('Deleted');load()});
    if(!fresh&&cfg.children?.length)await renderChildren(row);
  }
  async function renderChildren(parent){
    const holder=document.getElementById('children');
    const groups=await Promise.all(cfg.children.map(async def=>{const {data,error}=await sb.from(def.table).select('*').eq(def.foreignKey,parent.id).order('sort_order',{ascending:true});return {def,items:data||[],error}}));
    holder.innerHTML=groups.map((group,index)=>`<section class="child panel"><div class="child-head"><div><p class="eyebrow">Project content</p><h3>${esc(group.def.label)}</h3></div><div class="child-actions">${['lx_design_fixtures','lx_design_materials'].includes(group.def.table)?`<button class="seed" data-checklist-seed="${index}">Complete checklist</button>`:''}${group.def.table==='lx_project_specifications'? `<button type="button" data-catalog-bulk="${index}">+ Select saved products</button>`:''}<button data-child-new="${index}">+ Add row</button></div></div>${group.error?`<p>${esc(group.error.message)}</p>`:(group.items.length?group.items.map(item=>`<article data-child-group="${index}" data-child-id="${item.id}"><span>${esc(group.def.table==='lx_design_drawings'?choiceLabel(item[group.def.titleKey]):item[group.def.titleKey]||'Row')}</span><button>Edit</button></article>`).join(''):'<p class="empty">No rows yet.</p>')}</section>`).join('');
    holder.querySelectorAll('[data-child-new]').forEach(button=>button.onclick=()=>childEditor(groups[Number(button.dataset.childNew)],null,parent));
    holder.querySelectorAll('[data-catalog-bulk]').forEach(button=>button.onclick=()=>bulkAddFixtureLibrary(parent,groups[Number(button.dataset.catalogBulk)]));
    holder.querySelectorAll('[data-checklist-seed]').forEach(button=>button.onclick=()=>seedDesignChecklist(parent,groups[Number(button.dataset.checklistSeed)]));
    holder.querySelectorAll('[data-child-id]').forEach(el=>{const group=groups[Number(el.dataset.childGroup)];el.onclick=()=>childEditor(group,group.items.find(item=>String(item.id)===el.dataset.childId),parent)});
  }
  async function bulkAddFixtureLibrary(parent,group){
    const {data,error}=await sb.from('lx_fixture_library')
      .select('id,section,category,item_name,brand,model_code,specification,image_url')
      .eq('active',true).order('category').order('item_name');
    if(error)return toast(error.message);
    const existing=new Set(group.items.map(item=>item.catalog_item_id).filter(Boolean));
    const available=(data||[]).filter(item=>!existing.has(item.id));
    if(!available.length)return toast('Every available saved product has been added to this project.');
    modal.innerHTML=`<div class="modal-backdrop"><form id="catalog-bulk" class="modal-card">
      <div class="formhead"><h2>Choose saved fixtures & materials</h2><button type="button" id="bulk-close">Close</button></div>
      <p>Select several saved items. Their image and specification will be reused automatically. You can change details afterwards for this bathroom.</p>
      <label class="bulk-search">Filter products<input type="search" id="bulk-filter" placeholder="Search brand, WC, basin, tile…" /></label>
      <div class="bulk-items">${available.map(item=>`<label class="bulk-item" data-filter="${esc([item.category,item.brand,item.item_name,item.model_code].filter(Boolean).join(' ').toLowerCase())}">
        <input type="checkbox" value="${esc(item.id)}" />
        ${item.image_url?`<img src="${esc(item.image_url)}" alt="" loading="lazy">`:'<span class="bulk-empty-photo">No image</span>'}
        <span><strong>${esc(item.item_name)}</strong><small>${esc([item.brand,item.model_code,item.category].filter(Boolean).join(' · '))}</small></span>
      </label>`).join('')}</div>
      <div class="actions"><button type="submit" class="save">Add selected to project</button></div>
    </form></div>`;
    document.getElementById('bulk-close').onclick=()=>modal.innerHTML='';
    document.getElementById('bulk-filter').oninput=e=>{
      const term=e.target.value.toLowerCase().trim();
      modal.querySelectorAll('.bulk-item').forEach(el=>el.hidden=!el.dataset.filter.includes(term));
    };
    document.getElementById('catalog-bulk').onsubmit=async e=>{
      e.preventDefault();
      const chosen=[...modal.querySelectorAll('.bulk-item input:checked')].map(el=>el.value);
      if(!chosen.length)return toast('Choose at least one fixture or material.');
      const selected=available.filter(item=>chosen.includes(item.id));
      const start=Math.max(-1,...group.items.map(item=>item.sort_order||0))+1;
      const records=selected.map((item,i)=>({
        project_id:parent.id,catalog_item_id:item.id,section:item.section,
        category:item.category,item_name:item.item_name,brand:item.brand,
        model_code:item.model_code,specification:item.specification,image_url:item.image_url,
        sort_order:start+i,
      }));
      const button=modal.querySelector('button[type="submit"]');
      button.disabled=true;
      const {error:saveError}=await sb.from('lx_project_specifications').insert(records);
      if(saveError){button.disabled=false;return toast(saveError.message)}
      modal.innerHTML='';
      toast(`${records.length} saved items added to this bathroom`);
      renderChildren(parent);
    };
  }

  async function seedDesignChecklist(parent,group){
    const space=lookups.spaces.find(s=>s.id===parent.space_id);
    if(!space)return toast('Select a design space first');
    const isFixtures=group.def.table==='lx_design_fixtures';
    const categories=(isFixtures?FIXTURE_CATEGORIES:MATERIAL_CATEGORIES)[space.slug]||[];
    const existing=new Set(group.items.map(item=>String(item.category||'').trim().toLowerCase()));
    const missing=categories
      .map((category,index)=>({category,index}))
      .filter(({category})=>category!=='Other'&&!existing.has(category.toLowerCase()));
    if(!missing.length)return toast('Checklist is already complete');
    const label=isFixtures?'fixtures and fittings':'materials and finishes';
    if(!confirm(`Add ${missing.length} missing ${label} checklist rows for this ${space.name} design?`))return;
    const rows=missing.map(({category,index})=>isFixtures
      ? {design_id:parent.id,category,name:category,quantity:1,included:true,sort_order:index}
      : {design_id:parent.id,category,brand:'',item:null,sort_order:index});
    const {error}=await sb.from(group.def.table).insert(rows);
    if(error)return toast(error.message);
    toast(`${isFixtures?'Fixtures & fittings':'Materials & finishes'} checklist completed`);
    renderChildren(parent);
  }
  /* Photos come straight off a phone camera roll — often 4000px HEIC or JPEG.
     Convert to WebP and cap the long edge before upload so pages stay fast
     and every browser can display the result (Chrome cannot render HEIC). */
  const MAX_EDGE=2200,WEBP_QUALITY=0.86;
  async function toWebp(file){
    if(file.type==='image/webp')return file;
    let bitmap;
    try{bitmap=await createImageBitmap(file)}
    catch{
      // Safari occasionally refuses createImageBitmap on HEIC; retry via <img>.
      bitmap=await new Promise((resolve,reject)=>{
        const img=new Image(),src=URL.createObjectURL(file);
        img.onload=()=>{URL.revokeObjectURL(src);resolve(img)};
        img.onerror=()=>{URL.revokeObjectURL(src);reject(new Error('decode failed'))};
        img.src=src;
      });
    }
    const w0=bitmap.naturalWidth||bitmap.width,h0=bitmap.naturalHeight||bitmap.height;
    if(!w0||!h0)throw new Error('Could not read that image — try a JPEG or PNG');
    const scale=Math.min(1,MAX_EDGE/Math.max(w0,h0));
    const w=Math.max(1,Math.round(w0*scale)),h=Math.max(1,Math.round(h0*scale));
    const canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;
    const ctx=canvas.getContext('2d');ctx.imageSmoothingQuality='high';ctx.drawImage(bitmap,0,0,w,h);
    bitmap.close?.();
    const blob=await new Promise(res=>canvas.toBlob(res,'image/webp',WEBP_QUALITY));
    if(!blob)throw new Error('WebP conversion is not supported by this browser');
    const base=(file.name.replace(/\.[^.]+$/,'')||'image').replace(/[^a-z0-9-]+/gi,'-').toLowerCase();
    return new File([blob],`${base}.webp`,{type:'image/webp'});
  }
  const prettyKB=n=>n>=1048576?`${(n/1048576).toFixed(1)} MB`:`${Math.round(n/1024)} KB`;
  /** Converts, uploads and returns the public URL. */
  async function uploadImage(file,folder='uploads'){
    if(file.size>26214400)throw new Error('Please choose an image under 25 MB');
    const webp=await toWebp(file);
    const path=`${folder}/${Date.now()}-${crypto.randomUUID()}.webp`;
    const {error}=await sb.storage.from('luxehome-media').upload(path,webp,{cacheControl:'31536000',contentType:'image/webp'});
    if(error)throw error;
    return {url:sb.storage.from('luxehome-media').getPublicUrl(path).data.publicUrl,size:webp.size,was:file.size};
  }
  function showPreview(form,key,url){
    const old=form.querySelector(`[data-image-preview="${key}"]`);
    if(!old)return;
    const img=document.createElement('img');img.dataset.imagePreview=key;img.src=url;img.alt='Preview';
    old.replaceWith(img);
  }
  function bindGalleryPreviews(form){
    form.querySelectorAll('[data-photo-thumbnails]').forEach(preview=>{
      const name=preview.dataset.photoThumbnails;
      const textarea=form.elements[name];
      if(!textarea)return;
      function update(){
        const urls=textarea.value.split('\n').map(x=>x.trim()).filter(Boolean);
        preview.innerHTML=urls.map((url,i)=>`<div class="cms-photo-thumb">
          <img src="${esc(url)}" alt="Progress photo ${i+1}" loading="lazy">
          <button type="button" data-remove-stage-photo="${i}" aria-label="Remove progress photo ${i+1}">×</button>
        </div>`).join('');
        const count=form.querySelector(`[data-images-count="${name}"]`);
        if(count)count.textContent=`${urls.length} image(s)`;
      }
      textarea.addEventListener('input',update);
      preview.addEventListener('click',e=>{
        const button=e.target.closest('[data-remove-stage-photo]');
        if(!button)return;
        const urls=textarea.value.split('\n').map(x=>x.trim()).filter(Boolean);
        urls.splice(Number(button.dataset.removeStagePhoto),1);
        textarea.value=urls.join('\n');update();
      });
      update();
    });
  }
  function bindImageUploads(form,folder='uploads'){
    form.querySelectorAll('[data-image-upload]').forEach(input=>input.addEventListener('change',async e=>{
      const file=e.target.files?.[0];if(!file)return;
      const key=e.target.dataset.imageUpload,target=form.elements[key];
      e.target.disabled=true;toast('Converting to WebP…');
      try{
        const {url,size,was}=await uploadImage(file,folder);
        target.value=url;showPreview(form,key,url);
        toast(`Uploaded · ${prettyKB(was)} → ${prettyKB(size)} WebP`);
      }catch(err){toast(err.message||'Upload failed')}
      finally{e.target.disabled=false;e.target.value=''}
    }));
    bindGalleryPreviews(form);
    // Multi-image fields (galleries, diary photos) append one URL per line.
    form.querySelectorAll('[data-images-upload]').forEach(input=>input.addEventListener('change',async e=>{
      const files=[...(e.target.files||[])];if(!files.length)return;
      const target=form.elements[e.target.dataset.imagesUpload];
      e.target.disabled=true;
      const urls=[];
      for(let i=0;i<files.length;i++){
        toast(`Uploading ${i+1} of ${files.length}…`);
        try{const {url}=await uploadImage(files[i],folder);urls.push(url)}
        catch(err){toast(err.message||`Image ${i+1} failed`)}
      }
      if(urls.length){
        const existing=target.value.split('\n').map(s=>s.trim()).filter(Boolean);
        target.value=[...existing,...urls].join('\n');
        target.dispatchEvent(new Event('input',{bubbles:true}));
        const count=form.querySelector(`[data-images-count="${e.target.dataset.imagesUpload}"]`);
        if(count)count.textContent=`${existing.length+urls.length} image(s)`;
        toast(`Added ${urls.length} image(s)`);
      }
      e.target.disabled=false;e.target.value='';
    }));
  }
  async function childEditor(group,source,parent){
    const fresh=!source,def=group.def,row=source||{};
    if(def.table==='lx_project_specifications'){
      const {data,error}=await sb.from('lx_fixture_library').select('id,section,category,item_name,brand,model_code,specification,image_url').eq('active',true).order('category').order('item_name');
      if(error)return toast(error.message);
      lookups.fixtures=data||[];
    }
    if(fresh&&def.fields.some(field=>field.key==='sort_order'))row.sort_order=group.items.length;
    if(fresh&&def.table==='lx_design_fixtures'){row.quantity=1;row.included=true}
    const fields=def.table==='lx_design_fixtures'?def.fields.map(f=>f.key==='category'?{...f,options:FIXTURE_CATEGORIES[(lookups.spaces.find(s=>s.id===parent.space_id)||{}).slug]||[]}:f):def.fields;
    const libraryEditor=def.table==='lx_project_specifications';
    modal.innerHTML=`<div class="modal-backdrop"><form id="child-editor" class="modal-card"><div class="formhead"><h2>${fresh?'Add':'Edit'} ${esc(def.label)}</h2><button type="button" id="child-close">Close</button></div><div class="fields one">${fields.map(f=>field(f,row[f.key],'child_')).join('')}</div>${libraryEditor?'<p class="catalogue-help">Select a saved product to fill the fields, then adjust only what was actually installed in this project. <a href="/admin/cms/fixture-library" target="_blank" rel="noopener">Manage fixture library</a></p>':''}<div class="actions"><button class="save">Save row</button>${fresh?'':`<button type="button" id="child-delete" class="delete">Delete</button>`}</div></form></div>`;
    const form=document.getElementById('child-editor');document.getElementById('child-close').onclick=()=>modal.innerHTML='';
    if(libraryEditor){
      const selector=form.elements.child_catalog_item_id;
      const applyCatalogue=()=>{
        const item=lookups.catalogue.find(i=>i.id===selector.value);
        if(!item)return;
        for(const key of ['section','category','item_name','brand','model_code','specification','image_url']){
          const input=form.elements['child_'+key];
          if(input)input.value=item[key]??'';
        }
        showPreview(form,'child_image_url',item.image_url||'');
      };
      selector?.addEventListener('change',applyCatalogue);
    }
    bindImageUploads(form,cfg.slug);
    if(def.table==='lx_project_specifications'){
      const catalogPicker=form.querySelector('[data-catalog-picker]');
      catalogPicker?.addEventListener('change',()=>{
        const selected=lookups.fixtures.find(item=>item.id===catalogPicker.value);
        if(!selected)return;
        for(const key of ['section','category','item_name','brand','model_code','specification','image_url']){
          const control=form.elements['child_'+key];
          if(!control)continue;
          control.value=selected[key]??'';
        }
        const image=form.querySelector('[data-image-preview="child_image_url"]');
        if(image&&selected.image_url)showPreview(form,'child_image_url',selected.image_url);
        toast('Saved fixture copied. Review and save this project item.');
      });
    }
    form.onsubmit=async e=>{e.preventDefault();const payload={...values(form,fields,'child_'),[def.foreignKey]:parent.id};const query=fresh?sb.from(def.table).insert(payload):sb.from(def.table).update(payload).eq('id',row.id);const {error}=await query;if(error)return toast(error.message);modal.innerHTML='';toast('Row saved');renderChildren(parent)};
    document.getElementById('child-delete')?.addEventListener('click',async()=>{if(!confirm('Delete this row?'))return;const {error}=await sb.from(def.table).delete().eq('id',row.id);if(error)return toast(error.message);modal.innerHTML='';renderChildren(parent)});
  }
  load();
</script>
