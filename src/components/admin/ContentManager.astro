---
import type { CmsModule } from '../../lib/admin-cms';
const { module }=Astro.props as {module:CmsModule};
---
<div id="manager" data-module={JSON.stringify(module)}><div class="loading">Loading…</div></div>
<div id="cms-modal"></div><div id="toast"></div>
<script>
  import {createClient} from '@supabase/supabase-js';
  import {LUXE_SUPABASE_KEY as key,LUXE_SUPABASE_URL as url} from '../../lib/luxe-supabase';
  const root=document.getElementById('manager'),modal=document.getElementById('cms-modal'),cfg=JSON.parse(root.dataset.module);
  let sb,rows=[],lookups={spaces:[],designs:[]};
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const toast=m=>{const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400)};
  const slugify=s=>String(s).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
  async function auth(){if(!url||!key){root.innerHTML='<p>Supabase is not configured.</p>';return false}sb||=createClient(url,key);const {data:{session}}=await sb.auth.getSession();if(session)return true;location.assign('/admin');return false}
  async function load(){
    if(!(await auth()))return;
    const relationNames=[...new Set(cfg.fields.filter(f=>f.type==='relation').map(f=>f.relation))];
    await Promise.all(relationNames.map(async name=>{const table=name==='spaces'?'lx_spaces':'lx_designs',label=name==='spaces'?'name':'name';const {data}=await sb.from(table).select('id,'+label).order(label);lookups[name]=data||[]}));
    const {data,error}=await sb.from(cfg.table).select('*').order(cfg.titleKey);
    if(error)return root.innerHTML=`<div class="panel"><h2>Module unavailable</h2><p>${esc(error.message)}</p></div>`;
    rows=data||[];
    if(new URLSearchParams(location.search).get('new')==='1'){history.replaceState(null,'',location.pathname);edit(null)}else list();
  }
  function cards(items){return items.length?items.map(r=>{const status=cfg.statusKey?r[cfg.statusKey]:null;const label=typeof status==='boolean'?(status?'Published':'Draft'):status;return `<article class="item" data-id="${esc(r.id)}"><div><strong>${esc(r[cfg.titleKey]||'Untitled')}</strong>${label!==null&&label!==undefined&&label!==''?`<small class="status-pill ${status===true||status==='published'?'live':''}">${esc(label)}</small>`:''}</div><button type="button">Edit</button></article>`}).join(''):'<div class="panel empty">No records yet.</div>'}
  function list(){root.innerHTML=`<div class="toolbar"><input id="search" placeholder="Search ${esc(cfg.label.toLowerCase())}"><button id="new-record">+ New</button></div><div id="rows">${cards(rows)}</div>`;const search=document.getElementById('search');search.oninput=()=>document.getElementById('rows').innerHTML=cards(rows.filter(r=>String(r[cfg.titleKey]||'').toLowerCase().includes(search.value.toLowerCase())));document.getElementById('new-record').onclick=()=>edit(null);bindCards()}
  function bindCards(){root.querySelectorAll('.item').forEach(el=>el.onclick=()=>edit(rows.find(r=>String(r.id)===el.dataset.id)))}
  function field(f,v,prefix=''){
    const name=prefix+f.key;
    if(f.type==='checkbox')return `<label class="check"><input name="${name}" type="checkbox" ${v?'checked':''}> ${esc(f.label)}</label>`;
    if(f.type==='textarea')return `<label>${esc(f.label)}<textarea name="${name}" ${f.required?'required':''}>${esc(v)}</textarea></label>`;
    if(f.type==='lines')return `<label>${esc(f.label)}<textarea name="${name}" placeholder="One item per line">${esc(Array.isArray(v)?v.join('\n'):v)}</textarea></label>`;
    if(f.type==='select')return `<label>${esc(f.label)}<select name="${name}">${(f.options||[]).map(o=>`<option value="${esc(o)}" ${o===v?'selected':''}>${esc(o)}</option>`).join('')}</select></label>`;
    if(f.type==='relation'){const options=lookups[f.relation]||[];return `<label>${esc(f.label)}<select name="${name}" ${f.required?'required':''}><option value="">Not selected</option>${options.map(o=>`<option value="${o.id}" ${o.id===v?'selected':''}>${esc(o.name)}</option>`).join('')}</select></label>`}
    return `<label>${esc(f.label)}<input name="${name}" type="${f.type||'text'}" value="${esc(v)}" ${f.required?'required':''}></label>`;
  }
  function values(form,fields,prefix=''){const data={};fields.forEach(f=>{const el=form.elements[prefix+f.key];if(f.type==='checkbox')data[f.key]=el.checked;else if(f.type==='number')data[f.key]=el.value===''?null:Number(el.value);else if(f.type==='lines')data[f.key]=el.value.split('\n').map(x=>x.trim()).filter(Boolean);else data[f.key]=el.value||null});return data}
  async function edit(source){
    const fresh=!source,row=source||{};
    root.innerHTML=`<form id="editor" class="panel"><div class="formhead"><div><p class="eyebrow">${fresh?'Create':'Edit'} record</p><h2>${fresh?'New '+esc(cfg.label):esc(row[cfg.titleKey])}</h2></div><button type="button" id="back">Back to list</button></div>${cfg.slug==='media'?'<label class="media-upload">Upload image<input id="media-file" type="file" accept="image/jpeg,image/png,image/webp,image/avif"></label>':''}<div class="fields">${cfg.fields.map(f=>field(f,row[f.key])).join('')}</div><div class="actions"><button class="save">Save</button>${fresh?'':`<button type="button" class="delete" id="delete">Delete</button>`}</div></form><div id="children"></div>`;
    const editor=document.getElementById('editor');document.getElementById('back').onclick=list;
    const nameInput=editor.elements.name,titleInput=editor.elements.title,slugInput=editor.elements.slug;
    (nameInput||titleInput)?.addEventListener('blur',()=>{if(slugInput&&!slugInput.value)slugInput.value=slugify((nameInput||titleInput).value)});
    document.getElementById('media-file')?.addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;if(file.size>10485760)return toast('Image must be 10 MB or smaller');const ext=(file.name.split('.').pop()||'jpg').replace(/[^a-z0-9]/gi,'');const path=`media/${Date.now()}-${crypto.randomUUID()}.${ext}`;const {error}=await sb.storage.from('luxehome-media').upload(path,file,{cacheControl:'31536000'});if(error)return toast(error.message);editor.elements.storage_path.value=path;editor.elements.public_url.value=sb.storage.from('luxehome-media').getPublicUrl(path).data.publicUrl;if(!editor.elements.name.value)editor.elements.name.value=file.name;toast('Image uploaded')});
    editor.onsubmit=async e=>{e.preventDefault();const payload=values(editor,cfg.fields);let query=fresh?sb.from(cfg.table).insert(payload).select().single():sb.from(cfg.table).update(payload).eq('id',row.id).select().single();const {data,error}=await query;if(error)return toast(error.message);toast('Saved');await load();const saved=rows.find(item=>String(item.id)===String(data.id));if(saved)edit(saved)};
    document.getElementById('delete')?.addEventListener('click',async()=>{if(!confirm('Delete this record?'))return;const {error}=await sb.from(cfg.table).delete().eq('id',row.id);if(error)return toast(error.message);toast('Deleted');load()});
    if(!fresh&&cfg.children?.length)await renderChildren(row);
  }
  async function renderChildren(parent){
    const holder=document.getElementById('children');
    const groups=await Promise.all(cfg.children.map(async def=>{const {data,error}=await sb.from(def.table).select('*').eq(def.foreignKey,parent.id).order('sort_order',{ascending:true});return {def,items:data||[],error}}));
    holder.innerHTML=groups.map((group,index)=>`<section class="child panel"><div class="child-head"><div><p class="eyebrow">Design file section</p><h3>${esc(group.def.label)}</h3></div><button data-child-new="${index}">+ Add row</button></div>${group.error?`<p>${esc(group.error.message)}</p>`:(group.items.length?group.items.map(item=>`<article data-child-group="${index}" data-child-id="${item.id}"><span>${esc(item[group.def.titleKey]||'Row')}</span><button>Edit</button></article>`).join(''):'<p class="empty">No rows yet.</p>')}</section>`).join('');
    holder.querySelectorAll('[data-child-new]').forEach(button=>button.onclick=()=>childEditor(groups[Number(button.dataset.childNew)],null,parent));
    holder.querySelectorAll('[data-child-id]').forEach(el=>{const group=groups[Number(el.dataset.childGroup)];el.onclick=()=>childEditor(group,group.items.find(item=>String(item.id)===el.dataset.childId),parent)});
  }
  function childEditor(group,source,parent){
    const fresh=!source,row=source||{},def=group.def;
    modal.innerHTML=`<div class="modal-backdrop"><form id="child-editor" class="modal-card"><div class="formhead"><h2>${fresh?'Add':'Edit'} ${esc(def.label)}</h2><button type="button" id="child-close">Close</button></div><div class="fields one">${def.fields.map(f=>field(f,row[f.key],'child_')).join('')}</div><div class="actions"><button class="save">Save row</button>${fresh?'':`<button type="button" id="child-delete" class="delete">Delete</button>`}</div></form></div>`;
    const form=document.getElementById('child-editor');document.getElementById('child-close').onclick=()=>modal.innerHTML='';
    form.onsubmit=async e=>{e.preventDefault();const payload={...values(form,def.fields,'child_'),[def.foreignKey]:parent.id};const query=fresh?sb.from(def.table).insert(payload):sb.from(def.table).update(payload).eq('id',row.id);const {error}=await query;if(error)return toast(error.message);modal.innerHTML='';toast('Row saved');renderChildren(parent)};
    document.getElementById('child-delete')?.addEventListener('click',async()=>{if(!confirm('Delete this row?'))return;const {error}=await sb.from(def.table).delete().eq('id',row.id);if(error)return toast(error.message);modal.innerHTML='';renderChildren(parent)});
  }
  load();
</script>
<style is:global>
  #manager{width:100%;max-width:1180px}
  #manager .toolbar{display:flex;gap:10px;margin-bottom:16px}
  #manager .toolbar input{flex:1;min-width:0}
  #manager .toolbar button,#manager .panel button,#manager .child button,#cms-modal button{min-height:42px;background:#5c6b56;color:#fff;border:0;border-radius:7px;padding:10px 16px;font:600 13px/1 Jost,system-ui,sans-serif;cursor:pointer}
  #manager .toolbar input,#manager .panel input,#manager .panel textarea,#manager .panel select,#cms-modal input,#cms-modal textarea,#cms-modal select{min-width:0;border:1px solid #2b322a25;background:#fff;border-radius:7px;padding:11px 12px;color:#2b322a;font:400 15px/1.4 Jost,system-ui,sans-serif}
  #manager .item,#manager .panel{background:#fff;border:1px solid #2b322a16;border-radius:10px;padding:16px;margin-bottom:12px;box-shadow:0 4px 18px #2b322a08}
  #manager .item{display:flex;align-items:center;justify-content:space-between;gap:16px;cursor:pointer}
  #manager .item>div{min-width:0;display:flex;align-items:center;gap:9px;flex-wrap:wrap}
  #manager .item strong{display:block;overflow-wrap:anywhere;font-size:16px}
  #manager .status-pill{display:inline-flex;width:max-content;border-radius:999px;background:#efe8db;color:#667064;padding:3px 8px;font-size:10px;text-transform:uppercase;letter-spacing:.06em}
  #manager .status-pill.live{background:#dfe5db;color:#43513f}
  #manager .item button{flex:0 0 auto;background:#efe8db;color:#2b322a}
  #manager .formhead,#manager .actions,#manager .child-head,#cms-modal .formhead,#cms-modal .actions{display:flex;justify-content:space-between;gap:12px;align-items:center}
  #manager .formhead h2,#manager .child h3,#cms-modal .formhead h2{font:500 clamp(27px,4vw,34px)/1.1 'Cormorant Garamond',serif;margin:3px 0 0;overflow-wrap:anywhere}
  #manager .formhead>button,#cms-modal .formhead>button{background:#efe8db;color:#2b322a}
  #manager .eyebrow,#cms-modal .eyebrow{text-transform:uppercase;letter-spacing:.14em;color:#5c6b56;font-size:10px;margin:0}
  #manager .fields,#cms-modal .fields{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:15px;margin:22px 0}
  #manager .fields.one,#cms-modal .fields.one{grid-template-columns:minmax(0,1fr)}
  #manager .fields label,#cms-modal .fields label{display:block;min-width:0;color:#43513f;font-size:12px;font-weight:500}
  #manager .fields input,#manager .fields textarea,#manager .fields select,#cms-modal .fields input,#cms-modal .fields textarea,#cms-modal .fields select{display:block;width:100%;margin-top:6px}
  #manager .fields textarea,#cms-modal .fields textarea{min-height:120px;resize:vertical}
  #manager .fields .check,#cms-modal .fields .check{display:flex;align-items:center;gap:9px;min-height:44px}
  #manager .fields .check input,#cms-modal .fields .check input{width:20px;height:20px;margin:0;flex:0 0 auto}
  #manager .actions,#cms-modal .actions{justify-content:flex-start;flex-wrap:wrap}
  #manager .actions .save,#cms-modal .actions .save{min-width:160px}
  #manager .actions .delete,#cms-modal .actions .delete{background:#9b3e35}
  #manager .child{margin-top:16px}
  #manager .child article{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:11px 0;border-top:1px solid #2b322a12;cursor:pointer}
  #manager .child article span{min-width:0;overflow-wrap:anywhere}
  #manager .child article button{flex:0 0 auto;min-height:36px;background:#efe8db;color:#2b322a;padding:7px 11px}
  #manager .empty{color:#667064;text-align:center;padding:30px 18px}
  #manager .media-upload{display:inline-flex;background:#dfe5db;padding:11px 14px;border-radius:7px;margin-top:15px;cursor:pointer}
  #manager .media-upload input{display:none}
  #cms-modal .modal-backdrop{position:fixed;inset:0;z-index:999;background:#2b322ab3;display:grid;place-items:center;padding:16px}
  #cms-modal .modal-card{width:min(620px,100%);max-height:calc(100dvh - 32px);overflow:auto;background:#f7f3eb;border-radius:13px;padding:22px;box-shadow:0 24px 80px #0005}
  #toast{position:fixed;z-index:1200;bottom:max(25px,env(safe-area-inset-bottom));left:50%;width:max-content;max-width:calc(100vw - 32px);transform:translate(-50%,100px);background:#2b322a;color:#fff;padding:11px 18px;border-radius:8px;transition:.2s;text-align:center}
  #toast.show{transform:translate(-50%,0)}
  @media(max-width:650px){
    #manager .toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}
    #manager .toolbar input{width:100%;font-size:16px}
    #manager .item,#manager .panel{padding:14px}
    #manager .item{min-height:64px}
    #manager .item>div{display:grid;gap:5px}
    #manager .fields,#cms-modal .fields{grid-template-columns:minmax(0,1fr);gap:13px;margin:18px 0}
    #manager .fields input,#manager .fields textarea,#manager .fields select,#cms-modal .fields input,#cms-modal .fields textarea,#cms-modal .fields select{font-size:16px}
    #manager .formhead,#manager .child-head,#cms-modal .formhead{align-items:flex-start}
    #manager .child-head{flex-wrap:wrap}
    #manager .actions,#cms-modal .actions{display:grid;grid-template-columns:1fr}
    #manager .actions button,#cms-modal .actions button{width:100%;min-width:0}
    #cms-modal .modal-backdrop{align-items:end;padding:0}
    #cms-modal .modal-card{width:100%;max-height:92dvh;border-radius:16px 16px 0 0;padding:20px 16px calc(20px + env(safe-area-inset-bottom))}
  }
  @media(max-width:390px){
    #manager .toolbar{grid-template-columns:1fr}
    #manager .toolbar button{width:100%}
    #manager .formhead,#cms-modal .formhead{display:grid;grid-template-columns:1fr}
    #manager .formhead>button,#cms-modal .formhead>button{width:100%}
  }
</style>
