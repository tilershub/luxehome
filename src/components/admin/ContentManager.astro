---
import type { CmsModule } from '../../lib/admin-cms';
const { module }=Astro.props as {module:CmsModule};
---
<div id="manager" data-module={JSON.stringify(module)}><div class="loading">Loading…</div></div><div id="toast"></div>
<script>
  import {createClient} from '@supabase/supabase-js';
  const root=document.getElementById('manager'); const cfg=JSON.parse(root.dataset.module); const url=import.meta.env.PUBLIC_SUPABASE_URL,key=import.meta.env.PUBLIC_SUPABASE_ANON_KEY; let sb,rows=[];
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const toast=m=>{const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200)};
  async function auth(){if(!url||!key){root.innerHTML='<p>Supabase is not configured.</p>';return false}sb||=createClient(url,key);const {data:{session}}=await sb.auth.getSession();if(session)return true;root.innerHTML='<form id="login" class="panel login"><h2>Sign in</h2><label>Email<input id="email" type="email"></label><label>Password<input id="password" type="password"></label><button>Sign in</button></form>';document.getElementById('login').onsubmit=async e=>{e.preventDefault();const {error}=await sb.auth.signInWithPassword({email:document.getElementById('email').value,password:document.getElementById('password').value});if(error)return toast(error.message);load()};return false}
  async function load(){if(!(await auth()))return;const {data,error}=await sb.from(cfg.table).select('*').order(cfg.titleKey);if(error)return root.innerHTML=`<div class="panel"><h2>Module unavailable</h2><p>${esc(error.message)}</p></div>`;rows=data||[];list()}
  function list(){root.innerHTML=`<div class="toolbar"><input id="search" placeholder="Search ${esc(cfg.label.toLowerCase())}"><button id="new-record">+ New</button></div><div id="rows">${cards(rows)}</div>`;const search=document.getElementById('search');search.oninput=()=>document.getElementById('rows').innerHTML=cards(rows.filter(r=>String(r[cfg.titleKey]||'').toLowerCase().includes(search.value.toLowerCase())));document.getElementById('new-record').onclick=()=>edit(null);bind()}
  function cards(items){return items.length?items.map(r=>`<article class="item" data-id="${r.id}"><div><strong>${esc(r[cfg.titleKey]||'Untitled')}</strong><small>${cfg.statusKey?esc(r[cfg.statusKey]??''):''}</small></div><button>Edit</button></article>`).join(''):'<div class="panel empty">No records yet.</div>'}
  function bind(){root.querySelectorAll('.item').forEach(el=>el.onclick=()=>edit(rows.find(r=>String(r.id)===el.dataset.id)))}
  function edit(row){const fresh=!row;row=row||{};root.innerHTML=`<form id="editor" class="panel"><div class="formhead"><h2>${fresh?'New':`Edit ${esc(cfg.label)}`}</h2><button type="button" id="back">Close</button></div>${cfg.slug==='media'?'<label class="media-upload">Upload image<input id="media-file" type="file" accept="image/jpeg,image/png,image/webp,image/avif"></label>':''}<div class="fields">${cfg.fields.map(f=>field(f,row[f.key])).join('')}</div><div class="actions"><button class="save">Save</button>${fresh?'':`<button type="button" class="delete" id="delete">Delete</button>`}</div></form>`;const editor=document.getElementById('editor');document.getElementById('back').onclick=list;document.getElementById('media-file')?.addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;if(file.size>10485760)return toast('Image must be 10 MB or smaller');const ext=(file.name.split('.').pop()||'jpg').replace(/[^a-z0-9]/gi,'');const path=`media/${Date.now()}-${crypto.randomUUID()}.${ext}`;const {error}=await sb.storage.from('luxehome-media').upload(path,file,{cacheControl:'31536000'});if(error)return toast(error.message);editor.elements.storage_path.value=path;editor.elements.public_url.value=sb.storage.from('luxehome-media').getPublicUrl(path).data.publicUrl;if(!editor.elements.name.value)editor.elements.name.value=file.name;toast('Image uploaded')});editor.onsubmit=async e=>{e.preventDefault();const data={};cfg.fields.forEach(f=>{const el=editor.elements[f.key];data[f.key]=f.type==='checkbox'?el.checked:f.type==='number'?(el.value?Number(el.value):null):(el.value||null)});const q=fresh?sb.from(cfg.table).insert(data):sb.from(cfg.table).update(data).eq('id',row.id);const {error}=await q;if(error)return toast(error.message);toast('Saved');load()};document.getElementById('delete')?.addEventListener('click',async()=>{if(!confirm('Delete this record?'))return;const {error}=await sb.from(cfg.table).delete().eq('id',row.id);if(error)return toast(error.message);toast('Deleted');load()})}
  function field(f,v){if(f.type==='checkbox')return `<label class="check"><input name="${f.key}" type="checkbox" ${v?'checked':''}> ${esc(f.label)}</label>`;if(f.type==='textarea')return `<label>${esc(f.label)}<textarea name="${f.key}">${esc(v)}</textarea></label>`;if(f.type==='select')return `<label>${esc(f.label)}<select name="${f.key}">${(f.options||[]).map(o=>`<option ${o===v?'selected':''}>${esc(o)}</option>`)}</select></label>`;return `<label>${esc(f.label)}<input name="${f.key}" type="${f.type||'text'}" value="${esc(v)}" ${f.required?'required':''}></label>`}
  load();
</script>
<style>
  .toolbar{display:flex;gap:10px;margin-bottom:16px}.toolbar input{flex:1}.toolbar button,.panel button{background:#5c6b56;color:#fff;border:0;border-radius:6px;padding:10px 15px;font:inherit}.toolbar input,.panel input,.panel textarea,.panel select{border:1px solid #2b322a25;background:#fff;border-radius:6px;padding:11px;font:inherit}.item,.panel{background:#fff;border:1px solid #2b322a16;border-radius:9px;padding:15px;margin-bottom:9px}.item{display:flex;align-items:center;justify-content:space-between;cursor:pointer}.item strong,.item small{display:block}.item small{color:#667064;margin-top:3px}.item button{background:#efe8db;border:0;padding:7px 12px;border-radius:6px}.formhead,.actions{display:flex;justify-content:space-between;gap:10px;align-items:center}.formhead h2{font:500 30px 'Cormorant Garamond';margin:0}.formhead button{background:#efe8db;color:#2b322a}.fields{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:22px 0}.fields label{font-size:12px}.fields input,.fields textarea,.fields select{display:block;width:100%;margin-top:5px}.fields textarea{min-height:110px}.fields .check{display:flex;gap:8px;align-items:center}.fields .check input{width:auto;margin:0}.actions{justify-content:flex-start}.actions .save{min-width:160px;background:#5c6b56}.actions .delete{background:#a33}.login{max-width:400px;margin:60px auto}.login label{display:block;margin:12px 0}.login input{width:100%;display:block;margin-top:5px}#toast{position:fixed;bottom:25px;left:50%;transform:translate(-50%,80px);background:#2b322a;color:#fff;padding:10px 18px;border-radius:8px;transition:.2s}#toast.show{transform:translate(-50%,0)}@media(max-width:650px){.fields{grid-template-columns:1fr}}
  .media-upload{display:inline-flex;background:#dfe5db;color:#5c6b56;padding:10px 14px;border-radius:6px;margin-top:15px;cursor:pointer}.media-upload input{display:none}
</style>
