---
---

<!-- Hidden by default; JS reveals it when real bathroom project photos are found in Supabase -->
<section id="bathroom-walkthrough" class="bwt-section" style="display:none">
  <div class="bwt-scroll" id="bwt-scroll">
    <div class="bwt-stage">
      <div class="bwt-frames" id="bwt-frames"></div>
      <div class="bwt-scrim" aria-hidden="true"></div>

      <div class="bwt-eyebrow">Walk Through a Real Project</div>

      <div class="bwt-caption">
        <div class="bwt-step-title" id="bwt-title"></div>
        <p class="bwt-step-desc" id="bwt-desc"></p>
        <div class="bwt-credit" id="bwt-credit"></div>
        <div class="bwt-video-cta" id="bwt-video-cta" hidden>
          <button class="bwt-play-btn" id="bwt-play-btn" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Watch the Full Walkthrough
          </button>
        </div>
      </div>

      <div class="bwt-rail" aria-hidden="true">
        <span class="bwt-counter" id="bwt-counter"></span>
        <div class="bwt-dots" id="bwt-dots"></div>
      </div>

      <div class="bwt-hint" aria-hidden="true">Keep scrolling</div>

      <div class="bwt-video-holder" id="bwt-video-holder" hidden>
        <button class="bwt-video-close" id="bwt-video-close" type="button" aria-label="Close video">✕</button>
      </div>
    </div>
  </div>

  <!-- Reduced-motion / no-sticky fallback rendered here instead -->
  <div class="bwt-static-list" id="bwt-static-list"></div>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';

  const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  const FB_WALKTHROUGH_URL = 'https://www.facebook.com/share/v/1HtWteECQw/';

  const STOPS = [
    { title: 'Step inside',            desc: 'Every walkthrough begins at the door — a complete renovation, designed and built by one team from demolition to handover.' },
    { title: 'The vanity',             desc: 'Bespoke vanities, mirrors and storage — fitted and finished to the millimetre.' },
    { title: 'The shower & wet zone',  desc: 'Tokyo Super 2K waterproofing beneath Rocell large-format tiles. Beautiful, and built to last.' },
    { title: 'The finishes',           desc: 'Concealed bathware, brassware and lighting — the details that make it feel like a boutique hotel.' },
  ];

  function esc(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c]);
  }

  function ytIdFromUrl(url) {
    if (!url) return null;
    const m = url.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([a-zA-Z0-9_-]{11})/);
    return m ? m[1] : null;
  }

  async function init() {
    if (!SB_URL || !SB_KEY) return;

    let data;
    try {
      const sb = createClient(SB_URL, SB_KEY);
      const res = await sb
        .from('projects')
        .select('slug,title,location,cover_image,after_images,youtube_short')
        .eq('category', 'bathroom')
        .in('status', ['published', 'featured'])
        .order('completion_year', { ascending: false })
        .limit(3);
      data = res.data;
    } catch {
      return;
    }
    if (!data || data.length === 0) return;

    // Collect real photos: cover first, then after_images, deduped
    const images = [];
    const seen = new Set();
    for (const p of data) {
      const candidates = [p.cover_image, ...(Array.isArray(p.after_images) ? p.after_images : [])];
      for (const url of candidates) {
        if (url && !seen.has(url)) {
          seen.add(url);
          images.push(url);
        }
        if (images.length >= STOPS.length) break;
      }
      if (images.length >= STOPS.length) break;
    }
    if (images.length < 3) return;

    const stops = STOPS.slice(0, images.length);
    const lead = data[0];
    const credit = [lead.title, lead.location].filter(Boolean).map(esc).join(' — ');
    const ytId = ytIdFromUrl(data.find((p) => p.youtube_short)?.youtube_short);

    const section = document.getElementById('bathroom-walkthrough');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced) {
      renderStatic(section, images, stops, credit);
    } else {
      renderScroll(section, images, stops, credit, ytId);
    }
    section.style.display = '';
  }

  /* ── Static fallback (reduced motion) ── */
  function renderStatic(section, images, stops, credit) {
    section.classList.add('bwt-is-static');
    const list = document.getElementById('bwt-static-list');
    list.innerHTML = images.map((url, i) => `
      <figure class="bwt-static-item">
        <img src="${esc(url)}" alt="${esc(stops[i].title)} — real LUXEHOME bathroom project" loading="${i === 0 ? 'eager' : 'lazy'}" />
        <figcaption>
          <div class="bwt-step-title">${esc(stops[i].title)}</div>
          <p class="bwt-step-desc">${esc(stops[i].desc)}</p>
          ${i === images.length - 1 && credit ? `<div class="bwt-credit">${credit}</div>` : ''}
        </figcaption>
      </figure>
    `).join('');
  }

  /* ── Scroll-driven walkthrough ── */
  function renderScroll(section, images, stops, credit, ytId) {
    const scrollEl  = document.getElementById('bwt-scroll');
    const framesEl  = document.getElementById('bwt-frames');
    const titleEl   = document.getElementById('bwt-title');
    const descEl    = document.getElementById('bwt-desc');
    const creditEl  = document.getElementById('bwt-credit');
    const counterEl = document.getElementById('bwt-counter');
    const dotsEl    = document.getElementById('bwt-dots');
    const videoCta  = document.getElementById('bwt-video-cta');
    const playBtn   = document.getElementById('bwt-play-btn');
    const holder    = document.getElementById('bwt-video-holder');
    const closeBtn  = document.getElementById('bwt-video-close');

    const n = images.length;
    scrollEl.style.height = (n + 1) * 100 + 'vh';

    framesEl.innerHTML = images.map((url, i) => `
      <img class="bwt-frame" src="${esc(url)}"
        alt="${esc(stops[i].title)} — real LUXEHOME bathroom project"
        loading="${i === 0 ? 'eager' : 'lazy'}" />
    `).join('');
    const frames = framesEl.querySelectorAll('.bwt-frame');

    dotsEl.innerHTML = images.map(() => '<span class="bwt-dot"></span>').join('');
    const dots = dotsEl.querySelectorAll('.bwt-dot');

    let active = -1;
    function setActive(i) {
      if (i === active) return;
      active = i;
      frames.forEach((f, k) => f.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => d.classList.toggle('is-active', k === i));
      counterEl.textContent = String(i + 1).padStart(2, '0') + ' / ' + String(n).padStart(2, '0');

      const caption = section.querySelector('.bwt-caption');
      caption.classList.remove('is-in');
      void caption.offsetWidth; /* restart transition */
      titleEl.textContent = stops[i].title;
      descEl.textContent  = stops[i].desc;
      const last = i === n - 1;
      creditEl.textContent = last && credit ? credit.replace(/&amp;/g, '&') : '';
      videoCta.hidden = !last;
      caption.classList.add('is-in');
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const rect = scrollEl.getBoundingClientRect();
        const scrollable = rect.height - window.innerHeight;
        if (scrollable <= 0) { setActive(0); return; }
        const progress = Math.min(1, Math.max(0, -rect.top / scrollable));
        setActive(Math.min(n - 1, Math.floor(progress * n)));
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    setActive(0);
    onScroll();

    /* Video CTA */
    playBtn.addEventListener('click', () => {
      if (ytId) {
        holder.insertAdjacentHTML('beforeend', `<iframe
          src="https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0"
          allow="autoplay; encrypted-media; fullscreen"
          allowfullscreen frameborder="0"
          title="LUXEHOME bathroom walkthrough video"
        ></iframe>`);
        holder.hidden = false;
      } else {
        window.open(FB_WALKTHROUGH_URL, '_blank', 'noopener');
      }
    });
    closeBtn.addEventListener('click', () => {
      holder.querySelector('iframe')?.remove();
      holder.hidden = true;
    });
  }

  init();
</script>

<style>
  .bwt-section {
    background: var(--charcoal, #111111);
  }

  .bwt-scroll {
    position: relative;
    /* height set by JS: (steps + 1) × 100vh */
  }

  .bwt-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  /* ── Frames ── */

  .bwt-frames,
  .bwt-frame {
    position: absolute;
    inset: 0;
  }

  .bwt-frame {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity .8s ease, transform 1.6s ease;
  }

  .bwt-frame.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .bwt-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,17,17,.55) 0%, rgba(17,17,17,.05) 35%, rgba(17,17,17,.78) 100%);
    pointer-events: none;
  }

  /* ── Eyebrow ── */

  .bwt-eyebrow {
    position: absolute;
    top: clamp(4.5rem, 9vh, 6.5rem);
    left: 50%;
    transform: translateX(-50%);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: rgba(240,236,224,.85);
    white-space: nowrap;
  }

  /* ── Caption ── */

  .bwt-caption {
    position: absolute;
    left: clamp(1.2rem, 6vw, 5rem);
    right: clamp(1.2rem, 6vw, 5rem);
    bottom: clamp(2.2rem, 8vh, 5rem);
    max-width: 640px;
    opacity: 0;
    transform: translateY(14px);
  }

  .bwt-caption.is-in {
    opacity: 1;
    transform: translateY(0);
    transition: opacity .55s ease .1s, transform .55s ease .1s;
  }

  .bwt-step-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.7rem, 4.5vw, 2.8rem);
    font-weight: 700;
    color: #f0ece0;
    line-height: 1.12;
    margin-bottom: .55rem;
  }

  .bwt-step-desc {
    font-size: .92rem;
    color: rgba(240,236,224,.88);
    line-height: 1.68;
    max-width: 52ch;
    margin: 0 0 .7rem;
  }

  .bwt-credit {
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #d4a96b;
  }

  /* ── Video CTA ── */

  .bwt-video-cta { margin-top: 1.1rem; }

  .bwt-play-btn {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    background: linear-gradient(90deg, #b8945a, #c9a25e);
    color: #1e1a17;
    border: none;
    border-radius: 2px;
    font-family: 'DM Sans', sans-serif;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .8rem 1.5rem;
    min-height: 46px;
    cursor: pointer;
    transition: opacity .2s;
  }
  .bwt-play-btn:hover { opacity: .88; }

  /* ── Progress rail ── */

  .bwt-rail {
    position: absolute;
    right: clamp(1.1rem, 4vw, 2.6rem);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .9rem;
  }

  .bwt-counter {
    font-size: .64rem;
    font-weight: 600;
    letter-spacing: .14em;
    color: rgba(240,236,224,.8);
    writing-mode: vertical-rl;
  }

  .bwt-dots {
    display: flex;
    flex-direction: column;
    gap: .55rem;
  }

  .bwt-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(240,236,224,.32);
    transition: background .3s, transform .3s;
  }

  .bwt-dot.is-active {
    background: #d4a96b;
    transform: scale(1.35);
  }

  /* ── Scroll hint ── */

  .bwt-hint {
    position: absolute;
    bottom: 1.1rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: .62rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(240,236,224,.55);
    animation: bwtPulse 2.4s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes bwtPulse {
    0%, 100% { opacity: .35; }
    50%      { opacity: .9; }
  }

  /* ── Video overlay ── */

  .bwt-video-holder {
    position: absolute;
    inset: 0;
    background: rgba(17,17,17,.96);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
  }

  .bwt-video-holder iframe {
    width: min(92vw, 1000px);
    aspect-ratio: 16 / 9;
    max-height: 82vh;
    border: none;
  }

  .bwt-video-close {
    position: absolute;
    top: 1.2rem;
    right: 1.4rem;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.25);
    border-radius: 50%;
    width: 42px;
    height: 42px;
    color: #f0ece0;
    font-size: 1rem;
    cursor: pointer;
    transition: background .2s;
    z-index: 6;
  }
  .bwt-video-close:hover { background: rgba(255,255,255,.18); }

  /* ── Static fallback (reduced motion) ── */

  .bwt-static-list { display: none; }

  .bwt-is-static .bwt-scroll { display: none; }

  .bwt-is-static .bwt-static-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding: 4rem clamp(1.2rem, 6vw, 5rem);
    max-width: 1000px;
    margin: 0 auto;
  }

  .bwt-static-item { margin: 0; }

  .bwt-static-item img {
    width: 100%;
    max-height: 70vh;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 1.1rem;
  }

  /* ── Responsive ── */

  @media (max-width: 768px) {
    .bwt-rail { right: .9rem; }
    .bwt-caption { max-width: none; right: 3rem; }
  }

  @media (max-width: 480px) {
    .bwt-eyebrow { font-size: .58rem; letter-spacing: .16em; }
    .bwt-step-desc { font-size: .84rem; }
    .bwt-caption { left: 1rem; right: 2.6rem; bottom: 2.6rem; }
    .bwt-play-btn { width: 100%; justify-content: center; }
  }
</style>
