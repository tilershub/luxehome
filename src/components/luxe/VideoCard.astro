---
interface Props {
  title: string;
  embedUrl: string;
  coverImage: string;
  eyebrow?: string;
  duration?: string;
  description?: string;
}

const {
  title,
  embedUrl,
  coverImage,
  eyebrow = '3D walkthrough',
  duration,
  description = 'Open the vertical walkthrough without leaving this design.',
} = Astro.props;

const dialogId = `video-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const separator = embedUrl.includes('?') ? '&' : '?';
const playerUrl = `${embedUrl}${separator}autoplay=1&playsinline=1`;
---

<article class="lv-card lxr" data-video-card>
  <button
    class="lv-cover"
    type="button"
    data-video-open
    data-video-src={playerUrl}
    aria-haspopup="dialog"
    aria-controls={dialogId}
    aria-expanded="false"
    aria-label={`Play ${title}`}
  >
    <img src={coverImage} alt="" loading="lazy" width="540" height="960" />
    <span class="lv-shade" aria-hidden="true"></span>
    <span class="lv-play" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10-6.5z"></path></svg>
    </span>
    <span class="lv-cover-copy">
      <small>{eyebrow}</small>
      <strong>{title}</strong>
      {duration && <em>{duration}</em>}
    </span>
  </button>
  <p>{description}</p>

  <div
    class="lv-modal"
    id={dialogId}
    data-video-modal
    role="dialog"
    aria-modal="true"
    aria-label={title}
    hidden
  >
    <div class="lv-player-shell">
      <button class="lv-close" type="button" data-video-close aria-label="Close video">×</button>
      <div class="lv-player" data-video-frame></div>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-card]').forEach((card) => {
    if (card.dataset.videoReady === 'true') return;
    card.dataset.videoReady = 'true';

    const opener = card.querySelector<HTMLButtonElement>('[data-video-open]');
    const modal = card.querySelector<HTMLElement>('[data-video-modal]');
    const frame = card.querySelector<HTMLElement>('[data-video-frame]');
    const closer = card.querySelector<HTMLButtonElement>('[data-video-close]');
    if (!opener || !modal || !frame || !closer) return;

    const close = () => {
      frame.replaceChildren();
      modal.hidden = true;
      opener.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      opener.focus();
    };

    opener.addEventListener('click', () => {
      const src = opener.dataset.videoSrc;
      if (!src) return;

      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = opener.getAttribute('aria-label') || 'LUXEhome walkthrough';
      iframe.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      modal.hidden = false;
      opener.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closer.focus();
    });

    closer.addEventListener('click', close);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) close();
    });
  });
</script>

<style>
  .lv-card { width: min(100%, 330px); }
  .lv-cover {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: var(--sage-deep);
    color: var(--cream);
    text-align: left;
    cursor: pointer;
    box-shadow: 0 18px 42px rgba(43,50,42,.14);
  }
  .lv-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform .45s ease;
  }
  .lv-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(19,28,20,.04) 32%, rgba(19,28,20,.88) 100%);
  }
  .lv-play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 1px solid rgba(255,255,255,.72);
    border-radius: 50%;
    background: rgba(247,243,235,.93);
    color: var(--sage-deep);
    box-shadow: 0 8px 30px rgba(0,0,0,.2);
    transition: transform .2s ease, background .2s ease;
  }
  .lv-play svg { width: 25px; height: 25px; fill: currentColor; margin-left: 3px; }
  .lv-cover-copy {
    position: absolute;
    inset: auto 0 0;
    padding: 1.3rem;
  }
  .lv-cover-copy small,
  .lv-cover-copy strong,
  .lv-cover-copy em { display: block; }
  .lv-cover-copy small {
    color: var(--gold-soft);
    font-size: .65rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .lv-cover-copy strong {
    margin-top: .3rem;
    font: 600 1.55rem/1.05 var(--lx-serif);
  }
  .lv-cover-copy em {
    margin-top: .35rem;
    color: rgba(247,243,235,.76);
    font: normal .76rem/1.4 var(--lx-sans);
  }
  .lv-cover:hover img { transform: scale(1.035); }
  .lv-cover:hover .lv-play { transform: scale(1.06); background: #fff; }
  .lv-card > p {
    margin-top: .85rem;
    color: color-mix(in srgb, var(--ink) 68%, transparent);
    font-size: .84rem;
    line-height: 1.55;
  }

  .lv-modal[hidden] { display: none; }
  .lv-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgba(16,21,17,.9);
    backdrop-filter: blur(8px);
  }
  .lv-player-shell { position: relative; }
  .lv-player {
    width: min(420px, calc(100vw - 2rem), 49.5dvh);
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 12px;
    background: #000;
    box-shadow: 0 24px 70px rgba(0,0,0,.45);
  }
  .lv-player iframe { width: 100%; height: 100%; border: 0; display: block; }
  .lv-close {
    position: absolute;
    z-index: 1;
    top: .7rem;
    right: .7rem;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255,255,255,.45);
    border-radius: 50%;
    background: rgba(22,30,23,.78);
    color: #fff;
    font: 300 1.75rem/1 var(--lx-sans);
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .lv-card { width: min(82vw, 300px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .lv-cover img,
    .lv-play { transition: none; }
  }
</style>
