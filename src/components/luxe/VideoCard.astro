---
interface Props {
  title: string;
  embedUrl: string;
  coverImage: string;
  eyebrow?: string;
  duration?: string;
  description?: string;
  /** YouTube Shorts are shot vertically. The embed player is always 16:9, so
      a Short must be scaled up and cropped to fill a portrait frame — left as
      it comes, it sits as a tiny pillarboxed strip at the top of a black box. */
  portrait?: boolean;
}

const {
  title,
  embedUrl,
  coverImage,
  eyebrow = '3D walkthrough',
  duration,
  description = 'Open the vertical walkthrough without leaving this design.',
  portrait = true,
} = Astro.props;

const dialogId = `video-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const videoId = embedUrl.match(/embed\/([a-zA-Z0-9_-]{11})/)?.[1] ?? '';

/* Muted autoplay is the only kind iOS honours, so the video starts the moment
   the sheet opens instead of handing over to YouTube's own red play button.
   Sound is one tap away. Chrome is suppressed: no related videos, no
   annotations, no branding, and no controls to be cropped by the fill. */
const params = new URLSearchParams({
  autoplay: '1',
  mute: '1',
  playsinline: '1',
  rel: '0',
  modestbranding: '1',
  iv_load_policy: '3',
  controls: portrait ? '0' : '1',
  enablejsapi: '1',
});
if (portrait && videoId) {
  params.set('loop', '1');
  params.set('playlist', videoId);
}
const playerUrl = `${embedUrl}${embedUrl.includes('?') ? '&' : '?'}${params.toString()}`;
---

<article class="lv-card lxr" data-video-card>
  <button
    class="lv-cover"
    type="button"
    data-video-open
    data-video-src={playerUrl}
    aria-haspopup="dialog"
    aria-controls={dialogId}
    aria-expanded="false"
    aria-label={`Play ${title}`}
  >
    <img src={coverImage} alt="" loading="lazy" width="540" height="960" />
    <span class="lv-shade" aria-hidden="true"></span>
    <span class="lv-play" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10-6.5z"></path></svg>
    </span>
    <span class="lv-cover-copy">
      <small>{eyebrow}</small>
      <strong>{title}</strong>
      {duration && <em>{duration}</em>}
    </span>
  </button>
  <p>{description}</p>

  <div
    class="lv-modal"
    id={dialogId}
    data-video-modal
    role="dialog"
    aria-modal="true"
    aria-label={title}
    hidden
  >
    <div class="lv-shell">
      <div class="lv-shell-bar">
        <span class="lv-shell-title">{title}</span>
        <div class="lv-shell-actions">
          {portrait && (
            <button class="lv-sound" type="button" data-video-sound aria-pressed="false" aria-label="Turn sound on">
              <svg class="lv-icon-muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6.5 9H3v6h3.5L11 19V5Z"/><path d="m16 9 4 6M20 9l-4 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
              <svg class="lv-icon-loud" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6.5 9H3v6h3.5L11 19V5Z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
              <span>Sound</span>
            </button>
          )}
          <button class="lv-close" type="button" data-video-close aria-label="Close video">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>
      <div class:list={['lv-player', { 'is-portrait': portrait }]}>
        <div class="lv-frame" data-video-frame></div>
        {/* Taps must never reach the iframe: any click inside a YouTube embed
            can navigate to youtube.com, and a cross-origin frame cannot be
            intercepted. This layer takes every tap and drives the player over
            postMessage instead, so the visitor never leaves the site. */}
        <button class="lv-guard" type="button" data-video-guard aria-label="Pause video">
          <span class="lv-guard-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10-6.5z"/></svg>
          </span>
        </button>
        {/* Our own cover holds the frame until the player is actually playing,
            so YouTube's poster — title, channel and red button — is never seen. */}
        <div class="lv-poster" data-video-poster style={`background-image:url(${coverImage})`}>
          <span class="lv-poster-spinner" aria-hidden="true"></span>
        </div>
        {/* Shown only if the embed never reports back. The visitor is never
            sent to YouTube; the design's own render stays on screen and the
            next step is offered instead. */}
        <div class="lv-fallback" data-video-fallback hidden>
          <p>The walkthrough is taking a moment.</p>
          <small>Every view of this design is on the page below.</small>
          <button type="button" data-video-retry>Try again</button>
          <a href="/book-site-inspection">Book a site inspection</a>
        </div>
      </div>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-card]').forEach((card) => {
    if (card.dataset.videoReady === 'true') return;
    card.dataset.videoReady = 'true';

    const opener = card.querySelector<HTMLButtonElement>('[data-video-open]');
    const modal = card.querySelector<HTMLElement>('[data-video-modal]');
    const frame = card.querySelector<HTMLElement>('[data-video-frame]');
    const closer = card.querySelector<HTMLButtonElement>('[data-video-close]');
    const sound = card.querySelector<HTMLButtonElement>('[data-video-sound]');
    const poster = card.querySelector<HTMLElement>('[data-video-poster]');
    const guard = card.querySelector<HTMLButtonElement>('[data-video-guard]');
    const fallback = card.querySelector<HTMLElement>('[data-video-fallback]');
    if (!opener || !modal || !frame || !closer) return;

    let iframe: HTMLIFrameElement | null = null;
    let posterTimer: number | undefined;
    let embedTimer: number | undefined;
    let playing = false;
    let heardFromPlayer = false;

    /** Drives the embedded player without loading YouTube's API script. */
    const command = (func: string) => {
      iframe?.contentWindow?.postMessage(
        JSON.stringify({ event: 'command', func, args: [] }),
        '*'
      );
    };

    const revealPlayer = () => {
      window.clearTimeout(posterTimer);
      poster?.classList.add('is-gone');
    };

    const setPlaying = (value: boolean) => {
      playing = value;
      guard?.classList.toggle('is-paused', !value);
      guard?.setAttribute('aria-label', value ? 'Pause video' : 'Play video');
    };

    /* YouTube only reports state once the embed has been asked to listen. */
    window.addEventListener('message', (event: MessageEvent) => {
      if (!iframe || !/youtube(-nocookie)?\.com$/.test(new URL(event.origin).hostname)) return;
      try {
        const data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
        if (data?.event === 'onReady') {
          iframe.contentWindow?.postMessage(JSON.stringify({ event: 'listening' }), '*');
        }
        // 1 = playing, 3 = buffering: either means the poster has been replaced.
        heardFromPlayer = true;
        window.clearTimeout(embedTimer);
        if (data?.event === 'onStateChange') {
          if (data.info === 1 || data.info === 3) revealPlayer();
          if (data.info === 1) setPlaying(true);
          if (data.info === 2 || data.info === 0) setPlaying(false);
        }
      } catch { /* not a player message */ }
    });

    const close = () => {
      window.clearTimeout(posterTimer);
      window.clearTimeout(embedTimer);
      if (fallback) fallback.hidden = true;
      poster?.classList.remove('is-gone');
      frame.replaceChildren();
      iframe = null;
      modal.hidden = true;
      opener.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (sound) {
        sound.setAttribute('aria-pressed', 'false');
        sound.setAttribute('aria-label', 'Turn sound on');
      }
      opener.focus();
    };

    opener.addEventListener('click', () => {
      const src = opener.dataset.videoSrc;
      if (!src) return;

      iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = opener.getAttribute('aria-label') || 'LUXEhome walkthrough';
      iframe.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      iframe.addEventListener('load', () => {
        iframe?.contentWindow?.postMessage(JSON.stringify({ event: 'listening' }), '*');
      });
      // Safety net: never leave the cover stuck if no state ever arrives.
      posterTimer = window.setTimeout(revealPlayer, 1600);
      setPlaying(true);
      // An embed that never answers cannot be played inline — offer the link.
      heardFromPlayer = false;
      embedTimer = window.setTimeout(() => {
        if (heardFromPlayer) return;
        revealPlayer();
        if (fallback) fallback.hidden = false;
      }, 3200);
      modal.hidden = false;
      opener.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closer.focus();
    });

    const retry = card.querySelector<HTMLButtonElement>('[data-video-retry]');
    retry?.addEventListener('click', () => {
      const src = opener.dataset.videoSrc;
      if (!src || !iframe) return;
      if (fallback) fallback.hidden = true;
      heardFromPlayer = false;
      iframe.src = src;
      embedTimer = window.setTimeout(() => {
        if (!heardFromPlayer && fallback) fallback.hidden = false;
      }, 3200);
    });

    /* Every tap inside the frame lands here, never on YouTube. */
    guard?.addEventListener('click', () => {
      command(playing ? 'pauseVideo' : 'playVideo');
      setPlaying(!playing);
    });

    sound?.addEventListener('click', () => {
      const on = sound.getAttribute('aria-pressed') === 'true';
      command(on ? 'mute' : 'unMute');
      sound.setAttribute('aria-pressed', on ? 'false' : 'true');
      sound.setAttribute('aria-label', on ? 'Turn sound on' : 'Turn sound off');
    });

    closer.addEventListener('click', close);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) close();
    });
  });
</script>

<style>
  .lv-card { width: min(100%, 330px); }
  .lv-cover {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: var(--sage-deep);
    color: var(--cream);
    text-align: left;
    cursor: pointer;
    box-shadow: 0 18px 42px rgba(43,50,42,.14);
  }
  .lv-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform .45s ease;
  }
  .lv-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(19,28,20,.04) 32%, rgba(19,28,20,.88) 100%);
  }
  .lv-play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 1px solid rgba(255,255,255,.72);
    border-radius: 50%;
    background: rgba(247,243,235,.93);
    color: var(--sage-deep);
    box-shadow: 0 8px 30px rgba(0,0,0,.2);
    transition: transform .2s ease, background .2s ease;
  }
  .lv-play svg { width: 25px; height: 25px; fill: currentColor; margin-left: 3px; }
  .lv-cover-copy { position: absolute; inset: auto 0 0; padding: 1.3rem; }
  .lv-cover-copy small,
  .lv-cover-copy strong,
  .lv-cover-copy em { display: block; }
  .lv-cover-copy small {
    color: var(--gold-soft);
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .lv-cover-copy strong { margin-top: .3rem; font: 600 1.55rem/1.05 var(--lx-serif); }
  .lv-cover-copy em {
    margin-top: .35rem;
    color: rgba(247,243,235,.76);
    font: 500 .88rem/1.45 var(--lx-sans);
  }
  .lv-cover:hover img { transform: scale(1.035); }
  .lv-cover:hover .lv-play { transform: scale(1.06); background: #fff; }
  .lv-card > p {
    margin-top: .85rem;
    color: color-mix(in srgb, var(--ink) 84%, transparent);
    font-size: .95rem;
    line-height: 1.55;
  }

  /* ── Player sheet ── */
  .lv-modal[hidden] { display: none; }
  .lv-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: max(1rem, env(safe-area-inset-top)) 1rem max(1rem, env(safe-area-inset-bottom));
    background: rgba(14,18,14,.94);
    backdrop-filter: blur(14px);
  }
  .lv-shell { display: flex; flex-direction: column; gap: .7rem; max-width: 100%; }
  .lv-shell-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .lv-shell-title {
    color: rgba(247,243,235,.9);
    font: 500 .9rem var(--lx-sans);
    letter-spacing: .08em;
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lv-shell-actions { display: flex; align-items: center; gap: .5rem; flex: 0 0 auto; }

  .lv-sound, .lv-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    height: 40px;
    border: 1px solid rgba(247,243,235,.28);
    border-radius: 100px;
    background: rgba(247,243,235,.06);
    color: rgba(247,243,235,.92);
    cursor: pointer;
    transition: background .2s ease, border-color .2s ease;
  }
  .lv-sound { padding: 0 .95rem; font: 500 .82rem var(--lx-sans); letter-spacing: .07em; text-transform: uppercase; }
  .lv-close { width: 40px; padding: 0; }
  .lv-sound:hover, .lv-close:hover { background: rgba(247,243,235,.16); border-color: rgba(247,243,235,.5); }
  .lv-sound:focus-visible, .lv-close:focus-visible { outline: 2px solid var(--gold-soft); outline-offset: 2px; }
  .lv-sound svg, .lv-close svg { width: 17px; height: 17px; fill: currentColor; }
  .lv-sound .lv-icon-loud { display: none; }
  .lv-sound[aria-pressed='true'] .lv-icon-loud { display: block; }
  .lv-sound[aria-pressed='true'] .lv-icon-muted { display: none; }
  .lv-sound[aria-pressed='true'] { background: var(--gold); border-color: var(--gold); color: #fff; }

  /* Driven from the height so the video fills the screen it is given: it takes
     the full viewport height minus the title bar, unless that would make it
     wider than the screen, in which case width wins. Sizing the width from
     dvh instead left it far smaller than the space available. */
  .lv-player {
    position: relative;
    aspect-ratio: 9 / 16;
    height: min(calc(100dvh - 6.5rem), calc((100vw - 2rem) * 16 / 9));
    width: auto;
    max-width: min(560px, calc(100vw - 2rem));
    overflow: hidden;
    border-radius: 16px;
    background: #000;
    box-shadow: 0 30px 80px rgba(0,0,0,.55);
  }
  .lv-player:not(.is-portrait) {
    aspect-ratio: 16 / 9;
    height: auto;
    width: min(1040px, calc(100vw - 2rem));
    max-width: calc(100vw - 2rem);
  }
  /* The iframe is created in JavaScript, so it never carries Astro's scoping
     attribute — a plain `iframe` selector inside this scoped block would be
     compiled to `iframe[data-astro-cid-…]` and match nothing. :global() is
     required for every rule that targets it. */
  .lv-player :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .lv-frame { position: absolute; inset: 0; z-index: 1; }

  /* Sits above the iframe so no tap can ever reach YouTube. */
  .lv-guard {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .lv-guard:focus-visible { outline: 2px solid var(--gold-soft); outline-offset: -4px; }
  .lv-guard-icon {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: rgba(247,243,235,.94);
    color: #5B6349;
    opacity: 0;
    transform: scale(.9);
    transition: opacity .25s ease, transform .25s ease;
  }
  .lv-guard.is-paused .lv-guard-icon { opacity: 1; transform: none; }
  .lv-guard-icon svg { width: 27px; height: 27px; fill: currentColor; margin-left: 3px; }

  .lv-fallback[hidden] { display: none; }
  .lv-fallback {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    padding: 24px;
    background: rgba(14,18,14,.82);
    text-align: center;
  }
  .lv-fallback p { margin: 0; color: rgba(247,243,235,.92); font: 500 1.1rem var(--lx-serif); }
  .lv-fallback small { color: rgba(247,243,235,.78); font-size: .86rem; }
  .lv-fallback button,
  .lv-fallback a {
    padding: 12px 22px;
    border: 1px solid rgba(247,243,235,.4);
    border-radius: 100px;
    background: transparent;
    color: #EDE7DA;
    font: 500 .86rem var(--lx-sans);
    letter-spacing: .07em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }
  .lv-fallback a { background: var(--gold); border-color: var(--gold); color: #fff; }
  .lv-fallback button:hover { background: rgba(247,243,235,.14); }

  .lv-poster {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    background-size: cover;
    background-position: center;
    transition: opacity .45s ease;
  }
  .lv-poster::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(14,18,14,.45);
  }
  .lv-poster.is-gone { opacity: 0; pointer-events: none; }
  .lv-poster-spinner {
    position: relative;
    z-index: 1;
    width: 34px;
    height: 34px;
    border: 2px solid rgba(247,243,235,.28);
    border-top-color: rgba(247,243,235,.92);
    border-radius: 50%;
    animation: lvSpin .9s linear infinite;
  }
  @keyframes lvSpin { to { transform: rotate(360deg); } }

  /* A Short is a vertical video pillarboxed inside YouTube's fixed 16:9
     player. Widening that player to 256/81 of the frame makes the video
     itself exactly fill the frame, cropping the black bars either side. */
  .lv-player.is-portrait :global(iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    /* transform rather than the newer translate property, for older Safari */
    transform: translate(-50%, -50%);
    width: calc(100% * 256 / 81);
    height: 100%;
    max-width: none;
  }

  @media (max-width: 640px) {
    .lv-card { width: min(82vw, 300px); }
    /* Edge to edge on a phone, with only the safe areas and title bar spared. */
    .lv-modal { padding: max(.6rem, env(safe-area-inset-top)) .6rem max(.6rem, env(safe-area-inset-bottom)); }
    .lv-player {
      height: min(calc(100dvh - 5rem), calc((100vw - 1.2rem) * 16 / 9));
      max-width: calc(100vw - 1.2rem);
      border-radius: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lv-poster, .lv-guard-icon { transition: none; }
    .lv-poster-spinner { animation-duration: 2.4s; }
    .lv-cover img,
    .lv-play,
    .lv-sound,
    .lv-close { transition: none; }
  }
</style>
