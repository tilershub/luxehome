---
/* "Built the LUXEhome Way" in condensed form — the twelve stages as a single
   glance, with the reasons underneath, linking to the page that describes each
   stage in full. Titles come from BUILD_STAGES so this and the dedicated page
   can never disagree. */
import { BUILD_STAGES, WHY_LUXEHOME } from '../../lib/luxe-config';

interface Props {
  /** Headline above the grid. */
  title?: string;
  /** Show the "why homeowners choose" list beneath the stages. */
  showReasons?: boolean;
}

const {
  title = 'Every bathroom follows our proven construction system.',
  showReasons = true,
} = Astro.props;

const reasons = WHY_LUXEHOME.slice(0, 6);
---

<section class="bp" aria-labelledby="bp-title">
  <div class="bp-inner">
    <div class="bp-head lxr">
      <div>
        <p class="bp-eyebrow">Built the LUXEhome Way</p>
        <h2 id="bp-title">{title}</h2>
      </div>
      <p class="bp-lead">
        From the first site inspection to the final quality check, every LUXEhome project
        follows a carefully planned process that ensures outstanding craftsmanship,
        long-term durability, and a luxury finish.
      </p>
    </div>

    <ol class="bp-grid">
      {BUILD_STAGES.map((stage) => (
        <li class="bp-stage lxr">
          <a href={`/how-we-build#stage-${stage.n}`}>
            <span>{stage.n}</span>
            <strong>{stage.title}</strong>
          </a>
        </li>
      ))}
    </ol>

    {showReasons && (
      <ul class="bp-reasons lxr">
        {reasons.map((reason) => <li>{reason}</li>)}
      </ul>
    )}

    <a class="bp-cta lxr" href="/how-we-build">
      See what happens at every stage
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .bp {
    background: #262B23;
    color: #EDE7DA;
    padding: clamp(52px, 8vh, 92px) clamp(20px, 5vw, 64px);
  }
  .bp-inner { max-width: 1240px; margin: 0 auto; }

  .bp-head { display: grid; grid-template-columns: 1fr; gap: 18px; margin-bottom: clamp(28px, 4vw, 44px); }
  .bp-eyebrow {
    margin-bottom: 12px;
    font: 600 13px var(--lx-sans);
    letter-spacing: .22em;
    text-transform: uppercase;
    color: #A9AF97;
  }
  .bp-head h2 { margin: 0; max-width: 20ch; font: 500 clamp(28px, 4.4vw, 46px)/1.05 var(--lx-serif); }
  .bp-lead { margin: 0; max-width: 52ch; font-size: 16px; line-height: 1.75; color: #C4C9B8; }

  .bp-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: rgba(237,231,218,.14);
    border: 1px solid rgba(237,231,218,.14);
  }
  .bp-stage { background: #262B23; }
  .bp-stage a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: clamp(14px, 2vw, 20px);
    color: inherit;
    text-decoration: none;
    transition: background .25s ease;
  }
  .bp-stage a:hover { background: #2E342A; color: inherit; }
  .bp-stage span { font: 500 13px var(--lx-sans); letter-spacing: .1em; color: #C6A363; }
  .bp-stage strong { font: 500 clamp(14px, 1.6vw, 16px)/1.3 var(--lx-serif); }

  .bp-reasons {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px 28px;
    margin: clamp(26px, 4vw, 38px) 0 0;
    padding: 0;
    list-style: none;
  }
  .bp-reasons li { position: relative; padding-left: 24px; font-size: 16px; color: #DAD5C9; }
  .bp-reasons li::before { content: '✔'; position: absolute; left: 0; top: 0; color: #C6A363; font-size: 12px; }

  .bp-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(26px, 4vw, 36px);
    padding: 16px 28px;
    border: 1px solid rgba(237,231,218,.3);
    border-radius: 100px;
    color: #EDE7DA;
    font: 500 15px var(--lx-sans);
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background .25s ease, border-color .25s ease;
  }
  .bp-cta:hover { background: #5B6349; border-color: #5B6349; color: #F3EDE3; }

  @media (min-width: 700px) {
    .bp-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .bp-reasons { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .bp-head { grid-template-columns: 1.1fr .9fr; align-items: end; gap: 40px; }
    .bp-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .bp-reasons { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bp-stage a, .bp-cta { transition: none; }
  }
</style>
