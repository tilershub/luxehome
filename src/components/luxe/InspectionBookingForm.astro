---
import { getDesigns } from '../../lib/luxe';
import { normalizeBathroomDesignIdentity } from '../../lib/bathroom-taxonomy';

const storedDesigns = await getDesigns({ spaceSlug: 'bathrooms' });
const bathroomDesignNames = [...new Set(
  storedDesigns
    .filter((design) => design.cover_image_url)
    .map(normalizeBathroomDesignIdentity)
    .map((design) => design.name),
)];
---

<div class="ibf-wrap">
  <div class="ibf-success" id="inspection-success" aria-live="polite" hidden>
    <span aria-hidden="true">✓</span>
    <h2>Application received.</h2>
    <p>
      We will review the project type, location, timing and investment range, then contact you on WhatsApp.
      Please note that submitting the form does not automatically confirm a site appointment.
    </p>
    <a id="inspection-whatsapp-backup" href="#" target="_blank" rel="noopener noreferrer">
      Continue to WhatsApp
    </a>
  </div>

  <form id="inspection-request-form">
    <div class="ibf-heading">
      <p class="lx-eyebrow">Complimentary consultation application</p>
      <h2>Tell us about one bathroom.</h2>
      <p>You do not need drawings or measurements. A few practical details help us decide whether a site consultation will be useful for both sides.</p>
    </div>

    <input class="ibf-honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="ibf-grid">
      <label>
        <span>Full name <b aria-hidden="true">*</b></span>
        <input type="text" name="name" placeholder="e.g. Nuwan Perera" autocomplete="name" required />
      </label>
      <label>
        <span>Phone / WhatsApp <b aria-hidden="true">*</b></span>
        <input type="tel" name="phone" placeholder="e.g. 077 450 3744" autocomplete="tel" required />
      </label>
    </div>

    <label>
      <span>Email address <small>(optional)</small></span>
      <input type="email" name="email" placeholder="e.g. nuwan@example.com" autocomplete="email" />
    </label>

    <label>
      <span>Property location <b aria-hidden="true">*</b></span>
      <input type="text" name="location" placeholder="e.g. Nugegoda, Kandy, Galle" autocomplete="address-level2" required />
    </label>

    <fieldset>
      <legend>What are you planning? <b aria-hidden="true">*</b></legend>
      <div class="ibf-choice-grid">
        <label><input type="radio" name="project_type" value="Bathroom renovation" required /><span>Renovate an existing bathroom</span></label>
        <label><input type="radio" name="project_type" value="New bathroom" /><span>Build a new bathroom</span></label>
        <label><input type="radio" name="project_type" value="Not sure yet" /><span>Not sure yet</span></label>
      </div>
    </fieldset>

    <label>
      <span>Preferred LUXEhome design <small>(optional)</small></span>
      <input id="inspection-design" type="text" name="preferred_design" list="inspection-designs" placeholder="Choose a design or leave this blank" />
      <datalist id="inspection-designs">
        {bathroomDesignNames.map((name) => <option value={name}></option>)}
      </datalist>
    </label>
    <div class="ibf-selected-design" id="inspection-selected-design" hidden>
      <span>Selected from the design page</span>
      <strong id="inspection-selected-design-name"></strong>
    </div>

    <fieldset>
      <legend>Do you know the bathroom size?</legend>
      <div class="ibf-choice-grid ibf-choice-grid--two">
        <label><input type="radio" name="size_status" value="Please measure during approved site assessment" checked /><span>No — please measure it</span></label>
        <label><input type="radio" name="size_status" value="Approximate size provided" /><span>Yes — approximately</span></label>
      </div>
    </fieldset>

    <label id="inspection-size-field" hidden>
      <span>Approximate size <small>(optional)</small></span>
      <input type="text" name="approximate_size" placeholder="e.g. 2.5 m × 2 m, or about 5 m²" />
    </label>

    <fieldset>
      <legend>What investment range are you considering for this complete bathroom? <b aria-hidden="true">*</b></legend>
      <p class="ibf-field-note">Published LUXEhome complete-bathroom guides typically start around LKR 1.5M.</p>
      <div class="ibf-choice-grid">
        <label><input type="radio" name="budget_direction" value="Below LKR 1.5M" required /><span>Below LKR 1.5M</span></label>
        <label><input type="radio" name="budget_direction" value="LKR 1.5M–2M" /><span>LKR 1.5M–2M</span></label>
        <label><input type="radio" name="budget_direction" value="LKR 2M–3M" /><span>LKR 2M–3M</span></label>
        <label><input type="radio" name="budget_direction" value="LKR 3M+" /><span>LKR 3M+</span></label>
        <label><input type="radio" name="budget_direction" value="Not decided — need guidance" /><span>Not decided — need guidance</span></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>When would you like the project to begin? <b aria-hidden="true">*</b></legend>
      <div class="ibf-choice-grid ibf-choice-grid--four">
        <label><input type="radio" name="project_timing" value="Within 1–3 months" required /><span>Within 1–3 months</span></label>
        <label><input type="radio" name="project_timing" value="Within 3–6 months" /><span>Within 3–6 months</span></label>
        <label><input type="radio" name="project_timing" value="More than 6 months" /><span>More than 6 months</span></label>
        <label><input type="radio" name="project_timing" value="Researching for now" /><span>Researching for now</span></label>
      </div>
    </fieldset>

    <label>
      <span>Anything we should know? <small>(optional)</small></span>
      <textarea name="notes" rows="4" placeholder="Current problems, access, timeline, style preferences or other details"></textarea>
      <small class="ibf-help">You can attach current bathroom photos and the Reel or design that inspired you after WhatsApp opens.</small>
    </label>

    <div class="ibf-fee">
      <div>
        <span>Consultation application</span>
        <strong>No fee</strong>
      </div>
      <ul>
        <li>Every application is reviewed before a site appointment is offered</li>
        <li>Approved complete projects include one detailed site assessment</li>
        <li>The detailed design and construction proposal is a separate LKR 50,000 stage after consultation</li>
        <li>The proposal fee is credited in full if LUXEhome builds that bathroom</li>
      </ul>
    </div>

    <label class="ibf-consent">
      <input type="checkbox" name="process_acknowledgement" required />
      <span>I understand this is an application for a complimentary consultation, not an automatically confirmed site visit. If I commission the detailed proposal after consultation, it costs LKR 50,000 for one bathroom and is credited in full if LUXEhome builds it.</span>
    </label>

    <button class="ibf-submit" id="inspection-submit" type="submit">
      <span>Apply for Consultation</span>
      <span hidden>Preparing your request…</span>
    </button>
    <p class="ibf-footnote">Have several bathrooms? Begin the application with the first bathroom you want LUXEhome to assess.</p>
    <p class="ibf-privacy">By submitting, you ask LUXEhome to contact you about this project by WhatsApp and, if provided, email. See our <a href="/privacy-policy">Privacy Policy</a>.</p>
  </form>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';
  import type { LeadInsert } from '../../lib/supabase';
  import { LUXE_SUPABASE_KEY, LUXE_SUPABASE_URL } from '../../lib/luxe-supabase';

  const supabase = createClient(LUXE_SUPABASE_URL, LUXE_SUPABASE_KEY);

  const form = document.getElementById('inspection-request-form') as HTMLFormElement | null;
  const success = document.getElementById('inspection-success') as HTMLElement | null;
  const submit = document.getElementById('inspection-submit') as HTMLButtonElement | null;
  const designInput = document.getElementById('inspection-design') as HTMLInputElement | null;
  const selectedDesign = document.getElementById('inspection-selected-design') as HTMLElement | null;
  const selectedDesignName = document.getElementById('inspection-selected-design-name') as HTMLElement | null;
  const sizeField = document.getElementById('inspection-size-field') as HTMLElement | null;
  const backupLink = document.getElementById('inspection-whatsapp-backup') as HTMLAnchorElement | null;

  function titleFromSlug(value: string) {
    return value
      .replace(/[-_]+/g, ' ')
      .replace(/\b\w/g, (letter) => letter.toUpperCase());
  }

  function formValue(data: FormData, key: string) {
    return data.get(key)?.toString().trim() ?? '';
  }

  function updateSizeField() {
    if (!form || !sizeField) return;
    const status = form.querySelector<HTMLInputElement>('input[name="size_status"]:checked')?.value;
    sizeField.hidden = status !== 'Approximate size provided';
  }

  if (form) {
    const params = new URLSearchParams(window.location.search);
    const design = params.get('design');
    const project = params.get('project');

    if (design && designInput && selectedDesign && selectedDesignName) {
      const designName = titleFromSlug(design);
      designInput.value = designName;
      selectedDesignName.textContent = designName;
      selectedDesign.hidden = false;
    }

    const projectValues: Record<string, string> = {
      renovation: 'Bathroom renovation',
      new: 'New bathroom',
      unsure: 'Not sure yet',
    };
    const projectValue = project ? projectValues[project.toLowerCase()] : '';
    if (projectValue) {
      const option = form.querySelector<HTMLInputElement>(`input[name="project_type"][value="${projectValue}"]`);
      if (option) option.checked = true;
    }

    form.querySelectorAll<HTMLInputElement>('input[name="size_status"]').forEach((radio) => {
      radio.addEventListener('change', updateSizeField);
    });
    updateSizeField();

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (formValue(data, 'website')) return;
      if (!form.reportValidity() || !submit || !success) return;

      const name = formValue(data, 'name');
      const phone = formValue(data, 'phone');
      const email = formValue(data, 'email');
      const location = formValue(data, 'location');
      const projectType = formValue(data, 'project_type');
      const preferredDesign = formValue(data, 'preferred_design');
      const sizeStatus = formValue(data, 'size_status') || 'Please measure during approved site assessment';
      const approximateSize = formValue(data, 'approximate_size');
      const budgetDirection = formValue(data, 'budget_direction');
      const projectTiming = formValue(data, 'project_timing');
      const notes = formValue(data, 'notes');

      submit.disabled = true;
      submit.children[0]?.setAttribute('hidden', '');
      submit.children[1]?.removeAttribute('hidden');

      const details: Record<string, string> = {
        project_type: projectType,
        size_status: sizeStatus,
        budget_direction: budgetDirection,
        project_timing: projectTiming,
        consultation_fee_lkr: '0',
        consultation_status: 'Application pending suitability review',
        detailed_proposal_fee_lkr: '50000',
        proposal_scope: 'One bathroom',
        proposal_delivery: 'Within seven working days after proposal payment and the completed consultation',
        construction_credit: '100% credited to the related LUXEhome construction balance',
        payment_status: 'No payment requested for consultation application',
      };
      if (email) details.email = email;
      if (preferredDesign) details.preferred_design = preferredDesign;
      if (approximateSize) details.approximate_size = approximateSize;

      const queueNotes = [
        `Project: ${projectType}`,
        `Investment range: ${budgetDirection}`,
        `Desired start: ${projectTiming}`,
        preferredDesign ? `Preferred design: ${preferredDesign}` : 'Preferred design: Please recommend',
        `Measurements: ${sizeStatus}${approximateSize ? ` — ${approximateSize}` : ''}`,
        'Consultation: Complimentary, subject to suitability approval; one site assessment included if approved',
        'Detailed proposal: LKR 50,000 for one bathroom, commissioned only after consultation',
        'Proposal: five design images, materials, timeline, quality, warranties, final quotation and 3D video link',
        'Delivery: within seven working days after proposal payment and completed consultation',
        'Construction credit: 100% credited if LUXEhome builds this bathroom',
        notes ? `Notes: ${notes}` : '',
      ].filter(Boolean).join('\n');

      if (supabase) {
        const lead: LeadInsert = {
          name,
          phone,
          service: 'Bathroom Project Consultation',
          location,
          service_details: details,
          notes: notes || null,
          source_url: window.location.href,
        };

        supabase.from('leads').insert(lead).then(({ error }) => {
          if (error) console.warn('[LUXEHOME] Lead save failed:', error.message);
        });
        supabase.from('lx_site_inspections').insert({
          name,
          phone,
          email: email || null,
          location,
          space_slug: 'bathrooms',
          preferred_date: null,
          preferred_time: null,
          notes: queueNotes,
          source_url: window.location.href,
          status: 'new',
        }).then(({ error }) => {
          if (error) console.warn('[LUXEHOME] Inspection queue save failed:', error.message);
        });
      }

      /* luxeTrack loads fbevents.js before firing. Plain fbq would only queue
         the conversion when the deferred load has not run yet, and this is
         the last thing the visitor does before WhatsApp takes over. */
      const metaEventId = crypto.randomUUID();
      const leadParams = {
        content_name: 'Bathroom Project Consultation Application',
        content_category: projectType,
      };
      const track = (window as any).luxeTrack;
      if (typeof track === 'function') {
        track('Lead', leadParams, { eventID: metaEventId });
      } else if (typeof (window as any).fbq === 'function') {
        (window as any).fbq('track', 'Lead', leadParams, { eventID: metaEventId });
      }
      fetch('/api/meta-capi', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          event_id: metaEventId,
          event_source_url: window.location.href,
          phone,
          name,
          service: 'Bathroom Project Consultation',
        }),
      }).catch(() => {});

      const message = [
        'Bathroom Consultation Application — LUXEHOME',
        '',
        `Name: ${name}`,
        `Phone: ${phone}`,
        email ? `Email: ${email}` : '',
        `Location: ${location}`,
        `Project: ${projectType}`,
        `Investment range: ${budgetDirection}`,
        `Desired start: ${projectTiming}`,
        `Preferred design: ${preferredDesign || 'Please recommend one'}`,
        `Bathroom size: ${sizeStatus}${approximateSize ? ` — ${approximateSize}` : ''}`,
        'Consultation: No fee; site assessment subject to suitability approval',
        'Detailed proposal after consultation: LKR 50,000 for one bathroom',
        'Proposal delivery: within seven working days after payment and completed consultation',
        'Construction credit: 100% credited if LUXEhome builds this bathroom',
        notes ? `Notes: ${notes}` : '',
      ].filter(Boolean).join('\n');
      const whatsappUrl = `https://wa.me/94774503744?text=${encodeURIComponent(message)}`;

      if (backupLink) backupLink.href = whatsappUrl;
      window.open(whatsappUrl, '_blank', 'noopener');

      form.hidden = true;
      success.hidden = false;
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'consultation_application_submit', {
          event_category: 'Lead',
          event_label: 'Bathroom Project Consultation',
        });
      }
    });
  }
</script>

<style>
  .ibf-wrap {
    overflow: hidden;
    border: 1px solid rgba(43,50,42,.12);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 18px 50px rgba(43,50,42,.08);
  }
  .ibf-wrap form,
  .ibf-success { padding: clamp(1.35rem, 4vw, 2.4rem); }
  .ibf-heading { padding-bottom: 1.25rem; border-bottom: 1px solid var(--cream-deep); }
  .ibf-heading h2 { margin: .25rem 0 .4rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .ibf-heading > p:last-child { max-width: 58ch; color: color-mix(in srgb, var(--ink) 67%, transparent); }
  .ibf-wrap form { display: grid; gap: 1rem; }
  .ibf-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
  .ibf-wrap label > span,
  .ibf-wrap legend { display: block; margin-bottom: .42rem; font-size: .88rem; font-weight: 600; color: var(--ink); }
  .ibf-wrap label > span b,
  .ibf-wrap legend b { color: #9b493d; }
  .ibf-wrap label > span small { color: color-mix(in srgb, var(--ink) 48%, transparent); font-weight: 400; }
  .ibf-wrap input[type="text"],
  .ibf-wrap input[type="tel"],
  .ibf-wrap input[type="email"],
  .ibf-wrap input[type="date"],
  .ibf-wrap select,
  .ibf-wrap textarea {
    width: 100%;
    border: 1px solid rgba(43,50,42,.2);
    border-radius: 7px;
    background: #fff;
    color: var(--ink);
    padding: .78rem .85rem;
    min-height: 48px;
    font: 400 1rem/1.4 var(--lx-sans);
  }
  .ibf-wrap textarea { resize: vertical; }
  .ibf-wrap input:focus,
  .ibf-wrap select:focus,
  .ibf-wrap textarea:focus { outline: 2px solid color-mix(in srgb, var(--gold) 55%, transparent); outline-offset: 1px; border-color: var(--gold); }
  .ibf-wrap fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .ibf-field-note { margin: -.12rem 0 .55rem; color: color-mix(in srgb, var(--ink) 66%, transparent); font-size: .8rem; line-height: 1.5; }
  .ibf-choice-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .55rem; }
  .ibf-choice-grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ibf-choice-grid--four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ibf-choice-grid label {
    display: flex;
    align-items: flex-start;
    gap: .55rem;
    min-height: 100%;
    padding: .72rem;
    border: 1px solid rgba(43,50,42,.16);
    border-radius: 7px;
    background: color-mix(in srgb, var(--cream) 70%, #fff);
    cursor: pointer;
  }
  .ibf-choice-grid input { flex: 0 0 auto; margin-top: .12rem; accent-color: var(--sage-deep); }
  .ibf-choice-grid label > span { margin: 0; font-size: .9rem; font-weight: 400; line-height: 1.45; }
  .ibf-selected-design {
    margin-top: -.35rem;
    padding: .65rem .8rem;
    border-left: 3px solid var(--gold);
    background: var(--sage-mist);
  }
  .ibf-selected-design span,
  .ibf-selected-design strong { display: block; }
  .ibf-selected-design span { color: var(--sage-deep); font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .ibf-selected-design strong { margin-top: .15rem; font: 600 1.05rem var(--lx-serif); }
  .ibf-help { display: block; margin-top: .35rem; color: color-mix(in srgb, var(--ink) 70%, transparent); font-size: .82rem; }
  .ibf-fee {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 1rem;
    padding: 1.05rem;
    border-radius: 9px;
    background: var(--sage-deep);
    color: var(--cream);
  }
  .ibf-fee > div span,
  .ibf-fee > div strong { display: block; }
  .ibf-fee > div span { color: var(--gold-soft); font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .ibf-fee > div strong { margin-top: .25rem; font: 600 1.7rem var(--lx-serif); }
  .ibf-fee ul { margin: 0; padding-left: 1.1rem; color: rgba(247,243,235,.9); font-size: .86rem; line-height: 1.6; }
  .ibf-consent { display: flex; align-items: flex-start; gap: .65rem; cursor: pointer; }
  .ibf-consent input { flex: 0 0 auto; margin-top: .18rem; accent-color: var(--sage-deep); }
  .ibf-consent > span { margin: 0 !important; color: color-mix(in srgb, var(--ink) 82%, transparent) !important; font-size: .86rem !important; font-weight: 400 !important; line-height: 1.5; }
  .ibf-submit {
    width: 100%;
    border: 0;
    border-radius: 999px;
    background: var(--gold);
    color: #fff;
    min-height: 50px;
    padding: .9rem 1.2rem;
    font: 600 .95rem var(--lx-sans);
    cursor: pointer;
  }
  .ibf-submit:disabled { cursor: wait; opacity: .72; }
  .ibf-footnote { text-align: center; color: color-mix(in srgb, var(--ink) 70%, transparent); font-size: .82rem; }
  .ibf-privacy { margin-top: -.35rem; text-align: center; color: color-mix(in srgb, var(--ink) 58%, transparent); font-size: .76rem; }
  .ibf-privacy a { color: var(--sage-deep); text-underline-offset: 2px; }
  .ibf-honeypot { position: absolute !important; left: -9999px !important; width: 1px !important; height: 1px !important; opacity: 0 !important; }
  .ibf-success { min-height: 420px; display: grid; place-content: center; justify-items: center; text-align: center; }
  .ibf-success[hidden] { display: none; }
  .ibf-success > span { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--sage-deep); color: #fff; font-size: 1.3rem; }
  .ibf-success h2 { margin: .8rem 0 .4rem; font-size: 2.3rem; }
  .ibf-success p { max-width: 52ch; color: color-mix(in srgb, var(--ink) 68%, transparent); }
  .ibf-success a { display: inline-flex; align-items: center; min-height: 48px; margin-top: 1rem; border-radius: 999px; padding: .75rem 1rem; background: var(--gold); color: #fff; text-decoration: none; font-size: .9rem; font-weight: 600; }

  @media (max-width: 640px) {
    .ibf-grid,
    .ibf-choice-grid,
    .ibf-choice-grid--two,
    .ibf-choice-grid--four,
    .ibf-fee { grid-template-columns: 1fr; }
    .ibf-fee { gap: .6rem; }
  }
</style>
