---
import type { LuxeProject } from '../../lib/luxe';
import { cloudinary } from '../../lib/luxe-config';

interface Props {
  project: LuxeProject;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const cover = project.after_image_url || project.before_image_url;
---

<a href={`/projects/${project.slug}`} class:list={['lp-card', { 'lp-card--compact': compact }]}>
  <div class="lp-cover">
    {cover
      ? <img src={cloudinary(cover, 800)} alt={`${project.title} — completed LUXEhome project`} loading="lazy" width="800" height="560" />
      : <div class="lp-placeholder"><strong>LUXE</strong><em>home</em></div>}
    <span class="lp-badge">Completed project</span>
  </div>
  <div class="lp-body">
    <h3>{project.title}</h3>
    <p class="lp-meta">
      {[project.location, project.area_label, project.duration_label].filter(Boolean).join(' · ')}
    </p>
    {project.design && <p class="lp-design">Built from the {project.design.name} design</p>}
    <span class="lp-link">View complete project story <b aria-hidden="true">→</b></span>
  </div>
</a>

<style>
  .lp-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--cream-deep);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    box-shadow: 0 8px 28px rgba(43,50,42,.06);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .lp-card:hover { transform: translateY(-4px); box-shadow: 0 16px 38px rgba(43,50,42,.11); }
  .lp-cover { position: relative; aspect-ratio: 10 / 7; overflow: hidden; background: var(--sage-mist); }
  .lp-cover img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .lp-card:hover .lp-cover img { transform: scale(1.025); }
  .lp-badge {
    position: absolute;
    top: .8rem;
    left: .8rem;
    padding: .32rem .7rem;
    border-radius: 999px;
    background: rgba(43,50,42,.84);
    color: var(--cream);
    font-size: .62rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .lp-placeholder { height: 100%; display: grid; place-content: center; color: var(--sage-deep); }
  .lp-placeholder em { font-family: var(--lx-serif); }
  .lp-body { display: flex; flex-direction: column; flex: 1; padding: 1.1rem 1.2rem 1.25rem; }
  .lp-body h3 { font-size: 1.45rem; margin: 0; }
  .lp-meta { margin-top: .25rem; color: color-mix(in srgb, var(--ink) 60%, transparent); font-size: .78rem; }
  .lp-design { margin-top: .55rem; color: var(--sage-deep); font-size: .8rem; }
  .lp-link { margin-top: auto; padding-top: 1rem; font-size: .76rem; font-weight: 600; letter-spacing: .04em; }
  .lp-link b { display: inline-block; transition: transform .2s ease; }
  .lp-card:hover .lp-link b { transform: translateX(4px); }
  .lp-card--compact .lp-cover { aspect-ratio: 4 / 3; }
  .lp-card--compact .lp-body h3 { font-size: 1.25rem; }
</style>
