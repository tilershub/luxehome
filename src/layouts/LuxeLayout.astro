---
/* LUXEhome catalogue layout — the new brand system:
   cream/sage/gold palette · Cormorant Garamond + Jost + Noto Sans Sinhala.
   Keeps the site's Meta Pixel, Contact-event tracking, and SEO plumbing. */
import { WHATSAPP_NUMBER, GA_MEASUREMENT_IDS, absoluteUrl } from '../lib/luxe-config';

interface Props {
  title?: string;
  description?: string;
  /** Share image for this page. Relative paths are made absolute. */
  ogImage?: string;
  /** Describes the share image for screen readers and some crawlers. */
  ogImageAlt?: string;
  /** Hide site nav/footer chrome (used by /start). */
  bare?: boolean;
  /* Fires ViewContent for this page. Design pages pass their own catalogue
     values, so a design published later is tracked without further work.
     Pages that are not a design or a design listing leave this unset. */
  viewContent?: {
    content_name: string;
    content_category?: string;
    content_type?: string;
    content_ids?: string[];
    value?: number;
    currency?: string;
  };
}

const {
  title = 'LUXEhome — Complete Bathroom Design & Construction, Sri Lanka',
  description = 'Start one bathroom with a LKR 50,000 initiation deposit for the site visit, detailed design and complete construction proposal. Fully credited if LUXEhome builds it.',
  ogImage = 'https://luxehome.lk/og-bathroom.jpg',
  ogImageAlt,
  bare = false,
  viewContent,
} = Astro.props;

/* An unpublished price arrives as undefined, and Meta reads a literal `null`
   as a real parameter value, so empty keys are dropped rather than sent. */
const viewContentParams = viewContent
  ? Object.fromEntries(
      Object.entries(viewContent).filter(([, value]) => value !== undefined && value !== null)
    )
  : null;

/* A CMS image can arrive as a repo path, and a share with a relative
   og:image renders with no image at all. */
const shareImage = absoluteUrl(ogImage) ?? 'https://luxehome.lk/og-bathroom.jpg';
const shareImageAlt = ogImageAlt ?? title;

// Cloudflare can still serve slash variants of prerendered pages even when
// Astro's route policy is `never`. Canonical metadata must therefore normalize
// the pathname independently so both variants point at the same preferred URL.
const canonicalPath = Astro.url.pathname === '/'
  ? '/'
  : Astro.url.pathname.replace(/\/+$/, '');
const canonicalURL = new URL(canonicalPath, Astro.site);

/* CMS-driven pages render on demand so published content is live immediately.
   Cloudflare caches each response at the edge for a minute and serves the
   stale copy while revalidating, so ad traffic never queues behind Supabase.
   Prerendered pages ignore these headers at build time. */
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=300'
);
---

<!DOCTYPE html>
<html lang="en" class="luxe">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#F7F3EB" />
    <script>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="LUXEhome" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:secure_url" content={shareImage} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta property="og:locale" content="en_LK" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />

    <!-- Fonts: Cormorant Garamond (display) · Jost (body) · Noto Sans Sinhala -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,500;1,600&family=Jost:wght@300;400;500;600&family=Noto+Sans+Sinhala:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,500;1,600&family=Jost:wght@300;400;500;600&family=Noto+Sans+Sinhala:wght@400;500&display=swap"
      />
    </noscript>

    <slot name="head" />

    <!-- Meta Pixel (same install as the rest of the site): stub + PageView
         immediately, network fetch deferred; Contact on wa.me/tel clicks -->
    <script is:inline>
      (function (f, b) {
        var n = f.fbq = f.fbq || function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = n.queue || [];
        fbq('init', '1904211696933513');
        fbq('track', 'PageView');
        function loadPixel() {
          if (f.__fbLoaded) return;
          f.__fbLoaded = true;
          var t = b.createElement('script'); t.async = !0;
          t.src = 'https://connect.facebook.net/en_US/fbevents.js';
          var s = b.getElementsByTagName('script')[0];
          s.parentNode.insertBefore(t, s);
        }
        /* Until fbevents.js arrives, fbq only queues. A conversion fired from
           a click can therefore be sitting in that queue with nothing to send
           it, so tracking a named event pulls the script in first, and the
           first interaction of any kind warms it well before a submit. */
        f.luxeTrack = function (event, params, options) {
          loadPixel();
          if (options) fbq('track', event, params || {}, options);
          else fbq('track', event, params || {});
        };
        ['pointerdown', 'keydown'].forEach(function (type) {
          b.addEventListener(type, loadPixel, { once: true, passive: true });
        });
        var idle = f.requestIdleCallback || function (cb) { return setTimeout(cb, 1500); };
        f.addEventListener('load', function () { idle(loadPixel); });
        b.addEventListener('click', function (e) {
          var a = e.target && e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (href.indexOf('wa.me') !== -1 || href.indexOf('tel:') === 0) {
            fbq('track', 'Contact');
          }
        }, true);
      })(window, document);
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=1904211696933513&ev=PageView&noscript=1" />
    </noscript>

    {viewContentParams && (
      <script is:inline define:vars={{ viewContentParams }}>
        window.luxeTrack('ViewContent', viewContentParams);
      </script>
    )}

    <!-- Google Analytics 4. window.gtag and dataLayer exist immediately, so an
         event fired before gtag.js arrives is queued rather than dropped — the
         previous install defined gtag inside the script's onload, leaving
         window.gtag undefined and silently discarding every conversion event.
         The gtag.js fetch itself stays off the critical path. -->
    <script is:inline define:vars={{ gaIds: GA_MEASUREMENT_IDS }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      // Every configured property receives the same pageviews and events.
      gaIds.forEach(function (id) { gtag('config', id); });
      (function () {
        function loadGa() {
          if (window.__gaLoaded || !gaIds.length) return;
          window.__gaLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          // One gtag.js serves every configured property.
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaIds[0];
          document.head.appendChild(s);
        }
        var idle = window.requestIdleCallback || function (cb) { return setTimeout(cb, 1500); };
        window.addEventListener('load', function () { idle(loadGa); });
      })();
    </script>
  </head>
  <body class="luxe-body">
    {!bare && (
      <header class="lx-nav">
        <a href="/" class="lx-wordmark" aria-label="LUXEhome — Home"><strong>LUXE</strong><em>home</em></a>
        <nav class="lx-nav-links" aria-label="Main">
          <a href="/">Home</a>
          <a href="/designs">Designs</a>
          <a href="/projects">Projects</a>
          <a href="/how-it-works">How it works</a>
          <a href="/pricing-guide">Pricing</a>
          <a href="/blog">Journal</a>
          <a href="/about">About</a>
          <a href="/book-site-inspection">Start project · LKR 50k</a>
        </nav>
        <a
          href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hi LUXEhome! I would like to talk about a project.')}`}
          class="lx-nav-wa" target="_blank" rel="noopener noreferrer"
        >WhatsApp Us</a>
        <button class="lx-nav-burger" id="lx-burger" aria-label="Open menu" aria-expanded="false">
          <span></span><span></span>
        </button>
      </header>
      <div class="lx-mobile-menu" id="lx-mobile-menu" hidden>
        <a href="/">Home</a>
        <a href="/designs">Bathroom designs</a>
        <a href="/projects">Projects</a>
        <a href="/how-it-works">How it works</a>
        <a href="/how-we-build">How we build</a>
        <a href="/pricing-guide">Pricing</a>
        <a href="/blog">Journal</a>
        <a href="/about">About</a>
        <a href="/book-site-inspection">Start project · LKR 50k</a>
        <a
          href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hi LUXEhome! I would like to talk about a project.')}`}
          class="lx-mobile-wa" target="_blank" rel="noopener noreferrer"
        >WhatsApp Us</a>
      </div>
    )}

    <main id="main-content">
      <slot />
    </main>

    {!bare && (
      <footer class="lx-footer">
        <div class="lx-footer-inner">
          <a href="/" class="lx-wordmark lx-wordmark--footer"><strong>LUXE</strong><em>home</em></a>
          <p class="lx-footer-tag">Complete bathroom design &amp; construction · Sri Lanka<br />A sister brand of TILERSHUB</p>
          <div class="lx-footer-links">
            <a href="/designs">Bathroom designs</a>
            <a href="/projects">Projects</a>
            <a href="/blog">Journal</a>
            <a href="/how-it-works">How it works</a>
            <a href="/how-we-build">How we build</a>
            <a href="/materials-brands">Materials</a>
            <a href="/pricing-guide">Pricing</a>
            <a href="/team">Team</a>
            <a href="/faq">FAQ</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="/book-site-inspection">Start a bathroom project</a>
          </div>
          <div class="lx-footer-contact">
            <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer">077 450 3744</a>
            <span>·</span>
            <span>luxehome.lk</span>
          </div>
          <div class="lx-footer-legal">
            <a href="/terms">Terms</a>
            <a href="/privacy-policy">Privacy</a>
            <a href="/warranty-terms">Warranty</a>
            <a href="/payment-cancellation">Payments</a>
          </div>
        </div>
      </footer>
    )}

    <!-- Scroll reveal (respects prefers-reduced-motion via CSS) -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.lxr');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach && els.forEach(function (el) { el.classList.add('lxr-in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('lxr-in'); io.unobserve(en.target); }
          });
        }, { threshold: 0.08 });
        els.forEach(function (el) {
          var r = el.getBoundingClientRect();
          if (r.top < window.innerHeight) el.classList.add('lxr-in');
          else io.observe(el);
        });
      })();
    </script>

    <script is:inline>
      (function () {
        var burger = document.getElementById('lx-burger');
        var menu = document.getElementById('lx-mobile-menu');
        if (!burger || !menu) return;
        burger.addEventListener('click', function () {
          var open = !menu.hidden;
          menu.hidden = open;
          burger.setAttribute('aria-expanded', String(!open));
          burger.classList.toggle('is-open', !open);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* ── LUXEhome brand tokens ── */
  html.luxe {
    --cream:      #F7F3EB;
    --cream-deep: #EFE8DB;
    --sage:       #8A9A84;
    --sage-deep:  #5C6B56;
    --sage-mist:  #DFE5DB;
    --gold:       #C9A24B;
    --gold-soft:  #E4CE9C;
    --ink:        #2B322A;
    --lx-serif:   'Cormorant Garamond', Georgia, serif;
    --lx-sans:    'Jost', system-ui, sans-serif;
    --lx-sinhala: 'Noto Sans Sinhala', sans-serif;
  }

  html.luxe {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }
  /* Zero-specificity reset (:where) so the layout's own class rules always win */
  :where(html.luxe) *,
  :where(html.luxe) *::before,
  :where(html.luxe) *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .luxe-body {
    background: var(--cream);
    color: var(--ink);
    font-family: var(--lx-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.68;
    -webkit-font-smoothing: antialiased;
  }

  .luxe h1, .luxe h2, .luxe h3 {
    font-family: var(--lx-serif);
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
  }
  .luxe p, .luxe li { text-wrap: pretty; }
  .luxe .sinhala { font-family: var(--lx-sinhala); }
  .luxe :target { scroll-margin-top: 6rem; }
  .luxe a, .luxe button, .luxe input, .luxe select, .luxe textarea {
    -webkit-tap-highlight-color: rgba(92,107,86,.18);
  }
  .luxe :focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  /* ── Wordmark ── */
  .lx-wordmark {
    font-family: var(--lx-sans);
    font-size: 1.3rem;
    letter-spacing: .04em;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }
  .lx-wordmark strong { font-weight: 600; }
  .lx-wordmark em { font-family: var(--lx-serif); font-style: italic; color: var(--sage-deep); font-size: 1.15em; }

  /* ── Nav ── */
  .lx-nav {
    position: sticky;
    top: 0;
    z-index: 300;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1rem clamp(1.2rem, 5vw, 4rem);
    background: color-mix(in srgb, var(--cream) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--cream-deep);
  }
  .lx-nav-links { display: flex; gap: 1.6rem; margin-left: auto; }
  .lx-nav-links a {
    font-size: .86rem;
    font-weight: 500;
    letter-spacing: .075em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    transition: color .2s;
  }
  .lx-nav-links a:hover { color: var(--sage-deep); }
  .lx-nav-wa {
    font-size: .84rem;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--sage-deep);
    padding: .6rem 1.3rem;
    border-radius: 2px;
    text-decoration: none;
    transition: background .2s;
  }
  .lx-nav-wa:hover { background: var(--ink); }

  .lx-nav-burger { display: none; background: none; border: none; cursor: pointer; padding: .5rem; }
  .lx-nav-burger span { display: block; width: 24px; height: 2px; background: var(--ink); margin: 5px 0; transition: transform .25s; }
  .lx-nav-burger.is-open span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .lx-nav-burger.is-open span:last-child  { transform: translateY(-3.5px) rotate(-45deg); }

  .lx-mobile-menu[hidden] { display: none; }

  .lx-mobile-menu {
    position: sticky;
    top: 61px;
    z-index: 290;
    background: var(--cream);
    border-bottom: 1px solid var(--cream-deep);
    display: flex;
    flex-direction: column;
    padding: .6rem clamp(1.2rem, 5vw, 4rem) 1.2rem;
  }
  .lx-mobile-menu a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: .72rem 0;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: .025em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--cream-deep);
  }
  .lx-mobile-wa { color: var(--sage-deep) !important; font-weight: 500; border-bottom: none !important; }

  @media (max-width: 1120px) {
    .lx-nav-links, .lx-nav-wa { display: none; }
    .lx-nav-burger { display: block; margin-left: auto; }
  }

  /* ── Footer ── */
  .lx-footer {
    background: var(--ink);
    color: var(--cream);
    padding: 3.5rem clamp(1.2rem, 5vw, 4rem);
    margin-top: 5rem;
  }
  .lx-footer-inner { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.2rem; }
  .lx-wordmark--footer { color: var(--cream); }
  .lx-wordmark--footer em { color: var(--gold-soft); }
  .lx-footer-tag { font-size: .95rem; color: color-mix(in srgb, var(--cream) 82%, transparent); }
  .lx-footer-links { display: flex; gap: 1.4rem; flex-wrap: wrap; }
  .lx-footer-links a {
    font-size: .86rem; letter-spacing: .07em; text-transform: uppercase;
    color: color-mix(in srgb, var(--cream) 88%, transparent); text-decoration: none;
  }
  .lx-footer-links a:hover { color: var(--gold-soft); }
  .lx-footer-contact { font-size: .95rem; display: flex; gap: .6rem; color: color-mix(in srgb, var(--cream) 80%, transparent); }
  .lx-footer-contact a { color: var(--gold-soft); text-decoration: none; }
  .lx-footer-legal { display: flex; gap: 1rem; flex-wrap: wrap; padding-top: .7rem; border-top: 1px solid color-mix(in srgb, var(--cream) 15%, transparent); }
  .lx-footer-legal a { color: color-mix(in srgb, var(--cream) 76%, transparent); font-size: .82rem; text-decoration: none; }

  /* ── Shared primitives ── */
  .lx-eyebrow {
    font-size: .78rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--sage-deep);
  }
  .lx-btn-wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    background: var(--sage-deep);
    color: var(--cream);
    font-family: var(--lx-sans);
    font-size: .9rem;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .9rem 1.8rem;
    min-height: 48px;
    border-radius: 2px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background .2s;
  }
  .lx-btn-wa:hover { background: var(--ink); }
  .lx-btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--ink);
    font-size: .9rem;
    font-weight: 500;
    letter-spacing: .06em;
    text-transform: uppercase;
    padding: .9rem 1.8rem;
    min-height: 48px;
    border: 1px solid var(--sage);
    border-radius: 2px;
    text-decoration: none;
    transition: border-color .2s, color .2s;
  }
  .lx-btn-ghost:hover { border-color: var(--sage-deep); color: var(--sage-deep); }

  @media (max-width: 720px) {
    .luxe-body {
      font-size: 1.0625rem;
      line-height: 1.7;
    }
    .lx-nav { padding-block: .8rem; }
    .lx-wordmark { font-size: 1.35rem; }
    .lx-mobile-menu {
      top: 57px;
      max-height: calc(100dvh - 57px);
      overflow-y: auto;
      padding-bottom: calc(1rem + env(safe-area-inset-bottom));
    }
    .lx-footer { padding-top: 3rem; padding-bottom: calc(3rem + env(safe-area-inset-bottom)); }
    .lx-footer-links { gap: .25rem 1rem; }
    .lx-footer-links a {
      display: inline-flex;
      align-items: center;
      min-height: 42px;
    }
    .lx-btn-wa,
    .lx-btn-ghost {
      min-height: 50px;
      padding-inline: 1.2rem;
    }
    input,
    select,
    textarea {
      font-size: 16px !important;
    }
  }

  /* ── Scroll reveal ── */
  html.js .lxr { opacity: 0; transform: translateY(20px); transition: opacity .6s ease, transform .6s ease; }
  html.js .lxr.lxr-in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    html.luxe { scroll-behavior: auto; }
    html.js .lxr { opacity: 1; transform: none; transition: none; }
  }
</style>
