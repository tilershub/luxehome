---
import '../styles/global.css';
import SteamAmbience from '../components/SteamAmbience.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'LUXEHOME — Premium Tiling & Renovation Sri Lanka',
  description = 'Sri Lanka\'s premium bathroom renovation and floor tiling specialists. Complete home transformations across Colombo, Kandy, Galle & all Sri Lanka. Trusted by Sri Lankans worldwide.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f2" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <!-- Mark JS as active before body parses so .reveal elements are hidden only when JS runs -->
    <script>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="LUXEHOME" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/og-bathroom.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_LK" />
    <meta name="geo.region" content="LK" />
    <meta name="geo.placename" content="Sri Lanka" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-bathroom.jpg', Astro.site)} />

    <!-- LocalBusiness structured data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "HomeAndConstructionBusiness",
            "@id": "https://luxehome.lk/#business",
            "name": "LUXEHOME",
            "alternateName": ["Luxe Home Sri Lanka", "LuxeHome Renovations"],
            "description": "Sri Lanka's design-led renovation company for complete bathrooms, kitchens, staircases and floors, with documented specifications and managed construction.",
            "url": "https://luxehome.lk",
            "telephone": "+94774503744",
            "email": "luxehome@gmail.com",
            "logo": {
              "@type": "ImageObject",
              "url": "https://luxehome.lk/favicon.svg"
            },
            "image": "https://luxehome.lk/og-bathroom.jpg",
            "address": {
              "@type": "PostalAddress",
              "addressCountry": "LK",
              "addressRegion": "Western Province",
              "addressLocality": "Colombo"
            },
            "areaServed": [
              {"@type": "City", "name": "Colombo"},
              {"@type": "City", "name": "Kandy"},
              {"@type": "City", "name": "Galle"},
              {"@type": "City", "name": "Negombo"},
              {"@type": "City", "name": "Kurunegala"},
              {"@type": "City", "name": "Matara"},
              {"@type": "City", "name": "Jaffna"},
              {"@type": "Country", "name": "Sri Lanka"}
            ],
            "hasOfferCatalog": {
              "@type": "OfferCatalog",
              "name": "Complete Design Collections — Sri Lanka",
              "itemListElement": [
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Bathroom Designs",
                    "description": "Complete documented bathroom designs for new construction and renovation.",
                    "url": "https://luxehome.lk/bathroom-designs"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Floor Designs",
                    "description": "Material-led floor designs with carefully resolved layouts and transitions.",
                    "url": "https://luxehome.lk/floor-designs"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Staircase Designs",
                    "description": "Architectural staircase designs developed as part of the complete home.",
                    "url": "https://luxehome.lk/staircase-designs"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Kitchen Designs",
                    "description": "Complete kitchen designs covering cabinetry, surfaces, fixtures and workflow.",
                    "url": "https://luxehome.lk/kitchen-designs"
                  }
                }
              ]
            }
          }
        ]
      }
    </script>

    <!-- Meta Pixel — Lead event fired from ContactForm on submit.
         fbq stub + queue are available immediately so events never drop;
         the fbevents.js network fetch is deferred off the critical path. -->
    <script is:inline>
      (function (f, b) {
        var n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = [];
        fbq('init', '1904211696933513');
        fbq('track', 'PageView');
        function loadPixel() {
          if (f.__fbLoaded) return;
          f.__fbLoaded = true;
          var t = b.createElement('script'); t.async = !0;
          t.src = 'https://connect.facebook.net/en_US/fbevents.js';
          var s = b.getElementsByTagName('script')[0];
          s.parentNode.insertBefore(t, s);
        }
        var idle = f.requestIdleCallback || function (cb) { return setTimeout(cb, 1500); };
        f.addEventListener('load', function () { idle(loadPixel); });

        // Contact event on WhatsApp / phone link clicks (fbq stub queues if
        // the pixel script hasn't loaded yet, so no events are dropped)
        b.addEventListener('click', function (e) {
          var a = e.target && e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (href.indexOf('wa.me') !== -1 || href.indexOf('tel:') === 0) {
            fbq('track', 'Contact');
          }
        }, true);
      })(window, document);
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=1904211696933513&ev=PageView&noscript=1" />
    </noscript>
    <!-- End Meta Pixel -->

    <!-- Google Analytics — loaded after page is interactive, never blocks render -->
    <script>
      window.addEventListener('load', function () {
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-XKXFPFS3VN';
        s.async = true;
        document.head.appendChild(s);
        s.onload = function () {
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', 'G-XKXFPFS3VN');
        };
      });
    </script>
  </head>
  <body>
    <main id="main-content">
      <slot />
    </main>

    <SteamAmbience />

    <!-- Scroll-reveal: activates .reveal elements as they enter the viewport.
         Elements already visible on load are activated immediately (no delay)
         so the LCP element is never held at opacity:0. -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );

      document.querySelectorAll('.reveal').forEach((el) => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          // Already in viewport — make visible immediately, no JS delay
          el.classList.add('visible');
        } else {
          observer.observe(el);
        }
      });
    </script>
  </body>
</html>
