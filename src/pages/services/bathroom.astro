---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import SiteVisitCTA from '../../components/SiteVisitCTA.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Bathroom Renovation Sri Lanka — Packages from Rs. 1,120,000 | LUXEHOME"
  description="Complete bathroom renovation packages across Sri Lanka. Standard from Rs. 1,120,000, Premium from Rs. 1,330,000, Signature from Rs. 1,590,000 — tiles, bathware, waterproofing, plumbing, electrical & design included. Colombo, Kandy, Galle & all Sri Lanka."
>
  <Nav />

  <section class="page-hero" style="--hero-bg: url('https://images.pexels.com/photos/16249146/pexels-photo-16249146.jpeg?auto=compress&cs=tinysrgb&w=1400&fit=crop')">
    <div class="hero-inner">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <a href="/#shop">Services</a>
        <span>›</span>
        <span>Bathroom</span>
      </div>
      <h1 class="reveal">Bathroom Renovation</h1>
      <p class="hero-desc reveal">
        Full scope renovation — from structural preparation to handover. Three carefully crafted packages,
        each covering tiles, bathware, waterproofing, plumbing, electrical, ceiling, vanity, and design.
      </p>
      <div class="hero-cta reveal">
        <a href="/contact" class="btn-primary">Book a Site Visit</a>
        <a href="tel:+94774503744" class="btn-ghost">0774 503 744</a>
      </div>
    </div>
  </section>

  <!-- Packages -->
  <section class="pricing-section">
    <div class="pricing-inner">
      <div class="stag reveal">Packages</div>
      <h2 class="reveal">Three Packages. Complete Scope. Every One.</h2>
      <p class="sdesc reveal">
        Each package covers the complete bathroom — tiles, waterproofing, bathware, plumbing,
        electrical, ceiling, vanity, and design. Starting prices are based on a 4&nbsp;sqm bathroom.
        Enter your dimensions to see the price for your size.
      </p>

      <!-- Area calculator -->
      <div class="area-input-row reveal">
        <label class="area-label">Bathroom Size</label>
        <div class="area-fields">
          <div class="area-field">
            <input type="number" id="bathLength" class="area-input" min="0.1" max="999"
              placeholder="Length" inputmode="decimal" aria-label="Bathroom length in feet" />
            <span class="area-unit">ft</span>
          </div>
          <span class="area-multiply">×</span>
          <div class="area-field">
            <input type="number" id="bathWidth" class="area-input" min="0.1" max="999"
              placeholder="Width" inputmode="decimal" aria-label="Bathroom width in feet" />
            <span class="area-unit">ft</span>
          </div>
        </div>
        <span class="area-hint" id="areaHint"></span>
      </div>

      <div class="pkg-grid reveal">

        <!-- Standard -->
        <div class="pkg-card" data-pkg="standard" data-base="1120000" data-rate="105000">
          <div class="pkg-name">Standard Bathroom</div>
          <div class="pkg-desc">Modern, fully-functional bathroom with quality materials and complete scope</div>
          <div class="pkg-from-label" id="from-standard">Total Investment From</div>
          <div class="pkg-price" id="price-standard">Rs.&nbsp;1,120,000</div>
          <div class="pkg-price-note" id="note-standard">base price — 4 sqm</div>
          <ul class="pkg-features">
            <li><span class="feat-tick">✓</span>Rocell 300×600 mm floor &amp; wall tiles</li>
            <li><span class="feat-tick">✓</span>Swisstek Blue C2+ tile adhesive</li>
            <li><span class="feat-tick">✓</span>Swisstek grout</li>
            <li><span class="feat-tick">✓</span>Tokyo Super 2K waterproofing</li>
            <li><span class="feat-tick">✓</span>Slon pipes &amp; accessories</li>
            <li><span class="feat-tick">✓</span>ACL cables &amp; switches</li>
            <li><span class="feat-tick">✓</span>Swiss bathware</li>
            <li><span class="feat-tick">✓</span>Ferroli instant water heater</li>
            <li><span class="feat-tick">✓</span>IPanel ceiling</li>
            <li><span class="feat-tick">✓</span>Standard vanity</li>
            <li><span class="feat-tick">✓</span>Standard mirror</li>
            <li><span class="feat-tick">✓</span>Standard shower cubicle / glass partition</li>
            <li><span class="feat-tick">✓</span>Wall niche</li>
            <li><span class="feat-tick">✓</span>Bathroom design &amp; planning</li>
            <li><span class="feat-tick">✓</span>Plumbing works</li>
            <li><span class="feat-tick">✓</span>Electrical wiring works</li>
            <li><span class="feat-tick">✓</span>Tiling &amp; grouting</li>
            <li><span class="feat-tick">✓</span>Cleaning &amp; handover</li>
          </ul>
          <div class="pkg-ctas">
            <a href="/contact" class="pkg-btn pkg-btn--primary">Request a Quote</a>
            <a href="/contact" class="pkg-btn pkg-btn--ghost">Book a Site Visit</a>
            <a href="https://wa.me/94774503744" class="pkg-btn pkg-btn--wa" target="_blank" rel="noopener noreferrer">WhatsApp Us</a>
          </div>
        </div>

        <!-- Premium -->
        <div class="pkg-card pkg-card--mid" data-pkg="premium" data-base="1330000" data-rate="125000">
          <div class="pkg-badge">Most Popular</div>
          <div class="pkg-name">Premium Bathroom</div>
          <div class="pkg-desc">Elevated design with larger-format tiles and premium bathware range</div>
          <div class="pkg-from-label" id="from-premium">Total Investment From</div>
          <div class="pkg-price" id="price-premium">Rs.&nbsp;1,330,000</div>
          <div class="pkg-price-note" id="note-premium">base price — 4 sqm</div>
          <ul class="pkg-features">
            <li><span class="feat-tick">✓</span>Rocell 450×900 mm floor &amp; wall tiles</li>
            <li><span class="feat-tick">✓</span>Swisstek Blue C2+ tile adhesive</li>
            <li><span class="feat-tick">✓</span>Swisstek grout</li>
            <li><span class="feat-tick">✓</span>Tokyo Super 2K waterproofing</li>
            <li><span class="feat-tick">✓</span>Slon pipes &amp; accessories</li>
            <li><span class="feat-tick">✓</span>ACL cables &amp; switches</li>
            <li><span class="feat-tick">✓</span>Swiss premium bathware range</li>
            <li><span class="feat-tick">✓</span>Ferroli water heater</li>
            <li><span class="feat-tick">✓</span>IPanel ceiling</li>
            <li><span class="feat-tick">✓</span>Premium vanity</li>
            <li><span class="feat-tick">✓</span>Premium mirror</li>
            <li><span class="feat-tick">✓</span>Premium shower cubicle / glass partition</li>
            <li><span class="feat-tick">✓</span>Wall niche</li>
            <li><span class="feat-tick">✓</span>Bathroom design &amp; planning</li>
            <li><span class="feat-tick">✓</span>Plumbing works</li>
            <li><span class="feat-tick">✓</span>Electrical wiring works</li>
            <li><span class="feat-tick">✓</span>Tiling &amp; grouting</li>
            <li><span class="feat-tick">✓</span>Cleaning &amp; handover</li>
          </ul>
          <div class="pkg-ctas">
            <a href="/contact" class="pkg-btn pkg-btn--primary">Request a Quote</a>
            <a href="/contact" class="pkg-btn pkg-btn--ghost">Book a Site Visit</a>
            <a href="https://wa.me/94774503744" class="pkg-btn pkg-btn--wa" target="_blank" rel="noopener noreferrer">WhatsApp Us</a>
          </div>
        </div>

        <!-- Signature -->
        <div class="pkg-card pkg-card--sig" data-pkg="signature" data-base="1590000" data-rate="155000">
          <div class="pkg-badge pkg-badge--sig">Flagship</div>
          <div class="pkg-name">Signature Bathroom</div>
          <div class="pkg-desc">Luxury hotel-grade bathroom with concealed bathware and the finest finishes</div>
          <div class="pkg-from-label" id="from-signature">Total Investment From</div>
          <div class="pkg-price pkg-price--sig" id="price-signature">Rs.&nbsp;1,590,000</div>
          <div class="pkg-price-note" id="note-signature">base price — 4 sqm</div>
          <ul class="pkg-features">
            <li><span class="feat-tick feat-tick--sig">✓</span>Rocell 600×1200 mm floor &amp; wall tiles</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Swisstek Blue C2+ tile adhesive</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Swisstek grout</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Tokyo Super 2K waterproofing</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Slon pipes &amp; accessories</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>ACL cables &amp; switches</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Swiss Premium Concealed Bathware &amp; Taps</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Ferroli water heater</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>IPanel ceiling</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Signature vanity</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Signature mirror</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Premium shower cubicle / glass partition</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Wall niche</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Bathroom design &amp; planning</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Plumbing works</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Electrical wiring works</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Tiling &amp; grouting</li>
            <li><span class="feat-tick feat-tick--sig">✓</span>Cleaning &amp; handover</li>
          </ul>
          <div class="pkg-ctas">
            <a href="/contact" class="pkg-btn pkg-btn--primary pkg-btn--sig-primary">Request a Quote</a>
            <a href="/contact" class="pkg-btn pkg-btn--ghost">Book a Site Visit</a>
            <a href="https://wa.me/94774503744" class="pkg-btn pkg-btn--wa" target="_blank" rel="noopener noreferrer">WhatsApp Us</a>
          </div>
        </div>

      </div>

      <!-- Renovation add-on -->
      <div class="addons-section reveal">
        <div class="addons-head">Renovation Preparation — Optional Add-on</div>
        <div class="addon-card" id="addon-renov">
          <button class="addon-toggle" id="renov-toggle" aria-pressed="false">+ Add</button>
          <div class="addon-name">Existing Bathroom — Demolition &amp; Plastering</div>
          <div class="addon-price" id="renov-price">Rs.&nbsp;80,000</div>
          <div class="addon-desc">For existing bathrooms requiring demolition, debris removal, and surface preparation before new works begin. Price is based on bathroom size and updates when you enter dimensions above.</div>
        </div>
      </div>

      <!-- Door / Window / Pump Combos -->
      <div class="combos-section reveal">
        <div class="combos-head">Optional Door, Window &amp; Pressure Pump Combos</div>
        <p class="combos-note">Starting prices do not include door, window, or pressure pump. Add a combo to your package at a discounted bundle rate.</p>
        <div class="combos-grid">
          <div class="combo-card" data-combo-key="premium" data-combo-price="154000">
            <div class="combo-name">Premium Combo</div>
            <ul class="combo-items">
              <li>Swisstek aluminum door</li>
              <li>Aluminum window</li>
              <li>Pressure pump</li>
            </ul>
            <div class="combo-price">Rs.&nbsp;154,000</div>
          </div>
          <div class="combo-card combo-card--sig" data-combo-key="signature" data-combo-price="176000">
            <div class="combo-badge">Signature</div>
            <div class="combo-name">Signature Combo</div>
            <ul class="combo-items">
              <li>Wood door</li>
              <li>Wood window</li>
              <li>Pressure pump</li>
            </ul>
            <div class="combo-price">Rs.&nbsp;176,000</div>
          </div>
        </div>
      </div>

      <!-- Renovation note -->
      <div class="renov-callout reveal">
        <strong>Renovation Works</strong>
        <p>Renovation works are quoted separately depending on the existing bathroom condition. Renovation may include demolition, debris removal, plastering, and surface preparation.</p>
      </div>

      <!-- Important Notes -->
      <div class="notes-box reveal">
        <strong>Important Notes</strong>
        <ol class="notes-list">
          <li>Starting prices are based on a 4 sqm bathroom.</li>
          <li>Larger bathroom sizes will increase the final quotation.</li>
          <li>Final price may vary based on site condition, design complexity, renovation requirements, and selected add-ons.</li>
          <li>Outside plumbing, structural changes, and major layout changes are quoted separately if required.</li>
          <li>1 year workmanship warranty included.</li>
        </ol>
      </div>

      <!-- Estimate panel -->
      <div class="estimate-panel" id="estimate-panel" hidden>
        <div class="est-head">Your Estimate</div>
        <div class="est-items" id="est-items"></div>
        <hr class="est-divider" />
        <div class="est-total-row">
          <span class="est-total-label">Estimated Total</span>
          <span class="est-total-val" id="est-total"></span>
        </div>
        <p class="est-note">Final price confirmed after site inspection. This estimate covers selected scope only.</p>
        <div class="est-actions">
          <a href="/contact" class="pkg-btn pkg-btn--primary est-contact-btn">Request a Quote</a>
          <a id="est-wa-btn" href="https://wa.me/94774503744" class="pkg-btn pkg-btn--wa" target="_blank" rel="noopener noreferrer">Send via WhatsApp</a>
        </div>
      </div>

    </div>
  </section>

  <section id="recent-projects" class="recent-proj-section">
    <div class="recent-proj-inner">
      <div class="stag">Our Work</div>
      <h2>Recent Bathroom Projects</h2>
      <div id="proj-grid" class="mini-proj-row"></div>
      <a href="/projects?category=bathroom" class="view-all-link">View All Bathroom Projects →</a>
    </div>
  </section>

  <script>
    import { createClient } from '@supabase/supabase-js';
    const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL;
    const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    if (SB_URL && SB_KEY) {
      const sb = createClient(SB_URL, SB_KEY);
      (async () => {
        const { data } = await sb.from('projects')
          .select('slug,title,cover_image,location')
          .eq('category', 'bathroom')
          .in('status', ['published', 'featured'])
          .order('completion_year', { ascending: false })
          .limit(3);
        if (!data?.length) return;
        const section = document.getElementById('recent-projects');
        const grid = document.getElementById('proj-grid');
        if (!section || !grid) return;
        grid.innerHTML = data.map(p => `
          <a href="/projects/${p.slug}" class="mini-card">
            <div class="mini-img">${p.cover_image ? `<img src="${p.cover_image}" alt="${p.title}" loading="lazy">` : ''}</div>
            <div class="mini-body">
              <div class="mini-title">${p.title}</div>
              ${p.location ? `<div class="mini-loc">${p.location}</div>` : ''}
            </div>
          </a>
        `).join('');
        section.style.display = '';
      })();
    }
  </script>

  <SiteVisitCTA service="bathroom renovation" />
  <Footer />
</Layout>

<script is:inline>
(function () {
  var SQM_PER_SQFT = 0.0929;
  var BASE_SQM     = 4;
  var RENOV_RATE   = 20000;

  var state = {
    selectedPkg:   null,
    renovSelected: false,
    renovPrice:    BASE_SQM * RENOV_RATE,
    selectedCombo: null
  };

  var lengthInput = document.getElementById('bathLength');
  var widthInput  = document.getElementById('bathWidth');
  var panel       = document.getElementById('estimate-panel');

  function fmtRs(n) {
    return 'Rs. ' + Math.round(n).toLocaleString('en-US');
  }

  function getSqm() {
    var l = parseFloat(lengthInput.value) || 0;
    var w = parseFloat(widthInput.value)  || 0;
    if (l <= 0 || w <= 0) return 0;
    return parseFloat((l * w * SQM_PER_SQFT).toFixed(3));
  }

  function getCardPrice(card, sqm) {
    var base = parseInt(card.dataset.base, 10);
    var rate = parseInt(card.dataset.rate, 10);
    return base + Math.max(0, sqm - BASE_SQM) * rate;
  }

  function getPkgLabel(pkg) {
    var names = { standard: 'Standard', premium: 'Premium', signature: 'Signature' };
    return (names[pkg] || pkg) + ' Bathroom Package';
  }

  function updateAll() {
    var sqm  = getSqm();
    var sqft = parseFloat((sqm / SQM_PER_SQFT).toFixed(1));
    var hint = document.getElementById('areaHint');

    if (hint) {
      hint.textContent = sqm > 0 ? 'Floor area: ' + sqft.toFixed(1) + ' sq.ft (' + sqm.toFixed(2) + ' sqm)' : '';
    }

    document.querySelectorAll('[data-pkg]').forEach(function (card) {
      var effSqm  = sqm > 0 ? sqm : BASE_SQM;
      var price   = getCardPrice(card, effSqm);
      var pkg     = card.dataset.pkg;
      var priceEl = document.getElementById('price-' + pkg);
      var noteEl  = document.getElementById('note-'  + pkg);
      var fromEl  = document.getElementById('from-'  + pkg);

      if (priceEl) priceEl.textContent = fmtRs(price);
      if (noteEl) {
        noteEl.textContent = sqm > 0
          ? 'for ' + sqm.toFixed(2) + ' sqm (' + sqft.toFixed(1) + ' sq.ft)'
          : 'base price — 4 sqm';
      }
      if (fromEl) fromEl.textContent = sqm > 0 ? 'Total Investment' : 'Total Investment From';

      if (state.selectedPkg && state.selectedPkg.pkg === pkg) {
        state.selectedPkg.price = price;
      }
    });

    var renovSqm = sqm > 0 ? sqm : BASE_SQM;
    state.renovPrice = renovSqm * RENOV_RATE;
    var renovEl = document.getElementById('renov-price');
    if (renovEl) renovEl.textContent = fmtRs(state.renovPrice);

    updateEstimate();
  }

  function updateEstimate() {
    if (!panel) return;
    if (!state.selectedPkg) { panel.hidden = true; return; }
    panel.hidden = false;

    var items = [{ label: state.selectedPkg.name, price: state.selectedPkg.price }];
    if (state.renovSelected) {
      items.push({ label: 'Renovation — Demo &amp; Plastering', price: state.renovPrice });
    }
    if (state.selectedCombo) {
      items.push({ label: state.selectedCombo.name + ' Combo', price: state.selectedCombo.price });
    }

    var total   = items.reduce(function (s, i) { return s + i.price; }, 0);
    var itemsEl = document.getElementById('est-items');
    if (itemsEl) {
      itemsEl.innerHTML = items.map(function (i) {
        return '<div class="est-item">'
          + '<span class="est-item-label">' + i.label + '</span>'
          + '<span class="est-item-price">' + fmtRs(i.price) + '</span>'
          + '</div>';
      }).join('');
    }

    var totalEl = document.getElementById('est-total');
    if (totalEl) totalEl.textContent = fmtRs(total);

    var waBtn = document.getElementById('est-wa-btn');
    if (waBtn) {
      var msg = 'Hi, I\'m interested in a bathroom renovation:\n\n';
      items.forEach(function (i) {
        msg += '• ' + i.label.replace(/&amp;/g, '&') + ' — ' + fmtRs(i.price) + '\n';
      });
      msg += '\nEstimated Total: ' + fmtRs(total) + '\n\nPlease get in touch.';
      waBtn.href = 'https://wa.me/94774503744?text=' + encodeURIComponent(msg);
    }

    if (panel.dataset.shown !== '1') {
      panel.dataset.shown = '1';
      setTimeout(function () { panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }, 80);
    }
  }

  // Package card click
  document.querySelectorAll('[data-pkg]').forEach(function (card) {
    card.style.cursor = 'pointer';
    card.addEventListener('click', function (e) {
      if (e.target.closest('a, button')) return;
      var wasSelected = card.classList.contains('pkg-card--selected');
      document.querySelectorAll('[data-pkg]').forEach(function (c) {
        c.classList.remove('pkg-card--selected');
      });
      if (wasSelected) {
        state.selectedPkg = null;
        if (panel) panel.dataset.shown = '';
      } else {
        card.classList.add('pkg-card--selected');
        var effSqm = getSqm();
        effSqm = effSqm > 0 ? effSqm : BASE_SQM;
        state.selectedPkg = {
          pkg:   card.dataset.pkg,
          name:  getPkgLabel(card.dataset.pkg),
          price: getCardPrice(card, effSqm)
        };
      }
      updateEstimate();
    });
  });

  // Renovation toggle
  var renovToggle = document.getElementById('renov-toggle');
  var renovCard   = document.getElementById('addon-renov');
  if (renovToggle) {
    renovToggle.addEventListener('click', function () {
      state.renovSelected = !state.renovSelected;
      renovToggle.textContent = state.renovSelected ? '✓ Added' : '+ Add';
      renovToggle.setAttribute('aria-pressed', state.renovSelected ? 'true' : 'false');
      renovToggle.classList.toggle('is-selected', state.renovSelected);
      if (renovCard) renovCard.classList.toggle('addon-card--selected', state.renovSelected);
      updateEstimate();
    });
  }

  // Combo card click
  document.querySelectorAll('[data-combo-key]').forEach(function (card) {
    card.style.cursor = 'pointer';
    card.addEventListener('click', function () {
      var key         = card.dataset.comboKey;
      var price       = parseInt(card.dataset.comboPrice, 10);
      var label       = key.charAt(0).toUpperCase() + key.slice(1);
      var wasSelected = card.classList.contains('combo-card--selected');
      document.querySelectorAll('[data-combo-key]').forEach(function (c) {
        c.classList.remove('combo-card--selected');
      });
      if (wasSelected) {
        state.selectedCombo = null;
      } else {
        card.classList.add('combo-card--selected');
        state.selectedCombo = { name: label, price: price };
      }
      updateEstimate();
    });
  });

  if (lengthInput) lengthInput.addEventListener('input', updateAll);
  if (widthInput)  widthInput.addEventListener('input',  updateAll);
})();
</script>

<style>
  /* ── Hero ── */

  .page-hero {
    min-height: 52vh;
    display: flex;
    align-items: flex-end;
    padding: 0 4rem 4rem;
    position: relative;
    background-image: var(--hero-bg);
    background-size: cover;
    background-position: center;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(30,26,23,.75) 0%, rgba(30,26,23,.45) 60%, rgba(30,26,23,.75) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 700px;
    padding-top: 7rem;
  }

  .breadcrumb {
    display: flex;
    gap: .4rem;
    align-items: center;
    font-size: .72rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: rgba(240,236,224,.80);
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }
  .breadcrumb a { color: rgba(240,236,224,.80); text-decoration: none; transition: color .2s; }
  .breadcrumb a:hover { color: var(--clay); }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 700;
    color: var(--cream);
    line-height: 1.1;
    margin-bottom: 1.1rem;
  }

  .hero-desc {
    font-size: 1rem;
    color: rgba(240,236,224,.93);
    line-height: 1.72;
    max-width: 55ch;
    margin-bottom: 1.8rem;
  }

  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; }

  .btn-primary {
    display: inline-flex;
