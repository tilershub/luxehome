---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro'; import SpaceDesigns from '../components/luxe/SpaceDesigns.astro'; import { getDesigns } from '../lib/luxe';
const designs = await getDesigns({ spaceSlug: 'staircases' });
---
<LuxeLayout
  ogImage="/spaces/staircase.webp"
  ogImageAlt="LUXEhome staircase designs" title="Sri Lankan Highland Staircase Designs — LUXEhome"><SpaceDesigns space="staircases" designs={designs} /></LuxeLayout>
