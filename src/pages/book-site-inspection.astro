---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro';
import InspectionBookingForm from '../components/luxe/InspectionBookingForm.astro';
import { PROJECT_CONSULTATION, PROJECT_INITIATION } from '../lib/luxe-config';
import { PROJECT_INITIATION_FAQ } from '../lib/luxe-pages';

const proposalPrice = PROJECT_INITIATION.amount.toLocaleString('en-LK');

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PROJECT_INITIATION_FAQ.map((item) => ({
    '@type': 'Question',
    name: item.title,
    acceptedAnswer: { '@type': 'Answer', text: item.copy },
  })),
});
---

<LuxeLayout
  title="Complimentary Bathroom Project Consultation | LUXEhome Sri Lanka"
  description="Apply for a complimentary LUXEhome bathroom consultation. Approved complete projects include one site assessment; the optional proposal is LKR 50,000."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={faqSchema}></script>
  </Fragment>

  <section class="inspection-hero">
    <div class="inspection-hero-copy lxr">
      <p class="lx-eyebrow">Complimentary project consultation</p>
      <h1>Tell us about one bathroom.<br /><em>Let’s see if we are a fit.</em></h1>
      <p>
        There is no payment to apply. We review the location, project type, timing and
        investment range first. Suitable complete-bathroom projects receive one detailed site assessment as part of the consultation.
      </p>
      <div class="inspection-price">
        <span>Approved project consultation</span>
        <strong>{PROJECT_CONSULTATION.price}</strong>
        <small>The LKR {proposalPrice} detailed proposal is commissioned only after the consultation.</small>
      </div>
    </div>
    <div class="inspection-promise lxr">
      <strong>You do not need drawings or measurements</strong>
      <p>Share photographs and what you know. During an approved site assessment, we document the room, services, drainage, access and design context properly.</p>
    </div>
  </section>

  <section class="inspection-process" aria-labelledby="inspection-process-title">
    <div class="inspection-section-heading lxr">
      <p class="lx-eyebrow">How it works</p>
      <h2 id="inspection-process-title">A useful first step—without a hidden charge.</h2>
    </div>
    <div class="inspection-steps">
      <article class="lxr">
        <span>01</span>
        <h3>Apply</h3>
        <p>Share your location, project type, timing, budget direction and preferred design or inspiration.</p>
      </article>
      <article class="lxr">
        <span>02</span>
        <h3>Suitability review</h3>
        <p>We confirm whether the scope, location, timing and realistic investment fit our complete-project service.</p>
      </article>
      <article class="lxr">
        <span>03</span>
        <h3>Consult &amp; assess</h3>
        <p>For an approved project, we discuss the brief and complete one detailed site assessment at no consultation fee.</p>
      </article>
      <article class="lxr">
        <span>04</span>
        <h3>Commission the proposal</h3>
        <p>If you want LUXEhome to resolve the project, commission the detailed proposal for LKR {proposalPrice}.</p>
      </article>
      <article class="lxr">
        <span>05</span>
        <h3>Review the complete picture</h3>
        <p>Receive the design, materials, named brands, scope, timeline, warranties and final quotation together.</p>
      </article>
    </div>
    <p class="inspection-process-note lxr">No payment is required for the application or approved consultation. The paid proposal is delivered within seven working days after payment and the completed site consultation.</p>
  </section>

  <section class="inspection-booking">
    <div class="inspection-includes lxr">
      <p class="lx-eyebrow">What the consultation studies</p>
      <h2>More than the length and width of a room.</h2>
      <ul>
        {PROJECT_CONSULTATION.includes.map((item) => <li>{item}</li>)}
      </ul>
      <div class="inspection-note">
        <strong>Reserved for suitable complete projects</strong>
        <p>{PROJECT_CONSULTATION.qualification} A submitted application is not an automatically confirmed site appointment.</p>
      </div>
    </div>
    <InspectionBookingForm />
  </section>

  <section class="inspection-next" aria-labelledby="inspection-next-title">
    <div class="inspection-section-heading lxr">
      <p class="lx-eyebrow">After the proposal</p>
      <h2 id="inspection-next-title">Pay for the thinking—not for the first conversation.</h2>
    </div>
    <div class="inspection-next-grid">
      <article class="lxr">
        <span>The detailed proposal · LKR {proposalPrice}</span>
        <h3>A complete decision file</h3>
        <p>Five 3D presentation images, a walkthrough, selected fixtures and materials, named brands, construction scope, final quotation, timeline, payment plan and applicable warranties.</p>
      </article>
      <article class="lxr">
        <span>If LUXEhome builds</span>
        <h3>100% construction credit</h3>
        <p>The full LKR {proposalPrice} becomes an advance against the related bathroom construction price—not an extra fee on top of the contract.</p>
        <small>If you do not proceed, you still keep the completed proposal and the fee covers that professional design, selection, costing and documentation work.</small>
      </article>
    </div>
  </section>

  <section class="inspection-faq" aria-labelledby="inspection-faq-title">
    <div class="inspection-section-heading lxr">
      <p class="lx-eyebrow">Questions before you start</p>
      <h2 id="inspection-faq-title">Clear answers, before you apply.</h2>
      <p>These are the same consultation and proposal terms our team will explain during the suitability review.</p>
    </div>
    <div class="inspection-faq-grid">
      {PROJECT_INITIATION_FAQ.map((item, index) => (
        <details class="lxr" open={index === 0}>
          <summary>{item.title}</summary>
          <p>{item.copy}</p>
        </details>
      ))}
    </div>
  </section>
</LuxeLayout>

<style>
  .inspection-hero,
  .inspection-process,
  .inspection-booking,
  .inspection-next,
  .inspection-faq { width: min(1120px, calc(100% - 34px)); margin-inline: auto; }

  .inspection-hero {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(2.5rem, 6vw, 4.5rem);
  }
  .inspection-hero h1 { max-width: 850px; margin: .65rem 0 1rem; font-size: clamp(3.3rem, 7.5vw, 5.7rem); }
  .inspection-hero h1 em { color: var(--sage-deep); }
  .inspection-hero-copy > p:not(.lx-eyebrow) { max-width: 62ch; font: 500 clamp(1.08rem, 2.3vw, 1.28rem)/1.5 var(--lx-serif); }
  .inspection-price { width: min(100%, 470px); margin-top: 1.5rem; padding: 1.1rem 1.2rem; border-left: 3px solid var(--gold); background: #fff; }
  .inspection-price span,
  .inspection-price strong,
  .inspection-price small { display: block; }
  .inspection-price span { color: var(--sage-deep); font-size: .78rem; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; }
  .inspection-price strong { margin: .18rem 0; font: 600 2rem var(--lx-serif); }
  .inspection-price small { color: color-mix(in srgb, var(--ink) 72%, transparent); font-size: .84rem; }
  .inspection-promise { padding: clamp(1.4rem, 4vw, 2.2rem); border-radius: 14px; background: var(--sage-deep); color: var(--cream); }
  .inspection-promise strong { display: block; color: var(--gold-soft); font: 600 clamp(1.7rem, 4vw, 2.3rem)/1.05 var(--lx-serif); }
  .inspection-promise p { margin-top: .7rem; color: rgba(247,243,235,.88); font-size: .96rem; }

  .inspection-process,
  .inspection-next { padding: clamp(2.8rem, 6vw, 4.7rem) 0; border-top: 1px solid rgba(43,50,42,.12); }
  .inspection-section-heading { margin-bottom: 1.4rem; }
  .inspection-section-heading h2 { margin-top: .3rem; font-size: clamp(2.2rem, 5vw, 3.5rem); }
  .inspection-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .8rem; }
  .inspection-steps article { padding: 1.2rem; border-top: 2px solid var(--sage); background: rgba(255,255,255,.65); }
  .inspection-steps span { color: var(--gold); font: 600 1rem var(--lx-serif); }
  .inspection-steps h3 { margin: .55rem 0 .4rem; font-size: 1.25rem; }
  .inspection-steps p { color: color-mix(in srgb, var(--ink) 84%, transparent); font-size: .96rem; line-height: 1.65; }

  .inspection-booking {
    display: grid;
    grid-template-columns: .78fr 1.22fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
    padding: clamp(2.8rem, 7vw, 5rem) 0;
  }
  .inspection-includes { position: sticky; top: 7rem; }
  .inspection-includes h2 { margin: .35rem 0 1rem; font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .inspection-includes ul { display: grid; gap: .65rem; margin: 0; padding: 0; list-style: none; }
  .inspection-includes li { position: relative; padding-left: 1.35rem; color: color-mix(in srgb, var(--ink) 88%, transparent); font-size: .98rem; }
  .inspection-includes li::before { content: '✓'; position: absolute; left: 0; color: var(--gold); font-weight: 600; }
  .inspection-note { margin-top: 1.4rem; padding: 1rem; border: 1px solid var(--cream-deep); border-radius: 8px; background: #fff; }
  .inspection-note strong { color: var(--sage-deep); font-size: .82rem; letter-spacing: .08em; text-transform: uppercase; }
  .inspection-note p { margin-top: .25rem; color: color-mix(in srgb, var(--ink) 78%, transparent); font-size: .9rem; }

  .inspection-next { padding-bottom: 5rem; }
  .inspection-next-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .inspection-next-grid article { padding: clamp(1.4rem, 4vw, 2rem); border-radius: 12px; background: #fff; border: 1px solid var(--cream-deep); }
  .inspection-next-grid article:last-child { background: var(--sage-mist); }
  .inspection-next-grid span { color: var(--gold); font-size: .78rem; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; }
  .inspection-next-grid h3 { margin: .45rem 0 .6rem; font-size: 1.8rem; }
  .inspection-next-grid p { color: color-mix(in srgb, var(--ink) 84%, transparent); font-size: .96rem; }
  .inspection-next-grid small { display: block; margin-top: .8rem; color: color-mix(in srgb, var(--ink) 70%, transparent); font-size: .82rem; }

  .inspection-faq { padding: clamp(2.8rem, 6vw, 5rem) 0 5rem; border-top: 1px solid rgba(43,50,42,.12); }
  .inspection-faq .inspection-section-heading > p:last-child { max-width: 66ch; margin-top: .65rem; color: color-mix(in srgb, var(--ink) 76%, transparent); }
  .inspection-faq-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; align-items: start; }
  .inspection-faq details { overflow: hidden; border: 1px solid var(--cream-deep); border-radius: 10px; background: #fff; }
  .inspection-faq summary { position: relative; padding: 1.15rem 3rem 1.15rem 1.2rem; cursor: pointer; list-style: none; color: var(--ink); font: 600 1.03rem/1.4 var(--lx-serif); }
  .inspection-faq summary::-webkit-details-marker { display: none; }
  .inspection-faq summary::after { content: '+'; position: absolute; right: 1.2rem; top: 50%; translate: 0 -50%; color: var(--gold); font: 500 1.4rem/1 var(--lx-sans); }
  .inspection-faq details[open] summary::after { content: '−'; }
  .inspection-faq details p { margin: 0; padding: 0 1.2rem 1.2rem; color: color-mix(in srgb, var(--ink) 82%, transparent); font-size: .94rem; line-height: 1.65; }

  @media (max-width: 880px) {
    .inspection-hero,
    .inspection-booking { grid-template-columns: 1fr; }
    .inspection-promise { width: min(100%, 620px); }
    .inspection-steps { grid-template-columns: repeat(2, 1fr); }
    .inspection-includes { position: static; }
  }
  @media (max-width: 600px) {
    .inspection-hero { padding-top: 2.8rem; }
    .inspection-steps,
    .inspection-next-grid,
    .inspection-faq-grid { grid-template-columns: 1fr; }
  }
</style>
