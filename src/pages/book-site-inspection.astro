---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro';
import InspectionBookingForm from '../components/luxe/InspectionBookingForm.astro';
import { PROJECT_INITIATION } from '../lib/luxe-config';
import { PROJECT_INITIATION_FAQ } from '../lib/luxe-pages';
---
<LuxeLayout title="Discuss Your Bathroom Renovation | BathSpace by LUXEhome" description="Start with a free conversation about your premium bathroom renovation in Sri Lanka. Our LKR 30,000 per-bathroom package includes a site visit, layout, 3D images, walkthrough and detailed quotation.">
  <section class="enquiry-intro"><p class="lx-eyebrow">Your bathroom starts here</p><h1>Let’s plan your bathroom renovation.</h1><p>Tell us about the bathroom you would like to transform. Whether you live in Sri Lanka or overseas, your first conversation is free. You do not need drawings or measurements to enquire.</p></section>
  <section class="enquiry-form"><InspectionBookingForm /></section>
  <section class="enquiry-package"><p class="lx-eyebrow">One package · one bathroom</p><h2>Site visit, design &amp; quotation · LKR {PROJECT_INITIATION.amount.toLocaleString('en-LK')}</h2><ul>{PROJECT_INITIATION.includes.map(item=><li>{item}</li>)}</ul><p>{PROJECT_INITIATION.credit}</p><p>{PROJECT_INITIATION.delivery}</p></section>
  <section class="enquiry-faq"><h2>Questions before you start</h2>{PROJECT_INITIATION_FAQ.map(item=><details><summary>{item.title}</summary><p>{item.copy}</p></details>)}</section>
</LuxeLayout>
<style>
.enquiry-intro,.enquiry-form,.enquiry-package,.enquiry-faq{width:min(780px,calc(100% - 32px));margin-inline:auto}.enquiry-intro{padding:2rem 0 1.3rem}.enquiry-intro h1{font-size:clamp(2.4rem,6vw,3.7rem);line-height:1.1;margin:.5rem 0 .8rem}.enquiry-intro>p:last-child{max-width:65ch;color:var(--sage-deep)}.enquiry-package,.enquiry-faq{padding:2rem 0}.enquiry-package h2,.enquiry-faq h2{font-size:clamp(1.8rem,4vw,2.5rem);margin:.5rem 0 1rem}.enquiry-package ul{padding-left:1.3rem;line-height:1.9}.enquiry-package p{margin:.8rem 0}.enquiry-faq details{border-bottom:1px solid var(--cream-deep);padding:1rem 0}.enquiry-faq summary{cursor:pointer;font-weight:600;min-height:32px}.enquiry-faq details p{padding-top:.8rem;line-height:1.7}.enquiry-faq{padding-bottom:4rem}
</style>
