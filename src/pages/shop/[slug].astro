---
export const prerender = false;
import LuxeLayout from '../../layouts/LuxeLayout.astro'; import { getProductBySlug } from '../../lib/luxe'; import { waLink } from '../../lib/luxe-config';
const slug=Astro.params.slug||''; const stored=await getProductBySlug(slug);
const fallback:any={slug,name:slug.split('-').map(s=>s[0]?.toUpperCase()+s.slice(1)).join(' '),short_description:'A LUXEhome-specified product selected to work with a complete room design.',description:'Specification, finish, compatibility and installation requirements are confirmed for the project before ordering.',price_lkr:0,cover_image_url:null,gallery_image_urls:[],features:['Specified for the complete design','Compatibility checked before ordering','Installation coordinated by LUXEhome'],preorder:true,stock_status:'made_to_order',meta_title:null,meta_description:null}; const product=stored||fallback; const price=Number(product.price_lkr)>0?`From LKR ${Number(product.price_lkr).toLocaleString('en-LK')}`:'Price on request'; const images=[product.cover_image_url,...(product.gallery_image_urls||[])].filter(Boolean);
---
<LuxeLayout title={product.meta_title||`${product.name} — LUXEhome Shop`} description={product.meta_description||product.short_description}>
  <section class="product"><div class="gallery">{images.length?images.map((image:string,i:number)=><img src={image} alt={`${product.name} ${i+1}`} loading={i?'lazy':'eager'}/>):<div class="placeholder">{product.name}</div>}</div><div class="details"><a class="back" href="/shop">← Shop</a><p class="lx-eyebrow">Specified by LUXEhome</p><h1>{product.name}</h1><strong class="price">{price}</strong><p>{product.description||product.short_description}</p>{product.features?.length>0&&<ul>{product.features.map((f:string)=><li>✓ {f}</li>)}</ul>}<a class="wa" href={waLink(`Hi LUXEhome! I am interested in ${product.name} (${price}).`)} target="_blank" rel="noopener noreferrer">Ask about this product</a><small>Final availability, compatibility, delivery and installation are confirmed for your project.</small></div></section>
</LuxeLayout>
<style>
  .product{width:min(1100px,calc(100% - 34px));margin:auto;padding:clamp(3rem,7vw,6rem) 0 5rem;display:grid;grid-template-columns:1.15fr .85fr;gap:3rem}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:12px}.gallery img,.placeholder{width:100%;aspect-ratio:1;object-fit:cover;background:var(--sage-mist);border-radius:10px}.gallery img:first-child{grid-column:1/-1;aspect-ratio:4/3}.placeholder{grid-column:1/-1;aspect-ratio:4/3;display:grid;place-items:center;font:italic 2.4rem var(--lx-serif);color:var(--sage-deep)}.details{position:sticky;top:7rem;align-self:start}.back{display:inline-block;margin-bottom:2rem;color:var(--sage-deep)}.details h1{font-size:clamp(3rem,6vw,4.8rem);margin:.5rem 0}.price{font:600 1.4rem var(--lx-serif)}.details>p{color:#586057;margin-top:1.4rem}.details ul{list-style:none;padding:0;margin:1.4rem 0}.details li{padding:.4rem 0}.wa{display:block;text-align:center;background:var(--sage-deep);color:#fff;padding:14px;text-decoration:none;margin:1.5rem 0}.details small{color:#667064}@media(max-width:760px){.product{grid-template-columns:1fr;gap:2rem}.details{position:static}}
</style>
