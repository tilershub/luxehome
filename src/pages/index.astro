---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro';
import { getSpaces, getDesigns, getProjects, getTeam } from '../lib/luxe';
import { formatLKRM, cloudinary, waLink, BRAND_STRIP } from '../lib/luxe-config';

const spaces = await getSpaces();
const featuredDesigns = (await getDesigns({ featured: true })).slice(0, 6);
const featuredProjects = (await getProjects({ featured: true })).slice(0, 3);
const team = await getTeam({ permanentOnly: true });

const TRUST = [
  { title: 'Fixed quotation',        desc: 'Priced in full before work begins — no surprises later.' },
  { title: 'Verified teams',         desc: 'Every crew TILERSHUB-verified and named on your project.' },
  { title: 'WhatsApp updates',       desc: 'Photo and video progress straight to your phone.' },
  { title: '1-year warranty',        desc: 'Workmanship covered for a full year after handover.' },
];

const SPACE_IMAGES: Record<string, string> = {
  bathrooms: '/hero-bathroom-card.webp',
  staircases: '/hero-staircase-card.webp',
};
---

<LuxeLayout
  title="LUXEhome — Custom Design & Build Sri Lanka | Bathrooms, Kitchens, Staircases & Floors"
  description="Choose a named, fully documented design with a fixed price — bathrooms, kitchens, staircases and floors. Fixed quotation, verified teams, WhatsApp progress updates, 1-year warranty. Sri Lanka & diaspora."
>
  <!-- Hero -->
  <section class="hm-hero">
    <p class="lx-eyebrow lxr">Custom Design &amp; Build · Sri Lanka</p>
    <h1 class="lxr">Your dream space,<br /><em>built without the stress.</em></h1>
    <p class="hm-thesis lxr">
      Bathrooms, kitchens, staircases and floors — choose a named design with a complete
      file and a fixed price, then watch it built with weekly WhatsApp updates.
      <span class="sinhala hm-sinhala">ඔබේ සිහින නිවස, කරදරයකින් තොරව.</span>
    </p>
    <div class="hm-hero-cta lxr">
      <a href={waLink("Hi LUXEhome! I'd like to talk about a project for my home.")} class="lx-btn-wa" target="_blank" rel="noopener noreferrer">WhatsApp Us</a>
      <a href="/designs" class="lx-btn-ghost">Browse Designs</a>
    </div>
  </section>

  <!-- Spaces -->
  <section class="hm-section">
    <h2 class="lxr">What are we building?</h2>
    <div class="hm-spaces">
      {(spaces.length ? spaces : [
        { slug: 'bathrooms', name: 'Bathrooms', sinhala_name: null },
        { slug: 'kitchens', name: 'Kitchens', sinhala_name: null },
        { slug: 'staircases', name: 'Staircases', sinhala_name: null },
        { slug: 'floors', name: 'Floors', sinhala_name: null },
      ]).map((s) => (
        <a href={`/designs?space=${s.slug}`} class="hm-space-card lxr">
          <div class="hm-space-img">
            {SPACE_IMAGES[s.slug]
              ? <img src={SPACE_IMAGES[s.slug]} alt={s.name} loading="lazy" width="700" height="500" />
              : <div class="hm-space-ph"><em>{s.name}</em></div>}
          </div>
          <div class="hm-space-name">
            {s.name}
            {s.sinhala_name && <span class="sinhala">{s.sinhala_name}</span>}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured designs -->
  {featuredDesigns.length > 0 && (
    <section class="hm-section">
      <div class="hm-sec-head lxr">
        <h2>Featured designs</h2>
        <a href="/designs" class="hm-all">All designs →</a>
      </div>
      <div class="hm-designs">
        {featuredDesigns.map((d) => (
          <a href={`/designs/${d.slug}`} class="hm-design-card lxr">
            <div class="hm-design-img">
              {d.cover_image_url
                ? <img src={cloudinary(d.cover_image_url, 700)} alt={d.name} loading="lazy" width="700" height="500" />
                : <div class="hm-space-ph"><em>{d.name}</em></div>}
            </div>
            <div class="hm-design-body">
              <p class="lx-eyebrow">{d.collection} · {d.space?.name}</p>
              <h3>{d.name}</h3>
              {d.tagline && <p class="hm-design-tag">{d.tagline}</p>}
              <div class="hm-design-price">{formatLKRM(d.starting_price_lkr)}</div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Featured projects -->
  {featuredProjects.length > 0 && (
    <section class="hm-section">
      <div class="hm-sec-head lxr">
        <h2>Recent stories</h2>
        <a href="/projects" class="hm-all">All projects →</a>
      </div>
      <div class="hm-projects">
        {featuredProjects.map((p) => (
          <a href={`/projects/${p.slug}`} class="hm-proj-card lxr">
            <div class="hm-proj-split">
              {p.before_image_url && <div class="hm-proj-half"><img src={cloudinary(p.before_image_url, 500)} alt={`${p.title} before`} loading="lazy" width="500" height="400" /><span>Before</span></div>}
              {p.after_image_url && <div class="hm-proj-half"><img src={cloudinary(p.after_image_url, 500)} alt={`${p.title} after`} loading="lazy" width="500" height="400" /><span>After</span></div>}
            </div>
            <div class="hm-proj-body">
              <h3>{p.title}</h3>
              <p>{p.location}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Trust strip -->
  <section class="hm-trust lxr">
    <div class="hm-trust-inner">
      {TRUST.map((t) => (
        <div class="hm-trust-item">
          <div class="hm-trust-title">{t.title}</div>
          <p>{t.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Brands strip -->
  <section class="hm-section">
    <h2 class="lxr">Built with brands you know</h2>
    <div class="hm-brands lxr">
      {BRAND_STRIP.map((b) => <span class="hm-brand">{b}</span>)}
    </div>
  </section>

  <!-- Permanent team -->
  {team.length > 0 && (
    <section class="hm-section">
      <h2 class="lxr">The permanent team</h2>
      <p class="hm-team-intro lxr">The people who answer your messages, draw your design, and stand behind the warranty.</p>
      <div class="hm-team lxr">
        {team.map((m) => (
          <div class="hm-team-card">
            <div class="hm-team-photo">
              {m.photo_url
                ? <img src={cloudinary(m.photo_url, 300)} alt={m.name} loading="lazy" width="300" height="300" />
                : <span>{m.name.charAt(0)}</span>}
            </div>
            <div class="hm-team-name">{m.name}</div>
            {m.role && <div class="hm-team-role">{m.role}</div>}
            {m.tilershub_verified && <div class="hm-team-verified">✓ TILERSHUB Verified</div>}
          </div>
        ))}
      </div>
    </section>
  )}
</LuxeLayout>

<style>
  .hm-hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(3.5rem, 10vw, 7rem) clamp(1.2rem, 5vw, 4rem) 2rem;
    text-align: center;
  }
  .hm-hero h1 { font-size: clamp(2.6rem, 7vw, 4.8rem); margin: .7rem 0 1.1rem; }
  .hm-hero h1 em { color: var(--sage-deep); }
  .hm-thesis { max-width: 56ch; margin: 0 auto 1.8rem; font-size: 1.05rem; color: color-mix(in srgb, var(--ink) 78%, transparent); }
  .hm-sinhala { display: block; margin-top: .5rem; font-size: .92rem; color: var(--sage-deep); }
  .hm-hero-cta { display: flex; gap: .9rem; justify-content: center; flex-wrap: wrap; }

  .hm-section { max-width: 1100px; margin: 0 auto; padding: 2.6rem clamp(1.2rem, 5vw, 4rem); }
  .hm-section h2 { font-size: clamp(1.8rem, 4.5vw, 2.6rem); margin-bottom: 1.4rem; }
  .hm-sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .hm-all { font-size: .82rem; letter-spacing: .1em; text-transform: uppercase; color: var(--sage-deep); text-decoration: none; font-weight: 500; }

  /* Spaces */
  .hm-spaces { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  .hm-space-card { text-decoration: none; color: var(--ink); }
  .hm-space-img { aspect-ratio: 4 / 3; border-radius: 6px; overflow: hidden; background: var(--sage-mist); }
  .hm-space-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
  .hm-space-card:hover .hm-space-img img { transform: scale(1.05); }
  .hm-space-ph { height: 100%; display: flex; align-items: center; justify-content: center; color: var(--sage-deep); }
  .hm-space-ph em { font-family: var(--lx-serif); font-size: 1.4rem; }
  .hm-space-name { font-family: var(--lx-serif); font-size: 1.25rem; font-weight: 600; margin-top: .6rem; display: flex; align-items: baseline; gap: .6rem; }
  .hm-space-name .sinhala { font-size: .78rem; color: var(--sage-deep); font-weight: 400; }

  /* Designs */
  .hm-designs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .hm-design-card { background: #fff; border: 1px solid var(--cream-deep); border-radius: 6px; overflow: hidden; text-decoration: none; color: var(--ink); transition: transform .25s, box-shadow .25s; }
  .hm-design-card:hover { transform: translateY(-4px); box-shadow: 0 14px 34px rgba(43,50,42,.1); }
  .hm-design-img { aspect-ratio: 7 / 5; background: var(--sage-mist); }
  .hm-design-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hm-design-body { padding: 1rem 1.2rem 1.2rem; }
  .hm-design-body .lx-eyebrow { text-transform: capitalize; letter-spacing: .14em; }
  .hm-design-body h3 { font-size: 1.5rem; margin: .2rem 0 .1rem; }
  .hm-design-tag { font-family: var(--lx-serif); font-style: italic; color: var(--sage-deep); font-size: .95rem; margin-bottom: .5rem; }
  .hm-design-price { font-family: var(--lx-serif); font-size: 1.15rem; font-weight: 600; }

  /* Projects */
  .hm-projects { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .hm-proj-card { background: #fff; border: 1px solid var(--cream-deep); border-radius: 6px; overflow: hidden; text-decoration: none; color: var(--ink); transition: transform .25s; }
  .hm-proj-card:hover { transform: translateY(-4px); }
  .hm-proj-split { display: grid; grid-template-columns: 1fr 1fr; aspect-ratio: 10 / 6; background: var(--sage-mist); }
  .hm-proj-half { position: relative; overflow: hidden; }
  .hm-proj-half img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hm-proj-half span {
    position: absolute; bottom: .5rem; left: .5rem;
    font-size: .6rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase;
    background: color-mix(in srgb, var(--ink) 78%, transparent); color: var(--cream);
    padding: .2rem .55rem; border-radius: 999px;
  }
  .hm-proj-half + .hm-proj-half { border-left: 2px solid var(--cream); }
  .hm-proj-body { padding: .9rem 1.1rem 1.1rem; }
  .hm-proj-body h3 { font-size: 1.2rem; }
  .hm-proj-body p { font-size: .8rem; color: color-mix(in srgb, var(--ink) 62%, transparent); }

  /* Trust */
  .hm-trust { background: var(--sage-mist); padding: 3rem clamp(1.2rem, 5vw, 4rem); }
  .hm-trust-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.6rem; }
  .hm-trust-title { font-family: var(--lx-serif); font-size: 1.25rem; font-weight: 600; color: var(--sage-deep); margin-bottom: .3rem; }
  .hm-trust-item p { font-size: .85rem; color: color-mix(in srgb, var(--ink) 75%, transparent); }

  /* Brands */
  .hm-brands { display: flex; flex-wrap: wrap; gap: .6rem; }
  .hm-brand {
    font-size: .82rem;
    background: #fff;
    border: 1px solid var(--cream-deep);
    border-radius: 999px;
    padding: .5rem 1.1rem;
    color: color-mix(in srgb, var(--ink) 85%, transparent);
  }

  /* Team */
  .hm-team-intro { margin: -0.8rem 0 1.4rem; color: color-mix(in srgb, var(--ink) 68%, transparent); }
  .hm-team { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; }
  .hm-team-card { text-align: center; }
  .hm-team-photo {
    width: 120px; height: 120px; margin: 0 auto .7rem; border-radius: 50%; overflow: hidden;
    background: var(--sage-mist); display: flex; align-items: center; justify-content: center;
    font-family: var(--lx-serif); font-size: 2.2rem; color: var(--sage-deep);
  }
  .hm-team-photo img { width: 100%; height: 100%; object-fit: cover; }
  .hm-team-name { font-family: var(--lx-serif); font-size: 1.15rem; font-weight: 600; }
  .hm-team-role { font-size: .8rem; color: color-mix(in srgb, var(--ink) 62%, transparent); }
  .hm-team-verified { font-size: .72rem; font-weight: 600; color: var(--sage-deep); margin-top: .25rem; }

  @media (max-width: 900px) {
    .hm-spaces { grid-template-columns: repeat(2, 1fr); }
    .hm-designs, .hm-projects { grid-template-columns: repeat(2, 1fr); }
    .hm-trust-inner { grid-template-columns: repeat(2, 1fr); }
    .hm-team { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .hm-designs, .hm-projects { grid-template-columns: 1fr; }
    .hm-hero-cta .lx-btn-wa, .hm-hero-cta .lx-btn-ghost { width: 100%; }
  }
</style>
