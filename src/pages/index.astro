---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro';
import ProjectCard from '../components/luxe/ProjectCard.astro';
import KeyHighlights from '../components/luxe/KeyHighlights.astro';
import BuildProcess from '../components/luxe/BuildProcess.astro';
import { getDesigns, getProjects } from '../lib/luxe';
import { CATALOGUE_DESIGNS } from '../lib/luxe-catalogue';
import { cloudinary, formatLKRM, formatArea, WARRANTY_SCHEDULE, PRE_CONSTRUCTION_FEES } from '../lib/luxe-config';

interface HomeDesign {
  slug: string;
  name: string;
  collection: string;
  tagline: string;
  minSqm: number | null;
  newPrice: number | null;
  renovationPrice: number | null;
  cover: string;
}

const storedDesigns = await getDesigns({ spaceSlug: 'bathrooms' });
const readyCatalogue = CATALOGUE_DESIGNS.filter((item) => item.space === 'bathrooms' && item.coverImage);
const designMap = new Map<string, HomeDesign>();

for (const item of readyCatalogue) {
  designMap.set(item.slug, {
    slug: item.slug,
    name: item.name,
    collection: item.collection,
    tagline: item.tagline,
    minSqm: item.minSqm,
    newPrice: item.startingPrice,
    renovationPrice: item.renovationStartingPrice ?? null,
    cover: item.coverImage!,
  });
}

for (const item of storedDesigns) {
  const fallback = readyCatalogue.find((candidate) => candidate.slug === item.slug);
  const cover = item.cover_image_url || fallback?.coverImage;
  if (!cover) continue;
  designMap.set(item.slug, {
    slug: item.slug,
    name: item.name,
    collection: item.collection,
    tagline: item.tagline || fallback?.tagline || 'A complete, documented LUXEhome bathroom.',
    minSqm: item.min_sqm,
    newPrice: item.new_starting_price_lkr || item.starting_price_lkr || fallback?.startingPrice || null,
    renovationPrice: item.renovation_starting_price_lkr || fallback?.renovationStartingPrice || null,
    cover,
  });
}

const designs = [...designMap.values()].slice(0, 4);
const newPrices = designs.flatMap((design) => design.newPrice ? [design.newPrice] : []);
const renovationPrices = designs.flatMap((design) => design.renovationPrice ? [design.renovationPrice] : []);
const newFrom = newPrices.length ? Math.min(...newPrices) : null;
const renovationFrom = renovationPrices.length ? Math.min(...renovationPrices) : null;
const heroDesign = designs[0] ?? null;

const homeHighlights = [
  { value: String(designs.length ? CATALOGUE_DESIGNS.filter((d) => d.space === 'bathrooms').length : 9), title: 'Complete designs', copy: 'Three collections — Standard, Premium and Signature — each documented before it is published.' },
  { value: `LKR ${PRE_CONSTRUCTION_FEES.inspection.amount.toLocaleString('en-LK')}`, title: 'One clear first step', copy: 'A measured site inspection. No construction deposit at this stage.' },
  { value: WARRANTY_SCHEDULE[0].period, title: 'Longest warranty', copy: `${WARRANTY_SCHEDULE[0].item}. Every task carries its own written period.` },
  { value: 'Fixed', title: 'Quotation before work', copy: 'Scope, selections, payment stages and exclusions agreed in writing.' },
];

const projects = (await getProjects())
  .filter((project) => project.after_image_url)
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 2);
---

<LuxeLayout
  title="Complete Bathroom Design & Construction in Sri Lanka — LUXEhome"
  description="Choose a fully documented LUXEhome bathroom design, then book a LKR 10,000 site inspection. We measure, confirm the fit and manage new bathrooms or renovations through handover."
  ogImage={heroDesign ? cloudinary(heroDesign.cover, 1200) : undefined}
  ogImageAlt={heroDesign ? `${heroDesign.name} bathroom by LUXEhome` : undefined}
>
  <section class="home-hero">
    <div class="home-hero-copy">
      <p class="lx-eyebrow lxr">Complete bathroom design &amp; construction · Sri Lanka</p>
      <h1 class="lxr">Your bathroom,<br />fully resolved.</h1>
      <p class="home-lead lxr">
        Choose a complete LUXEhome design or adapt one to your room. One accountable team
        manages the design, specified materials, construction and final handover.
      </p>
      <div class="home-actions lxr">
        <a class="lx-btn-wa" href="/book-site-inspection">Book Site Inspection · LKR 10,000</a>
        <a class="lx-btn-ghost" href="/designs">Explore bathroom designs</a>
      </div>
      <div class="home-proof lxr" aria-label="LUXEhome service commitments">
        <span>No measurements needed</span>
        <span>Fixed quotation</span>
        <span>WhatsApp updates</span>
        <span>Written warranties</span>
      </div>
    </div>

    {heroDesign && (
      <a class="home-hero-visual lxr" href={`/designs/${heroDesign.slug}`} aria-label={`Explore the ${heroDesign.name} bathroom design`}>
        <img src={cloudinary(heroDesign.cover, 1000)} alt={`${heroDesign.name} bathroom design preview`} width="1000" height="750" fetchpriority="high" />
        <span class="home-visual-shade" aria-hidden="true"></span>
        <span class="home-visual-copy">
          <small>{heroDesign.collection} collection · Design preview</small>
          <strong>{heroDesign.name}</strong>
          <em>View this bathroom design →</em>
        </span>
      </a>
    )}
  </section>

  <section class="home-first-step" aria-labelledby="first-step-title">
    <div class="home-first-price lxr">
      <p class="lx-eyebrow">Your first commitment</p>
      <h2 id="first-step-title">Site inspection</h2>
      <strong>LKR 10,000</strong>
      <small>Pay after the location and appointment are confirmed.</small>
    </div>
    <div class="home-first-flow">
      <article class="lxr"><span>01</span><h3>Request</h3><p>Share your contact and location. Bathroom dimensions are optional.</p></article>
      <article class="lxr"><span>02</span><h3>Measure</h3><p>We inspect the room, services, site condition and access.</p></article>
      <article class="lxr"><span>03</span><h3>Decide</h3><p>We recommend the right design, budget path and next action.</p></article>
    </div>
  </section>

  <KeyHighlights items={homeHighlights} />

  <section class="home-paths" aria-labelledby="project-type-title">
    <div class="home-section-heading lxr">
      <div>
        <p class="lx-eyebrow">Start with your project</p>
        <h2 id="project-type-title">New bathroom or renovation?</h2>
      </div>
      <p>Choose the closest path. If you are unsure, the site inspection will settle it.</p>
    </div>
    <div class="home-path-grid">
      <a class="home-path-card lxr" href="/book-site-inspection?project=new">
        <span>01</span>
        <div>
          <p class="lx-eyebrow">New construction</p>
          <h3>Build a new bathroom</h3>
          <p>Start with a resolved layout, technical drawings and a complete material and fixture specification.</p>
          {newFrom && <strong>{formatLKRM(newFrom)}</strong>}
        </div>
        <b aria-hidden="true">→</b>
      </a>
      <a class="home-path-card lxr" href="/book-site-inspection?project=renovation">
        <span>02</span>
        <div>
          <p class="lx-eyebrow">Existing bathroom</p>
          <h3>Renovate completely</h3>
          <p>Rework the old room through demolition, repairs, services, waterproofing, finishes and handover.</p>
          {renovationFrom && <strong>{formatLKRM(renovationFrom)}</strong>}
        </div>
        <b aria-hidden="true">→</b>
      </a>
    </div>
    {(newFrom || renovationFrom) && <p class="home-price-note lxr">Current starting prices are based on the minimum room size and listed specification of the available design. Final fit and price follow room assessment.</p>}
  </section>

  <section class="home-designs" id="available-designs" aria-labelledby="available-designs-title">
    <div class="home-section-heading lxr">
      <div>
        <p class="lx-eyebrow">The floral collection</p>
        <h2 id="available-designs-title">Fully developed bathroom designs.</h2>
      </div>
      <p>We publish one design at a time—only after its renders, pricing, drawings, fixtures and warranties are documented.</p>
    </div>

    <div class="home-design-grid">
      {designs.map((design) => (
        <a class="home-design-card lxr" href={`/designs/${design.slug}`}>
          <div class="home-design-image">
            <img src={cloudinary(design.cover, 800)} alt={`${design.name} bathroom design`} loading="lazy" width="800" height="600" />
            <span>{formatArea(design.minSqm) ? `Minimum ${formatArea(design.minSqm)} m²` : 'Custom fit'}</span>
          </div>
          <div class="home-design-body">
            <p class="lx-eyebrow">{design.collection} collection</p>
            <h3>{design.name}</h3>
            <p>{design.tagline}</p>
            <dl>
              {design.newPrice && <><dt>New bathroom</dt><dd>{formatLKRM(design.newPrice)}</dd></>}
              {design.renovationPrice && <><dt>Renovation</dt><dd>{formatLKRM(design.renovationPrice)}</dd></>}
            </dl>
            <strong>View complete design <span aria-hidden="true">→</span></strong>
          </div>
        </a>
      ))}
    </div>
  </section>

  <BuildProcess />

  {projects.length > 0 && (
    <section class="home-projects" aria-labelledby="home-projects-title">
      <div class="home-section-heading lxr">
        <div>
          <p class="lx-eyebrow">Designs brought to life</p>
          <h2 id="home-projects-title">See what we actually built.</h2>
        </div>
        <a href="/projects">View all project stories →</a>
      </div>
      <div class="home-project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <section class="home-trust" aria-labelledby="why-title">
    <div class="home-section-heading lxr">
      <div><p class="lx-eyebrow">Why LUXEhome</p><h2 id="why-title">Clarity before construction.</h2></div>
      <p>Every important decision is documented before the work reaches site.</p>
    </div>
    <div class="home-trust-grid">
      <article class="lxr"><span>01</span><h3>Complete design file</h3><p>Renders, layouts, technical drawings, fixtures, finishes and warranties in one place.</p></article>
      <article class="lxr"><span>02</span><h3>Fixed quotation</h3><p>The approved scope, selections, payment stages and exclusions are written before construction.</p></article>
      <article class="lxr"><span>03</span><h3>One responsible team</h3><p>Design, procurement, civil work and specialist trades are coordinated through LUXEhome.</p></article>
      <article class="lxr"><span>04</span><h3>Visible progress</h3><p>Stage-by-stage WhatsApp updates keep local and overseas clients informed.</p></article>
    </div>
  </section>

  <section class="home-cta lxr">
    <div>
      <p class="lx-eyebrow">Do not know the bathroom size?</p>
      <h2>That is exactly where we start.</h2>
      <p>We will inspect it, measure it and check which design can work before you commit to construction.</p>
    </div>
    <div class="home-cta-actions">
      <a class="cta-gold" href="/book-site-inspection">Book Inspection · LKR 10,000</a>
      <a href="/designs">Browse designs first</a>
    </div>
  </section>
</LuxeLayout>

<style>
  .home-hero,
  .home-first-step,
  .home-paths,
  .home-designs,
  .home-projects,
  .home-trust,
  .home-cta { width: min(1160px, calc(100% - 34px)); margin-inline: auto; }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, .85fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: center;
    padding: clamp(3.2rem, 8vw, 7rem) 0 clamp(3rem, 7vw, 5.5rem);
  }
  .home-hero h1 { margin: .75rem 0 1.2rem; max-width: 780px; font-size: clamp(3.5rem, 7.6vw, 6rem); }
  .home-lead { max-width: 640px; font: 500 clamp(1.17rem, 2.5vw, 1.45rem)/1.45 var(--lx-serif); }
  .home-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.7rem; }
  .home-proof { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.35rem; }
  .home-proof span { padding: .36rem .7rem; border-radius: 999px; background: var(--sage-mist); color: var(--sage-deep); font-size: .7rem; }

  .home-hero-visual {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 14px;
    color: var(--cream);
    text-decoration: none;
    background: var(--sage-deep);
    box-shadow: 0 24px 60px rgba(43,50,42,.15);
  }
  .home-hero-visual img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .home-visual-shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, rgba(25,32,25,.9) 100%); }
  .home-visual-copy { position: absolute; inset: auto 0 0; padding: clamp(1.3rem, 4vw, 2rem); }
  .home-visual-copy small,
  .home-visual-copy strong,
  .home-visual-copy em { display: block; }
  .home-visual-copy small { color: var(--gold-soft); font-size: .65rem; font-style: normal; letter-spacing: .16em; text-transform: uppercase; }
  .home-visual-copy strong { margin-top: .25rem; font: 600 clamp(2rem, 4vw, 3rem)/1 var(--lx-serif); }
  .home-visual-copy em { margin-top: .65rem; font: normal .78rem var(--lx-sans); }
  .home-hero-visual:hover img { transform: scale(1.025); }

  .home-first-step {
    display: grid;
    grid-template-columns: .75fr 1.25fr;
    gap: 1rem;
    padding: 0 0 clamp(3rem, 7vw, 5rem);
  }
  .home-first-price {
    padding: clamp(1.35rem, 4vw, 2rem);
    border-radius: 12px;
    background: var(--sage-deep);
    color: var(--cream);
  }
  .home-first-price .lx-eyebrow { color: var(--gold-soft); }
  .home-first-price h2 { margin: .25rem 0 .1rem; font-size: 2rem; }
  .home-first-price strong,
  .home-first-price small { display: block; }
  .home-first-price strong { color: var(--gold-soft); font: 600 clamp(2rem, 5vw, 3rem) var(--lx-serif); }
  .home-first-price small { margin-top: .35rem; color: rgba(247,243,235,.7); font-size: .68rem; }
  .home-first-flow { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; }
  .home-first-flow article { padding: 1.2rem; border-top: 2px solid var(--sage); background: rgba(255,255,255,.65); }
  .home-first-flow span { color: var(--gold); font: 600 .9rem var(--lx-serif); }
  .home-first-flow h3 { margin: .55rem 0 .35rem; font-size: 1.2rem; }
  .home-first-flow p { color: color-mix(in srgb, var(--ink) 63%, transparent); font-size: .75rem; }

  .home-paths,
  .home-designs,
  .home-projects,
  .home-trust { padding: clamp(2.8rem, 6vw, 5rem) 0; border-top: 1px solid rgba(43,50,42,.12); }
  .home-section-heading { display: grid; grid-template-columns: 1.2fr .8fr; gap: 2rem; align-items: end; margin-bottom: 1.5rem; }
  .home-section-heading h2 { margin-top: .35rem; font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .home-section-heading > p { max-width: 48ch; color: color-mix(in srgb, var(--ink) 68%, transparent); }
  .home-section-heading > a { justify-self: end; color: var(--sage-deep); font-size: .78rem; font-weight: 600; text-decoration: none; }

  .home-path-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .home-path-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: start;
    padding: clamp(1.2rem, 3vw, 1.7rem);
    border: 1px solid var(--cream-deep);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .home-path-card > span { color: var(--gold); font: 600 1.2rem var(--lx-serif); }
  .home-path-card h3 { margin: .2rem 0 .5rem; font-size: 1.65rem; }
  .home-path-card p:not(.lx-eyebrow) { color: color-mix(in srgb, var(--ink) 68%, transparent); font-size: .85rem; }
  .home-path-card strong { display: block; margin-top: .8rem; font: 600 1.15rem var(--lx-serif); }
  .home-path-card > b { align-self: center; font-size: 1.2rem; transition: transform .2s ease; }
  .home-path-card:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(43,50,42,.08); }
  .home-path-card:hover > b { transform: translateX(4px); }
  .home-price-note { max-width: 78ch; margin-top: .85rem; color: color-mix(in srgb, var(--ink) 55%, transparent); font-size: .72rem; }

  .home-design-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr)); gap: 1rem; }
  .home-design-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--cream-deep);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .home-design-card:hover { transform: translateY(-4px); box-shadow: 0 16px 38px rgba(43,50,42,.1); }
  .home-design-image { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--sage-mist); }
  .home-design-image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .45s ease; }
  .home-design-card:hover img { transform: scale(1.025); }
  .home-design-image span { position: absolute; left: .8rem; bottom: .8rem; padding: .3rem .7rem; border-radius: 999px; background: rgba(43,50,42,.84); color: var(--cream); font-size: .63rem; letter-spacing: .08em; text-transform: uppercase; }
  .home-design-body { display: flex; flex-direction: column; flex: 1; padding: 1.15rem 1.2rem 1.3rem; }
  .home-design-body h3 { margin: .2rem 0 .3rem; font-size: 1.8rem; }
  .home-design-body > p:not(.lx-eyebrow) { color: color-mix(in srgb, var(--ink) 67%, transparent); font-size: .86rem; }
  .home-design-body dl { display: grid; grid-template-columns: 1fr auto; gap: .2rem .8rem; margin: 1rem 0; padding-top: .8rem; border-top: 1px solid var(--cream-deep); }
  .home-design-body dt { color: color-mix(in srgb, var(--ink) 58%, transparent); font-size: .72rem; }
  .home-design-body dd { margin: 0; font: 600 .9rem var(--lx-serif); }
  .home-design-body > strong { margin-top: auto; font-size: .75rem; letter-spacing: .04em; }
  .home-design-body > strong span { display: inline-block; transition: transform .2s ease; }
  .home-design-card:hover .home-design-body > strong span { transform: translateX(4px); }

  .home-project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }

  .home-trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .home-trust-grid article { padding: 1.25rem; border-top: 2px solid var(--sage); background: rgba(255,255,255,.55); }
  .home-trust-grid span { color: var(--gold); font: 600 .9rem var(--lx-serif); }
  .home-trust-grid h3 { margin: .6rem 0 .45rem; font-size: 1.25rem; }
  .home-trust-grid p { color: color-mix(in srgb, var(--ink) 66%, transparent); font-size: .8rem; }

  .home-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-top: 1rem;
    margin-bottom: 4rem;
    padding: clamp(1.8rem, 5vw, 3.2rem);
    border-radius: 14px;
    background: var(--sage-deep);
    color: var(--cream);
  }
  .home-cta .lx-eyebrow { color: var(--gold-soft); }
  .home-cta h2 { margin: .35rem 0; font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .home-cta p:not(.lx-eyebrow) { color: rgba(247,243,235,.74); }
  .home-cta-actions { display: flex; flex-direction: column; align-items: center; gap: .65rem; flex: 0 0 auto; }
  .home-cta-actions a { color: var(--cream); font-size: .78rem; }
  .home-cta-actions .cta-gold { padding: .8rem 1.25rem; border-radius: 999px; background: var(--gold); color: #fff; font-size: .84rem; font-weight: 500; text-decoration: none; white-space: nowrap; }

  @media (max-width: 900px) {
    .home-hero { grid-template-columns: 1fr; }
    .home-hero-visual { width: min(100%, 620px); aspect-ratio: 5 / 4; }
    .home-first-step { grid-template-columns: 1fr; }
    .home-path-grid,
    .home-project-grid { grid-template-columns: 1fr; }
    .home-trust-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .home-hero { padding-top: 2.8rem; }
    .home-hero h1 { font-size: clamp(3.35rem, 15vw, 4.6rem); }
    .home-actions a { width: 100%; }
    .home-hero-visual { aspect-ratio: 4 / 5; }
    .home-first-flow { grid-template-columns: 1fr; }
    .home-section-heading { grid-template-columns: 1fr; gap: .8rem; }
    .home-section-heading > a { justify-self: start; }
    .home-path-card { grid-template-columns: auto 1fr; }
    .home-path-card > b { display: none; }
    .home-trust-grid { grid-template-columns: 1fr; }
    .home-cta { display: block; }
    .home-cta-actions { align-items: stretch; margin-top: 1.2rem; text-align: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-visual img,
    .home-design-image img,
    .home-path-card,
    .home-design-card { transition: none; }
  }
</style>
