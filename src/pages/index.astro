---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro';
import ProjectCard from '../components/luxe/ProjectCard.astro';
import { getDesigns, getProjects } from '../lib/luxe';
import {
  BATHROOM_COLLECTIONS,
  collectionShortLabel,
  normalizeBathroomDesignIdentity,
} from '../lib/bathroom-taxonomy';
import {
  cloudinary,
  formatLKRM,
  formatArea,
  lkrM,
  WARRANTY_SCHEDULE,
  PROJECT_CONSULTATION,
  PROJECT_INITIATION,
} from '../lib/luxe-config';

interface HomeDesign {
  slug: string;
  name: string;
  collection: string;
  tagline: string;
  minSqm: number | null;
  newPrice: number | null;
  renovationPrice: number | null;
  cover: string;
}

const storedDesigns = await getDesigns({ spaceSlug: 'bathrooms' });
const designs: HomeDesign[] = storedDesigns
  .filter((item) => item.cover_image_url)
  .map(normalizeBathroomDesignIdentity)
  .map((item) => ({
    slug: item.slug,
    name: item.name,
    collection: item.collection,
    tagline: item.tagline || 'A complete, documented LUXEhome bathroom.',
    minSqm: item.min_sqm,
    newPrice: item.new_starting_price_lkr || item.starting_price_lkr || null,
    renovationPrice: item.renovation_starting_price_lkr || null,
    cover: item.cover_image_url!,
  }));

const collectionGroups = BATHROOM_COLLECTIONS.map((collection) => ({
  ...collection,
  // The homepage introduces one strong direction from each collection. The
  // full catalogue remains on /designs and individual campaigns land on the
  // exact design page, keeping this page focused and materially lighter.
  designs: designs.filter((design) => design.collection === collection.key).slice(0, 1),
})).filter((collection) => collection.designs.length > 0);
const featuredDesigns = collectionGroups.flatMap((collection) =>
  collection.designs.map((design) => ({ ...design, collectionInfo: collection }))
);

const newPrices = designs.flatMap((design) => design.newPrice ? [design.newPrice] : []);
const renovationPrices = designs.flatMap((design) => design.renovationPrice ? [design.renovationPrice] : []);
const newFrom = newPrices.length ? Math.min(...newPrices) : null;
const renovationFrom = renovationPrices.length ? Math.min(...renovationPrices) : null;
const moonstoneDesign = designs.find((design) => design.slug === 'moonstone');
const heroDesign = moonstoneDesign?.cover
  ? moonstoneDesign
  : designs.find((design) => design.cover) ?? null;
const heroCover = heroDesign?.cover ?? null;
const initiationPrice = PROJECT_INITIATION.amount.toLocaleString('en-LK');

const spaFacts = [
  { value: newFrom ? lkrM(newFrom) : 'Published', label: 'Complete bathroom starting guide' },
  { value: 'No fee', label: 'Approved project consultation' },
  { value: '01', label: 'Accountable project team' },
  { value: WARRANTY_SCHEDULE[0].period, label: 'Workmanship warranty' },
];

const journey = [
  { n: '01', title: 'Apply', copy: 'Share the location, project type, timing, budget direction and bathroom photographs.' },
  { n: '02', title: 'Consult', copy: 'Suitable projects receive a complimentary consultation with one detailed site assessment.' },
  { n: '03', title: 'Resolve', copy: 'Commission the LKR 50,000 design and construction proposal after the consultation.' },
  { n: '04', title: 'Build', copy: 'One coordinated team manages construction, waterproofing, installation and quality.' },
  { n: '05', title: 'Handover', copy: 'Testing, finishing, cleaning and documented warranties complete the bathroom.' },
];

const completeScope = [
  { title: 'Design & technical planning', copy: 'Measured layout, 3D views, service coordination and selections resolved before construction.' },
  { title: 'Site preparation & civil work', copy: 'Protection, demolition, debris removal, plastering, floor correction and approved modifications.' },
  { title: 'Plumbing & electrical', copy: 'Supply, drainage, hot-water preparation, wiring, lighting and ventilation points coordinated together.' },
  { title: 'Waterproofing & testing', copy: 'Prepared surfaces, reinforced critical junctions, sealed penetrations and a documented flood test.' },
  { title: 'Precision tiling', copy: 'Approved tiles, adhesive, levelling, alignment, cutting, grout and silicone finishing.' },
  { title: 'Ceiling, lighting & ventilation', copy: 'Moisture-resistant finishes, planned lighting, switches and exhaust preparation.' },
  { title: 'Fixtures & finishing', copy: 'Specified bathware, tapware, vanity, mirror, accessories, glass and related installation.' },
  { title: 'Inspection & handover', copy: 'Testing, snag correction, professional cleaning, care guidance and warranty record.' },
];

const proposalContents = [
  'Personalised layout and five 3D presentation images',
  '3D walkthrough of the proposed bathroom',
  'Selected fixtures, accessories, materials and named brands',
  'Complete construction scope, assumptions and exclusions',
  'Final quotation, timeline and staged payment plan',
  'Quality commitments and applicable warranty schedule',
];

const brandSystems = [
  { name: 'Swiss Bathware', role: 'Bathware & tapware', image: '/images/brands/swiss-bathware.webp' },
  { name: 'Rocell', role: 'Tiles & surfaces', image: '/images/brands/rocell.webp' },
  { name: 'Swisstek', role: 'Adhesive & grout', image: '/images/brands/swisstek.webp' },
  { name: 'S-lon', role: 'Pipes & accessories', image: '/images/brands/slon.webp' },
  { name: 'Tokyo Super 2K', role: 'Waterproofing system', image: '/images/brands/tokyo-cement.webp' },
  { name: 'ACL', role: 'Electrical cables', image: '/images/brands/acl-cables.webp' },
];

const trustPoints = [
  { title: 'Technical planning', copy: 'Every visible decision is supported by layouts for plumbing, electrical work, tiles and ceilings.' },
  { title: 'Waterproofing discipline', copy: 'Critical junctions are reinforced and the completed system is flood-tested before tiling.' },
  { title: 'Precision installation', copy: 'Slopes, tile lines, fittings, lighting and glass are coordinated as one finished room.' },
  { title: 'A documented handover', copy: 'The approved scope, selections, payment stages and applicable warranties remain clear.' },
];

const projects = (await getProjects())
  .filter((project) => project.after_image_url)
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 2);
---

<LuxeLayout
  title="Luxury Bathroom Design & Construction in Sri Lanka — LUXEhome"
  description="Explore complete LUXEhome bathrooms and apply for a complimentary consultation. The LKR 50,000 detailed proposal is fully credited if LUXEhome builds."
  ogImage={heroCover ? cloudinary(heroCover, 1200) : undefined}
  ogImageAlt={heroDesign ? `${heroDesign.name} bathroom by LUXEhome` : undefined}
  viewContent={{
    content_name: 'LUXEhome complete bathroom service',
    content_category: 'Bathroom design and construction',
    content_type: 'service',
  }}
>
  <section class="spa-hero" aria-labelledby="spa-hero-title">
    {heroCover ? (
      <img
        class="spa-hero-image"
        src={cloudinary(heroCover, 1800)}
        alt={`${heroDesign?.name ?? 'LUXEhome'} modern bathroom interior`}
        width="1800"
        height="1125"
        fetchpriority="high"
      />
    ) : (
      <span class="spa-hero-fallback" aria-hidden="true"></span>
    )}
    <span class="spa-hero-shade" aria-hidden="true"></span>

    <div class="spa-hero-inner">
      <div class="spa-hero-copy">
        <p class="spa-eyebrow spa-eyebrow--light lxr">Complete bathroom design &amp; construction · Sri Lanka</p>
        <h1 id="spa-hero-title" class="lxr">
          The bathroom you imagined,
          <em>designed for your home.</em>
        </h1>
        <p class="spa-hero-lead lxr">
          Choose a published LUXEhome design or share the one that inspired you.
          We adapt it to your room and deliver the complete bathroom through one accountable team.
        </p>
        <div class="spa-hero-actions lxr">
          <a class="spa-button spa-button--light" href="/book-site-inspection">Apply for a complimentary consultation</a>
          <a class="spa-button spa-button--glass" href="#bathroom-collections">Explore bathroom designs</a>
        </div>
        <p class="spa-hero-note lxr">No payment to apply · Site assessment included for approved complete-bathroom projects</p>
      </div>
    </div>

    {heroDesign && (
      <a class="spa-hero-caption lxr" href={`/designs/${heroDesign.slug}`}>
        <span>{heroDesign.name}</span>
        <small>{collectionShortLabel(heroDesign.collection)} Collection</small>
      </a>
    )}
    <a class="spa-scroll-cue" href="#spa-introduction">
      <span>Discover</span>
      <i aria-hidden="true"></i>
    </a>
  </section>

  <section class="spa-intro" id="spa-introduction" aria-labelledby="spa-intro-title">
    <div class="spa-intro-title lxr">
      <p class="spa-eyebrow">The LUXEhome approach</p>
      <h2 id="spa-intro-title">A beautiful image is only the beginning.</h2>
    </div>
    <div class="spa-intro-copy lxr">
      <p>
        The bathroom in a Reel has to work with your actual room, doors, windows,
        plumbing, drainage, wastewater routes, access, house style and investment range.
      </p>
      <p>
        LUXEhome studies those conditions, resolves the design and coordinates the
        specialists, materials, construction, testing and handover as one service.
      </p>
      <a href="/how-we-build">See how a LUXEhome bathroom is built <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="spa-facts" aria-label="LUXEhome at a glance">
    <ul>
      {spaFacts.map((fact) => (
        <li class="lxr">
          <strong>{fact.value}</strong>
          <span>{fact.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="spa-designs" id="bathroom-collections" aria-labelledby="bathroom-collections-title">
    <header class="spa-section-head lxr">
      <div>
        <p class="spa-eyebrow">Start with a design direction</p>
        <h2 id="bathroom-collections-title">Choose the feeling. We resolve the room.</h2>
      </div>
      <p>
        These are documented bathroom concepts with published starting guides—not
        isolated inspiration images. Explore the exact design, scope, fixtures and room-size guidance.
      </p>
    </header>

    <div class="spa-design-grid">
      {featuredDesigns.map((design) => (
        <a class="spa-design-card lxr" href={`/designs/${design.slug}`} aria-label={`Explore the ${design.name} bathroom design`}>
          <div class="spa-design-media">
            <img
              src={cloudinary(design.cover, 760)}
              alt={`${design.name} bathroom design`}
              loading="lazy"
              width="760"
              height="608"
            />
            <span class="spa-design-level">Level {design.collectionInfo.level} · {design.collectionInfo.note}</span>
          </div>
          <div class="spa-design-info">
            <div class="spa-design-title">
              <div>
                <small>{collectionShortLabel(design.collection)} Collection</small>
                <h3>{design.name}</h3>
              </div>
              <span aria-hidden="true">↗</span>
            </div>
            <p>{design.tagline}</p>
            <dl>
              <div>
                <dt>Room</dt>
                <dd>{formatArea(design.minSqm) ? `From ${formatArea(design.minSqm)} m²` : 'Custom fit'}</dd>
              </div>
              {design.newPrice && (
                <div>
                  <dt>New bathroom</dt>
                  <dd>{formatLKRM(design.newPrice)}</dd>
                </div>
              )}
              {design.renovationPrice && (
                <div>
                  <dt>Renovation</dt>
                  <dd>{formatLKRM(design.renovationPrice)}</dd>
                </div>
              )}
            </dl>
          </div>
        </a>
      ))}
    </div>
    <div class="spa-designs-more lxr">
      <a href="/designs">Explore every published bathroom design <span aria-hidden="true">→</span></a>
      <p>Campaign visitors can enter through the exact design page they saw in a Reel.</p>
    </div>
  </section>

  <section class="spa-scope" aria-labelledby="spa-scope-title">
    <header class="spa-section-head lxr">
      <div>
        <p class="spa-eyebrow">What a complete bathroom includes</p>
        <h2 id="spa-scope-title">One room. Every connected discipline.</h2>
      </div>
      <p>
        LUXEhome is not selling a render or a collection of fittings. The design,
        concealed services, surfaces and final installation are managed as one coordinated project.
      </p>
    </header>
    <div class="spa-scope-grid">
      {completeScope.map((item, index) => (
        <article class="lxr">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>
    <a class="spa-inline-link lxr" href="/how-we-build">See the complete LUXEhome construction system <span aria-hidden="true">→</span></a>
  </section>

  <section class="spa-journey" aria-labelledby="spa-journey-title">
    <div class="spa-journey-inner">
      <header class="spa-journey-head lxr">
        <div>
          <p class="spa-eyebrow spa-eyebrow--mist">One complete service</p>
          <h2 id="spa-journey-title">From room<br />to retreat.</h2>
        </div>
        <p>
          A calm result needs a controlled sequence. We coordinate every stage so the
          design intent and technical quality stay connected.
        </p>
      </header>

      <ol class="spa-journey-steps">
        {journey.map((step) => (
          <li class="lxr">
            <span>{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </li>
        ))}
      </ol>

      <div class="spa-inspection lxr">
        <div>
          <small>Your first step · approved complete-bathroom projects</small>
          <strong>{PROJECT_CONSULTATION.title} · {PROJECT_CONSULTATION.price}</strong>
          <p>{PROJECT_CONSULTATION.copy}</p>
          <em>{PROJECT_CONSULTATION.qualification}</em>
        </div>
        <a class="spa-button spa-button--mist" href="/book-site-inspection">Apply for consultation</a>
      </div>
    </div>
  </section>

  <section class="spa-proposal" aria-labelledby="spa-proposal-title">
    <div class="spa-proposal-intro lxr">
      <p class="spa-eyebrow">The professional decision stage</p>
      <h2 id="spa-proposal-title">Know what it will look like, cost and include.</h2>
      <p>{PROJECT_INITIATION.copy}</p>
      <p class="spa-proposal-credit"><strong>{PROJECT_INITIATION.credit}</strong> You keep the proposal even if you choose not to proceed with construction.</p>
    </div>
    <div class="spa-proposal-card lxr">
      <div class="spa-proposal-price">
        <span>After the consultation · one bathroom</span>
        <strong>LKR {initiationPrice}</strong>
        <small>Detailed design &amp; construction proposal</small>
      </div>
      <ul>
        {proposalContents.map((item) => <li>{item}</li>)}
      </ul>
      <p>{PROJECT_INITIATION.delivery}</p>
    </div>
  </section>

  <section class="spa-paths" aria-labelledby="spa-paths-title">
    <header class="spa-section-head lxr">
      <div>
        <p class="spa-eyebrow">Begin with your project</p>
        <h2 id="spa-paths-title">New bathroom or complete renovation?</h2>
      </div>
      <p>
        Both paths receive the same design-led planning and coordinated management.
        The site condition determines the final scope.
      </p>
    </header>

    <div class="spa-path-grid">
      <a class="spa-path-card lxr" href="/book-site-inspection?project=new">
        <span>01</span>
        <div>
          <small>New construction</small>
          <h3>Begin with a resolved room.</h3>
          <p>Plan layout, services, finishes and fixtures before construction starts.</p>
          {newFrom && <strong>Designs from {lkrM(newFrom)}</strong>}
        </div>
        <b aria-hidden="true">↗</b>
      </a>
      <a class="spa-path-card lxr" href="/book-site-inspection?project=renovation">
        <span>02</span>
        <div>
          <small>Existing bathroom</small>
          <h3>Replace the room, not the problems.</h3>
          <p>Assess concealed risks, rebuild the wet areas and renew the full experience.</p>
          {renovationFrom && <strong>Renovations from {lkrM(renovationFrom)}</strong>}
        </div>
        <b aria-hidden="true">↗</b>
      </a>
    </div>
    {(newFrom || renovationFrom) && (
      <p class="spa-price-note lxr">
        Starting prices reflect the minimum room and listed design specification.
        Your final quotation is prepared in the paid proposal after the complimentary consultation and site assessment.
      </p>
    )}
  </section>

  {projects.length > 0 && (
    <section class="spa-projects" aria-labelledby="spa-projects-title">
      <header class="spa-section-head lxr">
        <div>
          <p class="spa-eyebrow">Completed by LUXEhome</p>
          <h2 id="spa-projects-title">Design made real.</h2>
        </div>
        <a href="/projects">Explore completed projects <span aria-hidden="true">→</span></a>
      </header>
      <div class="spa-project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <section class="spa-assurance" aria-labelledby="spa-assurance-title">
    <header class="spa-section-head lxr">
      <div>
        <p class="spa-eyebrow">Specified, installed, supported</p>
        <h2 id="spa-assurance-title">Known systems. Written warranties.</h2>
      </div>
      <p>
        The proposal names the selected brands and materials for your bathroom.
        Substitutions and alternatives are approved before purchase—not discovered during construction.
      </p>
    </header>
    <div class="spa-brand-grid" aria-label="Selected material and product systems">
      {brandSystems.map((brand) => (
        <article class="lxr">
          <img src={brand.image} alt="" loading="lazy" width="160" height="64" />
          <div><strong>{brand.name}</strong><span>{brand.role}</span></div>
        </article>
      ))}
    </div>
    <div class="spa-warranty lxr">
      <div>
        <p class="spa-eyebrow">After handover</p>
        <h3>Responsibility does not end when the room is photographed.</h3>
        <a class="spa-inline-link" href="/warranty-aftercare">Read warranty &amp; aftercare terms <span aria-hidden="true">→</span></a>
      </div>
      <dl>
        {WARRANTY_SCHEDULE.map((item) => (
          <div><dt>{item.item}</dt><dd>{item.period}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="spa-trust" aria-labelledby="spa-trust-title">
    <header class="spa-trust-head lxr">
      <p class="spa-eyebrow">Beauty with discipline</p>
      <h2 id="spa-trust-title">Quiet on the surface.<br />Rigorous underneath.</h2>
    </header>
    <div class="spa-trust-grid">
      {trustPoints.map((point, index) => (
        <article class="lxr">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{point.title}</h3>
          <p>{point.copy}</p>
        </article>
      ))}
    </div>
  </section>

  {heroCover && (
    <section class="spa-final" aria-labelledby="spa-final-title">
      <img
        src={cloudinary(heroCover, 1600)}
        alt={`${heroDesign?.name ?? 'Published LUXEhome'} bathroom design`}
        width="1600"
        height="1000"
        loading="lazy"
      />
      <span class="spa-final-shade" aria-hidden="true"></span>
      <div class="spa-final-copy lxr">
        <p class="spa-eyebrow spa-eyebrow--light">Bring us the design that inspired you</p>
        <h2 id="spa-final-title">Could it work in your home?</h2>
        <p>Apply with your location, project type, timing and investment range. If the project is a suitable fit, the complimentary consultation includes one detailed site assessment.</p>
        <div>
          <a class="spa-button spa-button--light" href="/book-site-inspection">Apply for consultation</a>
          <a class="spa-final-link" href="/designs">Browse all designs</a>
        </div>
      </div>
    </section>
  )}
</LuxeLayout>

<style>
  :global(.luxe-body) {
    background: #F3F0E9;
  }
  :global(.lx-footer) {
    margin-top: 0;
  }

  .spa-eyebrow {
    margin: 0 0 15px;
    color: #66715F;
    font: 500 11px/1.4 var(--lx-sans);
    letter-spacing: .22em;
    text-transform: uppercase;
  }
  .spa-eyebrow--light { color: rgba(248,245,237,.86); }
  .spa-eyebrow--mist { color: #ADB6A7; }

  .spa-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 24px;
    border: 1px solid transparent;
    border-radius: 999px;
    font: 500 12px/1.25 var(--lx-sans);
    letter-spacing: .12em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color .25s ease, border-color .25s ease, color .25s ease;
  }
  .spa-button--light { background: #F6F2E9; color: #293229; }
  .spa-button--light:hover { background: #fff; color: #293229; }
  .spa-button--glass { border-color: rgba(255,255,255,.48); color: #fff; backdrop-filter: blur(8px); }
  .spa-button--glass:hover { border-color: #fff; background: rgba(255,255,255,.1); color: #fff; }
  .spa-button--mist { background: #E9E7DD; color: #293229; }
  .spa-button--mist:hover { background: #fff; color: #293229; }

  /* Immersive, quiet first impression */
  .spa-hero {
    position: relative;
    min-height: min(900px, calc(100svh - 70px));
    overflow: hidden;
    background: #4C574B;
    color: #fff;
  }
  .spa-hero-image,
  .spa-hero-fallback { position: absolute; inset: 0; width: 100%; height: 100%; }
  .spa-hero-image {
    object-fit: cover;
    object-position: center;
    display: block;
    animation: spaHeroDrift 24s ease-in-out infinite alternate;
  }
  .spa-hero-fallback {
    background:
      radial-gradient(circle at 65% 30%, rgba(235,225,202,.28), transparent 28%),
      linear-gradient(135deg, #778173, #394438);
  }
  .spa-hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(23,29,24,.8) 0%, rgba(23,29,24,.44) 45%, rgba(23,29,24,.05) 75%),
      linear-gradient(0deg, rgba(20,26,21,.54), transparent 46%);
  }
  .spa-hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    width: min(1240px, calc(100% - 64px));
    min-height: min(900px, calc(100svh - 70px));
    margin: 0 auto;
    padding: clamp(70px, 10vw, 130px) 0;
  }
  .spa-hero-copy { width: min(820px, 72%); }
  .spa-hero h1 {
    max-width: 12ch;
    margin: 0;
    color: #FBF8F1;
    font: 500 clamp(58px, 7.6vw, 106px)/.88 var(--lx-serif);
    letter-spacing: -.025em;
  }
  .spa-hero h1 em {
    display: block;
    color: #D8D8C8;
    font-weight: 400;
  }
  .spa-hero-lead {
    max-width: 580px;
    margin: 28px 0 0;
    color: rgba(255,255,255,.84);
    font-size: clamp(17px, 1.8vw, 20px);
    line-height: 1.65;
  }
  .spa-hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 34px; }
  .spa-hero-note {
    max-width: 610px;
    margin: 14px 0 0;
    color: rgba(255,255,255,.7);
    font-size: 11px;
    letter-spacing: .06em;
    line-height: 1.55;
    text-transform: uppercase;
  }
  .spa-hero-caption {
    position: absolute;
    z-index: 2;
    right: clamp(24px, 4vw, 64px);
    bottom: 42px;
    display: grid;
    justify-items: end;
    color: #fff;
    text-decoration: none;
  }
  .spa-hero-caption span { font: 500 25px var(--lx-serif); }
  .spa-hero-caption small {
    color: rgba(255,255,255,.7);
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .spa-scroll-cue {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 26px;
    display: grid;
    justify-items: center;
    gap: 8px;
    color: rgba(255,255,255,.76);
    font-size: 9px;
    letter-spacing: .18em;
    text-decoration: none;
    text-transform: uppercase;
    transform: translateX(-50%);
  }
  .spa-scroll-cue i {
    display: block;
    width: 1px;
    height: 34px;
    overflow: hidden;
    background: rgba(255,255,255,.34);
  }
  .spa-scroll-cue i::after {
    display: block;
    width: 100%;
    height: 45%;
    background: #fff;
    content: '';
    animation: spaScroll 2.2s ease-in-out infinite;
  }

  /* Editorial introduction */
  .spa-intro {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: clamp(46px, 8vw, 120px);
    align-items: start;
    width: min(1140px, calc(100% - 48px));
    margin: 0 auto;
    padding: clamp(92px, 12vw, 160px) 0 clamp(72px, 10vw, 120px);
  }
  .spa-intro h2,
  .spa-section-head h2,
  .spa-trust h2 {
    margin: 0;
    color: #303830;
    font: 500 clamp(43px, 5.4vw, 72px)/.98 var(--lx-serif);
    letter-spacing: -.02em;
  }
  .spa-intro-copy { padding-top: 30px; }
  .spa-intro-copy p {
    margin: 0 0 18px;
    color: #596158;
    font-size: 17px;
    line-height: 1.8;
  }
  .spa-intro-copy a,
  .spa-section-head > a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    padding-bottom: 5px;
    border-bottom: 1px solid #8C9586;
    color: #4E5B4D;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: .06em;
    text-decoration: none;
  }

  .spa-facts {
    border-block: 1px solid #DCD8CE;
    background: rgba(255,255,255,.34);
  }
  .spa-facts ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: min(1140px, calc(100% - 48px));
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .spa-facts li { padding: 35px clamp(16px, 3vw, 38px); border-right: 1px solid #DCD8CE; }
  .spa-facts li:first-child { padding-left: 0; }
  .spa-facts li:last-child { padding-right: 0; border-right: 0; }
  .spa-facts strong,
  .spa-facts span { display: block; }
  .spa-facts strong { color: #4E5B4D; font: 500 33px/1 var(--lx-serif); }
  .spa-facts span { margin-top: 9px; color: #71786F; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }

  /* A short, visual bridge from Reel inspiration to exact design details */
  .spa-designs {
    padding: clamp(90px, 12vw, 155px) 0;
    background: #ECE9E1;
  }
  .spa-section-head,
  .spa-design-grid,
  .spa-designs-more,
  .spa-scope,
  .spa-proposal,
  .spa-paths,
  .spa-projects,
  .spa-assurance,
  .spa-trust {
    width: min(1140px, calc(100% - 48px));
    margin-inline: auto;
  }
  .spa-section-head {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: clamp(42px, 7vw, 100px);
    align-items: end;
    margin-bottom: clamp(64px, 9vw, 108px);
  }
  .spa-section-head > p {
    max-width: 48ch;
    margin: 0 0 5px;
    color: #626A61;
    font-size: 16px;
    line-height: 1.75;
  }
  .spa-design-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .spa-design-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #D8D4CA;
    border-radius: 3px;
    background: #F8F6F0;
    color: #303830;
    text-decoration: none;
    transition: transform .35s ease, box-shadow .35s ease;
  }
  .spa-design-card:hover { transform: translateY(-5px); box-shadow: 0 24px 55px rgba(48,56,48,.1); }
  .spa-design-media { position: relative; aspect-ratio: 5 / 4; overflow: hidden; background: #DDE1D8; }
  .spa-design-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .7s ease; }
  .spa-design-card:hover .spa-design-media img { transform: scale(1.025); }
  .spa-design-level {
    position: absolute;
    left: 15px;
    bottom: 15px;
    padding: 7px 10px;
    border-radius: 999px;
    background: rgba(33,41,34,.68);
    color: rgba(255,255,255,.9);
    font-size: 9px;
    letter-spacing: .14em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }
  .spa-design-info { padding: 24px 25px 28px; }
  .spa-design-title { display: flex; justify-content: space-between; gap: 18px; align-items: start; }
  .spa-design-title small {
    color: #798174;
    font-size: 9px;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .spa-design-title h3 { margin: 4px 0 0; color: #303830; font: 500 38px/1 var(--lx-serif); }
  .spa-design-title > span { color: #64705E; font-size: 20px; transition: transform .25s ease; }
  .spa-design-card:hover .spa-design-title > span { transform: translate(3px, -3px); }
  .spa-design-info > p {
    min-height: 50px;
    margin: 13px 0 20px;
    color: #687067;
    font-size: 14px;
    line-height: 1.65;
  }
  .spa-design-info dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: 0; border-top: 1px solid #DCD8CE; }
  .spa-design-info dl > div { min-width: 0; padding: 15px 12px 0; border-left: 1px solid #DCD8CE; }
  .spa-design-info dl > div:first-child { padding-left: 0; border-left: 0; }
  .spa-design-info dt { color: #8A9087; font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }
  .spa-design-info dd { margin: 5px 0 0; overflow-wrap: anywhere; color: #394239; font: 500 14px/1.3 var(--lx-serif); }
  .spa-designs-more {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: center;
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid #D2CEC4;
  }
  .spa-designs-more a,
  .spa-inline-link {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    padding-bottom: 4px;
    border-bottom: 1px solid #8C9586;
    color: #4E5B4D;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: .05em;
    text-decoration: none;
  }
  .spa-designs-more p { margin: 0; color: #777E75; font-size: 12px; }

  /* Full project scope */
  .spa-scope { padding: clamp(90px, 11vw, 145px) 0; }
  .spa-scope .spa-section-head { width: auto; }
  .spa-scope-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid #D8D4CA;
    border-left: 1px solid #D8D4CA;
  }
  .spa-scope-grid article {
    min-height: 235px;
    padding: 28px 25px;
    border-right: 1px solid #D8D4CA;
    border-bottom: 1px solid #D8D4CA;
  }
  .spa-scope-grid span { color: #879080; font: italic 500 15px var(--lx-serif); }
  .spa-scope-grid h3 { margin: 28px 0 12px; color: #384138; font: 500 24px/1.08 var(--lx-serif); }
  .spa-scope-grid p { color: #6E756C; font-size: 13px; line-height: 1.7; }
  .spa-scope > .spa-inline-link { margin-top: 30px; }

  /* Paid proposal, clearly separated from the complimentary consultation */
  .spa-proposal {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: clamp(44px, 8vw, 110px);
    align-items: center;
    padding: clamp(90px, 11vw, 145px) 0;
  }
  .spa-proposal-intro h2 {
    margin: 0;
    color: #303830;
    font: 500 clamp(43px, 5.4vw, 70px)/.98 var(--lx-serif);
    letter-spacing: -.02em;
  }
  .spa-proposal-intro > p:not(.spa-eyebrow) { margin-top: 22px; color: #606960; font-size: 16px; line-height: 1.75; }
  .spa-proposal-credit { padding-left: 18px; border-left: 2px solid #8A9A84; }
  .spa-proposal-credit strong { color: #455143; }
  .spa-proposal-card { padding: clamp(30px, 5vw, 52px); border: 1px solid #D4D1C7; background: #FCFAF5; box-shadow: 0 30px 70px rgba(48,56,48,.08); }
  .spa-proposal-price { padding-bottom: 24px; border-bottom: 1px solid #D8D4CA; }
  .spa-proposal-price span,
  .spa-proposal-price strong,
  .spa-proposal-price small { display: block; }
  .spa-proposal-price span { color: #778073; font-size: 9px; letter-spacing: .14em; text-transform: uppercase; }
  .spa-proposal-price strong { margin: 7px 0 3px; color: #384138; font: 500 clamp(40px, 5vw, 58px)/1 var(--lx-serif); }
  .spa-proposal-price small { color: #626A61; font-size: 13px; }
  .spa-proposal-card ul { display: grid; gap: 0; margin: 22px 0 0; padding: 0; list-style: none; }
  .spa-proposal-card li { position: relative; padding: 12px 0 12px 25px; border-bottom: 1px solid #E1DED5; color: #525C52; font-size: 14px; }
  .spa-proposal-card li::before { position: absolute; left: 0; color: #697665; content: '✓'; }
  .spa-proposal-card > p { margin-top: 20px; color: #777E75; font-size: 12px; line-height: 1.65; }

  /* Construction journey */
  .spa-journey {
    padding: clamp(90px, 12vw, 150px) 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 8%, rgba(167,178,159,.12), transparent 30%),
      #263027;
    color: #F0EEE7;
  }
  .spa-journey-inner { width: min(1140px, calc(100% - 48px)); margin: 0 auto; }
  .spa-journey-head {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: clamp(42px, 8vw, 110px);
    align-items: end;
    margin-bottom: clamp(58px, 8vw, 90px);
  }
  .spa-journey h2 { margin: 0; color: #F2F0E9; font: 500 clamp(54px, 7vw, 88px)/.86 var(--lx-serif); letter-spacing: -.02em; }
  .spa-journey-head > p { max-width: 46ch; color: #BEC5B9; font-size: 16px; line-height: 1.8; }
  .spa-journey-steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(238,236,228,.2);
    list-style: none;
  }
  .spa-journey-steps li { padding: 30px 26px 10px 0; border-right: 1px solid rgba(238,236,228,.14); }
  .spa-journey-steps li + li { padding-left: 26px; }
  .spa-journey-steps li:last-child { padding-right: 0; border-right: 0; }
  .spa-journey-steps span { color: #B1B99F; font: italic 500 15px var(--lx-serif); }
  .spa-journey-steps h3 { margin: 18px 0 11px; color: #F2F0E9; font: 500 29px var(--lx-serif); }
  .spa-journey-steps p { color: #AEB6AA; font-size: 13px; line-height: 1.75; }
  .spa-inspection {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    align-items: center;
    margin-top: 70px;
    padding: 30px 0 0;
    border-top: 1px solid rgba(238,236,228,.2);
  }
  .spa-inspection small,
  .spa-inspection strong,
  .spa-inspection p,
  .spa-inspection em { display: block; }
  .spa-inspection > div { max-width: 760px; }
  .spa-inspection small { color: #99A393; font-size: 9px; letter-spacing: .16em; text-transform: uppercase; }
  .spa-inspection strong { margin-top: 6px; color: #F2F0E9; font: 500 26px var(--lx-serif); }
  .spa-inspection p { margin-top: 5px; color: #BEC5B9; font-size: 13px; line-height: 1.65; }
  .spa-inspection em { margin-top: 8px; color: #929D8E; font-size: 11px; font-style: normal; line-height: 1.55; }

  /* Project paths and real work */
  .spa-paths,
  .spa-projects,
  .spa-trust { padding: clamp(90px, 11vw, 145px) 0; }
  .spa-path-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-block: 1px solid #D8D4CA; }
  .spa-path-card {
    display: grid;
    grid-template-columns: 38px 1fr auto;
    gap: 24px;
    min-width: 0;
    padding: clamp(34px, 5vw, 58px) clamp(24px, 5vw, 58px);
    color: #303830;
    text-decoration: none;
    transition: background-color .25s ease;
  }
  .spa-path-card + .spa-path-card { border-left: 1px solid #D8D4CA; }
  .spa-path-card:hover { background: rgba(255,255,255,.5); }
  .spa-path-card > span { color: #7C8777; font: italic 500 16px var(--lx-serif); }
  .spa-path-card small { color: #7A8277; font-size: 9px; letter-spacing: .14em; text-transform: uppercase; }
  .spa-path-card h3 { max-width: 14ch; margin: 12px 0; color: #333B33; font: 500 clamp(31px, 3.8vw, 45px)/1 var(--lx-serif); }
  .spa-path-card p { max-width: 43ch; color: #687067; font-size: 14px; line-height: 1.7; }
  .spa-path-card strong { display: block; margin-top: 20px; color: #4D5A4B; font: 500 18px var(--lx-serif); }
  .spa-path-card > b { color: #66715F; font-size: 20px; font-weight: 400; transition: transform .25s ease; }
  .spa-path-card:hover > b { transform: translate(3px, -3px); }
  .spa-price-note { max-width: 78ch; margin: 20px 0 0; color: #777E75; font-size: 12px; line-height: 1.6; }

  .spa-projects { border-top: 1px solid #D8D4CA; }
  .spa-projects .spa-section-head { width: auto; }
  .spa-project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }

  /* Brands and warranty answer the trust questions before the final CTA */
  .spa-assurance { padding: clamp(90px, 11vw, 145px) 0; border-top: 1px solid #D8D4CA; }
  .spa-assurance .spa-section-head { width: auto; }
  .spa-brand-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid #D8D4CA; border-left: 1px solid #D8D4CA; }
  .spa-brand-grid article {
    display: flex;
    gap: 18px;
    align-items: center;
    min-height: 118px;
    padding: 22px;
    border-right: 1px solid #D8D4CA;
    border-bottom: 1px solid #D8D4CA;
    background: rgba(255,255,255,.26);
  }
  .spa-brand-grid img { width: 92px; height: 46px; object-fit: contain; filter: saturate(.75); }
  .spa-brand-grid strong,
  .spa-brand-grid span { display: block; }
  .spa-brand-grid strong { color: #414B40; font: 500 19px/1.1 var(--lx-serif); }
  .spa-brand-grid span { margin-top: 4px; color: #7A8277; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
  .spa-warranty {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: clamp(40px, 8vw, 100px);
    margin-top: 54px;
    padding: clamp(34px, 5vw, 58px);
    background: #E4E8DF;
  }
  .spa-warranty h3 { max-width: 15ch; margin: 0 0 24px; color: #384138; font: 500 clamp(31px, 4vw, 47px)/1.04 var(--lx-serif); }
  .spa-warranty dl { margin: 0; border-top: 1px solid #C4CBC0; }
  .spa-warranty dl > div { display: grid; grid-template-columns: 1fr auto; gap: 24px; padding: 17px 0; border-bottom: 1px solid #C4CBC0; }
  .spa-warranty dt { color: #596458; font-size: 13px; }
  .spa-warranty dd { margin: 0; color: #354034; font: 500 18px/1.2 var(--lx-serif); text-align: right; }

  .spa-trust {
    display: grid;
    grid-template-columns: .82fr 1.18fr;
    gap: clamp(50px, 8vw, 120px);
    padding-top: clamp(80px, 10vw, 130px);
    border-top: 1px solid #D8D4CA;
  }
  .spa-trust-head { position: sticky; top: 110px; align-self: start; }
  .spa-trust h2 { font-size: clamp(42px, 5vw, 65px); }
  .spa-trust-grid { border-top: 1px solid #D8D4CA; }
  .spa-trust-grid article {
    display: grid;
    grid-template-columns: 42px minmax(150px, .7fr) 1fr;
    gap: 20px;
    align-items: start;
    padding: 28px 0;
    border-bottom: 1px solid #D8D4CA;
  }
  .spa-trust-grid span { color: #899184; font: italic 500 14px var(--lx-serif); }
  .spa-trust-grid h3 { color: #3B443A; font: 500 23px/1.15 var(--lx-serif); }
  .spa-trust-grid p { color: #6E756C; font-size: 13px; line-height: 1.7; }

  /* Final emotional close */
  .spa-final {
    position: relative;
    min-height: 680px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #3A443A;
    color: #fff;
  }
  .spa-final > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .spa-final-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(24,30,25,.78), rgba(24,30,25,.35) 54%, rgba(24,30,25,.05));
  }
  .spa-final-copy {
    position: relative;
    z-index: 2;
    width: min(1140px, calc(100% - 48px));
    margin: 0 auto;
  }
  .spa-final-copy h2 {
    max-width: 10ch;
    margin: 0;
    color: #F7F4EC;
    font: 500 clamp(50px, 6.6vw, 82px)/.92 var(--lx-serif);
    letter-spacing: -.02em;
  }
  .spa-final-copy > p:not(.spa-eyebrow) {
    max-width: 500px;
    margin-top: 22px;
    color: rgba(255,255,255,.82);
    font-size: 16px;
    line-height: 1.7;
  }
  .spa-final-copy > div { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 30px; }
  .spa-final-link {
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(255,255,255,.48);
    color: #fff;
    font-size: 12px;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @keyframes spaHeroDrift {
    from { transform: scale(1); }
    to { transform: scale(1.035); }
  }
  @keyframes spaScroll {
    0% { transform: translateY(-120%); }
    55%, 100% { transform: translateY(230%); }
  }

  @media (max-width: 900px) {
    .spa-hero-inner { width: min(calc(100% - 40px), 700px); align-items: end; padding-bottom: 110px; }
    .spa-hero-copy { width: 100%; }
    .spa-hero-shade {
      background:
        linear-gradient(0deg, rgba(20,26,21,.78) 0%, rgba(20,26,21,.28) 68%, rgba(20,26,21,.06) 100%),
        linear-gradient(90deg, rgba(20,26,21,.4), transparent);
    }
    .spa-hero-caption { display: none; }
    .spa-scroll-cue { left: auto; right: 22px; transform: none; }
    .spa-intro,
    .spa-section-head,
    .spa-journey-head,
    .spa-proposal,
    .spa-warranty,
    .spa-trust { grid-template-columns: 1fr; }
    .spa-intro-copy { max-width: 650px; padding-top: 0; }
    .spa-facts ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .spa-facts li:nth-child(2) { border-right: 0; }
    .spa-facts li:nth-child(-n+2) { border-bottom: 1px solid #DCD8CE; }
    .spa-facts li:nth-child(3) { padding-left: 0; }
    .spa-scope-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .spa-journey-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .spa-journey-steps li { padding-bottom: 30px; border-bottom: 1px solid rgba(238,236,228,.14); }
    .spa-journey-steps li:nth-child(even) { border-right: 0; }
    .spa-journey-steps li:nth-child(odd) { padding-left: 0; }
    .spa-journey-steps li:last-child { grid-column: 1 / -1; border-right: 0; border-bottom: 0; }
    .spa-path-grid,
    .spa-project-grid { grid-template-columns: 1fr; }
    .spa-path-card + .spa-path-card { border-top: 1px solid #D8D4CA; border-left: 0; }
    .spa-brand-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .spa-trust-head { position: static; }
  }

  @media (max-width: 640px) {
    .spa-hero { min-height: calc(100svh - 57px); }
    .spa-hero-image { object-position: 58% center; }
    .spa-hero-inner { min-height: calc(100svh - 57px); padding: 90px 0 88px; }
    .spa-hero h1 { font-size: clamp(48px, 15vw, 67px); }
    .spa-hero-lead { margin-top: 22px; font-size: 16px; line-height: 1.6; }
    .spa-hero-actions { display: grid; margin-top: 26px; }
    .spa-button { width: 100%; }
    .spa-scroll-cue { display: none; }
    .spa-intro,
    .spa-section-head,
    .spa-design-grid,
    .spa-designs-more,
    .spa-scope,
    .spa-proposal,
    .spa-paths,
    .spa-projects,
    .spa-assurance,
    .spa-trust,
    .spa-journey-inner,
    .spa-final-copy { width: min(calc(100% - 32px), 1140px); }
    .spa-intro { padding: 76px 0 68px; }
    .spa-intro h2,
    .spa-section-head h2,
