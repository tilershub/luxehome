---
import LuxeLayout from '../layouts/LuxeLayout.astro';
import { waLink } from '../lib/luxe-config';
const spaces = [
  { name: 'Bathrooms', href: '/bathroom-designs' }, { name: 'Kitchens', href: '/kitchen-designs' },
  { name: 'Staircases', href: '/staircase-designs' }, { name: 'Floors', href: '/floor-designs' },
];
---
<LuxeLayout title="Your home, fully resolved. — LUXEhome" description="Choose a complete, documented design with an honest starting price, specified materials and a trusted Sri Lankan design-and-build team.">
  <section class="artifact-hero">
    <div class="lx-eyebrow lxr">Design-led renovation · Sri Lanka</div>
    <h1 class="lxr">Your home, fully resolved.</h1>
    <p class="lead lxr">Choose a complete, documented design—with an honest starting price, specified materials and a team you can trust.</p>
    <div class="actions lxr"><a class="lx-btn-wa" href="/book-site-inspection">Book site inspection</a><a class="lx-btn-ghost" href="/designs">Browse designs</a></div>
  </section>
  <section class="artifact-section"><div class="artifact-grid">
    <article class="artifact-card lxr"><h2>Choose your space</h2><div class="chips">{spaces.map((space) => <a href={space.href}>{space.name}</a>)}</div></article>
    <article class="artifact-card lxr"><h2>Why LUXEhome</h2><div class="chips"><span>Fixed quotation</span><span>Verified teams</span><span>WhatsApp progress updates</span><span>1-year warranty</span></div></article>
    <article class="artifact-card lxr"><h2>Start with clarity</h2><p>Browse named designs, see real project stories, or book a professional site inspection.</p></article>
  </div></section>
  <section class="artifact-cta lxr"><div><div class="lx-eyebrow">Start with clarity</div><h2>Ready to discuss your home?</h2></div><a class="cta-gold" href={waLink("Hi LUXEhome! I am interested in 'Your home, fully resolved.'")} target="_blank" rel="noopener noreferrer">Talk on WhatsApp</a></section>
</LuxeLayout>
<style>
  .artifact-hero{width:min(1100px,calc(100% - 34px));margin:auto;padding:clamp(3.5rem,9vw,7rem) 0 3rem}.artifact-hero h1{font-size:clamp(3.5rem,8vw,5.6rem);max-width:900px;margin:.8rem 0 1.35rem}.lead{font:500 clamp(1.25rem,3vw,1.5rem)/1.4 var(--lx-serif);max-width:700px}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.7rem}.artifact-section{padding:2.2rem 0 4.4rem}.artifact-grid{width:min(1100px,calc(100% - 34px));margin:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.artifact-card{background:#fff;border:1px solid #2b322a16;border-radius:10px;padding:24px}.artifact-card h2{font-size:1.7rem;margin-bottom:.8rem}.artifact-card p{color:#586057}.chips{display:flex;gap:8px;flex-wrap:wrap}.chips span,.chips a{background:var(--sage-mist);border-radius:99px;padding:7px 11px;font-size:12px;color:var(--ink);text-decoration:none}.artifact-cta{width:min(1100px,calc(100% - 34px));margin:0 auto 4rem;background:var(--sage-deep);color:#fff;border-radius:14px;padding:42px;display:flex;justify-content:space-between;align-items:center;gap:25px}.artifact-cta .lx-eyebrow{color:var(--gold-soft)}.artifact-cta h2{font-size:clamp(2.2rem,5vw,3.4rem);margin:.4rem 0 0}.cta-gold{display:inline-flex;padding:11px 18px;border-radius:99px;background:var(--gold);color:#fff;text-decoration:none;white-space:nowrap}@media(max-width:800px){.artifact-grid{grid-template-columns:1fr}.artifact-cta{display:block;padding:30px 24px}.cta-gold{margin-top:18px}.actions a{width:100%}}
</style>
