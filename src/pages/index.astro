---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro';
import BathroomJourney from '../components/luxe/BathroomJourney.astro';
import ProjectCard from '../components/luxe/ProjectCard.astro';
import { getProjects } from '../lib/luxe';
import {
  imageUrl,
  WARRANTY_SCHEDULE,
  PROJECT_INITIATION,
} from '../lib/luxe-config';

const allProjects = await getProjects();
const projects = allProjects
  .filter((project) => project.published && (project.project_status ?? 'completed') === 'completed')
  .sort((a, b) =>
    Number(b.slug === 'nawala-complete-bathroom-renovation') - Number(a.slug === 'nawala-complete-bathroom-renovation')
    || Number(b.featured) - Number(a.featured)
    || Number(Boolean(b.after_image_url)) - Number(Boolean(a.after_image_url))
  );
// Public homepage portfolio order, regardless of project publish date.
// Gampaha remains clearly labelled in progress; Aluthgama currently has
// no final image, so its card displays the existing honest placeholder.
const homepagePortfolioOrder = [
  'nawala-complete-bathroom-renovation',
  'avissawella-bathroom-renovation',
  'kotte-bathroom-renovation',
  'matugama-bathroom-renovation',
  'gampaha-returning-client-two-bathrooms',
  'aluthgama-bathroom-renovation',
  'kegalle-bathroom-renovation',
];
const featuredProjects = allProjects
  .filter((project) =>
    project.published &&
    homepagePortfolioOrder.includes(project.slug) &&
    ['completed', 'in_progress'].includes(project.project_status ?? 'completed')
  )
  .sort((a, b) => homepagePortfolioOrder.indexOf(a.slug) - homepagePortfolioOrder.indexOf(b.slug));
// Keep the hero based on real photographs of completed bathrooms only.
const photographedProjects = projects.filter((project) => Boolean(project.after_image_url));
const heroProject = photographedProjects[0] ?? null;
const heroCover = heroProject?.after_image_url ?? null;
const initiationPrice = PROJECT_INITIATION.amount.toLocaleString('en-LK');


const brandSystems = [
  { name: 'Swiss Bathware', role: 'Bathware & tapware', image: '/images/brands/swiss-bathware.webp' },
  { name: 'Rocell', role: 'Tiles & surfaces', image: '/images/brands/rocell.webp' },
  { name: 'Swisstek', role: 'Adhesive & grout', image: '/images/brands/swisstek.webp' },
  { name: 'S-lon', role: 'Pipes & accessories', image: '/images/brands/slon.webp' },
  { name: 'Tokyo Super 2K', role: 'Waterproofing system', image: '/images/brands/tokyo-cement.webp' },
  { name: 'ACL', role: 'Electrical cables', image: '/images/brands/acl-cables.webp' },
];

---
<LuxeLayout title="Premium Bathroom Renovations in Sri Lanka | BathSpace by LUXEhome" description="Imagine your next bathroom. Explore the details, see real BathSpace renovations and plan your complete renovation with LUXEhome in Sri Lanka." ogImage={heroCover || undefined} viewContent={{content_name:'BathSpace complete bathroom renovation service',content_category:'Premium bathroom renovation',content_type:'service'}}>
  <BathroomJourney />
  <section class="home-intro wrap">
    <p class="eyebrow">Complete bathroom renovations</p>
    <h2>A room you love.<br /><em>A team you can rely on.</em></h2>
    <div><p>From the first layout to the final clean, BathSpace manages your complete renovation—design, construction and every finishing detail.</p><p class="small">Design led by Charitha Amarasinghe, Founder &amp; CEO, alongside our site supervisor and specialist trades. <a href="/team">Meet the team →</a></p></div>
  </section>
  <section id="home-projects" class="wrap section" tabindex="-1">
    <header><div><p class="eyebrow">Real homes. Real transformations.</p><h2>See what comes to life.</h2></div><a href="/projects">All bathroom projects ↗</a></header>
    {featuredProjects.length ? <div class="project-grid">{featuredProjects.slice(0,3).map(project=><ProjectCard project={project}/>)}</div> : <p>Explore our project stories, photographs and progress updates. <a href="/projects">View our projects →</a></p>}
  </section>
  <section class="behind section">
    <div class="wrap behind-grid"><div><p class="eyebrow">Behind the finish</p><h2>Beautiful on the surface.<br /><em>Considered underneath.</em></h2><p>The details you cannot see deserve just as much care.</p><a href="/how-we-build">Explore how we build →</a></div>
    <div class="reveals">
      <details><summary>01 · A dry, protected foundation <span>＋</span></summary><p>Waterproofing, sealed junctions and a documented flood test before the next layer closes the work.</p></details>
      <details><summary>02 · Water that goes where it should <span>＋</span></summary><p>Concealed plumbing, floor levels, shower drainage and accessible drain covers planned as a connected system.</p></details>
      <details><summary>03 · Light, air and finishing <span>＋</span></summary><p>Mirror lighting, ceiling lights, ventilation, tile alignment and silicone finishing coordinated around the room.</p></details>
    </div></div>
  </section>
  <section class="wrap section investment">
    <div><p class="eyebrow">Plan your renovation</p><h2>Clarity before<br /><em>construction.</em></h2><p class="price">Typically LKR 1.5M–2.5M <small>per complete bathroom renovation</small></p><p>Final investment depends on room size, existing conditions, layout changes and your selected finishes. This is a guide, not a fixed package.</p><a href="/pricing">Explore pricing and scope →</a><p class="overseas">Living abroad? <a href="/overseas-bathroom-renovation">Plan your Sri Lankan renovation remotely ↗</a></p></div>
    <div class="proposal"><p class="eyebrow">Your design &amp; quotation package</p><h3>LKR {initiationPrice} <small>per bathroom · payable upfront</small></h3><ul>{PROJECT_INITIATION.includes.map(item=><li>{item}</li>)}</ul><p>The full package fee is credited towards that bathroom’s agreed renovation price when you appoint BathSpace to build. You keep the proposal if you choose not to proceed.</p><p>{PROJECT_INITIATION.delivery}</p><details><summary>Planning several bathrooms?</summary><p>Each bathroom needs its own measurements, design and quotation package. We confirm the total before payment.</p></details></div>
  </section>
  <section class="wrap section assurance"><header><div><p class="eyebrow">Selected with care</p><h2>Quality you can name.</h2></div><p>Your proposal specifies the brands and materials. Alternatives are approved before purchase.</p></header><div class="brands">{brandSystems.map(brand=><div><img src={brand.image} width="160" height="64" loading="lazy" alt={brand.name}/><span>{brand.role}</span></div>)}</div><div class="warranty"><p><strong>{WARRANTY_SCHEDULE[0].period} workmanship warranty</strong><br/>Product warranties follow manufacturer terms.</p><a href="/warranty-aftercare">Warranty &amp; aftercare details →</a></div></section>
  <section class="closing"><div class="wrap"><p class="eyebrow">Make room for something better</p><h2>Now, imagine yours.</h2><p>Tell us your location, timing and what you would love to change.<br/>Your first phone or WhatsApp conversation is free.</p><a class="cta" href="/book-site-inspection">Discuss my bathroom ↗</a><a class="process" href="/how-it-works">See the steps from enquiry to handover →</a></div></section>
</LuxeLayout>
<style>
.wrap{width:min(1180px,calc(100% - 48px));margin-inline:auto}.section{padding-block:90px;border-top:1px solid #d9d7ce;scroll-margin-top:90px}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:10px;color:#68745f;margin-bottom:20px}h2{font:500 clamp(38px,4.6vw,64px)/1.06 var(--lx-serif);letter-spacing:-.025em;margin:0 0 25px;color:#303b30}h2 em{font-weight:400;color:#74806c}p{line-height:1.8;color:#626b5e;font-size:16px}a{color:#475a42;text-underline-offset:6px;font-size:13px}header{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:38px}header p{max-width:40ch}.home-intro{padding-block:90px;display:grid;grid-template-columns:1fr 1fr;column-gap:80px}.home-intro>.eyebrow{grid-column:1/-1}.home-intro .small{font-size:13px;margin-top:20px}.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.behind{background:#e9eade}.behind-grid,.investment{display:grid;grid-template-columns:1fr 1fr;gap:80px}.reveals details{border-top:1px solid #bfc7b8;padding:23px 0}.reveals details:last-child{border-bottom:1px solid #bfc7b8}summary{cursor:pointer;font-size:15px;line-height:1.5;color:#3e4b39}summary span{float:right}.reveals p{font-size:14px;margin-top:20px}.price{font:500 32px var(--lx-serif);color:#3c4b37;margin:30px 0 20px}.price small,.proposal small{display:block;font:13px var(--lx-sans);margin-top:10px;color:#6d7568}.overseas{font-size:13px;margin-top:35px}.proposal{background:#eeece2;padding:38px}.proposal h3{font:500 42px var(--lx-serif);color:#36432f}.proposal ul{padding:20px 0 20px 18px;border-bottom:1px solid #d1d3c5}.proposal li{font-size:14px;color:#52604b;line-height:1.65;padding:5px 0}.proposal p{font-size:13px;margin-top:20px}.proposal details{margin-top:20px}.brands{display:grid;grid-template-columns:repeat(6,1fr);gap:24px}.brands>div{display:grid;place-items:center;gap:14px;text-align:center}.brands img{width:110px;height:55px;object-fit:contain}.brands span{font-size:10px;color:#717969}.warranty{display:flex;justify-content:space-between;align-items:center;gap:30px;border-top:1px solid #d9d7ce;margin-top:40px;padding-top:25px}.warranty p{font-size:13px}.closing{padding:100px 0;background:#29352a;text-align:center}.closing h2{color:#f4eee0;font-size:clamp(48px,7vw,86px)}.closing .eyebrow{color:#c5cfb9}.closing p{color:#ccd2c4}.cta{display:inline-block;background:#ede8d9;padding:17px 27px;margin-top:25px;color:#29352a;text-decoration:none}.process{display:block;color:#ccd2c4;margin-top:25px}@media(max-width:800px){.home-intro,.behind-grid,.investment{grid-template-columns:1fr;gap:25px}.project-grid{grid-template-columns:1fr}.brands{grid-template-columns:repeat(3,1fr);row-gap:30px}header{display:block}header>a{display:inline-block;margin-top:10px}.warranty{display:block}.section,.home-intro{padding-block:60px}.proposal{padding:25px}.wrap{width:calc(100% - 36px)}}
</style>
