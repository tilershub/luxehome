---
import LuxeLayout from '../layouts/LuxeLayout.astro';
---
<LuxeLayout title="Thank you. Let’s make the next step clear. — LUXEhome" description="Your LUXEhome inquiry has been received."><section class="thanks"><p class="lx-eyebrow">Inquiry received</p><h1>Thank you. Let’s make the next step clear.</h1><p>Keep your project photos, approximate dimensions and location ready. Our team will use them to guide the first conversation.</p><div><a class="lx-btn-wa" href="/book-site-inspection">Book site inspection</a><a class="lx-btn-ghost" href="/designs">Browse designs</a></div></section></LuxeLayout>
<style>.thanks{width:min(900px,calc(100% - 34px));margin:auto;padding:clamp(4rem,10vw,8rem) 0}.thanks h1{font-size:clamp(3.5rem,8vw,5.8rem);margin:.7rem 0 1.3rem}.thanks>p:not(.lx-eyebrow){font:500 1.35rem/1.45 var(--lx-serif);max-width:700px}.thanks>div{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}</style>
