---
// Routed product catalogue CMS. Public shop reads published rows from lx_products.
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>Shop — LUXEhome Admin</title></head>
<body>
  <header><a href="/admin">← Admin</a><strong>Shop Products</strong><button id="new">＋ New product</button></header>
  <main id="main"></main><div id="toast"></div>
  <style>
    *{box-sizing:border-box}body{margin:0;background:#161c1a;color:#f0ece0;font:15px system-ui,sans-serif}header{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:14px;padding:13px 16px;background:#1e2422;border-bottom:1px solid #ffffff14}header a{color:#b8945a;text-decoration:none}header strong{flex:1}button{border:0;border-radius:7px;background:#b8945a;color:#17130d;padding:9px 13px;font-weight:700;cursor:pointer}main{max-width:900px;margin:auto;padding:18px}.card{display:flex;gap:12px;align-items:center;background:#1e2422;border:1px solid #ffffff14;border-radius:9px;padding:12px;margin-bottom:9px;cursor:pointer}.card img{width:58px;height:58px;object-fit:cover;border-radius:6px;background:#252c29}.card .body{flex:1}.muted{color:#f0ece099;font-size:.78rem}.pill{font-size:.68rem;padding:4px 8px;border-radius:99px;background:#ffffff12}.pill.pub{color:#22c55e;background:#22c55e1f}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{margin-bottom:13px}.field label{display:block;color:#f0ece099;text-transform:uppercase;letter-spacing:.06em;font-size:.7rem;margin-bottom:5px}.field input,.field textarea,.field select{width:100%;border:1px solid #ffffff17;background:#252c29;color:#f0ece0;border-radius:7px;padding:10px;font:inherit}.field textarea{min-height:100px;resize:vertical}.upload{display:flex;gap:7px}.upload input[type=url]{flex:1}.upload label{display:grid;place-items:center;border:1px solid #b8945a;color:#b8945a;border-radius:7px;padding:0 12px;cursor:pointer}.upload input[type=file]{display:none}.checks{display:flex;flex-wrap:wrap;gap:18px;margin:14px 0}.actions{display:flex;gap:9px;margin-top:20px}.actions .save{flex:1;background:#22c55e}.actions .delete{background:#ef444422;color:#ef4444;border:1px solid #ef444455}.actions .back{background:#252c29;color:#f0ece0}.login{max-width:380px;margin:60px auto;padding:24px;background:#1e2422;border-radius:10px}#toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,90px);background:#f0ece0;color:#17130d;padding:10px 18px;border-radius:8px;transition:.2s}#toast.show{transform:translate(-50%,0)}@media(max-width:600px){.grid{grid-template-columns:1fr}header{flex-wrap:wrap}.card{align-items:flex-start}.actions{position:sticky;bottom:0;background:#161c1a;padding:10px 0}}
  </style>
  <script>
    import { createClient } from '@supabase/supabase-js';
    import { sendAdminSignInLink } from '../../lib/luxe-admin-sign-in';
    const URL=import.meta.env.PUBLIC_SUPABASE_URL, KEY=import.meta.env.PUBLIC_SUPABASE_ANON_KEY, BUCKET='luxehome-media';
    const main=document.getElementById('main'); let sb, products=[];
    const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const slugify=(s)=>s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
    function toast(s){const el=document.getElementById('toast');el.textContent=s;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2300)}
    async function auth(){const {data:{session}}=await sb.auth.getSession();if(session)return true;main.innerHTML=`<div class="login"><h2>Sign in by email link</h2><div class="field"><label>Email</label><input id="email" type="email" autocomplete="email" placeholder="name@example.com" required></div><button id="signin">Email me a sign-in link</button><p id="login-status" class="muted"></p></div>`;document.getElementById('signin').onclick=async()=>{const email=document.getElementById('email').value.trim().toLowerCase();if(!email){document.getElementById('login-status').textContent='Enter your authorised email address.';return}const error=await sendAdminSignInLink(sb,email,location.origin+'/admin/shop');document.getElementById('login-status').textContent=error?error.message:`Check ${email} and open the secure sign-in link.`};return false}
    async function boot(){if(!URL||!KEY){main.innerHTML='<p>Supabase is not configured.</p>';return}if(!sb)sb=createClient(URL,KEY);if(!(await auth()))return;const {data,error}=await sb.from('lx_products').select('*').order('sort_order');if(error)return toast(error.message);products=data||[];list()}
    function list(){main.innerHTML=products.length?products.map(p=>`<article class="card" data-id="${p.id}"><img src="${esc(p.cover_image_url||'')}" alt=""><div class="body"><strong>${esc(p.name)}</strong><div class="muted">${esc(p.category||'Uncategorised')} · Rs. ${Number(p.price_lkr).toLocaleString('en-LK')}</div></div><span class="pill ${p.published?'pub':''}">${p.published?'Published':'Draft'}</span></article>`).join(''):'<p class="muted">No products yet. Create the first shop product.</p>';document.querySelectorAll('.card').forEach(c=>c.onclick=()=>editor(products.find(p=>p.id===c.dataset.id)))}
    function editor(existing){const fresh=!existing,p=existing||{name:'',slug:'',category:'',short_description:'',description:'',price_lkr:'',compare_at_price_lkr:'',cover_image_url:'',gallery_image_urls:[],features:[],preorder:true,stock_status:'made_to_order',featured:false,published:false,sort_order:products.length};main.innerHTML=`<div class="grid"><div class="field"><label>Name *</label><input id="name" value="${esc(p.name)}"></div><div class="field"><label>Slug</label><input id="slug" value="${esc(p.slug)}"></div><div class="field"><label>Category</label><input id="category" value="${esc(p.category)}"></div><div class="field"><label>Stock</label><select id="stock">${['in_stock','made_to_order','out_of_stock'].map(x=>`<option ${x===p.stock_status?'selected':''}>${x}</option>`)}</select></div><div class="field"><label>Price LKR *</label><input id="price" type="number" value="${p.price_lkr}"></div><div class="field"><label>Compare-at price</label><input id="compare" type="number" value="${p.compare_at_price_lkr??''}"></div></div><div class="field"><label>Card description</label><textarea id="short">${esc(p.short_description)}</textarea></div><div class="field"><label>Full product description</label><textarea id="desc">${esc(p.description)}</textarea></div><div class="field"><label>Cover image</label><div class="upload"><input id="cover" type="url" value="${esc(p.cover_image_url)}" placeholder="Paste URL or upload"><label>Upload<input id="file" type="file" accept="image/jpeg,image/png,image/webp,image/avif"></label></div></div><div class="field"><label>Gallery URLs — one per line</label><textarea id="gallery">${esc((p.gallery_image_urls||[]).join('\n'))}</textarea></div><div class="field"><label>Features — one per line</label><textarea id="features">${esc((p.features||[]).join('\n'))}</textarea></div><div class="checks"><label><input id="preorder" type="checkbox" ${p.preorder?'checked':''}> Pre-order / made to order</label><label><input id="featured" type="checkbox" ${p.featured?'checked':''}> Featured</label><label><input id="published" type="checkbox" ${p.published?'checked':''}> Published</label></div><div class="actions"><button class="save" id="save">Save product</button>${fresh?'':`<button class="delete" id="delete">Delete</button>`}<button class="back" id="back">Back</button></div>`;
      file.onchange=async()=>{const f=file.files[0];if(!f)return;if(f.size>10485760)return toast('Image must be 10 MB or smaller');const ext=(f.name.split('.').pop()||'jpg').replace(/[^a-z0-9]/gi,'');const path=`shop/${Date.now()}-${crypto.randomUUID()}.${ext}`;const {error}=await sb.storage.from(BUCKET).upload(path,f,{cacheControl:'31536000'});if(error)return toast(error.message);cover.value=sb.storage.from(BUCKET).getPublicUrl(path).data.publicUrl;toast('Image uploaded')};
      back.onclick=list;save.onclick=async()=>{const row={name:name.value.trim(),slug:slug.value.trim()||slugify(name.value),category:category.value.trim()||null,short_description:short.value.trim()||null,description:desc.value.trim()||null,price_lkr:Number(price.value),compare_at_price_lkr:compare.value?Number(compare.value):null,cover_image_url:cover.value.trim()||null,gallery_image_urls:gallery.value.split('\n').map(x=>x.trim()).filter(Boolean),features:features.value.split('\n').map(x=>x.trim()).filter(Boolean),preorder:preorder.checked,stock_status:stock.value,featured:featured.checked,published:published.checked,sort_order:p.sort_order||0};if(!row.name||!row.price_lkr)return toast('Name and price are required');const result=fresh?await sb.from('lx_products').insert(row):await sb.from('lx_products').update(row).eq('id',p.id);if(result.error)return toast(result.error.message);toast('Product saved');boot()};
      document.getElementById('delete')?.addEventListener('click',async()=>{if(!confirm(`Delete ${p.name}?`))return;const {error}=await sb.from('lx_products').delete().eq('id',p.id);if(error)return toast(error.message);toast('Product deleted');boot()});
    }
    document.getElementById('new').onclick=()=>editor(null);boot();
  </script>
</body></html>
