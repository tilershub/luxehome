---
import AdminShell from '../../components/admin/AdminShell.astro';
const cards=[['Project Proposals','Create, approve and download client proposal PDFs','/admin/proposals'],['Designs','Complete named design files','/admin/cms/designs'],['Projects','Stories, journey and crew','/admin/cms/projects'],['Blog Articles','Useful SEO content','/admin/cms/blog'],['Website Pages','Editorial and legal pages','/admin/cms/pages'],['Products','Shop catalogue','/admin/cms/products'],['Categories','Blog, product and media groups','/admin/cms/categories'],['Site Inspections','Leads and follow-up','/admin/cms/inspections'],['Team','Permanent and project people','/admin/cms/team'],['Media Library','Stored images and alt text','/admin/cms/media'],['Global Settings','Contact, warranty and SEO defaults','/admin/cms/settings']];
---
<AdminShell title="Dashboard"><a slot="action" class="new" href="/admin/cms/designs?new=1">+ New design</a><section class="welcome"><p class="eyebrow">Keep the site current</p><h2>Everything that powers LUXEhome.</h2><p>The public website is organised around complete design files, transparent project stories and clear next steps.</p></section><div class="grid">{cards.map(([title,copy,href])=><a href={href}><h3>{title}</h3><p>{copy}</p><span>Open →</span></a>)}</div></AdminShell>
<style>.new{background:#5c6b56;color:#fff;padding:10px 15px;border-radius:6px;text-decoration:none}.welcome{background:#dfe5db;border-radius:12px;padding:28px;margin-bottom:20px}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:11px;color:#5c6b56}.welcome h2{font:500 clamp(30px,5vw,46px) 'Cormorant Garamond';margin:5px 0}.welcome>p:last-child{max-width:650px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.grid a{background:#fff;border:1px solid #2b322a16;border-radius:9px;padding:20px;text-decoration:none;color:#2b322a}.grid h3{font:500 25px 'Cormorant Garamond';margin:0}.grid p{color:#667064;min-height:2.8em}.grid span{color:#5c6b56}@media(max-width:900px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:550px){.grid{grid-template-columns:1fr}}</style>
