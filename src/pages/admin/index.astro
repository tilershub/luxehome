---
import AdminShell from '../../components/admin/AdminShell.astro';
const cards=[['Project Proposals','Create, approve and download client proposal PDFs','/admin/proposals'],['Projects','Real bathrooms, images, materials and project teams','/admin/cms/projects'],['Fixture Library','Reusable fixture photos, specifications and fixed selling prices','/admin/cms/fixture-library'],['Blog Articles','Useful SEO content','/admin/cms/blog'],['Website Pages','Editorial and legal pages','/admin/cms/pages'],['Categories','Blog, product and media groups','/admin/cms/categories'],['Bathroom Enquiries','Enquiry dates, customer details and follow-up management','/admin/enquiries'],['Team','Permanent and project people','/admin/cms/team'],['Media Library','Stored images and alt text','/admin/cms/media'],['Global Settings','Contact, warranty and SEO defaults','/admin/cms/settings']];
const workspaceCards = cards.filter(([, , href]) => ['/admin/proposals','/admin/cms/projects','/admin/enquiries','/admin/cms/team'].includes(href));
const websiteCards = cards.filter(([, , href]) => !workspaceCards.some(([, , workspaceHref]) => workspaceHref === href));
---
<AdminShell title="Dashboard"><a slot="action" class="new" href="/admin/cms/projects?new=1">+ New project</a><section class="welcome"><p class="eyebrow">LUXEhome Admin 2.0</p><h2>Business operations and website content, together.</h2><p>Manage customer enquiries, proposals, projects, team information and your published BathSpace content. Finance, procurement and site operations will be added as secured modules.</p></section><h2 class="section-heading">Workspace</h2><div class="grid">{workspaceCards.map(([title,copy,href])=><a href={href}><h3>{title}</h3><p>{copy}</p><span>Open →</span></a>)}</div><h2 class="section-heading">Website & Catalogue</h2><div class="grid">{websiteCards.map(([title,copy,href])=><a href={href}><h3>{title}</h3><p>{copy}</p><span>Open →</span></a>)}</div></AdminShell>
<style>.section-heading{font:500 29px 'Cormorant Garamond',serif;margin:26px 0 12px}.new{background:#5c6b56;color:#fff;padding:10px 15px;border-radius:6px;text-decoration:none}.welcome{background:#dfe5db;border-radius:12px;padding:28px;margin-bottom:20px}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:11px;color:#5c6b56}.welcome h2{font:500 clamp(30px,5vw,46px) 'Cormorant Garamond';margin:5px 0}.welcome>p:last-child{max-width:650px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.grid a{background:#fff;border:1px solid #2b322a16;border-radius:9px;padding:20px;text-decoration:none;color:#2b322a}.grid h3{font:500 25px 'Cormorant Garamond';margin:0}.grid p{color:#667064;min-height:2.8em}.grid span{color:#5c6b56}@media(max-width:900px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:550px){.grid{grid-template-columns:1fr}}</style>
