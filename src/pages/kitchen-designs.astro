---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro'; import SpaceDesigns from '../components/luxe/SpaceDesigns.astro'; import { getDesigns } from '../lib/luxe';
const designs = await getDesigns({ spaceSlug: 'kitchens' });
---
<LuxeLayout
  ogImage="/spaces/kitchen.webp"
  ogImageAlt="LUXEhome kitchen designs" title="Sri Lankan Spice Kitchen Designs — LUXEhome"><SpaceDesigns space="kitchens" designs={designs} /></LuxeLayout>
