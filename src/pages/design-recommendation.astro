---
import LuxeLayout from '../layouts/LuxeLayout.astro'; import { WHATSAPP_NUMBER } from '../lib/luxe-config';
---
<LuxeLayout title="Get a Design Recommendation — LUXEhome" description="Tell LUXEhome about your room, style and investment range and receive a shortlist of suitable named designs.">
  <section class="rec-hero"><p class="lx-eyebrow">Find your direction</p><h1>Get a design recommendation.</h1><p>Tell us your room size, preferred feeling and approximate investment range. We’ll recommend the best-fitting named designs.</p></section>
  <form id="rec"><div class="grid"><label>Full name<input id="name" required></label><label>WhatsApp number<input id="phone" required></label><label>Space type<select id="space"><option>Bathroom</option><option>Kitchen</option><option>Staircase</option><option>Floor</option></select></label><label>Approximate size<input id="size"></label><label>Preferred collection<select id="collection"><option>Not sure</option><option>Standard</option><option>Premium</option><option>Signature</option></select></label><label>Investment range<input id="budget"></label></div><button>Continue on WhatsApp</button><small>Your details are handed to WhatsApp; send the prepared message to complete the inquiry.</small></form>
</LuxeLayout>
<script define:vars={{WHATSAPP_NUMBER}} is:inline>document.getElementById('rec').addEventListener('submit',e=>{e.preventDefault();const v=id=>document.getElementById(id).value;const msg=`Hi LUXEhome! I would like a design recommendation.\nName: ${v('name')}\nPhone: ${v('phone')}\nSpace: ${v('space')}\nApprox. size: ${v('size')}\nCollection: ${v('collection')}\nInvestment range: ${v('budget')}`;open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`,'_blank')});</script>
<style>
  .rec-hero,#rec{width:min(850px,calc(100% - 34px));margin:auto}.rec-hero{padding:clamp(3.5rem,8vw,6rem) 0 3rem}.rec-hero h1{font-size:clamp(3.4rem,8vw,5.3rem);margin:.7rem 0 1rem}.rec-hero>p:last-child{font:500 1.3rem/1.45 var(--lx-serif)}#rec{background:var(--cream-deep);padding:30px;border-radius:12px;margin-bottom:5rem}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}label{font-size:.78rem}input,select{display:block;width:100%;margin-top:5px;padding:12px;border:1px solid #2b322a33;background:#fff;border-radius:7px;font:inherit}button{width:100%;margin-top:20px;padding:14px;border:0;background:var(--sage-deep);color:#fff;font:inherit}small{display:block;margin-top:10px;color:#667064}@media(max-width:650px){.grid{grid-template-columns:1fr}}
</style>
