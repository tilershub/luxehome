---
import LuxeLayout from '../../layouts/LuxeLayout.astro';
import { getSpaces, getDesigns, type Design } from '../../lib/luxe';
import { formatLKRM, cloudinary, waLink } from '../../lib/luxe-config';
import { CATALOGUE_DESIGNS, SPACE_PRESENTATION } from '../../lib/luxe-catalogue';

const dbSpaces = await getSpaces();
const spaces = dbSpaces.length ? dbSpaces : Object.entries(SPACE_PRESENTATION).map(([slug, value], index) => ({ id: slug, slug, name: value.name, sinhala_name: null, sort_order: index }));
const dbDesigns = await getDesigns();
const catalogueFallbacks = CATALOGUE_DESIGNS.map((item, index) => ({
  id: `catalogue-${item.space}-${item.slug}`, slug: item.slug, name: item.name,
  space_id: item.space, collection: item.collection, tagline: item.tagline,
  description: null, starting_price_lkr: item.startingPrice ?? 0, min_sqm: item.minSqm,
  new_starting_price_lkr: item.startingPrice ?? null,
  renovation_starting_price_lkr: item.renovationStartingPrice ?? null,
  cover_image_url: null, video_3d_url: null, video_work_url: null, workflow_text: null,
  highlights: [], featured: false, sort_order: index,
  space: spaces.find((space) => space.slug === item.space),
})) as Design[];
const catalogueKeys = new Set(dbDesigns.map((item) => `${item.space?.slug}:${item.slug}`));
const designs = [...dbDesigns, ...catalogueFallbacks.filter((item) => !catalogueKeys.has(`${item.space?.slug}:${item.slug}`))];

const COLLECTIONS = [
  { key: 'standard',  label: 'Standard Collection' },
  { key: 'premium',   label: 'Premium Collection' },
  { key: 'signature', label: 'Signature Collection' },
] as const;

function highlights(d: Design): string[] {
  const hl: string[] = [...(d.highlights ?? [])];
  if (d.tagline) hl.push(d.tagline);
  hl.push('Complete documented design file');
  hl.push('Fixed quotation before work begins');
  return hl.slice(0, 3);
}
---

<LuxeLayout
  title="Designs — LUXEhome Catalogue | Bathrooms, Kitchens, Staircases & Floors"
  description="Browse the LUXEhome design catalogue: named, fully documented designs for bathrooms, kitchens, staircases and floors — each with a starting price, complete fixture list, and technical drawings."
>
  <section class="dz-hero">
    <p class="lx-eyebrow lxr">The Catalogue</p>
    <h1 class="lxr">Choose a design,<br /><em>not a guess.</em></h1>
    <p class="dz-intro lxr">
      Every LUXEhome design is a complete, documented product — named, priced, and specified
      down to the last fixture before work begins.
    </p>
  </section>

  <section class="dz-body">
    {spaces.length > 0 && (
      <div class="dz-tabs lxr" role="tablist" aria-label="Filter by space">
        {spaces.map((s, index) => (
          <button class:list={["dz-tab", { "is-active": index === 0 }]} data-space={s.slug}>{s.name}</button>
        ))}
      </div>
    )}

    {designs.length === 0 ? (
      <div class="dz-empty lxr">
        <div class="dz-empty-mark"><strong>LUXE</strong><em>home</em></div>
        <p>The catalogue is being prepared. Message us on WhatsApp and we will send you the current design files directly.</p>
        <a href={waLink('Hi LUXEhome! Can you send me your current design catalogue?')} class="lx-btn-wa" target="_blank" rel="noopener noreferrer">WhatsApp Us</a>
      </div>
    ) : (
      COLLECTIONS.map((col) => {
        const group = designs.filter((d) => d.collection === col.key);
        if (group.length === 0) return null;
        return (
          <div class="dz-collection" data-collection={col.key}>
            <h2 class="dz-col-title lxr">{col.label}</h2>
            <div class="dz-grid">
              {group.map((d) => (
                <a href={`/designs/${d.slug}`} class="dz-card lxr" data-card-space={d.space?.slug ?? ''}>
                  <div class="dz-card-img">
                    {d.cover_image_url
                      ? <img src={cloudinary(d.cover_image_url, 700)} alt={`${d.name} — ${col.label} design`} loading="lazy" width="700" height="500" />
                      : <div class="dz-card-placeholder"><strong>LUXE</strong><em>home</em><span>{d.name}</span></div>}
                    {d.min_sqm
                      ? <span class="dz-badge">Requires min. {d.min_sqm} m²</span>
                      : <span class="dz-badge dz-badge--any">Fits any size</span>}
                  </div>
                  <div class="dz-card-body">
                    <p class="lx-eyebrow">{col.label.replace(' Collection', '')} · {d.space?.name ?? ''}</p>
                    <h3 class="dz-card-name">{d.name}</h3>
                    {d.tagline && <p class="dz-card-tag">{d.tagline}</p>}
                    <ul class="dz-card-points">
                      {highlights(d).map((h) => <li>{h}</li>)}
                    </ul>
                    <div class="dz-card-price">{d.starting_price_lkr > 0 ? formatLKRM(d.starting_price_lkr) : 'Starting price to be confirmed'}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })
    )}
  </section>
</LuxeLayout>

<script is:inline>
(function () {
  var tabs = document.querySelectorAll('.dz-tab');
  function apply(space) {
    document.querySelectorAll('.dz-card').forEach(function (card) {
      card.style.display = (!space || card.dataset.cardSpace === space) ? '' : 'none';
    });
    document.querySelectorAll('.dz-collection').forEach(function (col) {
      var visible = col.querySelectorAll('.dz-card:not([style*="display: none"])').length;
      col.style.display = visible ? '' : 'none';
    });
  }
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) { t.classList.toggle('is-active', t === tab); });
      apply(tab.dataset.space);
      var url = new URL(location.href);
      if (tab.dataset.space) url.searchParams.set('space', tab.dataset.space);
      else url.searchParams.delete('space');
      history.replaceState(null, '', url);
    });
  });
  var initial = new URL(location.href).searchParams.get('space') || 'bathrooms';
  var tab = document.querySelector('.dz-tab[data-space="' + initial + '"]') || document.querySelector('.dz-tab');
  if (tab) tab.click();
})();
</script>

<style>
  .dz-hero {
    padding: clamp(3rem, 8vw, 6rem) clamp(1.2rem, 5vw, 4rem) 1rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .dz-hero h1 { font-size: clamp(2.4rem, 6vw, 4rem); margin: .6rem 0 1rem; }
  .dz-hero h1 em { color: var(--sage-deep); }
  .dz-intro { max-width: 52ch; font-size: 1.02rem; color: color-mix(in srgb, var(--ink) 78%, transparent); }

  .dz-body { max-width: 1100px; margin: 0 auto; padding: 1.5rem clamp(1.2rem, 5vw, 4rem) 3rem; }

  .dz-tabs { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 2.4rem; }
  .dz-tab {
    font-family: var(--lx-sans);
    font-size: .78rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--cream-deep);
    border-radius: 999px;
    padding: .55rem 1.2rem;
    cursor: pointer;
    transition: all .2s;
  }
  .dz-tab:hover { border-color: var(--sage); }
  .dz-tab.is-active { background: var(--sage-deep); border-color: var(--sage-deep); color: var(--cream); }

  .dz-col-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--sage-deep);
    margin: 2.2rem 0 1.2rem;
    padding-bottom: .5rem;
    border-bottom: 1px solid var(--cream-deep);
  }

  .dz-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }

  .dz-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--cream-deep);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: transform .25s, box-shadow .25s;
  }
  .dz-card:hover { transform: translateY(-4px); box-shadow: 0 14px 34px rgba(43,50,42,.1); }

  .dz-card-img { position: relative; aspect-ratio: 7 / 5; background: var(--sage-mist); }
  .dz-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dz-card-placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .3rem;
    color: var(--sage-deep);
    font-size: 1.05rem;
  }
  .dz-card-placeholder em { font-family: var(--lx-serif); }
  .dz-card-placeholder span { font-family: var(--lx-serif); font-size: 1.5rem; font-style: italic; }

  .dz-badge {
    position: absolute;
    bottom: .8rem;
    left: .8rem;
    font-size: .66rem;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    color: var(--cream);
    padding: .28rem .7rem;
    border-radius: 999px;
  }
  .dz-badge--any { background: color-mix(in srgb, var(--sage-deep) 88%, transparent); }

  .dz-card-body { padding: 1.2rem 1.3rem 1.4rem; display: flex; flex-direction: column; flex: 1; }
  .dz-card-name { font-size: 1.7rem; margin: .25rem 0 .1rem; }
  .dz-card-tag { font-family: var(--lx-serif); font-style: italic; font-size: 1rem; color: var(--sage-deep); margin-bottom: .7rem; }
  .dz-card-points { list-style: none; margin: 0 0 1rem; flex: 1; }
  .dz-card-points li {
    font-size: .82rem;
    color: color-mix(in srgb, var(--ink) 75%, transparent);
    padding: .25rem 0 .25rem 1.1rem;
    position: relative;
  }
  .dz-card-points li::before { content: ''; position: absolute; left: 0; top: .72em; width: 5px; height: 5px; border-radius: 50%; background: var(--gold); }
  .dz-card-price { font-family: var(--lx-serif); font-size: 1.3rem; font-weight: 600; color: var(--ink); }

  .dz-empty {
    text-align: center;
    padding: 4rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }
  .dz-empty-mark { font-size: 1.6rem; color: var(--sage-deep); }
  .dz-empty-mark em { font-family: var(--lx-serif); }
  .dz-empty p { max-width: 46ch; color: color-mix(in srgb, var(--ink) 70%, transparent); }

  @media (max-width: 980px) { .dz-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .dz-grid { grid-template-columns: 1fr; } }
</style>
