---
import LuxeLayout from '../../layouts/LuxeLayout.astro';
import { getDesigns, type Design } from '../../lib/luxe';
import { formatLKRM, cloudinary } from '../../lib/luxe-config';
import { CATALOGUE_DESIGNS } from '../../lib/luxe-catalogue';

const storedDesigns = await getDesigns({ spaceSlug: 'bathrooms' });
const readyCatalogue = CATALOGUE_DESIGNS.filter((item) => item.space === 'bathrooms' && item.coverImage);
const designMap = new Map<string, Design>();

for (const [index, item] of readyCatalogue.entries()) {
  designMap.set(item.slug, {
    id: `catalogue-bathrooms-${item.slug}`,
    slug: item.slug,
    name: item.name,
    space_id: 'bathrooms',
    collection: item.collection,
    tagline: item.tagline,
    description: null,
    starting_price_lkr: item.startingPrice ?? 0,
    min_sqm: item.minSqm,
    new_starting_price_lkr: item.startingPrice,
    renovation_starting_price_lkr: item.renovationStartingPrice ?? null,
    cover_image_url: item.coverImage!,
    inspiration_image_url: null,
    video_3d_url: null,
    video_work_url: null,
    workflow_text: null,
    highlights: [],
    featured: false,
    sort_order: index,
    space: { id: 'bathrooms', slug: 'bathrooms', name: 'Bathrooms', sinhala_name: null, sort_order: 0 },
  });
}

for (const stored of storedDesigns) {
  const fallback = readyCatalogue.find((item) => item.slug === stored.slug);
  const cover = stored.cover_image_url || fallback?.coverImage;
  if (!cover) continue;
  designMap.set(stored.slug, {
    ...stored,
    cover_image_url: cover,
    new_starting_price_lkr: stored.new_starting_price_lkr || stored.starting_price_lkr || fallback?.startingPrice || null,
    renovation_starting_price_lkr: stored.renovation_starting_price_lkr || fallback?.renovationStartingPrice || null,
  });
}

const designs = [...designMap.values()].sort((a, b) => a.sort_order - b.sort_order);
const collections = [
  { key: 'standard', label: 'Standard Collection' },
  { key: 'premium', label: 'Premium Collection' },
  { key: 'signature', label: 'Signature Collection' },
] as const;
---

<LuxeLayout
  title="Bathroom Designs — Complete Design Files | LUXEhome"
  description="Browse fully developed LUXEhome bathroom designs with room-size guidance, new and renovation starting prices, renders, technical drawings, fixtures and warranties."
>
  <section class="dz-hero">
    <p class="lx-eyebrow lxr">The Sri Lankan floral collection</p>
    <h1 class="lxr">Choose a bathroom design,<br /><em>not a guess.</em></h1>
    <p class="dz-intro lxr">
      Every published design is fully developed—renders, room-size guidance, new and renovation
      pricing, technical drawings, specified fixtures and warranties.
    </p>
  </section>

  <section class="dz-body">
    <div class="dz-publishing-note lxr">
      <span>Our publishing standard</span>
      <p>We add designs one by one. A design appears here only when its complete decision file is ready.</p>
    </div>

    {designs.length === 0 ? (
      <div class="dz-empty lxr">
        <p>The first complete bathroom design is being prepared. You can still request a site inspection so we can measure the room and advise the correct path.</p>
        <a href="/book-site-inspection" class="lx-btn-wa">Book Site Inspection · LKR 10,000</a>
      </div>
    ) : (
      collections.map((collection) => {
        const group = designs.filter((design) => design.collection === collection.key);
        if (group.length === 0) return null;
        return (
          <section class="dz-collection">
            <h2 class="dz-col-title lxr">{collection.label}</h2>
            <div class="dz-grid">
              {group.map((design) => (
                <a href={`/designs/${design.slug}`} class="dz-card lxr">
                  <div class="dz-card-img">
                    <img src={cloudinary(design.cover_image_url, 800)} alt={`${design.name} bathroom design`} loading="lazy" width="800" height="600" />
                    <span class="dz-badge">{design.min_sqm ? `Minimum ${design.min_sqm} m²` : 'Custom fit'}</span>
                  </div>
                  <div class="dz-card-body">
                    <p class="lx-eyebrow">{collection.label.replace(' Collection', '')}</p>
                    <h3>{design.name}</h3>
                    {design.tagline && <p class="dz-tagline">{design.tagline}</p>}
                    <dl>
                      {(design.new_starting_price_lkr || design.starting_price_lkr > 0) && (
                        <><dt>New bathroom</dt><dd>{formatLKRM(design.new_starting_price_lkr || design.starting_price_lkr)}</dd></>
                      )}
                      {design.renovation_starting_price_lkr && (
                        <><dt>Renovation</dt><dd>{formatLKRM(design.renovation_starting_price_lkr)}</dd></>
                      )}
                    </dl>
                    <strong>View complete design <span aria-hidden="true">→</span></strong>
                  </div>
                </a>
              ))}
            </div>
          </section>
        );
      })
    )}
  </section>

  <section class="dz-cta lxr">
    <div><p class="lx-eyebrow">Need help choosing?</p><h2>We will measure your bathroom.</h2><p>No dimensions are required to request the visit.</p></div>
    <a href="/book-site-inspection">Book Inspection · LKR 10,000</a>
  </section>
</LuxeLayout>

<style>
  .dz-hero,
  .dz-body,
  .dz-cta { width: min(1100px, calc(100% - 34px)); margin-inline: auto; }
  .dz-hero { padding: clamp(3.2rem, 8vw, 6.5rem) 0 2.2rem; }
  .dz-hero h1 { margin: .65rem 0 1rem; max-width: 900px; font-size: clamp(3.2rem, 7vw, 5.4rem); }
  .dz-hero h1 em { color: var(--sage-deep); }
  .dz-intro { max-width: 64ch; font: 500 clamp(1.08rem, 2.5vw, 1.28rem)/1.5 var(--lx-serif); }
  .dz-body { padding: 1rem 0 4rem; }
  .dz-publishing-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.2rem;
    align-items: center;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--gold);
    background: rgba(255,255,255,.65);
  }
  .dz-publishing-note span { color: var(--sage-deep); font-size: .68rem; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; }
  .dz-publishing-note p { color: color-mix(in srgb, var(--ink) 68%, transparent); font-size: .83rem; }
  .dz-collection { padding-top: 2.6rem; }
  .dz-col-title { margin-bottom: 1.1rem; padding-bottom: .55rem; border-bottom: 1px solid var(--cream-deep); color: var(--sage-deep); font-size: clamp(1.7rem, 4vw, 2.3rem); }
  .dz-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1rem; }
  .dz-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--cream-deep);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .dz-card:hover { transform: translateY(-4px); box-shadow: 0 16px 38px rgba(43,50,42,.1); }
  .dz-card-img { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--sage-mist); }
  .dz-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .dz-card:hover .dz-card-img img { transform: scale(1.025); }
  .dz-badge { position: absolute; left: .8rem; bottom: .8rem; padding: .3rem .7rem; border-radius: 999px; background: rgba(43,50,42,.84); color: var(--cream); font-size: .63rem; letter-spacing: .08em; text-transform: uppercase; }
  .dz-card-body { display: flex; flex-direction: column; flex: 1; padding: 1.15rem 1.25rem 1.35rem; }
  .dz-card-body h3 { margin: .2rem 0 .3rem; font-size: 1.9rem; }
  .dz-tagline { color: var(--sage-deep); font: italic 1rem/1.4 var(--lx-serif); }
  .dz-card-body dl { display: grid; grid-template-columns: 1fr auto; gap: .2rem 1rem; margin: 1rem 0; padding-top: .8rem; border-top: 1px solid var(--cream-deep); }
  .dz-card-body dt { color: color-mix(in srgb, var(--ink) 58%, transparent); font-size: .72rem; }
  .dz-card-body dd { margin: 0; font: 600 .95rem var(--lx-serif); }
  .dz-card-body > strong { margin-top: auto; font-size: .76rem; letter-spacing: .04em; }
  .dz-card-body > strong span { display: inline-block; transition: transform .2s ease; }
  .dz-card:hover .dz-card-body > strong span { transform: translateX(4px); }
  .dz-empty { display: grid; place-items: center; gap: 1rem; padding: 4rem 1rem; text-align: center; }
  .dz-empty p { max-width: 48ch; }
  .dz-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 4rem;
    padding: clamp(1.7rem, 5vw, 2.8rem);
    border-radius: 14px;
    background: var(--sage-deep);
    color: var(--cream);
  }
  .dz-cta .lx-eyebrow { color: var(--gold-soft); }
  .dz-cta h2 { margin-top: .3rem; font-size: clamp(2rem, 4.5vw, 3rem); }
  .dz-cta div > p:last-child:not(.lx-eyebrow) { margin-top: .35rem; color: rgba(247,243,235,.72); font-size: .78rem; }
  .dz-cta > a { flex: 0 0 auto; padding: .75rem 1.15rem; border-radius: 999px; background: var(--gold); color: #fff; text-decoration: none; }
  @media (max-width: 640px) {
    .dz-publishing-note { grid-template-columns: 1fr; gap: .35rem; }
    .dz-cta { display: block; }
    .dz-cta > a { display: inline-flex; margin-top: 1rem; }
  }
</style>
