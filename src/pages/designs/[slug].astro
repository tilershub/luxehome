---
export const prerender = false;
import LuxeLayout from '../../layouts/LuxeLayout.astro';
import VideoCard from '../../components/luxe/VideoCard.astro';
import ProjectCard from '../../components/luxe/ProjectCard.astro';
import KeyHighlights from '../../components/luxe/KeyHighlights.astro';
import BuildProcess from '../../components/luxe/BuildProcess.astro';
import SwipeCarouselController from '../../components/luxe/SwipeCarouselController.astro';
import { getDesignBySlug, getProjects, youtubeEmbed, isYouTubeShort, type DesignFull } from '../../lib/luxe';
import { formatLKRM, lkrM, cloudinary, FIXTURE_CATEGORIES, WARRANTY_SCHEDULE, STANDARD_DRAWINGS, PROJECT_INITIATION, formatArea, absoluteUrl } from '../../lib/luxe-config';
import {
  collectionShortLabel,
  LEGACY_BATHROOM_DESIGN_REDIRECTS,
  LEGACY_SLUG_BY_CURRENT,
  normalizeBathroomDesignIdentity,
} from '../../lib/bathroom-taxonomy';

const requestedSlug = Astro.params.slug!;
const currentSlug = LEGACY_BATHROOM_DESIGN_REDIRECTS[
  requestedSlug as keyof typeof LEGACY_BATHROOM_DESIGN_REDIRECTS
];
if (currentSlug) return Astro.redirect(`/designs/${currentSlug}`, 301);

const legacySlug = LEGACY_SLUG_BY_CURRENT[requestedSlug];
const storedDesignRaw = await getDesignBySlug(requestedSlug)
  ?? (legacySlug ? await getDesignBySlug(legacySlug) : null);
const storedDesign = storedDesignRaw
  ? normalizeBathroomDesignIdentity(storedDesignRaw)
  : null;
const design: DesignFull | null = storedDesign?.cover_image_url ? storedDesign : null;
if (!design) return Astro.redirect('/designs');

const collectionLabel = collectionShortLabel(design.collection);
const priceLabel = design.starting_price_lkr > 0 ? formatLKRM(design.starting_price_lkr) : 'Starting price to be confirmed';
const newPrice = design.new_starting_price_lkr || design.starting_price_lkr || null;
const renoPrice = design.renovation_starting_price_lkr ?? null;

const inspectionHref = `/book-site-inspection?design=${encodeURIComponent(design.slug)}`;

const drawingOf = (kind: string) => design.drawings.find((d) => d.kind === kind) ?? null;

/* The walk-in: the doorway view, then each named area in the order you
   move through the room. Only the areas that have an image are shown, and
   a CMS caption overrides the default title. */
const AREAS = [
  { kind: 'cover',        n: 'I',   kicker: 'At the door',        title: 'The first glance across the room' },
  { kind: 'vanity',       n: 'II',  kicker: 'The vanity',         title: 'Stone and warm mirror light' },
  { kind: 'water_closet', n: 'III', kicker: 'The water closet',   title: 'Concealed, quiet and neatly set out' },
  {
    kind: 'shower',
    n: 'IV',
    kicker: design.slug === 'moonstone' ? 'The bathtub' : 'The shower',
    title: design.slug === 'moonstone' ? 'The freestanding bath and concealed mixer' : 'The walk-in shower and niche',
  },
  { kind: 'shower_cubicle', n: 'V', kicker: 'The shower cubicle', title: 'Glass, hardware and precise sealing' },
  { kind: 'ceiling',      n: 'VI',  kicker: 'Looking up',         title: 'The ceiling, lighting and ventilation' },
] as const;

const steps = AREAS.flatMap((area) => {
  const source = area.kind === 'cover'
    ? (design.cover_image_url ? { image_url: design.cover_image_url, caption: null } : null)
    : drawingOf(area.kind);
  if (!source) return [];
  return [{
    n: area.n,
    kicker: `${area.kicker}`,
    title: source.caption || area.title,
    image: source.image_url,
  }];
});
const renders = steps.slice(1);

const video3d = youtubeEmbed(design.video_3d_url);
const priceTiers = design.price_tiers;

// Flat per-m² rate, derived from the first two published tiers.
const perSqmRate = (() => {
  if (priceTiers.length < 2) return null;
  const [a, b] = priceTiers;
  const span = Number(b.sqm) - Number(a.sqm);
  if (span <= 0) return null;
  const rate = (Number(b.new_price_lkr) - Number(a.new_price_lkr)) / span;
  return rate > 0 ? Math.round(rate) : null;
})();

// Explicit sort_order wins; otherwise fixtures follow the order clients look
// through a bathroom (tile → water closet → basin → …).
const categoryRank = (f: DesignFixture) => {
  const i = FIXTURE_CATEGORIES.bathrooms.indexOf(f.category);
  return i === -1 ? FIXTURE_CATEGORIES.bathrooms.length : i;
};
/* Checklist rows carrying nothing but a category name are still being
   filled in — showing them would publish an empty tab. A fixture appears
   once it has something to say. */
const hasSubstance = (f: DesignFixture) =>
  Boolean(f.image_url || f.brand || f.spec || f.model_code || f.reference_price_label);
const fixtures: DesignFixture[] = [...design.fixtures]
  .filter(hasSubstance)
  .sort((a, b) => (a.sort_order - b.sort_order) || (categoryRank(a) - categoryRank(b)));

/* Product photographs remain uncropped. When a fixture has no product image,
   pair it with the most relevant approved room render instead of repeating the
   first room image for every card. */
const fixtureImageFor = (fixture: DesignFixture) => {
  if (fixture.image_url) return fixture.image_url;

  const label = `${fixture.category} ${fixture.name}`.toLowerCase();
  const drawingKind =
    /(bathtub|bath tub|bath mixer|bath spout|bath niche)/.test(label) ? 'shower' :
    /(shower cubicle|shower enclosure|shower glass)/.test(label) ? 'shower_cubicle' :
    /(water closet|toilet|bidet|angle valve|paper holder|magic hose|flexible hose|magic bend)/.test(label) ? 'water_closet' :
    /(wash basin|basin mixer|tap|vanity|mirror)/.test(label) ? 'vanity' :
    /(shower|gully|floor drain)/.test(label) ? 'shower_cubicle' :
    /(ceiling|light|exhaust|water heater)/.test(label) ? 'ceiling' :
    null;

  return (drawingKind ? drawingOf(drawingKind)?.image_url : null) || design.cover_image_url || '';
};

/* The CMS "Card highlights" field finally does something: one highlight per
   line. With none set, the highlights are derived from the design file. */
const designHighlights = design.highlights.length > 0
  ? design.highlights.map((line) => ({ title: line }))
  : [
      ...(formatArea(design.min_sqm) ? [{ value: `${formatArea(design.min_sqm)} m²`, title: 'Minimum room', copy: 'Smaller rooms are assessed on site before the design is confirmed.' }] : []),
      ...(newPrice ? [{ value: lkrM(newPrice), title: 'New bathroom from', copy: 'The complete listed specification at the minimum fit.' }] : []),
      { value: WARRANTY_SCHEDULE[0].period, title: 'Workmanship warranty', copy: 'LUXEhome installation workmanship, documented from handover.' },
      ...(fixtures.length ? [{ value: String(fixtures.length), title: 'Specified fixtures', copy: 'Named products with brand, model, finish and manufacturer warranty where available.' }] : []),
    ];

const allRelated = storedDesign?.id
  ? await getProjects({ designId: storedDesign.id })
  : (await getProjects()).filter((project) => project.design?.slug === design.slug);
const related = allRelated.filter((project) => project.after_image_url).slice(0, 3);
const testimonials = allRelated
  .filter((project) => project.review_text)
  .slice(0, 2)
  .map((project) => ({
    text: project.review_text!,
    who: [project.review_by, project.location].filter(Boolean).join(' · ') || 'LUXEhome client',
  }));

const nameHeading = design.name_heading
  || (design.collection === 'flora'
    ? `Inspired by the ${design.name} flower.`
    : `Inspired by ${design.name}.`);
const nameStory = design.name_story
  || (design.slug === 'sigiriya-bathroom'
    ? 'Sigiriya translates monumental stone, precise geometry and the calm intelligence of its historic water gardens into a composed Heritage bathroom.'
    : design.description
    || `The ${design.name} carries its namesake’s character into a fully documented ${collectionLabel} bathroom.`);

/* Category-only checklist rows can be prepared in admin before the exact
   product is confirmed. Keep those drafts out of the public page until they
   contain a brand, item, usage note or image. */
const materials = [...design.materials]
  .filter((m) => Boolean(m.brand?.trim() || m.item?.trim() || m.usage_label?.trim() || m.image_url))
  .sort((a, b) => a.sort_order - b.sort_order);
const materialsWithPhotos = materials.filter((m) => m.image_url);

/* Video structured data ties the walkthrough to THIS page, so a video rich
   result links here rather than to youtube.com. Works with an embedded or a
   self-hosted file — only contentUrl/embedUrl changes. */
const videoSchema = (video3d && design.cover_image_url) ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: `${design.name} — 3D bathroom walkthrough`,
  description: `A vertical 3D walkthrough of the ${design.name} ${collectionLabel} bathroom by LUXEhome: vanity, water closet, shower and the complete room.`,
  thumbnailUrl: [absoluteUrl(cloudinary(design.cover_image_url, 1200))],
  uploadDate: design.created_at ?? undefined,
  // contentUrl must be a media file. While the video is hosted on YouTube,
  // embedUrl alone is correct; self-hosting an MP4 would add contentUrl.
  embedUrl: video3d,
  publisher: { '@type': 'Organization', name: 'LUXEhome', url: 'https://luxehome.lk' },
  regionsAllowed: 'LK',
}) : null;

const productSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${design.name} — ${collectionLabel} ${design.space?.name ?? ''} Design`,
  description: design.tagline ?? design.description ?? '',
  ...(design.cover_image_url ? { image: cloudinary(design.cover_image_url, 1200) } : {}),
  brand: { '@type': 'Brand', name: 'LUXEhome' },
  ...(design.starting_price_lkr > 0 ? { offers: {
    '@type': 'Offer',
    price: design.starting_price_lkr,
    priceCurrency: 'LKR',
    availability: 'https://schema.org/InStock',
    url: new URL(`/designs/${design.slug}`, Astro.site ?? 'https://luxehome.lk').href,
  }} : {}),
});
---

<LuxeLayout
  title={`${design.name} — ${collectionLabel} ${design.space?.name ?? ''} Design | ${priceLabel} | LUXEhome`}
  description={`${design.name}: ${design.tagline ?? 'a fully documented LUXEhome design'}. ${priceLabel}. Walk through the renders, fixtures, drawings and pricing, then start the LKR 50,000 project initiation for your bathroom.`}
  ogImage={design.cover_image_url ? cloudinary(design.cover_image_url, 1200) : undefined}
  ogImageAlt={`${design.name} — ${collectionLabel} bathroom design by LUXEhome`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={productSchema}></script>
    {videoSchema && <script is:inline type="application/ld+json" set:html={videoSchema}></script>}
  </Fragment>

  <!-- HERO · THE DOORWAY -->
  <header class="wx-hero" id="wx-hero">
    <div class="wx-hero-media" id="wx-hero-media">
      <img src={cloudinary(design.cover_image_url, 1600)} alt={`${design.name} — the view from the doorway`} width="1600" height="1000" fetchpriority="high" />
    </div>
    <div class="wx-hero-shade" aria-hidden="true"></div>
    <div class="wx-hero-copy">
      <p class="wx-kicker wx-kicker--light">{collectionLabel} Collection · Bathrooms</p>
      <h1>{design.name}</h1>
      {design.tagline && <p class="wx-hero-tagline">{design.tagline}</p>}
      <div class="wx-hero-prices">
        {newPrice && <div><span>New bathroom</span><strong>From {lkrM(newPrice)}</strong></div>}
        {renoPrice && <div><span>Renovation</span><strong>From {lkrM(renoPrice)}</strong></div>}
      </div>
    </div>
    <button class="wx-hero-cue" id="wx-hero-cue" aria-label="Scroll down">
      <span>Step inside</span>
      <span class="wx-cue-line" aria-hidden="true"></span>
      <span aria-hidden="true">↓</span>
    </button>
  </header>

  <KeyHighlights items={designHighlights} />

  <!-- THRESHOLD -->
  <section class="wx-threshold">
    <p class="wx-kicker">You are standing at the doorway</p>
    <p class="wx-statement">A complete bathroom, documented to the last fitting — <em>before</em> a single tile is laid.</p>
    <div class="wx-threshold-cta">
      <a href={inspectionHref}><span>Start my bathroom with this design</span><b aria-hidden="true">→</b></a>
      <small>LKR 50,000 · Fully credited if LUXEhome builds it</small>
    </div>
  </section>

  <!-- THE NAME -->
  {(design.inspiration_image_url || nameStory) && (
    <section class="wx-name">
      <div class="wx-name-grid">
        <div class="wx-name-flower">
          {design.inspiration_image_url
            ? <img src={cloudinary(design.inspiration_image_url, 420)} alt={`The ${design.name} flower — the inspiration behind this design`} loading="lazy" width="420" height="420" />
            : <span aria-hidden="true">{design.name.charAt(0)}</span>}
        </div>
        <div>
          <p class="wx-kicker">The name behind the design</p>
          <h2>{nameHeading}</h2>
          <p class="wx-body">{nameStory}</p>
        </div>
      </div>
    </section>
  )}

  <!-- THE WALK-IN -->
  {steps.length >= 2 && (
    <section id="walkin" data-swipe-carousel>
      <div class="wx-section wx-walkin-intro">
        <p class="wx-kicker">The walk-in</p>
        <h2>Step inside, one view at a time.</h2>
        <p class="wx-body" id="walkin-swipe-help">Swipe left or right and the room unfolds exactly as it does at the door — one large view at a time.</p>
      </div>
      <div
        class="wx-steps"
        role="region"
        aria-label={`${design.name} walk-in views`}
        aria-describedby="walkin-swipe-help"
        tabindex="0"
        data-swipe-track
      >
        {steps.map((step) => (
          <div class="wx-step" data-swipe-slide>
            <img src={cloudinary(step.image, 1600)} alt={`${design.name} — ${step.title}`} loading="lazy" width="1600" height="1000" />
            <div class="wx-step-shade" aria-hidden="true"></div>
            <div class="wx-step-copy">
              <div>
                <p class="wx-kicker wx-kicker--faded">{step.kicker}</p>
                <strong>{step.title}</strong>
              </div>
              <em aria-hidden="true">{step.n}</em>
            </div>
          </div>
        ))}
      </div>
      <div class="wx-walkin-dots" data-swipe-dots role="group" aria-label={`${design.name} walk-in carousel position`}>
        {steps.map((step, index) => (
          <button
            type="button"
            class:list={[{ 'is-active': index === 0 }]}
            data-swipe-dot
            aria-label={`Show ${step.kicker}, image ${index + 1} of ${steps.length}`}
            aria-current={index === 0 ? 'true' : undefined}
          ></button>
        ))}
      </div>
    </section>
  )}

  <!-- FIXTURES · UP CLOSE -->
  <section id="fixtures" class="wx-section" data-swipe-carousel>
    <div class="wx-heading-row">
      <div>
        <p class="wx-kicker">Products installed in the bathroom</p>
        <h2>Fixtures &amp; fittings.</h2>
      </div>
      <p class="wx-aside" id="fixtures-swipe-help">Swipe left or right to explore one specified item at a time. Each card shows its image, exact specification{fixtures.some((f) => f.reference_price_label) ? ' and reference price' : ''}.</p>
    </div>

    {fixtures.length > 0 ? (
      <div class="wxf-carousel">
        <div
          class="wxf-track"
          data-swipe-track
          role="region"
          aria-label={`Fixtures and fittings in ${design.name}`}
          aria-describedby="fixtures-swipe-help"
          tabindex="0"
        >
          {fixtures.map((f, i) => {
            const cardImage = fixtureImageFor(f);
            const usesRoomImage = !f.image_url;
            return (
              <article
                class="wxf-card"
                data-swipe-slide
                aria-label={`${f.name}, item ${i + 1} of ${fixtures.length}`}
              >
                <div class:list={['wxf-card-media', { 'is-room-image': usesRoomImage }]}>
                  <img
                    src={cloudinary(cardImage, 900)}
                    alt={f.image_alt || (usesRoomImage
                      ? `${f.name} in the ${design.name} bathroom design`
                      : `${f.brand ? `${f.brand} ` : ''}${f.name}`)}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    width="900"
                    height="1125"
                  />
                  <span class="wxf-count" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')} / {String(fixtures.length).padStart(2, '0')}
                  </span>
                </div>
                <div class="wxf-card-body">
                  <div class="wxf-card-top">
                    <span class="wxf-category">{f.category}</span>
                    <span class:list={['wxf-badge', { optional: f.included === false }]}>
                      {f.included === false ? 'Optional upgrade' : 'Included'}
                    </span>
                  </div>
                  <h3>{f.brand ? `${f.brand} — ` : ''}{f.name}</h3>
                  {f.spec && <p class="wxf-spec">{f.spec}</p>}
                  {f.notes && <p class="wxf-notes">{f.notes}</p>}
                  <dl class="wxf-meta">
                    {f.model_code && <><dt>Model</dt><dd>{f.model_code}</dd></>}
                    {f.finish && <><dt>Finish</dt><dd>{f.finish}</dd></>}
                    {f.quantity > 1 && <><dt>Quantity</dt><dd>{f.quantity}</dd></>}
                    {f.warranty_period && <><dt>Manufacturer warranty</dt><dd>{f.warranty_period}</dd></>}
                  </dl>
                  {f.reference_price_label && (
                    <div class="wxf-price"><span>Reference price</span><strong>{f.reference_price_label}</strong></div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
        <div class="wxf-dots" data-swipe-dots role="group" aria-label={`${design.name} fixture carousel position`}>
          {fixtures.map((f, i) => (
            <button
              type="button"
              class:list={[{ 'is-active': i === 0 }]}
              data-swipe-dot
              aria-label={`Show ${f.name}, item ${i + 1} of ${fixtures.length}`}
              aria-current={i === 0 ? 'true' : undefined}
            ></button>
          ))}
        </div>
      </div>
    ) : (
      <div class="wxf-empty"><strong>The full schedule is being prepared.</strong><p>The confirmed sanitaryware, tapware, shower, furniture, glass and accessory specification will be published here. The project initiation will confirm whether this layout is suitable for your room.</p><a href={inspectionHref}>Start this design for my bathroom →</a></div>
    )}
  </section>

  <!-- PRICING -->
  <section id="pricing" class="wx-dark">
    <div class="wx-section">
      <p class="wx-kicker wx-kicker--sage">Pricing</p>
      <h2 class="wx-dark-title">A starting price for the minimum room.</h2>
      <p class="wx-body wx-body--dark">
        {renoPrice
          ? `Both prices hold the full ${design.name} specification for a ${formatArea(design.min_sqm) ?? formatArea(priceTiers[0]?.sqm) ?? '—'} m² room.${perSqmRate ? ' Every additional square metre of floor, wall and construction area is added at a flat rate.' : ''}`
          : `The starting price holds the full ${design.name} specification for a ${formatArea(design.min_sqm) ?? formatArea(priceTiers[0]?.sqm) ?? '—'} m² room.${perSqmRate ? ' Every additional square metre of floor, wall and construction area is added at a flat rate.' : ''}`}
      </p>

      <div class="wx-from-grid">
        {newPrice && (
          <div class="wx-from-card">
            <span>New bathroom</span>
            <div><small>From</small><strong>{lkrM(newPrice)}</strong></div>
            <em>{formatArea(design.min_sqm) ? `Minimum ${formatArea(design.min_sqm)} m²` : 'Minimum fit'} · complete build</em>
          </div>
        )}
        {renoPrice && (
          <div class="wx-from-card">
            <span>Renovation</span>
            <div><small>From</small><strong>{lkrM(renoPrice)}</strong></div>
            <em>{formatArea(design.min_sqm) ? `Minimum ${formatArea(design.min_sqm)} m²` : 'Minimum fit'} · existing room</em>
          </div>
        )}
      </div>

      {priceTiers.length > 0 && (
        <div class="wx-tiers">
          <p class="wx-kicker wx-kicker--sage">Choose by room size</p>
          <div class="wx-tier-head" role="row"><span>Fit</span><span>Area</span><span>New</span><span>Renovation</span></div>
          {priceTiers.map((tier) => (
            <div class="wx-tier-row" role="row">
              <span class="wx-tier-label">{tier.label}</span>
              <span class="wx-tier-area">{formatArea(tier.sqm)} m²</span>
              <span>{lkrM(tier.new_price_lkr)}</span>
              <span class="wx-tier-reno">{lkrM(tier.renovation_price_lkr)}</span>
            </div>
          ))}
        </div>
      )}

      {perSqmRate && (
        <div class="wx-rate">
          <em>Each additional square metre</em>
          <strong>+ LKR {perSqmRate.toLocaleString('en-LK')} <span>/ m²</span></strong>
        </div>
      )}
      <p class="wx-fineprint">Final area is confirmed during the site visit. Larger or complex rooms are quoted from the same rate. Room proportions, ceiling height, access, service relocation and structural changes are assessed separately.</p>
      <a class="wx-dark-cta" href={inspectionHref}>Check this design against my bathroom →</a>
    </div>
  </section>

  <!-- MATERIALS -->
  {materials.length > 0 && (
    <section id="materials" class="wx-section">
      <div class="wx-heading-row">
        <div>
          <p class="wx-kicker">Surfaces, colours and construction layers</p>
          <h2>Materials &amp; finishes.</h2>
        </div>
        <p class="wx-aside">Tiles, waterproofing, adhesives, grout, ceiling and decorative finishes that shape the room and protect it over time.</p>
      </div>
      {materialsWithPhotos.length > 0 && (
        <div class="wx-mat-grid">
          {materialsWithPhotos.map((m) => (
            <figure class="wx-mat">
              <div class="wx-mat-img">
                <img src={cloudinary(m.image_url!, 700)} alt={`${m.brand}${m.item ? ` — ${m.item}` : ''}`} loading="lazy" width="700" height="875" />
              </div>
              <figcaption>
                <span>{m.brand}</span>
                <em>{m.usage_label || m.category}</em>
              </figcaption>
            </figure>
          ))}
        </div>
      )}
      <ul class="wx-checklist wx-material-checklist" aria-label="Materials and finishes checklist">
        {materials.map((m) => (
          <li class="wx-check-item">
            <span class="wx-check-mark" aria-hidden="true">✓</span>
            <span class="wx-check-copy">
              <strong>{m.category}</strong>
              <small>{m.brand}{m.item ? ` · ${m.item}` : ''}</small>
            </span>
            <em>{m.usage_label || 'Specified'}</em>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- TECHNICAL DRAWINGS -->
  <section id="drawings" class="wx-section">
    <p class="wx-kicker">Documented before construction</p>
    <h2>Technical drawings.</h2>
    <p class="wx-body">Four drawing sets — sampled here for a 2.5 m × 2 m (5 m²) room and customised to your bathroom in the design file. Illustrative only; not for construction.</p>
    <div class="wx-draw-grid">
      {STANDARD_DRAWINGS.map((t) => (
        <figure class="wx-draw">
          <div class="wx-draw-img">
            <img src={t.image} alt={`${t.label} — sample`} loading="lazy" width="800" height="600" />
            <div class="wx-watermark" aria-hidden="true"></div>
          </div>
          <figcaption><span>{t.label}</span><em>{t.tag}</em></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- PROJECT INITIATION -->
  <section id="fees" class="wx-panel-band">
    <div class="wx-section">
      <p class="wx-kicker">One clear first commitment</p>
      <h2>Start one bathroom for LKR {PROJECT_INITIATION.amount.toLocaleString('en-LK')}.</h2>
      <p class="wx-body">The initiation deposit covers the site consultation, detailed design and complete construction proposal for one bathroom. The proposal is delivered within seven working days after the site visit.</p>

      <div class="wx-fee-grid">
        <article class="wx-fee wx-fee--feature">
          <span class="wx-fee-step">One bathroom<b>100% construction credit</b></span>
          <strong class="wx-fee-price">LKR {PROJECT_INITIATION.amount.toLocaleString('en-LK')}</strong>
          <h3>{PROJECT_INITIATION.title}</h3>
