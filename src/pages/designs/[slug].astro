---
export const prerender = false;
import LuxeLayout from '../../layouts/LuxeLayout.astro';
import VideoCard from '../../components/luxe/VideoCard.astro';
import ProjectCard from '../../components/luxe/ProjectCard.astro';
import KeyHighlights from '../../components/luxe/KeyHighlights.astro';
import BuildProcess from '../../components/luxe/BuildProcess.astro';
import SwipeCarouselController from '../../components/luxe/SwipeCarouselController.astro';
import { getDesignBySlug, getProjects, youtubeEmbed, isYouTubeShort, type DesignFixture, type DesignFull } from '../../lib/luxe';
import { formatLKRM, lkrM, cloudinary, FIXTURE_CATEGORIES, WARRANTY_SCHEDULE, STANDARD_DRAWINGS, PRE_CONSTRUCTION_FEES, formatArea, absoluteUrl } from '../../lib/luxe-config';
import { CATALOGUE_DESIGNS, SPACE_PRESENTATION } from '../../lib/luxe-catalogue';

const PREMIUM_NIFI_700_ACCESSORIES: DesignFixture[] = [
  {
    category: 'Paper Holder',
    name: 'NIFI 700 Paper Holder',
    brand: 'Swiss Bathware',
    model_code: 'NIFI 700 PH',
    finish: null,
    quantity: 1,
    included: true,
    spec: 'NIFI 700 paper holder. 170 × 70 × 25 mm.',
    notes: null,
    warranty_period: null,
    reference_price_label: null,
    image_url: 'https://ctxugrhuanygycjgijcf.supabase.co/storage/v1/object/public/luxehome-media/designs/1785129129343-445e9847-e5fc-4339-99c6-05fb36fda508.webp',
    image_alt: 'Swiss Bathware NIFI 700 paper holder',
    sort_order: 2,
  },
  {
    category: 'Robe Hook',
    name: 'NIFI 700 Robe Hook',
    brand: 'Swiss Bathware',
    model_code: 'NIFI 700 RH',
    finish: null,
    quantity: 1,
    included: true,
    spec: 'NIFI 700 robe hook. 60 × 45 × 25 mm.',
    notes: null,
    warranty_period: null,
    reference_price_label: null,
    image_url: 'https://ctxugrhuanygycjgijcf.supabase.co/storage/v1/object/public/luxehome-media/designs/1785129263722-00feddc5-704a-47e8-877a-11c5a607f336.webp',
    image_alt: 'Swiss Bathware NIFI 700 robe hook',
    sort_order: 7,
  },
  {
    category: 'Towel Bar',
    name: 'NIFI 700 Towel Bar',
    brand: 'Swiss Bathware',
    model_code: 'NIFI 700 TB',
    finish: null,
    quantity: 1,
    included: true,
    spec: 'NIFI 700 towel bar. 600 × 68 × 25 mm.',
    notes: null,
    warranty_period: null,
    reference_price_label: null,
    image_url: 'https://ctxugrhuanygycjgijcf.supabase.co/storage/v1/object/public/luxehome-media/designs/1785129279899-51ada35b-700e-43a5-b474-6e282db2aba0.webp',
    image_alt: 'Swiss Bathware NIFI 700 towel bar',
    sort_order: 8,
  },
  {
    category: 'Tumbler Holder',
    name: 'NIFI 700 Tumbler Holder',
    brand: 'Swiss Bathware',
    model_code: 'NIFI 700 TH',
    finish: null,
    quantity: 1,
    included: true,
    spec: 'NIFI 700 tumbler holder. 110 × 95 × 25 mm.',
    notes: null,
    warranty_period: null,
    reference_price_label: null,
    image_url: 'https://ctxugrhuanygycjgijcf.supabase.co/storage/v1/object/public/luxehome-media/designs/1785129301649-9615dbad-1c15-4adf-aa63-a92b2ef3592e.webp',
    image_alt: 'Swiss Bathware NIFI 700 tumbler holder',
    sort_order: 9,
  },
  {
    category: 'Soap Tray',
    name: 'NIFI 700 Soap Tray',
    brand: 'Swiss Bathware',
    model_code: 'NIFI 700 ST',
    finish: null,
    quantity: 1,
    included: true,
    spec: 'NIFI 700 soap tray. 180 × 95 × 25 mm.',
    notes: null,
    warranty_period: null,
    reference_price_label: null,
    image_url: 'https://ctxugrhuanygycjgijcf.supabase.co/storage/v1/object/public/luxehome-media/designs/1785129326338-984154e2-8e38-4a5f-b46a-e39b12d4ffac.webp',
    image_alt: 'Swiss Bathware NIFI 700 soap tray',
    sort_order: 10,
  },
];

const { slug } = Astro.params;
const storedDesign = await getDesignBySlug(slug!);
const catalogueDesign = CATALOGUE_DESIGNS.find((item) => item.space === 'bathrooms' && item.slug === slug);
const design: DesignFull | null = storedDesign ?? (catalogueDesign ? {
  id: '', slug: catalogueDesign.slug, name: catalogueDesign.name, space_id: catalogueDesign.space,
  collection: catalogueDesign.collection, tagline: catalogueDesign.tagline,
  description: 'A complete LUXEhome design file, customised for your room and documented before construction begins.',
  starting_price_lkr: catalogueDesign.startingPrice ?? 0, min_sqm: catalogueDesign.minSqm,
  new_starting_price_lkr: catalogueDesign.startingPrice ?? null,
  renovation_starting_price_lkr: catalogueDesign.renovationStartingPrice ?? null,
  cover_image_url: catalogueDesign.coverImage ?? null, video_3d_url: null, video_work_url: null,
  inspiration_image_url: null,
  workflow_text: 'We inspect, customise and approve the complete design file before procurement and construction begin.',
  highlights: [], featured: false, sort_order: 0,
  space: { id: catalogueDesign.space, slug: catalogueDesign.space, name: SPACE_PRESENTATION[catalogueDesign.space].name, sinhala_name: null, sort_order: 0 },
  drawings: [],
  fixtures: catalogueDesign.collection === 'premium' ? PREMIUM_NIFI_700_ACCESSORIES : [],
  price_tiers: (catalogueDesign.pricingTiers ?? []).map((tier, sort_order) => ({
    label: tier.label,
    sqm: tier.sqm,
    new_price_lkr: tier.newPrice,
    renovation_price_lkr: tier.renovationPrice,
    sort_order,
  })),
  materials: [
    { category: 'Adhesive', brand: 'Swisstek', item: 'Tile Adhesive', sort_order: 0 },
    { category: 'Grout', brand: 'Swisstek', item: 'Grout', sort_order: 1 },
    { category: 'Waterproofing', brand: 'Tokyo Super 2K', item: 'Waterproofing', sort_order: 2 },
    { category: 'Electrical', brand: 'ACL', item: 'Wiring & Cables', sort_order: 3 },
  ],
  faq: [],
} : null);
if (!design) return Astro.redirect('/designs');

// Repository-backed Manel samples keep the canonical page complete even before
// the same assets are uploaded through the CMS. CMS values always win.
if (design.slug === 'manel') {
  design.starting_price_lkr = 2_060_000;
  design.new_starting_price_lkr = 2_060_000;
  design.renovation_starting_price_lkr = 2_175_000;
  design.min_sqm = 5;
  design.cover_image_url ||= '/images/designs/manel/cover.jpeg';
  design.inspiration_image_url ||= '/images/designs/manel/manel-flower.jpeg';
  design.video_3d_url ||= 'https://youtube.com/shorts/LHkPOUT4ku8';
  design.workflow_text ||= 'We inspect, customise and approve the complete design file before procurement and construction begin.';
  if (design.materials.length === 0) {
    design.materials.push(
      { category: 'Adhesive', brand: 'Swisstek', item: 'Tile Adhesive', sort_order: 0 },
      { category: 'Grout', brand: 'Swisstek', item: 'Grout', sort_order: 1 },
      { category: 'Waterproofing', brand: 'Tokyo Super 2K', item: 'Waterproofing', sort_order: 2 },
      { category: 'Electrical', brand: 'ACL', item: 'Wiring & Cables', sort_order: 3 },
    );
  }
  const samples = {
    vanity: '/images/designs/manel/render-1.jpeg',
    water_closet: '/images/designs/manel/render-2.jpeg',
    shower: '/images/designs/manel/render-3.jpeg',
  } as const;
  for (const [kind, image_url] of Object.entries(samples)) {
    if (!design.drawings.some((drawing) => drawing.kind === kind)) {
      design.drawings.push({ kind: kind as keyof typeof samples, image_url });
    }
  }
}

const collectionLabel = design.collection.charAt(0).toUpperCase() + design.collection.slice(1);
const priceLabel = design.starting_price_lkr > 0 ? formatLKRM(design.starting_price_lkr) : 'Starting price to be confirmed';
const newPrice = design.new_starting_price_lkr || design.starting_price_lkr || null;
const renoPrice = design.renovation_starting_price_lkr ?? null;

const inspectionHref = `/book-site-inspection?design=${encodeURIComponent(design.slug)}`;

const drawingOf = (kind: string) => design.drawings.find((d) => d.kind === kind) ?? null;

/* The walk-in: the doorway view, then each named area in the order you
   move through the room. Only the areas that have an image are shown, and
   a CMS caption overrides the default title. */
const AREAS = [
  { kind: 'cover',        n: 'I',   kicker: 'At the door',        title: 'The first glance across the room' },
  { kind: 'vanity',       n: 'II',  kicker: 'The vanity',         title: 'Stone and warm mirror light' },
  { kind: 'water_closet', n: 'III', kicker: 'The water closet',   title: 'Concealed, quiet and neatly set out' },
  { kind: 'shower',       n: 'IV',  kicker: 'The shower',         title: 'The walk-in shower and niche' },
  { kind: 'shower_cubicle', n: 'V', kicker: 'The shower cubicle', title: 'Glass, hardware and precise sealing' },
  { kind: 'ceiling',      n: 'VI',  kicker: 'Looking up',         title: 'The ceiling, lighting and ventilation' },
] as const;

const steps = AREAS.flatMap((area) => {
  const source = area.kind === 'cover'
    ? (design.cover_image_url ? { image_url: design.cover_image_url, caption: null } : null)
    : drawingOf(area.kind);
  if (!source) return [];
  return [{
    n: area.n,
    kicker: `${area.kicker}`,
    title: source.caption || area.title,
    image: source.image_url,
  }];
});
const renders = steps.slice(1);

const video3d = youtubeEmbed(design.video_3d_url);
const priceTiers = design.price_tiers.length > 0
  ? design.price_tiers
  : (catalogueDesign?.pricingTiers ?? []).map((tier, sort_order) => ({
      label: tier.label,
      sqm: tier.sqm,
      new_price_lkr: tier.newPrice,
      renovation_price_lkr: tier.renovationPrice,
      sort_order,
    }));

// Flat per-m² rate, derived from the first two published tiers.
const perSqmRate = (() => {
  if (priceTiers.length < 2) return null;
  const [a, b] = priceTiers;
  const span = Number(b.sqm) - Number(a.sqm);
  if (span <= 0) return null;
  const rate = (Number(b.new_price_lkr) - Number(a.new_price_lkr)) / span;
  return rate > 0 ? Math.round(rate) : null;
})();

// Explicit sort_order wins; otherwise fixtures follow the order clients look
// through a bathroom (tile → water closet → basin → …).
const categoryRank = (f: DesignFixture) => {
  const i = FIXTURE_CATEGORIES.bathrooms.indexOf(f.category);
  return i === -1 ? FIXTURE_CATEGORIES.bathrooms.length : i;
};
/* Checklist rows carrying nothing but a category name are still being
   filled in — showing them would publish an empty tab. A fixture appears
   once it has something to say. */
const hasSubstance = (f: DesignFixture) =>
  Boolean(f.image_url || f.brand || f.spec || f.model_code || f.reference_price_label);
const fixtures: DesignFixture[] = [...design.fixtures]
  .filter(hasSubstance)
  .sort((a, b) => (a.sort_order - b.sort_order) || (categoryRank(a) - categoryRank(b)));
const roomImage = renders[0]?.image ?? design.cover_image_url;
const romanNumeral = (n: number) => ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII','XIV','XV','XVI','XVII','XVIII','XIX','XX'][n - 1] ?? String(n);

/* The CMS "Card highlights" field finally does something: one highlight per
   line. With none set, the highlights are derived from the design file. */
const designHighlights = design.highlights.length > 0
  ? design.highlights.map((line) => ({ title: line }))
  : [
      ...(formatArea(design.min_sqm) ? [{ value: `${formatArea(design.min_sqm)} m²`, title: 'Minimum room', copy: 'Smaller rooms are assessed on site before the design is confirmed.' }] : []),
      ...(newPrice ? [{ value: lkrM(newPrice), title: 'New bathroom from', copy: 'The complete listed specification at the minimum fit.' }] : []),
      { value: WARRANTY_SCHEDULE[0].period, title: 'Longest warranty', copy: `${WARRANTY_SCHEDULE[0].item}. Every task carries its own written period.` },
      ...(fixtures.length ? [{ value: String(fixtures.length), title: 'Specified fixtures', copy: 'Named products with brand, model, finish and warranty.' }] : []),
    ];

const allRelated = storedDesign?.id
  ? await getProjects({ designId: storedDesign.id })
  : (await getProjects()).filter((project) => project.design?.slug === design.slug);
const related = allRelated.filter((project) => project.after_image_url).slice(0, 3);
const testimonials = allRelated
  .filter((project) => project.review_text)
  .slice(0, 2)
  .map((project) => ({
    text: project.review_text!,
    who: [project.review_by, project.location].filter(Boolean).join(' · ') || 'LUXEhome client',
  }));

const nameHeading = design.name_heading || `Inspired by the ${design.name} flower.`;
const nameStory = design.name_story
  || (design.slug === 'manel'
    ? 'Named after Sri Lanka’s blue water lily, this design translates its deep blue character and quiet symmetry into a composed Signature bathroom.'
    : design.description
    || `The ${design.name} carries its namesake’s character into a fully documented ${collectionLabel} bathroom.`);

/* Category-only checklist rows can be prepared in admin before the exact
   product is confirmed. Keep those drafts out of the public page until they
   contain a brand, item, usage note or image. */
const materials = [...design.materials]
  .filter((m) => Boolean(m.brand?.trim() || m.item?.trim() || m.usage_label?.trim() || m.image_url))
  .sort((a, b) => a.sort_order - b.sort_order);
const materialsWithPhotos = materials.filter((m) => m.image_url);

/* Video structured data ties the walkthrough to THIS page, so a video rich
   result links here rather than to youtube.com. Works with an embedded or a
   self-hosted file — only contentUrl/embedUrl changes. */
const videoSchema = (video3d && design.cover_image_url) ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: `${design.name} — 3D bathroom walkthrough`,
  description: `A vertical 3D walkthrough of the ${design.name} ${collectionLabel} bathroom by LUXEhome: vanity, water closet, shower and the complete room.`,
  thumbnailUrl: [absoluteUrl(cloudinary(design.cover_image_url, 1200))],
  uploadDate: design.created_at ?? undefined,
  // contentUrl must be a media file. While the video is hosted on YouTube,
  // embedUrl alone is correct; self-hosting an MP4 would add contentUrl.
  embedUrl: video3d,
  publisher: { '@type': 'Organization', name: 'LUXEhome', url: 'https://luxehome.lk' },
  regionsAllowed: 'LK',
}) : null;

const productSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${design.name} — ${collectionLabel} ${design.space?.name ?? ''} Design`,
  description: design.tagline ?? design.description ?? '',
  ...(design.cover_image_url ? { image: cloudinary(design.cover_image_url, 1200) } : {}),
  brand: { '@type': 'Brand', name: 'LUXEhome' },
  ...(design.starting_price_lkr > 0 ? { offers: {
    '@type': 'Offer',
    price: design.starting_price_lkr,
    priceCurrency: 'LKR',
    availability: 'https://schema.org/InStock',
    url: new URL(`/designs/${design.slug}`, Astro.site ?? 'https://luxehome.lk').href,
  }} : {}),
});
---

<LuxeLayout
  title={`${design.name} — ${collectionLabel} ${design.space?.name ?? ''} Design | ${priceLabel} | LUXEhome`}
  description={`${design.name}: ${design.tagline ?? 'a fully documented LUXEhome design'}. ${priceLabel}. Walk through the renders, fixtures, drawings and pricing, then book a site inspection to check the fit.`}
  ogImage={design.cover_image_url ? cloudinary(design.cover_image_url, 1200) : undefined}
  ogImageAlt={`${design.name} — ${collectionLabel} bathroom design by LUXEhome`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={productSchema}></script>
    {videoSchema && <script is:inline type="application/ld+json" set:html={videoSchema}></script>}
  </Fragment>

  <!-- HERO · THE DOORWAY -->
  <header class="wx-hero" id="wx-hero">
    <div class="wx-hero-media" id="wx-hero-media">
      {design.cover_image_url
        ? <img src={cloudinary(design.cover_image_url, 1600)} alt={`${design.name} — the view from the doorway`} width="1600" height="1000" fetchpriority="high" />
        : <div class="wx-placeholder wx-placeholder--hero"><strong>LUXE</strong><em>home</em><span>{design.name}</span></div>}
    </div>
    <div class="wx-hero-shade" aria-hidden="true"></div>
    <div class="wx-hero-copy">
      <p class="wx-kicker wx-kicker--light">{collectionLabel} Collection · Bathrooms</p>
      <h1>{design.name}</h1>
      {design.tagline && <p class="wx-hero-tagline">{design.tagline}</p>}
      <div class="wx-hero-prices">
        {newPrice && <div><span>New bathroom</span><strong>From {lkrM(newPrice)}</strong></div>}
        {renoPrice && <div><span>Renovation</span><strong>From {lkrM(renoPrice)}</strong></div>}
      </div>
    </div>
    <button class="wx-hero-cue" id="wx-hero-cue" aria-label="Scroll down">
      <span>Step inside</span>
      <span class="wx-cue-line" aria-hidden="true"></span>
      <span aria-hidden="true">↓</span>
    </button>
  </header>

  <KeyHighlights items={designHighlights} />

  <!-- THRESHOLD -->
  <section class="wx-threshold">
    <p class="wx-kicker">You are standing at the doorway</p>
    <p class="wx-statement">A complete bathroom, documented to the last fitting — <em>before</em> a single tile is laid.</p>
    <div class="wx-threshold-cta">
      <a href={inspectionHref}><span>Inspect my bathroom for this design</span><b aria-hidden="true">→</b></a>
      <small>LKR 10,000 · No measurements needed</small>
    </div>
  </section>

  <!-- THE NAME -->
  {(design.inspiration_image_url || nameStory) && (
    <section class="wx-name">
      <div class="wx-name-grid">
        <div class="wx-name-flower">
          {design.inspiration_image_url
            ? <img src={cloudinary(design.inspiration_image_url, 420)} alt={`The ${design.name} flower — the inspiration behind this design`} loading="lazy" width="420" height="420" />
            : <span aria-hidden="true">{design.name.charAt(0)}</span>}
        </div>
        <div>
          <p class="wx-kicker">The name behind the design</p>
          <h2>{nameHeading}</h2>
          <p class="wx-body">{nameStory}</p>
        </div>
      </div>
    </section>
  )}

  <!-- THE WALK-IN -->
  {steps.length >= 2 && (
    <section id="walkin" data-swipe-carousel>
      <div class="wx-section wx-walkin-intro">
        <p class="wx-kicker">The walk-in</p>
        <h2>Step inside, one view at a time.</h2>
        <p class="wx-body" id="walkin-swipe-help">Swipe left or right and the room unfolds exactly as it does at the door — one large view at a time.</p>
      </div>
      <div
        class="wx-steps"
        role="region"
        aria-label={`${design.name} walk-in views`}
        aria-describedby="walkin-swipe-help"
        tabindex="0"
        data-swipe-track
      >
        {steps.map((step) => (
          <div class="wx-step" data-swipe-slide>
            <img src={cloudinary(step.image, 1600)} alt={`${design.name} — ${step.title}`} loading="lazy" width="1600" height="1000" />
            <div class="wx-step-shade" aria-hidden="true"></div>
            <div class="wx-step-copy">
              <div>
                <p class="wx-kicker wx-kicker--faded">{step.kicker}</p>
                <strong>{step.title}</strong>
              </div>
              <em aria-hidden="true">{step.n}</em>
            </div>
          </div>
        ))}
      </div>
      <div class="wx-walkin-dots" data-swipe-dots role="group" aria-label={`${design.name} walk-in carousel position`}>
        {steps.map((step, index) => (
          <button
            type="button"
            class:list={[{ 'is-active': index === 0 }]}
            data-swipe-dot
            aria-label={`Show ${step.kicker}, image ${index + 1} of ${steps.length}`}
            aria-current={index === 0 ? 'true' : undefined}
          ></button>
        ))}
      </div>
    </section>
  )}

  <!-- FIXTURES · UP CLOSE -->
  <section id="fixtures" class="wx-section" data-fixture-explorer>
    <div class="wx-heading-row">
      <div>
        <p class="wx-kicker">Products installed in the bathroom</p>
        <h2>Fixtures &amp; fittings.</h2>
      </div>
      <p class="wx-aside">Sanitaryware, tapware, furniture, glass and accessories. Choose an item to see its exact specification{fixtures.some((f) => f.reference_price_label) ? ' and reference price' : ''}.</p>
    </div>

    {fixtures.length > 0 ? (
      <>
        <ul class="wx-checklist wx-fixture-checklist" aria-label="Fixtures and fittings checklist">
          {fixtures.map((f) => (
            <li class:list={['wx-check-item', { 'is-optional': f.included === false }]}>
              <span class="wx-check-mark" aria-hidden="true">{f.included === false ? '+' : '✓'}</span>
              <span class="wx-check-copy">
                <strong>{f.category}</strong>
                <small>{f.brand ? `${f.brand} · ` : ''}{f.name}{f.quantity > 1 ? ` × ${f.quantity}` : ''}</small>
              </span>
              <em>{f.included === false ? 'Optional' : 'Included'}</em>
            </li>
          ))}
        </ul>

        <div class="wxf-layout">
          <div class="wxf-canvas">
            {fixtures.map((f, i) => (
              <img
                class:list={[
                  'wxf-canvas-img',
                  {
                    on: i === 0,
                    'wxf-canvas-img--product': Boolean(f.image_url),
                  },
                ]}
                data-fixture-img={i}
                src={cloudinary(f.image_url || roomImage || design.cover_image_url || '', 900)}
                alt={f.image_alt || `${f.brand ? `${f.brand} ` : ''}${f.name}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                width="900" height="1125"
              />
            ))}
          </div>
          <div class="wxf-right">
            <div class="wxf-panels">
              {fixtures.map((f, i) => (
                <div class:list={['wxf-panel', { on: i === 0 }]} data-fixture-panel={i}>
                  <div>
                    <div class="wxf-n">{romanNumeral(i + 1).toLowerCase()} · {f.category}</div>
                    <h3>{f.brand ? `${f.brand} — ` : ''}{f.name}</h3>
                    {f.spec && <p class="wxf-spec">{f.spec}</p>}
                    <dl class="wxf-meta">
                      {f.model_code && <><dt>Model</dt><dd>{f.model_code}</dd></>}
                      {f.finish && <><dt>Finish</dt><dd>{f.finish}</dd></>}
                      {f.quantity > 1 && <><dt>Quantity</dt><dd>{f.quantity}</dd></>}
                      {f.warranty_period && <><dt>Warranty</dt><dd>{f.warranty_period}</dd></>}
                    </dl>
                    <span class:list={['wxf-badge', { optional: f.included === false }]}>{f.included === false ? 'Optional upgrade' : 'Included'}</span>
                  </div>
                  {f.reference_price_label && (
                    <div class="wxf-price"><span>Reference price</span><strong>{f.reference_price_label}</strong></div>
                  )}
                </div>
              ))}
            </div>
            <div class="wxf-tabs" role="tablist" aria-label="Fixtures and fittings in this design">
              {fixtures.map((f, i) => (
                <button
                  type="button"
                  data-fixture-tab={i}
                  class:list={[{ on: i === 0 }]}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                >
                  <em aria-hidden="true">{String(i + 1).padStart(2, '0')}</em>
                  <span>{f.name}</span>
                  {f.reference_price_label && <small>{f.reference_price_label}</small>}
                </button>
              ))}
            </div>
          </div>
        </div>
      </>
    ) : (
