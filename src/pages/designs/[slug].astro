export const prerender = false;
const slug = Astro.params.slug ?? '';
const avissawellaLegacy = new Set([
  'sigiriya',
  'sigiriya-bathroom',
  'manel',
  'kuttam-pokuna',
  'idda',
]);
if (avissawellaLegacy.has(slug)) {
  return Astro.redirect('/projects/avissawella-bathroom-renovation', 301);
}
return Astro.redirect('/projects', 301);
