<script is:inline>
(function () {
  // Scroll cue → glide past the hero
  var cue = document.getElementById('wx-hero-cue');
  var hero = document.getElementById('wx-hero');
  if (cue && hero) {
    cue.addEventListener('click', function () {
      window.scrollTo({ top: hero.offsetTop + hero.offsetHeight, behavior: 'smooth' });
    });
  }

  // Sticky book bar appears once the hero has been passed
  var bar = document.getElementById('wx-bar');
  if (bar && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      bar.classList.toggle('show', !entries[0].isIntersecting);
    }, { threshold: 0 }).observe(hero);
  } else if (bar) {
    bar.classList.add('show');
  }

  // Gentle hero parallax (skipped for reduced motion)
  var media = document.getElementById('wx-hero-media');
  if (media && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        media.style.transform = 'translateY(' + (window.scrollY * 0.18) + 'px)';
        ticking = false;
      });
    }, { passive: true });
  }

  // Fixture explorer
  var explorer = document.querySelector('[data-fixture-explorer]');
  if (explorer) {
    explorer.addEventListener('click', function (event) {
      var tab = event.target.closest('[data-fixture-tab]');
      if (!tab) return;
      var index = tab.getAttribute('data-fixture-tab');
      explorer.querySelectorAll('[data-fixture-tab]').forEach(function (el) {
        var on = el === tab;
        el.classList.toggle('on', on);
        el.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      explorer.querySelectorAll('[data-fixture-panel]').forEach(function (el) {
        el.classList.toggle('on', el.getAttribute('data-fixture-panel') === index);
      });
      explorer.querySelectorAll('[data-fixture-img]').forEach(function (el) {
        el.classList.toggle('on', el.getAttribute('data-fixture-img') === index);
      });
    });
  }
})();
</script>

