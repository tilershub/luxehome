---
export const prerender = false;
const slug = Astro.params.slug ?? '';

const projectRedirects: Record<string, string> = {
  // Avissawella residence — two completed bathrooms
  'sigiriya': '/projects/avissawella-bathroom-renovation',
  'sigiriya-bathroom': '/projects/avissawella-bathroom-renovation',
  'manel': '/projects/avissawella-bathroom-renovation',
  'kuttam-pokuna': '/projects/avissawella-bathroom-renovation',
  'idda': '/projects/avissawella-bathroom-renovation',

  // Matugama
  'bentota': '/projects/matugama-bathroom-renovation',
  'nelum': '/projects/matugama-bathroom-renovation',

  // Kegalle
  'mirissa': '/projects/kegalle-bathroom-renovation',
  'orchid': '/projects/kegalle-bathroom-renovation',

  // Kotte
  'yapahuwa': '/projects/kotte-bathroom-renovation',
  'binara': '/projects/kotte-bathroom-renovation',
};

return Astro.redirect(projectRedirects[slug] ?? '/projects', 301);
---
