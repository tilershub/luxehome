---
import LuxeLayout from '../../layouts/LuxeLayout.astro';
import VideoCard from '../../components/luxe/VideoCard.astro';
import ProjectCard from '../../components/luxe/ProjectCard.astro';
import { getDesigns, getDesignBySlug, getProjects, youtubeEmbed, type DesignFixture, type DesignFull } from '../../lib/luxe';
import { formatLKRM, cloudinary, waLink } from '../../lib/luxe-config';
import { CATALOGUE_DESIGNS, SPACE_PRESENTATION } from '../../lib/luxe-catalogue';

export async function getStaticPaths() {
  const stored = await getDesigns({ spaceSlug: 'bathrooms' });
  const slugs = new Set([
    ...CATALOGUE_DESIGNS.filter((design) => design.space === 'bathrooms' && design.coverImage).map((design) => design.slug),
    ...stored.filter((design) => design.cover_image_url).map((design) => design.slug),
  ]);
  return [...slugs].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const storedDesign = await getDesignBySlug(slug!);
const catalogueDesign = CATALOGUE_DESIGNS.find((item) => item.space === 'bathrooms' && item.slug === slug);
const design: DesignFull | null = storedDesign ?? (catalogueDesign ? {
  id: '', slug: catalogueDesign.slug, name: catalogueDesign.name, space_id: catalogueDesign.space,
  collection: catalogueDesign.collection, tagline: catalogueDesign.tagline,
  description: 'A complete LUXEhome design file, customised for your room and documented before construction begins.',
  starting_price_lkr: catalogueDesign.startingPrice ?? 0, min_sqm: catalogueDesign.minSqm,
  new_starting_price_lkr: catalogueDesign.startingPrice ?? null,
  renovation_starting_price_lkr: catalogueDesign.renovationStartingPrice ?? null,
  cover_image_url: catalogueDesign.coverImage ?? null, video_3d_url: null, video_work_url: null,
  inspiration_image_url: null,
  workflow_text: 'We inspect, customise and approve the complete design file before procurement and construction begin.',
  highlights: [], featured: false, sort_order: 0,
  space: { id: catalogueDesign.space, slug: catalogueDesign.space, name: SPACE_PRESENTATION[catalogueDesign.space].name, sinhala_name: null, sort_order: 0 },
  drawings: [], fixtures: [],
  price_tiers: (catalogueDesign.pricingTiers ?? []).map((tier, sort_order) => ({
    label: tier.label,
    sqm: tier.sqm,
    new_price_lkr: tier.newPrice,
    renovation_price_lkr: tier.renovationPrice,
    sort_order,
  })),
  materials: [
    { category: 'Adhesive', brand: 'Swisstek', item: 'Tile Adhesive', sort_order: 0 },
    { category: 'Grout', brand: 'Swisstek', item: 'Grout', sort_order: 1 },
    { category: 'Waterproofing', brand: 'Tokyo Super 2K', item: 'Waterproofing', sort_order: 2 },
    { category: 'Electrical', brand: 'ACL', item: 'Wiring & Cables', sort_order: 3 },
  ],
  timeline: [], faq: [],
} : null);
if (!design) return Astro.redirect('/designs');

// Repository-backed Manel samples keep the canonical page complete even before
// the same assets are uploaded through the CMS. CMS values always win.
if (design.slug === 'manel') {
  design.starting_price_lkr = 2_060_000;
  design.new_starting_price_lkr = 2_060_000;
  design.renovation_starting_price_lkr = 2_175_000;
  design.min_sqm = 5;
  design.cover_image_url ||= '/images/designs/manel/cover.jpeg';
  design.inspiration_image_url ||= '/images/designs/manel/manel-flower.jpeg';
  design.video_3d_url ||= 'https://youtube.com/shorts/LHkPOUT4ku8';
  design.workflow_text ||= 'We inspect, customise and approve the complete design file before procurement and construction begin.';
  if (design.materials.length === 0) {
    design.materials.push(
      { category: 'Adhesive', brand: 'Swisstek', item: 'Tile Adhesive', sort_order: 0 },
      { category: 'Grout', brand: 'Swisstek', item: 'Grout', sort_order: 1 },
      { category: 'Waterproofing', brand: 'Tokyo Super 2K', item: 'Waterproofing', sort_order: 2 },
      { category: 'Electrical', brand: 'ACL', item: 'Wiring & Cables', sort_order: 3 },
    );
  }
  const samples = {
    render_1: '/images/designs/manel/render-1.jpeg',
    render_2: '/images/designs/manel/render-2.jpeg',
    render_3: '/images/designs/manel/render-3.jpeg',
    civil: '/images/designs/manel/sample-civil.webp',
    supply_water: '/images/designs/manel/sample-supply-water.webp',
    waste_drainage: '/images/designs/manel/sample-waste-drainage.webp',
    electrical: '/images/designs/manel/sample-electrical.webp',
  } as const;
  for (const [kind, image_url] of Object.entries(samples)) {
    if (!design.drawings.some((drawing) => drawing.kind === kind)) {
      design.drawings.push({ kind: kind as keyof typeof samples, image_url });
    }
  }
}

const collectionLabel = design.collection.charAt(0).toUpperCase() + design.collection.slice(1);
const priceLabel = design.starting_price_lkr > 0 ? formatLKRM(design.starting_price_lkr) : 'Starting price to be confirmed';
const newPriceLabel = design.new_starting_price_lkr ? formatLKRM(design.new_starting_price_lkr) : null;
const renovationPriceLabel = design.renovation_starting_price_lkr ? formatLKRM(design.renovation_starting_price_lkr) : null;

const waMessage = `Hi LUXEhome! I'm interested in the "${design.name}" design (${collectionLabel}, ${priceLabel.replace('From ', 'from ')}). Can you send me the full design file?`;

const renders = (['render_1', 'render_2', 'render_3', 'render_4'] as const)
  .map((k) => design.drawings.find((dr) => dr.kind === k) ?? null)
  .filter((render): render is NonNullable<typeof render> => Boolean(render));

const TECH = [
  { kind: 'civil',          label: 'Civil Drawing' },
  { kind: 'supply_water',   label: 'Supply Water' },
  { kind: 'waste_drainage', label: 'Waste & Drainage' },
  { kind: 'electrical',     label: 'Electrical' },
] as const;

const video3d = youtubeEmbed(design.video_3d_url);
const priceTiers = design.price_tiers.length > 0
  ? design.price_tiers
  : (catalogueDesign?.pricingTiers ?? []).map((tier, sort_order) => ({
      label: tier.label,
      sqm: tier.sqm,
      new_price_lkr: tier.newPrice,
      renovation_price_lkr: tier.renovationPrice,
      sort_order,
    }));

const fixtureGroups: Array<{ category: string; items: DesignFixture[] }> = [];
for (const f of design.fixtures) {
  const g = fixtureGroups.find((x) => x.category === f.category);
  if (g) g.items.push(f);
  else fixtureGroups.push({ category: f.category, items: [f] });
}

const allRelated = storedDesign?.id
  ? await getProjects({ designId: storedDesign.id })
  : (await getProjects()).filter((project) => project.design?.slug === design.slug);
const related = allRelated.filter((project) => project.after_image_url).slice(0, 3);

const productSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${design.name} — ${collectionLabel} ${design.space?.name ?? ''} Design`,
  description: design.tagline ?? design.description ?? '',
  ...(design.cover_image_url ? { image: cloudinary(design.cover_image_url, 1200) } : {}),
  brand: { '@type': 'Brand', name: 'LUXEhome' },
  ...(design.starting_price_lkr > 0 ? { offers: {
    '@type': 'Offer',
    price: design.starting_price_lkr,
    priceCurrency: 'LKR',
    availability: 'https://schema.org/InStock',
    url: new URL(`/designs/${design.slug}`, Astro.site ?? 'https://luxehome.lk').href,
  }} : {}),
});
---

<LuxeLayout
  title={`${design.name} — ${collectionLabel} ${design.space?.name ?? ''} Design | ${priceLabel} | LUXEhome`}
  description={`${design.name}: ${design.tagline ?? 'a fully documented LUXEhome design'}. ${priceLabel}. Complete fixture list, technical drawings, timeline and FAQ — the full design file on request.`}
  ogImage={design.cover_image_url ? cloudinary(design.cover_image_url, 1200) : undefined}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={productSchema}></script>
  </Fragment>

  <!-- Hero -->
  <section class="df-hero">
    <div class="df-hero-text">
      <p class="lx-eyebrow lxr">{collectionLabel} Collection · {design.space?.name}</p>
      <h1 class="lxr">{design.name}</h1>
      {design.tagline && <p class="df-tagline lxr">{design.tagline}</p>}
      <div class="df-meta lxr">
        {newPriceLabel && renovationPriceLabel ? (
          <div class="df-price-options">
            <div><span>New bathroom</span><strong>{newPriceLabel}</strong></div>
            <div><span>Renovation</span><strong>{renovationPriceLabel}</strong></div>
          </div>
        ) : <div class="df-price">{priceLabel}</div>}
        <div class="df-size">{design.min_sqm ? `Requires min. ${design.min_sqm} m²` : 'Fits any size'}</div>
      </div>
      {design.description && <p class="df-desc lxr">{design.description}</p>}
      <div class="df-cta lxr">
        <a href={waLink(waMessage)} class="lx-btn-wa" target="_blank" rel="noopener noreferrer">Get This Design's Full File</a>
      </div>
    </div>
    <div class="df-hero-img lxr">
      {design.cover_image_url
        ? <img src={cloudinary(design.cover_image_url, 1000)} alt={`${design.name} design`} width="1000" height="750" fetchpriority="high" />
        : <div class="df-placeholder df-placeholder--hero"><strong>LUXE</strong><em>home</em><span>{design.name}</span></div>}
    </div>
  </section>

  {design.inspiration_image_url && (
    <section class="df-inspiration df-section lxr">
      <img src={cloudinary(design.inspiration_image_url, 480)} alt={`${design.name} flower — the inspiration behind this design`} loading="lazy" width="480" height="420" />
      <div><p class="lx-eyebrow">The name behind the design</p><h2>Inspired by the Manel flower.</h2><p>Named after Sri Lanka’s blue water lily, this design translates its deep blue character and quiet symmetry into a composed Signature bathroom.</p></div>
    </section>
  )}

  {priceTiers.length > 0 && (
    <section class="df-section df-pricing" aria-labelledby="pricing-title">
      <div class="df-pricing-intro lxr">
        <div>
          <p class="lx-eyebrow">Size-based pricing guide</p>
          <h2 id="pricing-title">Choose the right fit for your room.</h2>
        </div>
        <p>Each reference price keeps the {design.name} specification while allowing for the additional floor, wall and construction area.</p>
      </div>
      <div class="df-price-table lxr" role="table" aria-label={`${design.name} size and price guide`}>
        <div class="df-price-row df-price-head" role="row">
          <span role="columnheader">Design fit</span>
          <span role="columnheader">Floor area</span>
          <span role="columnheader">New bathroom</span>
          <span role="columnheader">Renovation</span>
        </div>
        {priceTiers.map((tier) => (
          <div class="df-price-row" role="row">
            <strong role="cell">{tier.label}</strong>
            <span role="cell">{tier.sqm} m²</span>
            <span role="cell">{formatLKRM(tier.new_price_lkr)}</span>
            <span role="cell">{formatLKRM(tier.renovation_price_lkr)}</span>
          </div>
        ))}
        <div class="df-price-row df-price-custom" role="row">
          <strong role="cell">Larger or complex room</strong>
          <span role="cell">Above {priceTiers.at(-1)?.sqm} m²</span>
          <span role="cell">Custom price</span>
          <span role="cell">Custom price</span>
        </div>
      </div>
      <p class="df-price-disclaimer lxr">Starting-price guide for the listed design specification and standard room conditions. Room proportions, ceiling height, access, service relocation and structural changes are assessed separately.</p>
      <a class="df-price-cta lxr" href={waLink(`Hi LUXEhome! I would like an exact ${design.name} price for my bathroom. The approximate floor size is ... m² and it is a new bathroom / renovation.`)} target="_blank" rel="noopener noreferrer">Get a price for my bathroom →</a>
    </section>
  )}

  <!-- 3D renders -->
  <section class="df-section">
    <h2 class="lxr">The design, rendered</h2>
    <div class="df-render-grid" aria-label="3D render gallery">
      {renders.map((render, i) => (
        <div class="df-render lxr">
          <img src={cloudinary(render.image_url, 800)} alt={`${design.name} — 3D render ${i + 1}`} loading="lazy" width="800" height="600" />
        </div>
      ))}
    </div>
  </section>

  {video3d && design.cover_image_url && (
    <section class="df-section">
      <div class="df-video-layout">
        <div class="df-video-copy lxr">
          <p class="lx-eyebrow">Vertical 3D walkthrough</p>
          <h2>Walk through the {design.name}.</h2>
          <p>See the vanity, water closet, shower and complete room in one short walkthrough. The video opens in a portrait player and keeps you on this design page.</p>
        </div>
        <VideoCard
          title={`${design.name} 3D Walkthrough`}
          embedUrl={video3d}
          coverImage={cloudinary(design.cover_image_url, 700)}
          eyebrow="3D walkthrough"
          description="Tap to watch the complete vertical walkthrough."
        />
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="df-section">
      <div class="df-related-heading lxr">
        <div><p class="lx-eyebrow">From design to reality</p><h2>See the {design.name} built.</h2></div>
        <p>Real completed bathrooms based on this design, including their customisations and complete project stories.</p>
      </div>
      <div class="df-related">
        {related.map((project) => <ProjectCard project={project} compact />)}
      </div>
    </section>
  )}

  <!-- Technical drawings -->
  <section class="df-section">
    <h2 class="lxr">Technical drawings</h2>
    <p class="df-note lxr">Samples for a 2.5 m × 2 m (5 m²) bathroom — customised for your bathroom in your design file. Illustrative only; not for construction.</p>
    <div class="df-tech-grid" aria-label="Technical drawing samples">
      {TECH.map((t) => {
        const dr = design.drawings.find((d) => d.kind === t.kind);
        return (
          <figure class="df-tech lxr">
            <div class="df-tech-img">
              {dr
                ? <img src={cloudinary(dr.image_url, 700)} alt={`${design.name} — ${t.label} sample`} loading="lazy" width="700" height="500" />
                : <div class="df-placeholder"><span>{t.label}</span><small>Coming soon</small></div>}
              <div class="df-watermark" aria-hidden="true"></div>
            </div>
            <figcaption>{t.label}</figcaption>
          </figure>
        );
      })}
    </div>
  </section>

  <!-- Fixtures -->
  <section class="df-section df-fixtures">
      <div class="df-fixture-intro lxr">
        <div>
          <p class="lx-eyebrow">Complete fixture schedule</p>
          <h2>Every fixture, finish and fitting</h2>
          <p>See exactly what is specified for the {design.name}—from tiles and bathware to taps, shower fittings, lighting and accessories.</p>
        </div>
        <div class="df-fixture-count"><strong>{design.fixtures.length}</strong><span>specified items</span></div>
      </div>
      {fixtureGroups.length > 0 ? (
      <>
      <nav class="df-fixture-nav lxr" aria-label="Fixture categories">
        {fixtureGroups.map((g) => <a href={`#fixture-${g.category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{g.category}<span>{g.items.length}</span></a>)}
      </nav>
      {fixtureGroups.map((g) => (
        <div class="df-fix-group" id={`fixture-${g.category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
          <div class="df-fix-heading lxr"><h3 class="df-fix-cat">{g.category}</h3><span>{g.items.length} {g.items.length === 1 ? 'item' : 'items'}</span></div>
          <div class="df-fix-grid">
            {g.items.map((f) => (
              <div class="df-fix-card lxr">
                <div class="df-fix-img">
                  {f.image_url
                    ? <img src={cloudinary(f.image_url, 600)} alt={f.image_alt || `${f.brand ? `${f.brand} ` : ''}${f.name}`} loading="lazy" width="600" height="450" />
                    : <div class="df-placeholder df-placeholder--sm"><strong>LUXE</strong><em>home</em><span>{f.category}</span><small>Image being prepared</small></div>}
                  <span class:list={['df-included', { optional: f.included === false }]}>{f.included === false ? 'Optional upgrade' : 'Included'}</span>
                </div>
                <div class="df-fix-body">
                  {f.brand && <p class="lx-eyebrow">{f.brand}</p>}
                  <div class="df-fix-name">{f.name}</div>
                  <dl class="df-fix-meta">
                    {f.model_code && <><dt>Model</dt><dd>{f.model_code}</dd></>}
                    {f.finish && <><dt>Finish</dt><dd>{f.finish}</dd></>}
                    {f.quantity > 1 && <><dt>Quantity</dt><dd>{f.quantity}</dd></>}
                    {f.warranty_period && <><dt>Warranty</dt><dd>{f.warranty_period}</dd></>}
                  </dl>
                  {f.spec && <div class="df-fix-spec">{f.spec}</div>}
                  {f.notes && <div class="df-fix-note">{f.notes}</div>}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
      </>
      ) : (
        <div class="df-fixture-empty lxr"><strong>The full schedule is being prepared.</strong><p>Ask for the design file to receive the confirmed tiles, bathware, tapware, shower, lighting and accessory specification for this design.</p><a href={waLink(waMessage)} target="_blank" rel="noopener noreferrer">Request the fixture schedule →</a></div>
      )}
    </section>

  <!-- Materials -->
  {design.materials.length > 0 && (
    <section class="df-section">
      <h2 class="lxr">Construction materials</h2>
      <div class="df-chips lxr">
        {design.materials.map((m) => (
          <span class="df-chip"><strong>{m.brand}</strong>{m.item ? ` · ${m.item}` : ''}</span>
        ))}
      </div>
    </section>
  )}

  <!-- Workflow + timeline -->
  {(design.workflow_text || design.timeline.length > 0) && (
    <section class="df-section">
      <h2 class="lxr">How it gets built</h2>
      {design.workflow_text && <p class="df-workflow lxr">{design.workflow_text}</p>}
      {design.timeline.length > 0 && (
        <ol class="df-timeline">
          {design.timeline.map((t) => (
            <li class="lxr">
              <span class="df-tl-dot" aria-hidden="true"></span>
              <div class="df-tl-week">{t.week_label}</div>
              <div class="df-tl-title">{t.title}</div>
              {t.description && <p class="df-tl-desc">{t.description}</p>}
            </li>
          ))}
        </ol>
      )}
    </section>
  )}

  <!-- FAQ -->
  {design.faq.length > 0 && (
    <section class="df-section">
      <h2 class="lxr">Questions about {design.name}</h2>
      <div class="df-faq lxr">
        {design.faq.map((f) => (
          <details class="df-faq-item">
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <section class="df-section df-warranty lxr">
    <div class="df-warranty-intro">
      <p class="lx-eyebrow">Warranty &amp; aftercare</p>
      <h2>Protected after handover.</h2>
      <p>The completed project includes LUXEhome’s documented one-year service warranty. Manufacturer or supplier cover is listed against each confirmed fixture where applicable.</p>
      <a href="/warranty-aftercare">Read how warranty support works →</a>
    </div>
    <div class="df-warranty-grid">
      <article><strong>01</strong><h3>Tested handover</h3><p>Final checks, care guidance and the agreed warranty record.</p></article>
      <article><strong>02</strong><h3>Product clarity</h3><p>Fixture warranty periods stay attached to the exact approved products.</p></article>
      <article><strong>03</strong><h3>One contact</h3><p>Report an issue with the project reference, photos and a clear description.</p></article>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="df-closing lxr">
    <h2>The {design.name}, in your home.</h2>
    <p>Get the complete design file — renders, drawings, fixture list, and a fixed quotation for your exact space.</p>
    <a href={waLink(waMessage)} class="lx-btn-wa" target="_blank" rel="noopener noreferrer">Get This Design's Full File</a>
  </section>
</LuxeLayout>

<style>
  .df-hero {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.2rem, 5vw, 4rem) 2rem;
  }
  .df-hero h1 { font-size: clamp(2.8rem, 7vw, 4.6rem); margin: .4rem 0 .2rem; }
  .df-tagline { font-family: var(--lx-serif); font-style: italic; font-size: 1.25rem; color: var(--sage-deep); margin-bottom: 1.2rem; }
  .df-meta { display: flex; gap: 1.4rem; align-items: baseline; margin-bottom: 1rem; flex-wrap: wrap; }
  .df-price { font-family: var(--lx-serif); font-size: 1.7rem; font-weight: 700; }
  .df-price-options { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .65rem; width: min(100%,480px); }
  .df-price-options>div { padding: .75rem .9rem; border: 1px solid var(--cream-deep); border-radius: 7px; background: #fff; }
  .df-price-options span,.df-price-options strong { display: block; }
  .df-price-options span { margin-bottom: .18rem; color: var(--sage-deep); font-size: .66rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .df-price-options strong { font-family: var(--lx-serif); font-size: 1.25rem; }
  .df-size {
    font-size: .72rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase;
    background: var(--sage-mist); color: var(--sage-deep);
    padding: .35rem .8rem; border-radius: 999px;
  }
  .df-desc { max-width: 52ch; color: color-mix(in srgb, var(--ink) 78%, transparent); margin-bottom: 1.4rem; }

  .df-hero-img { border-radius: 8px; overflow: hidden; aspect-ratio: 4 / 3; background: var(--sage-mist); }
  .df-hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .df-section { max-width: 1100px; margin: 0 auto; padding: 2.2rem clamp(1.2rem, 5vw, 4rem); }
  .df-section h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); margin-bottom: 1.2rem; }
  .df-inspiration { display:grid; grid-template-columns:minmax(150px,240px) 1fr; gap:clamp(1.2rem,4vw,3rem); align-items:center; }
  .df-inspiration img { width:100%; height:auto; aspect-ratio:1; object-fit:cover; border-radius:50%; }
  .df-inspiration h2 { margin:.25rem 0 .55rem; }
  .df-inspiration p:last-child { max-width:58ch; color:color-mix(in srgb,var(--ink) 72%,transparent); }
  .df-note { font-size: .85rem; font-style: italic; color: color-mix(in srgb, var(--ink) 60%, transparent); margin: -0.6rem 0 1.2rem; }

  /* Size-based price guidance */
  .df-pricing { padding-top: 2.8rem; padding-bottom: 2.8rem; }
  .df-pricing-intro {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.2rem;
  }
  .df-pricing-intro h2 { margin: .3rem 0 0; }
  .df-pricing-intro > p { color: color-mix(in srgb, var(--ink) 67%, transparent); font-size: .86rem; }
  .df-price-table { overflow: hidden; border: 1px solid var(--cream-deep); border-radius: 9px; background: #fff; }
  .df-price-row {
    display: grid;
    grid-template-columns: 1.2fr .65fr 1fr 1fr;
    gap: 1rem;
    align-items: center;
    padding: .9rem 1rem;
    border-bottom: 1px solid var(--cream-deep);
