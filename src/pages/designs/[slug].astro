  <SwipeCarouselController />
</LuxeLayout>

<script is:inline>
(function () {
  // Scroll cue → glide past the hero
  var cue = document.getElementById('wx-hero-cue');
  var hero = document.getElementById('wx-hero');
  if (cue && hero) {
    cue.addEventListener('click', function () {
      window.scrollTo({ top: hero.offsetTop + hero.offsetHeight, behavior: 'smooth' });
    });
  }

  // Sticky book bar appears once the hero has been passed
  var bar = document.getElementById('wx-bar');
  if (bar && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      bar.classList.toggle('show', !entries[0].isIntersecting);
    }, { threshold: 0 }).observe(hero);
  } else if (bar) {
    bar.classList.add('show');
  }

  // Gentle hero parallax (skipped for reduced motion)
  var media = document.getElementById('wx-hero-media');
  if (media && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        media.style.transform = 'translateY(' + (window.scrollY * 0.18) + 'px)';
        ticking = false;
      });
    }, { passive: true });
  }

})();
</script>

<style>
