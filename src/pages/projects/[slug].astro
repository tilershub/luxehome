---
export const prerender = false;
import LuxeLayout from '../../layouts/LuxeLayout.astro';
import VideoCard from '../../components/luxe/VideoCard.astro';
import { getProjectBySlug, youtubeEmbed, isYouTubeShort, type ProjectFull } from '../../lib/luxe';
import { imageUrl, absoluteUrl } from '../../lib/luxe-config';

const { slug } = Astro.params;
const storedProject = await getProjectBySlug(slug!);
const project: ProjectFull | null = storedProject;
if (!project || !project.published || project.project_status === 'proposed') return Astro.redirect('/projects');
const status = project.project_status ?? 'completed';
const ongoing = status === 'in_progress';

const video = youtubeEmbed(project.video_url);
const episode1 = youtubeEmbed(project.episode_1_url);
const episode2 = youtubeEmbed(project.episode_2_url);
// Finished photographs stay together; the original bathroom is shown separately below.
const heroImages = [...new Set([project.after_image_url,...project.gallery.map((photo)=>photo.image_url)].filter((url): url is string=>Boolean(url)))];
const projectVideoCover = project.after_image_url || project.before_image_url;

const inspectionHref = `/book-site-inspection?source_project=${encodeURIComponent(project.slug)}`;

const primaryVideo = video || episode2 || episode1;
const videoSchema = (primaryVideo && project.after_image_url) ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: `${project.title} — ${ongoing ? 'renovation progress' : 'completed bathroom walkthrough'}`,
  description: `A walkthrough of the ${ongoing ? 'ongoing' : 'completed'} ${project.title} bathroom by BathSpace by LUXEhome${project.location ? `, ${project.location}` : ''}.`,
  thumbnailUrl: [absoluteUrl(imageUrl(project.after_image_url, 1200))],
  uploadDate: project.created_at ?? undefined,
  embedUrl: primaryVideo,
  publisher: { '@type': 'Organization', name: 'BathSpace by LUXEhome', url: 'https://luxehome.lk' },
  regionsAllowed: 'LK',
}) : null;

const reviewSchema = project.rating ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'LocalBusiness',
    name: 'BathSpace by LUXEhome',
    image: 'https://luxehome.lk/og-bathroom.jpg',
  },
  reviewRating: { '@type': 'Rating', ratingValue: project.rating, bestRating: 5 },
  ...(project.review_by ? { author: { '@type': 'Person', name: project.review_by } } : {}),
  ...(project.review_text ? { reviewBody: project.review_text } : {}),
}) : null;
---

<LuxeLayout
  title={`${project.title} — BathSpace Project Story | LUXEhome`}
  description={`${project.title}${project.location ? `, ${project.location}` : ''} — a real BathSpace ${ongoing ? 'ongoing renovation' : 'completed bathroom renovation'} with clear scope, project stage and investment.`}
  ogImage={project.after_image_url ? imageUrl(project.after_image_url, 1200) : undefined}
  ogImageAlt={`${project.title} — ${ongoing ? 'renovation progress' : 'completed BathSpace bathroom'}${project.location ? `, ${project.location}` : ''}`}
>
  <Fragment slot="head">
    {reviewSchema && <script is:inline type="application/ld+json" set:html={reviewSchema}></script>}
    {videoSchema && <script is:inline type="application/ld+json" set:html={videoSchema}></script>}
  </Fragment>

  <!-- Hero -->
  <section class="ps-hero">
    <p class="lx-eyebrow lxr">{ongoing ? 'Ongoing BathSpace renovation' : 'Completed BathSpace project'}</p>
    <h1 class="lxr">{project.title}</h1>
    <p class="ps-meta lxr">
      {project.location}
      {project.project_ref && <span> · {project.project_ref}</span>}
      {project.area_label && <span> · {project.area_label}</span>}
      {project.duration_label && <span> · {project.duration_label}</span>}
      {project.completed_label && <span> · {ongoing ? 'Current stage' : 'Completed'}: {project.completed_label}</span>}
    </p>
  </section>

  {/* Keep unfinished photo archives transparent rather than implying we have
      images of a finished bathroom that have not actually been uploaded. */}
  {!project.after_image_url && !project.before_image_url && project.gallery.length === 0 && !project.journey.some((stage) => (stage.image_urls ?? []).length > 0) && (
    <section class="ps-photo-note lxr" aria-label="Project photo archive status">
      <strong>{ongoing ? 'Project photographs coming soon' : 'Completed-project photographs being added'}</strong>
      <p>
        {ongoing
          ? 'This renovation is underway. We will add genuine site photographs as the work progresses and final images only after handover.'
          : 'This is a documented bathroom project. Its original photographs are being prepared for the public gallery; the recorded project details are available below.'}
      </p>
    </section>
  )}

  <!-- Swipeable finished bathroom gallery; never mix the old bathroom into the finished images. -->
  {heroImages.length > 0 && (
    <section class="ps-carousel-wrap lxr" aria-label={ongoing ? 'Renovation progress photographs' : 'Finished bathroom photographs'}>
      <div class="ps-carousel" id="project-photo-carousel">
        <div class="ps-carousel-track" tabindex="0" aria-roledescription="carousel" aria-label="Swipe or use arrow keys to explore the bathroom photographs">
          {heroImages.map((url, i) => (
            <figure class="ps-carousel-slide">
              <img src={imageUrl(url, 1200)}
                srcset={`${imageUrl(url, 480)} 480w, ${imageUrl(url, 800)} 800w, ${imageUrl(url, 1200)} 1200w`}
                sizes="(max-width: 720px) calc(100vw - 32px), 1000px"
                alt={`${project.title} — ${ongoing ? 'progress' : 'finished bathroom'} photo ${i + 1}`}
                loading={i === 0 ? 'eager' : 'lazy'} decoding="async"
                width="1200" height="900" />
            </figure>
          ))}
        </div>
        {heroImages.length > 1 && (
          <>
            <button type="button" class="ps-carousel-arrow ps-carousel-arrow--prev" data-carousel-prev aria-label="Previous bathroom photo">‹</button>
            <button type="button" class="ps-carousel-arrow ps-carousel-arrow--next" data-carousel-next aria-label="Next bathroom photo">›</button>
          </>
        )}
      </div>
      {heroImages.length > 1 && (
        <nav class="ps-carousel-nav" aria-label="Project photo navigation">
          <span class="ps-carousel-counter" aria-live="polite" data-carousel-counter>1 / {heroImages.length}</span>
          <div class="ps-carousel-dots">
            {heroImages.map((_, i) => (
              <button type="button" data-carousel-dot={i} class:list={{'is-active':i===0}}
                aria-label={`Go to bathroom photo ${i+1}`}
                aria-current={i===0 ? 'true' : undefined}></button>
            ))}
          </div>
          <span class="ps-carousel-tip">Swipe to explore</span>
        </nav>
      )}
    </section>
  )}

  <!-- The brief: what the family asked for, and the agreed path -->
  {(project.client_requirements || project.estimate_label) && (
    <section class="ps-section">
      <h2 class="lxr">The brief</h2>
      <div class="ps-brief lxr">
        {project.client_requirements && (
          <div class="ps-brief-req">
            <p class="lx-eyebrow">What the family asked for</p>
            <div>{project.client_requirements.split('\n\n').map((para) => <p>{para}</p>)}</div>
          </div>
        )}
        <div class="ps-brief-facts">
          {project.estimate_label && (
            <div class="ps-brief-fact">
              <span>Project investment</span>
              <strong>{project.estimate_label}</strong>
            </div>
          )}
          {project.duration_label && (
            <div class="ps-brief-fact">
              <span>Timeline</span>
              <strong>{project.duration_label}</strong>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Story -->
  {(episode1 || episode2) && projectVideoCover && (
    <section class="ps-section">
      <h2 class="lxr">{ongoing ? 'Construction progress videos' : 'Old Space → 3D Design → Construction → Final Reveal'}</h2>
      <div class="ps-video-cards">
        {episode1 && (
          <VideoCard
            title={`${project.title} — Episode 01`}
            embedUrl={episode1}
            coverImage={imageUrl(project.before_image_url || projectVideoCover, 700)}
            portrait={isYouTubeShort(project.episode_1_url)}
            eyebrow="Old space to 3D design"
            description="Tap to watch episode one in its original vertical format."
          />
        )}
        {episode2 && (
          <VideoCard
            title={`${project.title} — Episode 02`}
            embedUrl={episode2}
            coverImage={imageUrl(project.after_image_url || projectVideoCover, 700)}
            portrait={isYouTubeShort(project.episode_2_url)}
            eyebrow="Completed bathroom tour"
            description="Tap to watch the final reveal in its original vertical format."
          />
        )}
      </div>
    </section>
  )}

  <!-- Story -->
  {project.story && (
    <section class="ps-section">
      <h2 class="lxr">{ongoing ? 'Project progress' : 'The story'}</h2>
      <div class="ps-story lxr">{project.story.split('\n\n').map((para) => <p>{para}</p>)}</div>
    </section>
  )}

  {project.before_image_url && (
    <section class="ps-section ps-original-photo">
      <h2 class="lxr">Before the renovation</h2>
      <p class="ps-original-intro">The original bathroom before BathSpace started work.</p>
      <img src={imageUrl(project.before_image_url, 900)}
        alt={`${project.title} before renovation`} loading="lazy" width="900" height="675" />
    </section>
  )}

  <!-- Specification records: actual products, not a generic package promise. -->
  {project.specifications.length > 0 && (
    <section class="ps-section ps-specifications" aria-labelledby="ps-spec-title">
      <p class="lx-eyebrow lxr">What went into this bathroom</p>
      <h2 class="lxr" id="ps-spec-title">Materials, fixtures &amp; finishes</h2>
      <p class="ps-spec-intro lxr">
        A record of the systems behind the walls and the finishes you can see.
        Every project has its own selections and specifications.
      </p>
      {([
        { key: 'finishes', title: 'Finishes, fixtures & fittings', summary: 'Tiles, bathware, brassware, lighting, vanity and other visible details' },
        { key: 'construction', title: 'Construction & installation materials', summary: 'Plumbing, electrical, waterproofing, tile fixing and civil materials' },
      ] as const).map((section) => {
        const items = project.specifications.filter((item) => item.section === section.key);
        return items.length > 0 && (
          <details class="ps-spec-section" open={section.key === 'finishes'}>
            <summary class="ps-spec-summary">
              <span class="ps-spec-heading">
                <strong>{section.title}</strong>
                <small>{section.summary}</small>
              </span>
              <span class="ps-spec-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="ps-spec-grid">
              {items.map((item) => (
                <article class="ps-spec-item">
                  {(item.image_url || item.catalog_item?.image_url) && (
                    <img class="ps-spec-photo" src={imageUrl(item.image_url || item.catalog_item?.image_url, 440)}
                      alt={`${item.item_name} — product reference photograph`} loading="lazy" width="440" height="330" />
                  )}
                  <p class="ps-spec-category">{item.category}</p>
                  <h3>{item.item_name}</h3>
                  {(item.brand || item.model_code) && (
                    <p class="ps-spec-brand">
                      {[item.brand, item.model_code && `Model: ${item.model_code}`].filter(Boolean).join(' · ')}
                    </p>
                  )}
                  {item.specification && <p class="ps-spec-note">{item.specification}</p>}
                </article>
              ))}
            </div>
          </details>
        );
      })}
      <p class="ps-spec-disclaimer">Specifications reflect the materials selected for this particular project. Brands, models, tile sizes and construction systems may vary by bathroom, site conditions and availability.</p>
    </section>
  )}

  <!-- Optional walkthrough video; photographs appear in the swipe gallery above. -->
  {(video && projectVideoCover) && (
    <section class="ps-section">
      <h2 class="lxr">{ongoing ? 'Progress photographs' : 'Inside the build'}</h2>
      {video && projectVideoCover && (
        <div class="ps-video-cards ps-video-cards--single">
          <VideoCard
            title={`${project.title} — Project Walkthrough`}
            embedUrl={video}
            coverImage={imageUrl(projectVideoCover, 700)}
            portrait={isYouTubeShort(project.video_url)}
            eyebrow="Project walkthrough"
            description="Tap to watch the vertical project walkthrough."
          />
        </div>
      )}
    </section>
  )}

  <!-- The journey -->
  {project.journey.length > 0 && (
    <section class="ps-section">
      <h2 class="lxr">The journey</h2>
      <p class="ps-journey-intro lxr">{ongoing ? 'Verified work completed so far; future steps are not shown as finished.' : 'From first message to handover — every stage, as recorded.'}</p>
      <ol class="ps-journey">
        {project.journey.map((j) => (
          <li class="lxr">
            <span class="ps-j-dot" aria-hidden="true"></span>
            {j.date_label && <div class="ps-j-date">{j.date_label}</div>}
            <div class="ps-j-stage">{j.stage}</div>
            {j.note && <p class="ps-j-note">{j.note}</p>}
            {(j.issue || j.fix) && (
              <div class="ps-callout">
                <div class="ps-callout-title">What we found — and how we fixed it</div>
                {j.issue && <p><strong>The issue:</strong> {j.issue}</p>}
                {j.fix && <p><strong>The fix:</strong> {j.fix}</p>}
              </div>
            )}
            {(j.image_urls ?? []).length > 0 && (
              <div class="ps-j-photos">
                {(j.image_urls ?? []).map((url, i) => (
                  <img src={imageUrl(url, 800)} alt={`${project.title} — ${j.stage}, photo ${i + 1}`} loading="lazy" width="500" height="375" />
                ))}
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- Crew -->
  {project.crew.length > 0 && (
    <section class="ps-section">
      <h2 class="lxr">The team that built this</h2>
      <div class="ps-crew lxr">
        {project.crew.map((c) => (
          <div class="ps-crew-card">
            <div class="ps-crew-photo">
              {c.photo_url
                ? <img src={imageUrl(c.photo_url, 200, 200)} alt={c.name} loading="lazy" width="200" height="200" />
                : <span>{c.name.charAt(0)}</span>}
            </div>
            <div>
              <div class="ps-crew-name">{c.name}</div>
              {c.role && <div class="ps-crew-role">{c.role}</div>}
              {c.tilershub_verified && <div class="ps-verified">✓ TILERSHUB Verified</div>}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Review -->
  {(project.rating || project.review_text || project.review_screenshot_url) && (
    <section class="ps-section">
      <h2 class="lxr">What our client said</h2>
      <div class="ps-review lxr">
        {project.rating && (
          <div class="ps-stars" aria-label={`${project.rating} out of 5 stars`}>
            {'★'.repeat(project.rating)}{'☆'.repeat(5 - project.rating)}
          </div>
        )}
        {project.review_text && <blockquote>“{project.review_text}”</blockquote>}
        {project.review_by && <cite>— {project.review_by}</cite>}
        {project.review_screenshot_url && (
          <figure class="ps-review-proof">
            <img src={imageUrl(project.review_screenshot_url, 700)} alt={`Google review by ${project.review_by ?? 'the client'}`} loading="lazy" width="700" height="400" />
            <figcaption>Screenshot of the client's Google review</figcaption>
          </figure>
        )}
      </div>
    </section>
  )}

  <!-- Closing CTA -->
  <section class="ps-closing lxr">
    <h2>Planning a bathroom renovation?</h2>
    <p>
      Start with a complimentary project consultation. For suitable complete-bathroom projects,
      one detailed site assessment is included before you decide whether to commission the
      LKR 50,000 design and construction proposal.
    </p>
    <div class="ps-closing-btns">
      <a href={inspectionHref} class="lx-btn-wa">Apply for complimentary consultation</a>
      <a href="/projects" class="lx-btn-ghost">See more completed projects</a>
    </div>
    <small>No payment to apply. The LKR 50,000 proposal is commissioned only after consultation and is credited in full if BathSpace by LUXEhome builds that bathroom.</small>
  </section>
</LuxeLayout>

<script is:inline>
(function () {
  var carousel = document.getElementById('project-photo-carousel');
  if (!carousel) return;
  var track = carousel.querySelector('.ps-carousel-track');
  var slides = [...track.querySelectorAll('.ps-carousel-slide')];
  var dots = [...document.querySelectorAll('[data-carousel-dot]')];
  var counter = document.querySelector('[data-carousel-counter]');
  var prev = carousel.querySelector('[data-carousel-prev]');
  var next = carousel.querySelector('[data-carousel-next]');
  var current = 0;

  function goTo(index) {
    var target = Math.max(0, Math.min(slides.length - 1, index));
    track.scrollTo({left: slides[target].offsetLeft - slides[0].offsetLeft, behavior: 'smooth'});
  }
  function update() {
    var width = track.clientWidth || 1;
    current = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / width)));
    dots.forEach(function(dot,i){
      dot.classList.toggle('is-active', i === current);
      if (i === current) dot.setAttribute('aria-current','true');
      else dot.removeAttribute('aria-current');
    });
    if (counter) counter.textContent = (current + 1) + ' / ' + slides.length;
    if (prev) prev.disabled = current === 0;
    if (next) next.disabled = current === slides.length - 1;
  }
  var frame = 0;
  track.addEventListener('scroll', function(){
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(update);
  }, {passive: true});
  track.addEventListener('keydown',function(e){
    if(e.key === 'ArrowRight') {e.preventDefault();goTo(current + 1)}
    if(e.key === 'ArrowLeft') {e.preventDefault();goTo(current - 1)}
  });
  dots.forEach(function(dot,i){dot.addEventListener('click',function(){goTo(i)})});
  if(prev)prev.addEventListener('click',function(){goTo(current - 1)});
  if(next)next.addEventListener('click',function(){goTo(current + 1)});
  window.addEventListener('resize',update,{passive:true});
  update();
})();
</script>

<style>
  .ps-hero { padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.2rem, 5vw, 4rem) 1.4rem; max-width: 1100px; margin: 0 auto; }
  .ps-hero h1 { font-size: clamp(2.2rem, 5.5vw, 3.6rem); margin: .5rem 0 .6rem; }
  .ps-meta { font-size: .92rem; color: color-mix(in srgb, var(--ink) 68%, transparent); }
  .ps-meta a { color: var(--sage-deep); font-weight: 500; }
  .ps-photo-note {
    width: min(1020px, calc(100% - 2rem));
    margin: 0 auto 1.5rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--cream-deep);
    border-left: 3px solid var(--sage-deep);
    border-radius: 8px;
    background: #fff;
  }
  .ps-photo-note strong { display: block; font-weight: 600; }
  .ps-photo-note p { margin-top: .3rem; font-size: .92rem; color: color-mix(in srgb, var(--ink) 72%, transparent); }

  /* Before/after drag slider */
  .ps-slider-wrap { max-width: 1100px; margin: 0 auto; padding: 0 clamp(1.2rem, 5vw, 4rem); }
  .ps-slider {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: 8px;
    overflow: hidden;
    touch-action: pan-y;
    cursor: ew-resize;
    background: var(--sage-mist);
    user-select: none;
  }
  .ps-slider img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .ps-before-clip { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ps-handle {
    position: absolute;
    top: 0; bottom: 0;
    left: var(--pos);
    width: 2px;
    background: var(--cream);
    transform: translateX(-1px);
    pointer-events: none;
  }
  .ps-handle span {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 42px; height: 42px;
    border-radius: 50%;
    background: var(--cream);
    box-shadow: 0 2px 12px rgba(43,50,42,.3);
  }
  .ps-handle span::before, .ps-handle span::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0; height: 0;
    border: 5px solid transparent;
    transform: translateY(-50%);
  }
  .ps-handle span::before { left: 8px;  border-right-color: var(--sage-deep); }
  .ps-handle span::after  { right: 8px; border-left-color:  var(--sage-deep); }
  .ps-label {
    position: absolute;
    bottom: 1rem;
    font-size: .78rem; font-weight: 600; letter-spacing: .09em; text-transform: uppercase;
    background: color-mix(in srgb, var(--ink) 78%, transparent); color: var(--cream);
    padding: .3rem .75rem; border-radius: 999px;
    pointer-events: none;
  }
  .ps-label--before { left: 1rem; }
  .ps-label--after  { right: 1rem; }
  .ps-slider-hint { text-align: center; font-size: .84rem; font-weight: 500; letter-spacing: .09em; text-transform: uppercase; color: color-mix(in srgb, var(--ink) 70%, transparent); margin-top: .6rem; }
  .ps-single { width: 100%; height: auto; border-radius: 8px; display: block; object-fit: contain; }

  /* Swipe-first gallery: original proportions preserved with contain, not cropped. */
  .ps-carousel-wrap { max-width: 1100px; padding: 0 clamp(1.2rem, 5vw, 4rem); margin: 0 auto 1.4rem; }
  .ps-carousel { position: relative; }
  .ps-carousel-track {
    display: flex; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch;
    scrollbar-width: none; border-radius: 12px; background: var(--sage-mist);
  }
  .ps-carousel-track::-webkit-scrollbar { display: none; }
  .ps-carousel-slide {
    flex: 0 0 100%; width: 100%; aspect-ratio: 3 / 2; scroll-snap-align: start;
    display: flex; justify-content: center; align-items: center;
    margin: 0; background: var(--sage-mist);
  }
  .ps-carousel-slide img {
    display: block; width: 100%; height: 100%; object-fit: contain; object-position: center;
  }
  .ps-carousel-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
    width: 44px; height: 44px; border: 0; border-radius: 50%;
    background: rgba(255,255,255,.94); color: var(--ink);
    box-shadow: 0 2px 15px rgba(0,0,0,.14);
    display: grid; place-items: center; cursor: pointer; font-size: 1.7rem;
  }
  .ps-carousel-arrow--prev { left: 12px; }
  .ps-carousel-arrow--next { right: 12px; }
  .ps-carousel-arrow:disabled { opacity: .35; cursor: default; }
  .ps-carousel-nav {
    display: flex; justify-content: space-between; align-items: center;
    gap: 12px; padding-top: 13px; min-height: 40px;
  }
  .ps-carousel-counter { font-size: .84rem; font-weight: 600; white-space: nowrap; }
  .ps-carousel-dots { display: flex; gap: 7px; align-items: center; justify-content: center; flex-wrap: wrap; }
  .ps-carousel-dots button {
    width: 10px; height: 10px; padding: 0; border: 0; background: #b8bdb5;
    border-radius: 50%; cursor: pointer; transition: background .15s ease, transform .15s ease;
  }
  .ps-carousel-dots button.is-active { background: var(--sage-deep); transform: scale(1.3); }
  .ps-carousel-tip { font-size: .8rem; color: color-mix(in srgb, var(--ink) 70%, transparent); white-space: nowrap; }
  .ps-carousel-track:focus-visible, .ps-carousel-dots button:focus-visible, .ps-carousel-arrow:focus-visible {
    outline: 3px solid var(--sage-deep); outline-offset: 2px;
  }
  .ps-original-photo img { display: block; width: 100%; height: auto; border-radius: 10px; max-height: 560px; object-fit: contain; background: var(--sage-mist); }
  .ps-original-intro { margin-bottom: 1rem; color: color-mix(in srgb,var(--ink) 75%,transparent); font-size: .9rem; }
