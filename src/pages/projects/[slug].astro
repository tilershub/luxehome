---
export const prerender = false;
import LuxeLayout from '../../layouts/LuxeLayout.astro';
import VideoCard from '../../components/luxe/VideoCard.astro';
import { getProjectBySlug, youtubeEmbed, type ProjectFull } from '../../lib/luxe';
import { cloudinary } from '../../lib/luxe-config';

const { slug } = Astro.params;
const storedProject = await getProjectBySlug(slug!);
const project: ProjectFull | null = storedProject;
if (!project) return Astro.redirect('/projects');

const video = youtubeEmbed(project.video_url);
const episode1 = youtubeEmbed(project.episode_1_url);
const episode2 = youtubeEmbed(project.episode_2_url);
const hasSlider = !!(project.before_image_url && project.after_image_url);
const projectVideoCover = project.after_image_url || project.before_image_url;

const inspectionHref = project.design
  ? `/book-site-inspection?design=${encodeURIComponent(project.design.slug)}&source_project=${encodeURIComponent(project.slug)}`
  : `/book-site-inspection?source_project=${encodeURIComponent(project.slug)}`;

const reviewSchema = project.rating ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'LocalBusiness',
    name: 'LUXEhome',
    image: 'https://luxehome.lk/og-bathroom.jpg',
  },
  reviewRating: { '@type': 'Rating', ratingValue: project.rating, bestRating: 5 },
  ...(project.review_by ? { author: { '@type': 'Person', name: project.review_by } } : {}),
  ...(project.review_text ? { reviewBody: project.review_text } : {}),
}) : null;
---

<LuxeLayout
  title={`${project.title} — Project Story | LUXEhome`}
  description={`${project.title}${project.location ? `, ${project.location}` : ''} — the full LUXEhome project story: before and after, the week-by-week journey, what we found on site and how we fixed it.`}
  ogImage={project.after_image_url ? cloudinary(project.after_image_url, 1200) : undefined}
>
  <Fragment slot="head">
    {reviewSchema && <script is:inline type="application/ld+json" set:html={reviewSchema}></script>}
  </Fragment>

  <!-- Hero -->
  <section class="ps-hero">
    <p class="lx-eyebrow lxr">Project Story</p>
    <h1 class="lxr">{project.title}</h1>
    <p class="ps-meta lxr">
      {project.location}
      {project.project_ref && <span> · {project.project_ref}</span>}
      {project.area_label && <span> · {project.area_label}</span>}
      {project.duration_label && <span> · {project.duration_label}</span>}
      {project.completed_label && <span> · Completed {project.completed_label}</span>}
      {project.design && <span> · Built on the <a href={`/designs/${project.design.slug}`}>{project.design.name}</a> design</span>}
    </p>
  </section>

  <!-- Before / after -->
  {hasSlider ? (
    <section class="ps-slider-wrap lxr">
      <div class="ps-slider" id="ba-slider" style={`--pos: 50%`}>
        <img class="ps-after" src={cloudinary(project.after_image_url!, 1200)} alt={`${project.title} — after`} width="1200" height="800" />
        <div class="ps-before-clip">
          <img class="ps-before" src={cloudinary(project.before_image_url!, 1200)} alt={`${project.title} — before`} width="1200" height="800" />
        </div>
        <div class="ps-handle" aria-hidden="true"><span></span></div>
        <span class="ps-label ps-label--before">Before</span>
        <span class="ps-label ps-label--after">After</span>
      </div>
      <p class="ps-slider-hint">Drag to compare</p>
    </section>
  ) : project.after_image_url && (
    <section class="ps-slider-wrap lxr">
      <img class="ps-single" src={cloudinary(project.after_image_url, 1200)} alt={project.title} width="1200" height="800" />
    </section>
  )}

  <!-- The brief: what the family asked for, and the agreed path -->
  {(project.client_requirements || project.estimate_label) && (
    <section class="ps-section">
      <h2 class="lxr">The brief</h2>
      <div class="ps-brief lxr">
        {project.client_requirements && (
          <div class="ps-brief-req">
            <p class="lx-eyebrow">What the family asked for</p>
            <div>{project.client_requirements.split('\n\n').map((para) => <p>{para}</p>)}</div>
          </div>
        )}
        <div class="ps-brief-facts">
          {project.design && (
            <a class="ps-brief-fact" href={`/designs/${project.design.slug}`}>
              <span>Chosen design</span>
              <strong>{project.design.name} →</strong>
            </a>
          )}
          {project.estimate_label && (
            <div class="ps-brief-fact">
              <span>Approved estimate</span>
              <strong>{project.estimate_label}</strong>
            </div>
          )}
          {project.duration_label && (
            <div class="ps-brief-fact">
              <span>Timeline</span>
              <strong>{project.duration_label}</strong>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Story -->
  {(episode1 || episode2) && projectVideoCover && (
    <section class="ps-section">
      <h2 class="lxr">Old Space → 3D Design → Construction → Final Reveal</h2>
      <div class="ps-video-cards">
        {episode1 && (
          <VideoCard
            title={`${project.title} — Episode 01`}
            embedUrl={episode1}
            coverImage={cloudinary(project.before_image_url || projectVideoCover, 700)}
            eyebrow="Old space to 3D design"
            description="Tap to watch episode one in its original vertical format."
          />
        )}
        {episode2 && (
          <VideoCard
            title={`${project.title} — Episode 02`}
            embedUrl={episode2}
            coverImage={cloudinary(project.after_image_url || projectVideoCover, 700)}
            eyebrow="Completed bathroom tour"
            description="Tap to watch the final reveal in its original vertical format."
          />
        )}
      </div>
    </section>
  )}

  <!-- Story -->
  {project.story && (
    <section class="ps-section">
      <h2 class="lxr">The story</h2>
      <div class="ps-story lxr">{project.story.split('\n\n').map((para) => <p>{para}</p>)}</div>
    </section>
  )}

  <!-- Video + gallery -->
  {((video && projectVideoCover) || project.gallery.length > 0) && (
    <section class="ps-section">
      <h2 class="lxr">Inside the build</h2>
      {video && projectVideoCover && (
        <div class="ps-video-cards ps-video-cards--single">
          <VideoCard
            title={`${project.title} — Project Walkthrough`}
            embedUrl={video}
            coverImage={cloudinary(projectVideoCover, 700)}
            eyebrow="Project walkthrough"
            description="Tap to watch the vertical project walkthrough."
          />
        </div>
      )}
      {project.gallery.length > 0 && (
        <div class="ps-gallery">
          {project.gallery.map((g, i) => (
            <img class="lxr" src={cloudinary(g.image_url, 600)} alt={`${project.title} — photo ${i + 1}`} loading="lazy" width="600" height="450" />
          ))}
        </div>
      )}
    </section>
  )}

  <!-- The journey -->
  {project.journey.length > 0 && (
    <section class="ps-section">
      <h2 class="lxr">The journey</h2>
      <p class="ps-journey-intro lxr">From first message to handover — every stage, exactly as it happened.</p>
      <ol class="ps-journey">
        {project.journey.map((j) => (
          <li class="lxr">
            <span class="ps-j-dot" aria-hidden="true"></span>
            {j.date_label && <div class="ps-j-date">{j.date_label}</div>}
            <div class="ps-j-stage">{j.stage}</div>
            {j.note && <p class="ps-j-note">{j.note}</p>}
            {(j.issue || j.fix) && (
              <div class="ps-callout">
                <div class="ps-callout-title">What we found — and how we fixed it</div>
                {j.issue && <p><strong>The issue:</strong> {j.issue}</p>}
                {j.fix && <p><strong>The fix:</strong> {j.fix}</p>}
              </div>
            )}
            {(j.image_urls ?? []).length > 0 && (
              <div class="ps-j-photos">
                {(j.image_urls ?? []).map((url, i) => (
                  <img src={cloudinary(url, 500)} alt={`${project.title} — ${j.stage}, photo ${i + 1}`} loading="lazy" width="500" height="375" />
                ))}
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- Crew -->
  {project.crew.length > 0 && (
    <section class="ps-section">
      <h2 class="lxr">The team that built this</h2>
      <div class="ps-crew lxr">
        {project.crew.map((c) => (
          <div class="ps-crew-card">
            <div class="ps-crew-photo">
              {c.photo_url
                ? <img src={cloudinary(c.photo_url, 200)} alt={c.name} loading="lazy" width="200" height="200" />
                : <span>{c.name.charAt(0)}</span>}
            </div>
            <div>
              <div class="ps-crew-name">{c.name}</div>
              {c.role && <div class="ps-crew-role">{c.role}</div>}
              {c.tilershub_verified && <div class="ps-verified">✓ TILERSHUB Verified</div>}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Review -->
  {project.rating && (
    <section class="ps-section">
      <div class="ps-review lxr">
        <div class="ps-stars" aria-label={`${project.rating} out of 5 stars`}>
          {'★'.repeat(project.rating)}{'☆'.repeat(5 - project.rating)}
        </div>
        {project.review_text && <blockquote>“{project.review_text}”</blockquote>}
        {project.review_by && <cite>— {project.review_by}</cite>}
        {project.review_screenshot_url && (
          <figure class="ps-review-proof">
            <img src={cloudinary(project.review_screenshot_url, 700)} alt={`Google review by ${project.review_by ?? 'the client'}`} loading="lazy" width="700" height="400" />
            <figcaption>Verified Google review</figcaption>
          </figure>
        )}
      </div>
    </section>
  )}

  <!-- Closing CTA -->
  <section class="ps-closing lxr">
    <h2>Want a result like this?</h2>
    <p>Start with a site inspection. We will measure your bathroom, assess its condition and confirm the right design and quotation path.</p>
    <div class="ps-closing-btns">
      <a href={inspectionHref} class="lx-btn-wa">Book Inspection · LKR 10,000</a>
      {project.design && <a href={`/designs/${project.design.slug}`} class="lx-btn-ghost">See the {project.design.name} design</a>}
    </div>
    <small>No measurements or construction deposit are required to request the visit.</small>
  </section>
</LuxeLayout>

<script is:inline>
(function () {
  var slider = document.getElementById('ba-slider');
  if (!slider) return;
  var dragging = false;
  function setPos(clientX) {
    var rect = slider.getBoundingClientRect();
    var pct = Math.max(2, Math.min(98, ((clientX - rect.left) / rect.width) * 100));
    slider.style.setProperty('--pos', pct + '%');
  }
  slider.addEventListener('pointerdown', function (e) {
    dragging = true;
    slider.setPointerCapture(e.pointerId);
    setPos(e.clientX);
  });
  slider.addEventListener('pointermove', function (e) {
    if (dragging) setPos(e.clientX);
  });
  slider.addEventListener('pointerup',    function () { dragging = false; });
  slider.addEventListener('pointercancel', function () { dragging = false; });
})();
</script>

<style>
  .ps-hero { padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.2rem, 5vw, 4rem) 1.4rem; max-width: 1100px; margin: 0 auto; }
  .ps-hero h1 { font-size: clamp(2.2rem, 5.5vw, 3.6rem); margin: .5rem 0 .6rem; }
  .ps-meta { font-size: .92rem; color: color-mix(in srgb, var(--ink) 68%, transparent); }
  .ps-meta a { color: var(--sage-deep); font-weight: 500; }

  /* Before/after drag slider */
  .ps-slider-wrap { max-width: 1100px; margin: 0 auto; padding: 0 clamp(1.2rem, 5vw, 4rem); }
  .ps-slider {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: 8px;
    overflow: hidden;
    touch-action: none;
    cursor: ew-resize;
    background: var(--sage-mist);
    user-select: none;
  }
  .ps-slider img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .ps-before-clip { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ps-handle {
    position: absolute;
    top: 0; bottom: 0;
    left: var(--pos);
    width: 2px;
    background: var(--cream);
    transform: translateX(-1px);
    pointer-events: none;
  }
  .ps-handle span {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 42px; height: 42px;
    border-radius: 50%;
    background: var(--cream);
    box-shadow: 0 2px 12px rgba(43,50,42,.3);
  }
  .ps-handle span::before, .ps-handle span::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0; height: 0;
    border: 5px solid transparent;
    transform: translateY(-50%);
  }
  .ps-handle span::before { left: 8px;  border-right-color: var(--sage-deep); }
  .ps-handle span::after  { right: 8px; border-left-color:  var(--sage-deep); }
  .ps-label {
    position: absolute;
    bottom: 1rem;
    font-size: .66rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase;
    background: color-mix(in srgb, var(--ink) 78%, transparent); color: var(--cream);
    padding: .3rem .75rem; border-radius: 999px;
    pointer-events: none;
  }
  .ps-label--before { left: 1rem; }
  .ps-label--after  { right: 1rem; }
  .ps-slider-hint { text-align: center; font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: color-mix(in srgb, var(--ink) 50%, transparent); margin-top: .6rem; }
  .ps-single { width: 100%; border-radius: 8px; display: block; }

  .ps-section { max-width: 900px; margin: 0 auto; padding: 2.2rem clamp(1.2rem, 5vw, 4rem); }
  .ps-section h2 { font-size: clamp(1.7rem, 4vw, 2.3rem); margin-bottom: 1rem; }

  .ps-story p { margin-bottom: 1rem; max-width: 65ch; color: color-mix(in srgb, var(--ink) 82%, transparent); }

  /* The brief */
  .ps-brief { display: grid; grid-template-columns: 1.25fr .75fr; gap: 1.2rem; align-items: start; }
  .ps-brief-req { padding: 1.2rem 1.3rem; border-left: 3px solid var(--sage); background: #fff; border-radius: 0 8px 8px 0; }
  .ps-brief-req .lx-eyebrow { margin-bottom: .5rem; }
  .ps-brief-req p:not(.lx-eyebrow) { margin-bottom: .7rem; max-width: 60ch; color: color-mix(in srgb, var(--ink) 80%, transparent); font-size: .92rem; }
  .ps-brief-req p:last-child { margin-bottom: 0; }
  .ps-brief-facts { display: grid; gap: .6rem; }
  .ps-brief-fact { display: block; padding: .85rem 1rem; border: 1px solid var(--cream-deep); border-radius: 8px; background: #fff; color: var(--ink); text-decoration: none; }
  .ps-brief-fact span { display: block; margin-bottom: .2rem; color: var(--sage-deep); font-size: .64rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .ps-brief-fact strong { font: 600 1.05rem var(--lx-serif); }
  a.ps-brief-fact:hover strong { color: var(--sage-deep); }

  /* Diary photos per journey stage */
  .ps-j-photos { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: .85rem; }
  .ps-j-photos img { width: min(100%, 168px); aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; }

  /* Google review screenshot */
  .ps-review-proof { max-width: 460px; margin: 1.4rem auto 0; }
  .ps-review-proof img { width: 100%; height: auto; border: 1px solid var(--cream-deep); border-radius: 8px; }
  .ps-review-proof figcaption { margin-top: .45rem; color: color-mix(in srgb, var(--ink) 55%, transparent); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; }

  .ps-video-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 330px)); gap: 1.2rem; }
  .ps-video-cards--single { grid-template-columns: minmax(0, 330px); margin-bottom: 1.4rem; }
  @media (max-width: 700px) { .ps-video-cards { grid-template-columns: minmax(0, 300px); } }
  .ps-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; }
  .ps-gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; display: block; }

  /* Journey */
  .ps-journey-intro { color: color-mix(in srgb, var(--ink) 68%, transparent); margin: -0.4rem 0 1.6rem; }
  .ps-journey { list-style: none; position: relative; padding-left: 1.7rem; }
  .ps-journey::before { content: ''; position: absolute; left: 6px; top: 10px; bottom: 10px; width: 1px; background: var(--cream-deep); }
  .ps-journey li { position: relative; padding-bottom: 1.8rem; }
  .ps-j-dot { position: absolute; left: -1.7rem; top: .4rem; width: 13px; height: 13px; border-radius: 50%; background: var(--sage); border: 3px solid var(--cream); }
  .ps-j-date { font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; color: color-mix(in srgb, var(--ink) 55%, transparent); }
  .ps-j-stage { font-family: var(--lx-serif); font-size: 1.25rem; font-weight: 600; }
  .ps-j-note { font-size: .9rem; color: color-mix(in srgb, var(--ink) 75%, transparent); max-width: 58ch; margin-top: .2rem; }

  /* Signature transparency callout */
  .ps-callout {
    margin-top: .9rem;
    border: 1px solid var(--gold);
    border-left-width: 4px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--gold-soft) 22%, #fff);
    padding: 1rem 1.2rem;
    max-width: 58ch;
  }
  .ps-callout-title {
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: .5rem;
  }
  .ps-callout p { font-size: .9rem; margin-bottom: .4rem; color: color-mix(in srgb, var(--ink) 85%, transparent); }
  .ps-callout p:last-child { margin-bottom: 0; }
  .ps-callout strong { font-weight: 600; color: var(--ink); }

  /* Crew */
  .ps-crew { display: flex; flex-wrap: wrap; gap: 1rem; }
  .ps-crew-card {
    display: flex; align-items: center; gap: .9rem;
    background: #fff; border: 1px solid var(--cream-deep); border-radius: 999px;
    padding: .5rem 1.3rem .5rem .5rem;
  }
  .ps-crew-photo {
    width: 52px; height: 52px; border-radius: 50%; overflow: hidden;
    background: var(--sage-mist); display: flex; align-items: center; justify-content: center;
    font-family: var(--lx-serif); font-size: 1.3rem; color: var(--sage-deep);
    flex-shrink: 0;
  }
  .ps-crew-photo img { width: 100%; height: 100%; object-fit: cover; }
  .ps-crew-name { font-weight: 500; font-size: .95rem; }
  .ps-crew-role { font-size: .76rem; color: color-mix(in srgb, var(--ink) 60%, transparent); }
  .ps-verified { font-size: .7rem; font-weight: 600; color: var(--sage-deep); letter-spacing: .04em; }

  /* Review */
  .ps-review { text-align: center; background: #fff; border: 1px solid var(--cream-deep); border-radius: 8px; padding: 2.2rem 1.6rem; }
  .ps-stars { color: var(--gold); font-size: 1.4rem; letter-spacing: .2em; margin-bottom: .8rem; }
  .ps-review blockquote { font-family: var(--lx-serif); font-size: 1.35rem; font-style: italic; max-width: 46ch; margin: 0 auto .6rem; }
  .ps-review cite { font-style: normal; font-size: .85rem; color: color-mix(in srgb, var(--ink) 62%, transparent); }

  /* Closing */
  .ps-closing { text-align: center; background: var(--sage-mist); margin-top: 3rem; padding: 3.5rem clamp(1.2rem, 5vw, 4rem); }
  .ps-closing h2 { font-size: clamp(1.8rem, 4.5vw, 2.6rem); margin-bottom: .5rem; }
  .ps-closing p { max-width: 46ch; margin: 0 auto 1.5rem; color: color-mix(in srgb, var(--ink) 75%, transparent); }
  .ps-closing-btns { display: flex; gap: .9rem; justify-content: center; flex-wrap: wrap; }
  .ps-closing small { display: block; margin-top: .8rem; color: color-mix(in srgb, var(--ink) 52%, transparent); font-size: .68rem; }

  @media (max-width: 720px) {
    .ps-gallery { grid-template-columns: repeat(2, 1fr); }
    .ps-brief { grid-template-columns: 1fr; }
    .ps-j-photos img { width: calc(50% - .3rem); }
  }
  @media (max-width: 480px) {
    .ps-gallery { grid-template-columns: 1fr; }
    .ps-closing-btns { flex-direction: column; align-items: stretch; }
  }
</style>
