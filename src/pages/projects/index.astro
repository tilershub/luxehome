---
export const prerender = false;
import LuxeLayout from '../../layouts/LuxeLayout.astro';
import ProjectCard from '../../components/luxe/ProjectCard.astro';
import { getProjects } from '../../lib/luxe';
import { waLink, imageUrl } from '../../lib/luxe-config';

const projects = (await getProjects())
  .filter((project) => project.published && project.after_image_url)
  .sort((a, b) => Number(b.featured) - Number(a.featured));
---

<LuxeLayout
  title="Completed Bathroom Renovation Projects — BathSpace by LUXEhome"
  ogImage={projects[0]?.after_image_url ? imageUrl(projects[0].after_image_url, 1200) : undefined}
  ogImageAlt="Completed BathSpace bathroom renovation projects in Sri Lanka"
  description="Real BathSpace by LUXEhome bathroom renovations documented from the client brief through construction, technical testing and final handover."
>
  <section class="pj-hero">
    <p class="lx-eyebrow lxr">BathSpace by LUXEhome · Real completed bathrooms</p>
    <h1 class="lxr">From first inquiry<br /><em>to final handover.</em></h1>
    <p class="pj-intro lxr">
      See the real bathrooms behind BathSpace: what the client needed, what we changed,
      how the hidden work was handled, what the project cost and how it was handed over.
    </p>
  </section>

  <section class="pj-body">
    {projects.length === 0 ? (
      <div class="pj-empty lxr">
        <h2>Real project stories are being documented.</h2>
        <p>
          We are converting our completed bathroom archive into real case studies—not design collections.
          Each case study will show the brief, construction stages, testing, materials, investment and handover.
        </p>
        <div class="pj-empty-actions">
          <a href="/book-site-inspection" class="lx-btn-wa">Apply for a complimentary consultation</a>
          <a href={waLink('Hi LUXEhome! I am planning a complete bathroom renovation. Can I share my bathroom photos with you?')} class="lx-btn-ghost" target="_blank" rel="noopener noreferrer">Send bathroom photos</a>
        </div>
      </div>
    ) : (
      <div class="pj-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    )}
  </section>
</LuxeLayout>

<style>
  .pj-hero { max-width: 1100px; margin: 0 auto; padding: clamp(3.2rem, 8vw, 6.5rem) clamp(1.2rem, 5vw, 4rem) 1.4rem; }
  .pj-hero h1 { margin: .6rem 0 1rem; font-size: clamp(3.1rem, 7vw, 5.2rem); }
  .pj-hero h1 em { color: var(--sage-deep); }
  .pj-intro { max-width: 62ch; font: 500 clamp(1.05rem, 2.4vw, 1.25rem)/1.5 var(--lx-serif); }
  .pj-body { max-width: 1100px; margin: 0 auto; padding: 1.5rem clamp(1.2rem, 5vw, 4rem) 4rem; }
  .pj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .pj-empty { display: grid; place-items: center; gap: 1rem; padding: 4rem 1rem; text-align: center; }
  .pj-empty h2 { font-size: clamp(2rem, 5vw, 3.1rem); }
  .pj-empty p { max-width: 62ch; color: color-mix(in srgb, var(--ink) 70%, transparent); }
  .pj-empty-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .7rem; margin-top: .4rem; }
  @media (max-width: 720px) { .pj-grid { grid-template-columns: 1fr; } }
</style>
