---
export const prerender = false;
import LuxeLayout from '../../layouts/LuxeLayout.astro';
import ProjectCard from '../../components/luxe/ProjectCard.astro';
import { getProjects } from '../../lib/luxe';
import { waLink } from '../../lib/luxe-config';

const projects = (await getProjects())
  .filter((project) => project.after_image_url)
  .sort((a, b) => Number(b.featured) - Number(a.featured));
---

<LuxeLayout
  title="Completed Bathroom Project Stories — LUXEhome"
  description="Real LUXEhome bathroom projects documented from inquiry and design through construction, problem-solving, the team and final handover."
>
  <section class="pj-hero">
    <p class="lx-eyebrow lxr">Real bathrooms · Complete stories</p>
    <h1 class="lxr">From first inquiry<br /><em>to final handover.</em></h1>
    <p class="pj-intro lxr">
      Every published project shows the design, the existing conditions, what we discovered,
      how we solved it, the construction journey and the team responsible.
    </p>
  </section>

  <section class="pj-body">
    {projects.length === 0 ? (
      <div class="pj-empty lxr">
        <p>Complete project stories are being prepared. We publish them one by one when the full inquiry-to-handover record and real completed photographs are ready.</p>
        <a href={waLink('Hi LUXEhome! Can you share photos of your recent completed bathroom projects?')} class="lx-btn-wa" target="_blank" rel="noopener noreferrer">Ask for recent work</a>
      </div>
    ) : (
      <div class="pj-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    )}
  </section>
</LuxeLayout>

<style>
  .pj-hero { max-width: 1100px; margin: 0 auto; padding: clamp(3.2rem, 8vw, 6.5rem) clamp(1.2rem, 5vw, 4rem) 1.4rem; }
  .pj-hero h1 { margin: .6rem 0 1rem; font-size: clamp(3.1rem, 7vw, 5.2rem); }
  .pj-hero h1 em { color: var(--sage-deep); }
  .pj-intro { max-width: 62ch; font: 500 clamp(1.05rem, 2.4vw, 1.25rem)/1.5 var(--lx-serif); }
  .pj-body { max-width: 1100px; margin: 0 auto; padding: 1.5rem clamp(1.2rem, 5vw, 4rem) 4rem; }
  .pj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .pj-empty { display: grid; place-items: center; gap: 1.2rem; padding: 4rem 1rem; text-align: center; }
  .pj-empty p { max-width: 58ch; color: color-mix(in srgb, var(--ink) 70%, transparent); }
  @media (max-width: 720px) { .pj-grid { grid-template-columns: 1fr; } }
</style>
