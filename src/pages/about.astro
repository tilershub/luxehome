---
import LuxeLayout from '../layouts/LuxeLayout.astro';
---
<LuxeLayout title="Design responsibility, from first line to final clean. — LUXEhome" description="LUXEhome makes residential renovation clearer through named designs, documented decisions and accountable construction teams.">
  <section class="about-hero"><p class="lx-eyebrow">About LUXEhome</p><h1>Design responsibility, from first line to final clean.</h1><p>We make residential renovation clearer through named designs, documented decisions and accountable teams.</p></section>
  <section class="about-section"><div class="about-grid"><article><h2>Why we exist</h2><p>Homeowners should not have to choose between beautiful design, technical clarity and trustworthy construction.</p></article><article><h2>Our model</h2><p>Choose a direction, inspect the site, customise the design file, approve a fixed quotation, then build with documented progress.</p></article><article><h2>Our relationship with TILERSHUB</h2><p>A permanent LUXEhome core coordinates TILERSHUB Verified specialists selected for the project.</p></article><article><h2>What we design & build</h2><div class="chips"><a href="/bathroom-designs">Bathrooms</a><a href="/kitchen-designs">Kitchens</a><a href="/staircase-designs">Staircases</a><a href="/floor-designs">Floors</a></div></article></div></section>
  <section class="about-cta"><div><p class="lx-eyebrow">Start with clarity</p><h2>Ready to discuss your home?</h2></div><a href="/book-site-inspection">Book consultation</a></section>
</LuxeLayout>
<style>
  .about-hero,.about-section,.about-cta{width:min(1100px,calc(100% - 34px));margin:auto}.about-hero{padding:clamp(3.5rem,8vw,6rem) 0 3rem}.about-hero h1{font-size:clamp(3.4rem,8vw,5.6rem);max-width:900px;margin:.7rem 0 1.3rem}.about-hero>p:last-child{font:500 1.35rem/1.45 var(--lx-serif);max-width:700px}.about-section{padding:1.5rem 0 4rem}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.about-grid article{background:#fff;border:1px solid #2b322a16;border-radius:10px;padding:24px}.about-grid h2{font-size:1.8rem;margin-bottom:.7rem}.about-grid p{color:#586057}.chips{display:flex;gap:8px;flex-wrap:wrap}.chips a{background:var(--sage-mist);border-radius:99px;padding:7px 11px;font-size:12px;text-decoration:none;color:var(--ink)}.about-cta{margin-bottom:4rem;background:var(--sage-deep);color:#fff;border-radius:14px;padding:42px;display:flex;justify-content:space-between;align-items:center}.about-cta .lx-eyebrow{color:var(--gold-soft)}.about-cta h2{font-size:3rem}.about-cta>a{background:var(--gold);color:#fff;padding:12px 18px;border-radius:99px;text-decoration:none}@media(max-width:700px){.about-grid{grid-template-columns:1fr}.about-cta{display:block}.about-cta>a{display:inline-flex;margin-top:15px}}
</style>
