---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro';
import { getDesigns, getProjects } from '../lib/luxe';
import { formatLKRM, cloudinary, BRAND_STRIP, PLANNER } from '../lib/luxe-config';
import {
  collectionShortLabel,
  normalizeBathroomDesignIdentity,
} from '../lib/bathroom-taxonomy';

const featured = (await getDesigns({ featured: true }))
  .map(normalizeBathroomDesignIdentity)
  .filter((design) => design.cover_image_url)
  .slice(0, 3);
const heroProject = (await getProjects({ featured: true })).find((p) => p.before_image_url && p.after_image_url) ?? null;

const DELIVERABLES = [
  ['Site consultation & measurements', 'We assess the actual room, services, access and existing conditions.'],
  ['Five design images', 'See the detailed bathroom direction created for your measured room.'],
  ['3D walkthrough video', 'A video link lets you experience the proposed bathroom before construction.'],
  ['Material selection', 'The proposed finishes and materials are listed, with reference images where useful.'],
  ['Final construction quotation', 'A clear price and scope for LUXEhome to build the bathroom.'],
  ['Timeline, quality & warranties', 'The programme, quality commitments, applicable warranties and project values are documented.'],
  ['One complete proposal PDF', 'All proposal details are delivered together within seven working days after the site visit.'],
];

const FAQ = [
  ['Do I need to know the bathroom size?', 'No. Start the project and choose “please measure it.” We take the measurements during the site visit.'],
  ['What does the LKR 50,000 cover?', 'It covers the site consultation, detailed design and one complete proposal for one bathroom.'],
  ['Is it an extra charge?', 'Not if LUXEhome builds that bathroom. The full LKR 50,000 is recorded as an advance and deducted from the remaining construction balance.'],
  ['What if I do not proceed?', 'The deposit is retained to cover the consultation, design and proposal work already completed.'],
  ['What if I have several bathrooms?', 'Start with one bathroom and review its complete proposal first. Each additional proposal has its own LKR 50,000 initiation deposit, credited to its related LUXEhome construction contract.'],
  ['When will I receive the proposal?', 'Within seven working days after the site visit.'],
  ['I live overseas — can you manage everything?', 'Most of our clients are abroad. Design approval happens on a video call, you get weekly WhatsApp photo and video updates, and you approve every milestone before payment.'],
  ['How long does a bathroom take?', 'Typically 3–5 weeks depending on the design and site condition. Your design file includes a week-by-week plan.'],
  ['What warranty do I get?', 'A written warranty against each part of the work — 15 years on bathware, 10 on waterproofing, plumbing and wiring, 5 on tapware, showers and the ceiling.'],
];
---

<LuxeLayout
  bare={true}
  title="Start Your Bathroom Project — LKR 50,000 | LUXEhome"
  description="Start one LUXEhome bathroom with a LKR 50,000 initiation deposit for the site visit, detailed design and complete proposal. Fully credited if LUXEhome builds it."
>
  <!-- Minimal header -->
  <header class="st-hdr">
    <span class="lx-wordmark"><strong>LUXE</strong><em>home</em></span>
    <a href="/book-site-inspection" class="st-hdr-wa">Start project · LKR 50,000</a>
  </header>

  <!-- Hero -->
  <section class="st-hero">
    <p class="lx-eyebrow lxr">Measured first · Verified teams · Written warranties</p>
    <h1 class="lxr">Your dream bathroom,<br /><em>built without the stress.</em></h1>
    <p class="st-sub lxr">
      Start with one bathroom. We visit and measure the actual room, create the detailed design,
      select materials and deliver the complete construction proposal within seven working days after the visit.
    </p>
    <div class="st-hero-actions lxr">
      <a class="lx-btn-wa" href="/book-site-inspection">Start My Bathroom Project · LKR 50,000</a>
      <a class="lx-btn-ghost" href="/designs">Browse bathroom designs</a>
    </div>

    {heroProject ? (
      <div class="st-slider lxr" id="st-slider" style="--pos: 50%">
        <img class="st-after" src={cloudinary(heroProject.after_image_url!, 1000)} alt="After" width="1000" height="670" />
        <div class="st-before-clip"><img src={cloudinary(heroProject.before_image_url!, 1000)} alt="Before" width="1000" height="670" /></div>
        <div class="st-handle" aria-hidden="true"><span></span></div>
        <span class="st-lb st-lb--b">Before</span>
        <span class="st-lb st-lb--a">After</span>
      </div>
    ) : (
      <div class="st-hero-img lxr">
        <img src="/hero-bathroom.webp" srcset="/hero-bathroom-mobile.webp 860w, /hero-bathroom.webp 1717w" sizes="(max-width: 860px) 100vw, 860px" alt="LUXEhome bathroom" width="1717" height="916" fetchpriority="high" />
      </div>
    )}
  </section>

  <!-- Featured designs -->
  {featured.length > 0 && (
    <section class="st-sec">
      <h2 class="lxr">Three designs to start with</h2>
      <div class="st-designs">
        {featured.map((d) => (
          <a href={`/designs/${d.slug}`} class="st-design lxr">
            <div class="st-design-img">
              <img src={cloudinary(d.cover_image_url!, 600)} alt={d.name} loading="lazy" width="600" height="430" />
            </div>
            <div class="st-design-body">
              <p class="lx-eyebrow">{collectionShortLabel(d.collection)}</p>
              <h3>{d.name}</h3>
              <div class="st-design-price">{d.starting_price_lkr > 0 ? formatLKRM(d.starting_price_lkr) : 'Custom price'}</div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Design file explainer -->
  <section class="st-sec st-file">
    <h2 class="lxr">What you get before work begins</h2>
    <p class="st-file-sub lxr">The LKR 50,000 initiation deposit covers one bathroom and one complete decision package:</p>
    <ol class="st-deliv">
      {DELIVERABLES.map(([t, d], i) => (
        <li class="lxr">
          <span class="st-deliv-n">{String(i + 1).padStart(2, '0')}</span>
          <div><strong>{t}</strong><p>{d}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Whole-house planner -->
  <section class="st-sec">
    <h2 class="lxr">Planning more than one bathroom?</h2>
    <p class="st-file-sub lxr">Use the planner for an early whole-home estimate, but initiate only one bathroom first. Review its complete proposal before deciding on the remaining rooms.</p>
    <div class="st-planner lxr">
      <div class="st-plan-row">
        <label>Bathrooms</label>
        <div class="st-count">
          <button type="button" id="pl-minus">−</button>
          <span id="pl-count">2</span>
          <button type="button" id="pl-plus">+</button>
        </div>
      </div>
      <div class="st-plan-row">
        <label>Collection</label>
        <div class="st-collections" id="pl-collections">
          {Object.entries(PLANNER.collections).map(([key, c], i) => (
            <button type="button" data-col={key} data-base={c.basePrice} class={i === 0 ? 'on' : ''}>{c.label}</button>
          ))}
        </div>
      </div>
      <div class="st-plan-row">
        <label>Typical size</label>
        <div class="st-collections" id="pl-sizes">
          {Object.entries(PLANNER.sizeMultipliers).map(([key, s], i) => (
            <button type="button" data-size={key} data-factor={s.factor} class={i === 1 ? 'on' : ''}>{s.label}</button>
          ))}
        </div>
      </div>
      <div class="st-plan-total">
        <span>Estimated from</span>
        <strong id="pl-total"></strong>
      </div>
    </div>
  </section>

  <!-- Brands -->
  <section class="st-sec">
    <h2 class="lxr">Built with brands you know</h2>
    <div class="st-brands lxr">{BRAND_STRIP.map((b) => <span>{b}</span>)}</div>
  </section>

  <!-- Lead form -->
  <section class="st-sec st-lead">
    <p class="lx-eyebrow lxr">The practical first step</p>
    <h2 class="lxr">You do not need bathroom measurements.</h2>
    <p class="st-lead-sub lxr">Share your contact and property location. We confirm the visit, then send the LKR 50,000 initiation payment details for one bathroom.</p>
    <a href="/book-site-inspection" class="lx-btn-wa lxr">Start My Bathroom Project</a>
    <small class="lxr">100% credited to the construction balance if LUXEhome builds that bathroom.</small>
  </section>

  <!-- FAQ -->
  <section class="st-sec">
    <h2 class="lxr">Common questions</h2>
    {FAQ.map(([q, a]) => (
      <details class="st-faq lxr"><summary>{q}</summary><p>{a}</p></details>
    ))}
  </section>

  <footer class="st-footer">
    <span class="lx-wordmark"><strong>LUXE</strong><em>home</em></span>
    <p>Custom design &amp; build · Sri Lanka · 077 450 3744</p>
  </footer>

  <!-- Sticky mobile initiation bar -->
  <div class="st-sticky">
    <a href="/book-site-inspection">Start project · LKR 50,000</a>
  </div>
</LuxeLayout>

<script is:inline>
(function () {
  // Before/after slider
  var slider = document.getElementById('st-slider');
  if (slider) {
    var dragging = false;
    function setPos(x) {
      var r = slider.getBoundingClientRect();
      slider.style.setProperty('--pos', Math.max(2, Math.min(98, ((x - r.left) / r.width) * 100)) + '%');
    }
    slider.addEventListener('pointerdown', function (e) { dragging = true; slider.setPointerCapture(e.pointerId); setPos(e.clientX); });
    slider.addEventListener('pointermove', function (e) { if (dragging) setPos(e.clientX); });
    slider.addEventListener('pointerup', function () { dragging = false; });
    slider.addEventListener('pointercancel', function () { dragging = false; });
  }

  // Whole-house planner
  var count = 2;
  function fmtM(n) {
    var m = n / 1e6;
    return 'LKR ' + (m >= 10 ? m.toFixed(0) : (Math.round(m * 100) / 100)) + 'M';
  }
  function planTotal() {
    var col = document.querySelector('#pl-collections .on');
    var size = document.querySelector('#pl-sizes .on');
    if (!col || !size) return;
    document.getElementById('pl-count').textContent = count;
    var base = parseFloat(col.dataset.base || '');
    var factor = parseFloat(size.dataset.factor || '');
    document.getElementById('pl-total').textContent = Number.isFinite(base) && Number.isFinite(factor)
      ? fmtM(count * base * factor)
      : 'Custom price';
  }
  document.getElementById('pl-minus')?.addEventListener('click', function () { count = Math.max(1, count - 1); planTotal(); });
  document.getElementById('pl-plus')?.addEventListener('click', function () { count = Math.min(10, count + 1); planTotal(); });
  ['pl-collections', 'pl-sizes'].forEach(function (id) {
    var wrap = document.getElementById(id);
    wrap?.querySelectorAll('button').forEach(function (b) {
      b.addEventListener('click', function () {
        wrap.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); });
        planTotal();
      });
    });
  });
  planTotal();

})();
</script>

<style>
  .st-hdr {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem clamp(1.2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--cream-deep);
  }
  .st-hdr-wa {
    font-size: .78rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase;
    color: var(--cream); background: var(--sage-deep);
    padding: .55rem 1.2rem; border-radius: 2px; text-decoration: none;
  }

  .st-hero { max-width: 860px; margin: 0 auto; padding: clamp(2.5rem, 7vw, 4.5rem) clamp(1.2rem, 5vw, 3rem) 1rem; text-align: center; }
  .st-hero h1 { font-size: clamp(2.4rem, 7vw, 4rem); margin: .6rem 0 1rem; }
  .st-hero h1 em { color: var(--sage-deep); }
  .st-sub { max-width: 52ch; margin: 0 auto 1.8rem; color: color-mix(in srgb, var(--ink) 78%, transparent); }
  .st-hero-actions { display: flex; justify-content: center; gap: .7rem; flex-wrap: wrap; margin: -.45rem 0 1.5rem; }

  .st-slider {
    position: relative; aspect-ratio: 3 / 2; border-radius: 8px; overflow: hidden;
    touch-action: none; cursor: ew-resize; background: var(--sage-mist); user-select: none;
  }
  .st-slider img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .st-before-clip { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .st-handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; background: var(--cream); transform: translateX(-1px); pointer-events: none; }
  .st-handle span { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 40px; height: 40px; border-radius: 50%; background: var(--cream); box-shadow: 0 2px 10px rgba(43,50,42,.3); }
  .st-lb { position: absolute; bottom: .8rem; font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; background: color-mix(in srgb, var(--ink) 78%, transparent); color: var(--cream); padding: .25rem .65rem; border-radius: 999px; pointer-events: none; }
  .st-lb--b { left: .8rem; } .st-lb--a { right: .8rem; }
  .st-hero-img img { width: 100%; border-radius: 8px; }

  .st-sec { max-width: 860px; margin: 0 auto; padding: 2.4rem clamp(1.2rem, 5vw, 3rem); }
  .st-sec h2 { font-size: clamp(1.7rem, 4.5vw, 2.3rem); margin-bottom: 1.2rem; }

  .st-designs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .st-design { background: #fff; border: 1px solid var(--cream-deep); border-radius: 6px; overflow: hidden; text-decoration: none; color: var(--ink); }
  .st-design-img { aspect-ratio: 7 / 5; background: var(--sage-mist); }
  .st-design-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .st-ph { height: 100%; display: flex; align-items: center; justify-content: center; color: var(--sage-deep); }
  .st-ph em { font-family: var(--lx-serif); font-size: 1.3rem; }
  .st-design-body { padding: .8rem 1rem 1rem; }
  .st-design-body .lx-eyebrow { text-transform: capitalize; }
  .st-design-body h3 { font-size: 1.35rem; }
  .st-design-price { font-family: var(--lx-serif); font-weight: 600; margin-top: .2rem; }

  .st-file { background: var(--sage-mist); border-radius: 10px; }
  .st-file-sub { margin: -0.6rem 0 1.4rem; color: color-mix(in srgb, var(--ink) 72%, transparent); }
  .st-deliv { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .st-deliv li { display: flex; gap: .8rem; }
  .st-deliv-n { font-family: var(--lx-serif); font-size: 1.4rem; color: var(--gold); font-weight: 700; }
  .st-deliv strong { font-weight: 500; }
  .st-deliv p { font-size: .84rem; color: color-mix(in srgb, var(--ink) 70%, transparent); }

  .st-planner { background: #fff; border: 1px solid var(--cream-deep); border-radius: 10px; padding: 1.4rem; }
  .st-plan-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
  .st-plan-row label { font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; color: var(--sage-deep); min-width: 90px; }
  .st-count { display: flex; align-items: center; gap: .8rem; }
  .st-count button { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--cream-deep); background: var(--cream); font-size: 1.1rem; cursor: pointer; }
  .st-count span { font-family: var(--lx-serif); font-size: 1.3rem; font-weight: 700; min-width: 1.4ch; text-align: center; }
  .st-collections { display: flex; gap: .5rem; flex-wrap: wrap; }
  .st-collections button {
    font-family: var(--lx-sans); font-size: .78rem; padding: .5rem 1rem;
    border: 1px solid var(--cream-deep); border-radius: 999px; background: var(--cream); cursor: pointer;
  }
  .st-collections button.on { background: var(--sage-deep); border-color: var(--sage-deep); color: var(--cream); }
  .st-plan-total { display: flex; align-items: baseline; gap: .8rem; border-top: 1px solid var(--cream-deep); padding-top: 1rem; }
  .st-plan-total span { font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; color: color-mix(in srgb, var(--ink) 60%, transparent); }
  .st-plan-total strong { font-family: var(--lx-serif); font-size: 1.7rem; }

  .st-brands { display: flex; flex-wrap: wrap; gap: .5rem; }
  .st-brands span { font-size: .8rem; background: #fff; border: 1px solid var(--cream-deep); border-radius: 999px; padding: .45rem 1rem; }

  .st-lead { text-align: center; }
  .st-lead-sub { max-width: 46ch; margin: -0.6rem auto 1.4rem; color: color-mix(in srgb, var(--ink) 72%, transparent); }
  .st-lead > .lx-btn-wa { display: inline-flex; }
  .st-lead > small { display: block; margin-top: .65rem; color: color-mix(in srgb, var(--ink) 52%, transparent); font-size: .68rem; }

  .st-faq { border-bottom: 1px solid var(--cream-deep); }
  .st-faq summary { font-family: var(--lx-serif); font-size: 1.1rem; font-weight: 600; padding: .9rem 0; cursor: pointer; list-style: none; }
  .st-faq p { padding: 0 0 1rem; max-width: 60ch; font-size: .9rem; color: color-mix(in srgb, var(--ink) 78%, transparent); }

  .st-footer { text-align: center; padding: 2.5rem 1rem 7rem; color: color-mix(in srgb, var(--ink) 60%, transparent); font-size: .85rem; }

  .st-sticky {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 100;
    padding: .7rem 1rem calc(.7rem + env(safe-area-inset-bottom, 0px));
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--cream-deep);
  }
  .st-sticky a {
    display: flex; align-items: center; justify-content: center;
    background: var(--sage-deep); color: var(--cream);
    font-size: .85rem; font-weight: 500; letter-spacing: .05em;
    min-height: 50px; border-radius: 6px; text-decoration: none;
  }

  @media (min-width: 861px) { .st-sticky { display: none; } .st-footer { padding-bottom: 2.5rem; } }
  @media (max-width: 720px) {
    .st-designs { grid-template-columns: 1fr; }
    .st-deliv { grid-template-columns: 1fr; }
    .st-hero-actions a { width: 100%; }
  }
</style>
