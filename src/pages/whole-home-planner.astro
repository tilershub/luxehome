---
import LuxeLayout from '../layouts/LuxeLayout.astro'; import { PLANNER } from '../lib/luxe-config';
---
<LuxeLayout title="Whole-Home Planner — LUXEhome" description="Build an early investment picture across multiple bathrooms and spaces before booking your LUXEhome inspection.">
  <section class="planner-hero"><p class="lx-eyebrow">Plan the whole home</p><h1>Whole-home renovation planner.</h1><p>Use the planner for an initial bathroom investment range, then add kitchens, staircases and floors during the site inspection.</p></section>
  <section class="planner"><div class="row"><label>Bathrooms</label><div class="counter"><button id="minus">−</button><strong id="count">2</strong><button id="plus">+</button></div></div><div class="row"><label>Collection</label><div id="collections" class="options">{Object.entries(PLANNER.collections).map(([key,value],i)=><button class:list={{on:i===0}} data-price={value.basePrice}>{value.label}</button>)}</div></div><div class="row"><label>Typical size</label><div id="sizes" class="options">{Object.entries(PLANNER.sizeMultipliers).map(([key,value],i)=><button class:list={{on:i===1}} data-factor={value.factor}>{value.label}</button>)}</div></div><div class="total"><span>Estimated from</span><strong id="total"></strong></div><a href="/book-site-inspection">Book site inspection</a><small>Planning estimate only. The fixed quotation follows inspection and design customisation.</small></section>
</LuxeLayout>
<script is:inline>
  (()=>{let count=2,price=1000000,factor=1;const c=document.getElementById('count'),t=document.getElementById('total');const draw=()=>{c.textContent=count;t.textContent='LKR '+(count*price*factor/1000000).toFixed(2).replace(/\.00$/,'')+' M'};document.getElementById('minus').onclick=()=>{count=Math.max(1,count-1);draw()};document.getElementById('plus').onclick=()=>{count=Math.min(10,count+1);draw()};document.querySelectorAll('#collections button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#collections button').forEach(x=>x.classList.remove('on'));b.classList.add('on');price=Number(b.dataset.price);draw()});document.querySelectorAll('#sizes button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#sizes button').forEach(x=>x.classList.remove('on'));b.classList.add('on');factor=Number(b.dataset.factor);draw()});draw()})();
</script>
<style>
  .planner-hero,.planner{width:min(800px,calc(100% - 34px));margin:auto}.planner-hero{padding:clamp(3.5rem,8vw,6rem) 0 3rem}.planner-hero h1{font-size:clamp(3.4rem,8vw,5.3rem);margin:.7rem 0 1rem}.planner-hero>p:last-child{font:500 1.3rem/1.45 var(--lx-serif)}.planner{background:#fff;border:1px solid #2b322a16;border-radius:12px;padding:30px;margin-bottom:5rem}.row{padding:18px 0;border-bottom:1px solid #2b322a16}.row>label{display:block;font-weight:500;margin-bottom:10px}.counter,.options{display:flex;gap:8px;flex-wrap:wrap}.counter button,.options button{border:1px solid var(--sage);background:transparent;padding:9px 14px;border-radius:99px}.counter strong{padding:8px 16px}.options button.on{background:var(--sage-deep);color:#fff}.total{padding:28px 0;display:flex;justify-content:space-between;align-items:center}.total strong{font:600 2rem var(--lx-serif)}.planner>a{display:block;text-align:center;background:var(--sage-deep);color:#fff;padding:14px;text-decoration:none}.planner small{display:block;margin-top:12px;color:#667064}
</style>
