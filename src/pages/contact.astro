---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro';
import InspectionBookingForm from '../components/luxe/InspectionBookingForm.astro';
import { waLink } from '../lib/luxe-config';
---
<LuxeLayout title="Contact BathSpace by LUXEhome — Bathroom Renovation" description="Contact BathSpace by LUXEhome about a complete bathroom renovation in Sri Lanka or apply for a complimentary project consultation.">
  <section class="contact-hero">
    <p class="lx-eyebrow">Contact BathSpace by LUXEhome</p>
    <h1>Tell us what you want to transform.</h1>
    <p>Ask a question, share bathroom photographs or a project reference or apply for a complimentary project consultation. Suitable complete projects include one detailed site assessment.</p>
  </section>
  <section class="contact-body">
    <div class="contact-cards">
      <article><h2>Bathroom renovation</h2><p>Ask about a complete renovation or share photos of your existing bathroom. Dimensions are optional.</p><a href={waLink('Hi BathSpace! I would like to discuss a complete bathroom renovation.')} target="_blank" rel="noopener noreferrer">Discuss a renovation →</a></article>
      <article><h2>Fixtures & shop orders</h2><p>Questions about taps, showers, tiles, custom vanities, mirrors, availability, or delivery?</p><a href="/shop">Browse the BathSpace Shop →</a><br /><a href={waLink('Hi BathSpace! I have a question about your bathroom shop products or an order.')} target="_blank" rel="noopener noreferrer">Ask about products →</a></article>
      <article><h2>Aftercare & warranties</h2><p>For a completed BathSpace project, please share the project reference and photos of the issue.</p><a href={waLink('Hi BathSpace! I need aftercare support for a completed bathroom. My project reference is: ')} target="_blank" rel="noopener noreferrer">Request aftercare support →</a></article>
      <article><h2>Service area</h2><p>Projects across Sri Lanka, subject to scope, location and site assessment.</p></article>
      <article><h2>Business hours</h2><p>Monday to Saturday · 8:00 am–6:00 pm</p><a href="tel:+94774503744">077 450 3744</a></article>
    </div>
    <div class="contact-form"><h2>Applying for a complete bathroom renovation?</h2><p>This consultation form is for complete bathroom projects. For products, use the shop or WhatsApp above.</p><InspectionBookingForm /></div>
  </section>
</LuxeLayout>
<style>
  .contact-hero,.contact-body{width:min(1100px,calc(100% - 34px));margin:auto}.contact-hero{padding:clamp(3.5rem,8vw,6rem) 0 3rem}.contact-hero h1{font-size:clamp(3.4rem,8vw,5.6rem);max-width:900px;margin:.7rem 0 1.2rem}.contact-hero>p:last-child{font:500 1.3rem/1.45 var(--lx-serif);max-width:720px}.contact-body{display:grid;grid-template-columns:.7fr 1.3fr;gap:2rem;padding-bottom:5rem}.contact-cards{display:grid;align-content:start;gap:12px}.contact-cards article{background:#fff;border:1px solid #2b322a16;border-radius:10px;padding:24px}.contact-cards h2{font-size:1.7rem;margin-bottom:.5rem}.contact-cards p{color:#586057}.contact-cards a{display:inline-block;color:var(--sage-deep);margin-top:.6rem}@media(max-width:800px){.contact-body{grid-template-columns:1fr}}
</style>
