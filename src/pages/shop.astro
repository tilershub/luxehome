---
import LuxeLayout from '../layouts/LuxeLayout.astro';
import { getProducts } from '../lib/luxe';
import { waLink } from '../lib/luxe-config';
const fallback = [
  {slug:'wall-hung-wc',name:'Wall-Hung WC Set',category:'Featured',short_description:'A clean-lined wall-hung suite specified for contemporary bathrooms.',price_lkr:0,cover_image_url:null},
  {slug:'backlit-5mm-mirror',name:'Backlit 5mm Mirror',category:'Featured',short_description:'Made-to-measure mirror with soft integrated lighting.',price_lkr:38000,cover_image_url:null},
  {slug:'10mm-shower-screen',name:'10mm Shower Screen',category:'Featured',short_description:'Malaysian tempered glass with hardware selected for the design.',price_lkr:0,cover_image_url:null},
  {slug:'eco-board-vanity',name:'Eco Board Vanity',category:'Bathroom',short_description:'Custom storage designed around the basin and room.',price_lkr:0,cover_image_url:null},
  {slug:'concealed-rain-shower',name:'Concealed Rain Shower',category:'Bathroom',short_description:'A complete concealed shower specification.',price_lkr:0,cover_image_url:null},
  {slug:'tile-in-linear-drain',name:'Tile-In Linear Drain',category:'Bathroom',short_description:'A quiet drainage detail integrated with the floor layout.',price_lkr:0,cover_image_url:null},
  {slug:'undermount-sink-set',name:'Undermount Sink Set',category:'Kitchen',short_description:'Sink and tap selected together for function and finish.',price_lkr:0,cover_image_url:null},
  {slug:'quartz-worktop',name:'Quartz Worktop',category:'Kitchen',short_description:'Durable worktop measured and fabricated for the design.',price_lkr:0,cover_image_url:null},
  {slug:'soft-close-drawer-system',name:'Soft-Close Drawer System',category:'Kitchen',short_description:'Reliable drawer hardware for hard-working storage.',price_lkr:0,cover_image_url:null},
];
const stored = await getProducts(); const products = stored.length ? stored : fallback;
const groups = ['Featured','Bathroom','Kitchen'];
---
<LuxeLayout title="Shop — LUXEhome" description="Products specified by LUXEhome for better bathrooms, kitchens and complete rooms.">
  <section class="shop-hero"><p class="lx-eyebrow">Specified by LUXEhome</p><h1>Products selected for better rooms.</h1><p>A curated selection of fixtures, furniture and finishes chosen to work with our designs.</p><nav>{groups.map((group)=><a href={`#${group.toLowerCase()}`}>{group}</a>)}</nav></section>
  <div class="shop-body">{groups.map((group)=><section id={group.toLowerCase()}><p class="lx-eyebrow">{group} collection</p><h2>{group === 'Featured' ? 'Curated selection' : group === 'Bathroom' ? 'Fixtures & furniture' : 'Function, finished beautifully'}</h2><div class="product-grid">{products.filter((p:any)=>(p.category||'Featured').toLowerCase()===group.toLowerCase()).map((p:any)=><a class="product" href={`/shop/${p.slug}`}><div class="image">{p.cover_image_url?<img src={p.cover_image_url} alt={p.name} loading="lazy"/>:<span>{p.name}</span>}</div><div class="body"><h3>{p.name}</h3><p>{p.short_description}</p><strong>{Number(p.price_lkr)>0?`From LKR ${Number(p.price_lkr).toLocaleString('en-LK')}`:'Price on request'}</strong><span class="link">View product →</span></div></a>)}</div></section>)}</div>
  <section class="shop-cta"><div><p class="lx-eyebrow">Need tiles, flooring or finishing materials?</p><h2>Choose them with the design.</h2></div><a href={waLink('Hi LUXEhome! I need help selecting materials.')} target="_blank" rel="noopener noreferrer">Ask for material options</a></section>
</LuxeLayout>
<style>
  .shop-hero,.shop-body,.shop-cta{width:min(1100px,calc(100% - 34px));margin:auto}.shop-hero{padding:clamp(3.5rem,8vw,6rem) 0 3rem}.shop-hero h1{font-size:clamp(3.4rem,8vw,5.6rem);max-width:900px;margin:.7rem 0 1rem}.shop-hero>p:not(.lx-eyebrow){font:500 1.3rem/1.45 var(--lx-serif);max-width:650px}.shop-hero nav{display:flex;gap:8px;margin-top:1.6rem}.shop-hero nav a{background:var(--sage-mist);border-radius:99px;padding:7px 12px;font-size:12px;text-decoration:none;color:var(--ink)}.shop-body>section{padding:2rem 0 3.5rem;border-top:1px solid #2b322a1c}.shop-body h2{font-size:clamp(2.2rem,4vw,3.2rem);margin:.4rem 0 1.5rem}.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.product{background:#fff;border:1px solid #2b322a16;border-radius:10px;overflow:hidden;text-decoration:none;color:var(--ink)}.image{height:210px;background:var(--sage-mist);display:grid;place-items:center;padding:20px;text-align:center;font:italic 1.5rem var(--lx-serif);color:var(--sage-deep)}.image img{width:100%;height:100%;object-fit:cover}.body{padding:18px}.body h3{font-size:1.7rem}.body p{color:#586057;min-height:3.2em}.body strong,.link{display:block;margin-top:12px}.link{color:var(--sage-deep);font-size:.82rem}.shop-cta{margin-bottom:4rem;background:var(--sage-deep);color:#fff;border-radius:14px;padding:38px;display:flex;justify-content:space-between;align-items:center}.shop-cta .lx-eyebrow{color:var(--gold-soft)}.shop-cta h2{font-size:2.8rem}.shop-cta a{background:var(--gold);color:#fff;padding:12px 18px;border-radius:99px;text-decoration:none}@media(max-width:800px){.product-grid{grid-template-columns:1fr 1fr}.shop-cta{display:block}.shop-cta a{display:inline-flex;margin-top:15px}}@media(max-width:520px){.product-grid{grid-template-columns:1fr}}
</style>
