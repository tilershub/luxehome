---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro';
import { getTeam } from '../lib/luxe';
const members=await getTeam();
---
<LuxeLayout title="A permanent core. Verified specialists. — LUXEhome" description="Meet the permanent LUXEhome team and TILERSHUB Verified specialists responsible for design, construction quality and handover.">
  <section class="team-hero"><p class="lx-eyebrow">The people responsible</p><h1>A permanent core. Verified specialists.</h1><p>Every project has clear ownership from client communication through procurement, site quality and handover.</p></section>
  <section class="team-grid">{members.length?members.map(member=><article>{member.photo_url?<img src={member.photo_url} alt={member.name} loading="lazy"/>:<div class="portrait">{member.name.slice(0,1)}</div>}<p class="lx-eyebrow">{member.permanent?'Permanent team':'Project specialist'}</p><h2>{member.name}</h2><strong>{member.role}</strong><p>{member.bio}</p>{member.tilershub_verified&&<span>✓ TILERSHUB Verified</span>}</article>):<><article><h2>Design & Client Experience</h2><p>Guides the brief, design selection and approvals.</p></article><article><h2>Project Manager</h2><p>Coordinates procurement, programme and specialist teams.</p></article><article><h2>Quality Supervisor</h2><p>Checks critical construction stages before work proceeds.</p></article><article><h2>TILERSHUB Verified Specialists</h2><p>Trade teams selected for the needs and location of each project.</p></article></>}</section>
</LuxeLayout>
<style>.team-hero,.team-grid{width:min(1100px,calc(100% - 34px));margin:auto}.team-hero{padding:clamp(3.5rem,8vw,6rem) 0 3rem}.team-hero h1{font-size:clamp(3.4rem,8vw,5.6rem);margin:.7rem 0 1rem}.team-hero>p:last-child{font:500 1.3rem/1.45 var(--lx-serif);max-width:700px}.team-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;padding-bottom:5rem}.team-grid article{background:#fff;border:1px solid #2b322a16;border-radius:10px;padding:20px}.team-grid img,.portrait{width:100%;aspect-ratio:4/3;object-fit:cover;background:var(--sage-mist);display:grid;place-items:center;font:italic 4rem var(--lx-serif);color:var(--sage-deep);margin-bottom:18px}.team-grid h2{font-size:1.8rem}.team-grid strong{color:var(--sage-deep)}.team-grid span{display:inline-block;margin-top:12px;color:var(--gold)}@media(max-width:800px){.team-grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.team-grid{grid-template-columns:1fr}}</style>
