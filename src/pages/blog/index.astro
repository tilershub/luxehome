---
/* LUXEhome Journal — server-rendered so CMS-published articles
   appear immediately without a site rebuild. */
export const prerender = false;

import LuxeLayout from '../../layouts/LuxeLayout.astro';
import { getPublishedPosts, readingTime, excerptOf, formatPostDate } from '../../lib/luxe-blog';
import { cloudinary } from '../../lib/luxe-config';

const posts = await getPublishedPosts();
const categories = [...new Set(posts.map((post) => post.category).filter(Boolean))] as string[];

const activeCategory = Astro.url.searchParams.get('category');
const filtered = activeCategory
  ? posts.filter((post) => post.category === activeCategory)
  : posts;

const [featured, ...rest] = filtered;
---

<LuxeLayout
  title="Ideas & Advice — The LUXEhome Journal"
  description="Practical design, materials, quotation and construction guidance from the LUXEhome team in Sri Lanka — written for homeowners planning real projects."
  ogImage={featured?.cover_image || undefined}
  ogImageAlt="The LUXEhome Journal"
>
  <section class="journal-hero">
    <p class="lx-eyebrow lxr">The LUXEhome journal</p>
    <h1 class="lxr">Better decisions make better homes.</h1>
    <p class="lxr">Clear advice about design, materials, quotations and construction — written for homeowners.</p>
    {categories.length > 0 && (
      <nav class="journal-filter lxr" aria-label="Article categories">
        <a href="/blog" class:list={{ active: !activeCategory }}>All articles</a>
        {categories.map((category) => (
          <a
            href={`/blog?category=${encodeURIComponent(category)}`}
            class:list={{ active: activeCategory === category }}
          >{category}</a>
        ))}
      </nav>
    )}
  </section>

  {filtered.length === 0 && (
    <section class="journal-empty lxr">
      <p class="lx-eyebrow">Coming soon</p>
      <h2>{activeCategory ? 'Nothing in this category yet.' : 'The first articles are being prepared.'}</h2>
      <p>In the meantime, the design collections show how we document a complete project.</p>
      <div class="journal-empty-actions">
        {activeCategory && <a class="lx-btn-ghost" href="/blog">View all articles</a>}
        <a class="lx-btn-wa" href="/designs">Explore bathroom designs</a>
      </div>
    </section>
  )}

  {featured && (
    <section class="journal-featured lxr" aria-labelledby="featured-title">
      <a class="journal-featured-card" href={`/blog/${featured.slug}`}>
        <div class="journal-featured-art">
          {featured.cover_image
            ? <img src={cloudinary(featured.cover_image, 1000)} alt="" width="1000" height="640" fetchpriority="high" />
            : <span aria-hidden="true">Journal</span>}
        </div>
        <div class="journal-featured-body">
          <p class="lx-eyebrow">
            Featured{featured.category ? ` · ${featured.category}` : ''} · {readingTime(featured)}
          </p>
          <h2 id="featured-title">{featured.title}</h2>
          <p>{excerptOf(featured)}</p>
          <span class="journal-meta">{featured.author} · <time datetime={featured.pub_date}>{formatPostDate(featured.pub_date)}</time></span>
          <strong>Read the full article <span aria-hidden="true">→</span></strong>
        </div>
      </a>
    </section>
  )}

  {rest.length > 0 && (
    <section class="journal-grid-wrap" aria-label="All articles">
      <div class="journal-grid">
        {rest.map((post) => (
          <a class="journal-card lxr" href={`/blog/${post.slug}`}>
            <div class="journal-card-art">
              {post.cover_image
                ? <img src={cloudinary(post.cover_image, 700)} alt="" loading="lazy" width="700" height="480" />
                : <span aria-hidden="true">{post.category ?? 'Journal'}</span>}
            </div>
            <div class="journal-card-body">
              <p class="lx-eyebrow">{post.category ?? 'Advice'} · {readingTime(post)}</p>
              <h2>{post.title}</h2>
              <p>{excerptOf(post)}</p>
              <span class="journal-meta"><time datetime={post.pub_date}>{formatPostDate(post.pub_date)}</time></span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="journal-cta lxr">
    <div>
      <p class="lx-eyebrow">From reading to planning</p>
      <h2>Ready to look at your own bathroom?</h2>
      <p>The project initiation turns good advice into a measured, detailed design and complete proposal for one bathroom.</p>
    </div>
    <a href="/book-site-inspection">Start Project · LKR 50,000</a>
  </section>
</LuxeLayout>

<style>
  .journal-hero,
  .journal-empty,
  .journal-featured,
  .journal-grid-wrap,
  .journal-cta { width: min(1160px, calc(100% - 34px)); margin-inline: auto; }

  .journal-hero { padding: clamp(3.2rem, 8vw, 6rem) 0 clamp(1.8rem, 4vw, 2.6rem); }
  .journal-hero h1 { margin: .7rem 0 1rem; max-width: 820px; font-size: clamp(3.2rem, 7vw, 5.4rem); }
  .journal-hero > p:not(.lx-eyebrow) { max-width: 620px; font: 500 clamp(1.1rem, 2.3vw, 1.35rem)/1.5 var(--lx-serif); }

  .journal-filter { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.6rem; }
  .journal-filter a {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: .5rem .95rem;
    border: 1px solid rgba(43,50,42,.18);
    border-radius: 999px;
    color: var(--ink);
    font-size: .82rem;
    font-weight: 500;
    letter-spacing: .045em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background .2s, color .2s, border-color .2s;
  }
  .journal-filter a:hover { border-color: var(--sage-deep); color: var(--sage-deep); }
  .journal-filter a.active { background: var(--sage-deep); border-color: var(--sage-deep); color: var(--cream); }

  .journal-empty { padding: clamp(2rem, 5vw, 3.5rem) 0 4rem; }
  .journal-empty h2 { margin: .4rem 0 .6rem; font-size: clamp(2rem, 4.5vw, 3rem); }
  .journal-empty > p:not(.lx-eyebrow) { max-width: 56ch; color: color-mix(in srgb, var(--ink) 68%, transparent); }
  .journal-empty-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.4rem; }

  .journal-featured { padding-bottom: 1rem; }
  .journal-featured-card {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    overflow: hidden;
    border: 1px solid var(--cream-deep);
    border-radius: 14px;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .journal-featured-card:hover { transform: translateY(-3px); box-shadow: 0 18px 44px rgba(43,50,42,.1); }
  .journal-featured-art { position: relative; min-height: 320px; background: var(--sage-mist); }
  .journal-featured-art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .journal-featured-art span,
  .journal-card-art span {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    color: var(--sage-deep);
    font: 600 1.4rem var(--lx-serif);
    letter-spacing: .1em; text-transform: uppercase;
  }
  .journal-featured-body { display: flex; flex-direction: column; gap: .7rem; padding: clamp(1.4rem, 3.5vw, 2.4rem); }
  .journal-featured-body h2 { font-size: clamp(1.9rem, 3.6vw, 2.9rem); }
  .journal-featured-body > p:not(.lx-eyebrow) { color: color-mix(in srgb, var(--ink) 86%, transparent); font-size: 1rem; line-height: 1.65; }
  .journal-featured-body strong { margin-top: auto; padding-top: .6rem; font-size: .9rem; letter-spacing: .03em; }
  .journal-featured-body strong span { display: inline-block; transition: transform .2s ease; }
  .journal-featured-card:hover strong span { transform: translateX(4px); }

  .journal-meta { color: color-mix(in srgb, var(--ink) 72%, transparent); font-size: .84rem; }

  .journal-grid-wrap { padding: clamp(1.6rem, 4vw, 2.6rem) 0 1rem; }
  .journal-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1rem; }
  .journal-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--cream-deep);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .journal-card:hover { transform: translateY(-4px); box-shadow: 0 14px 34px rgba(43,50,42,.09); }
  .journal-card-art { position: relative; aspect-ratio: 16 / 10; background: var(--sage-mist); }
  .journal-card-art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .journal-card-body { display: flex; flex-direction: column; gap: .6rem; flex: 1; padding: 1.2rem 1.25rem 1.35rem; }
  .journal-card-body h2 { font-size: 1.65rem; }
  .journal-card-body > p:not(.lx-eyebrow) { color: color-mix(in srgb, var(--ink) 84%, transparent); font-size: .96rem; line-height: 1.65; }
  .journal-card-body .journal-meta { margin-top: auto; padding-top: .5rem; }

  .journal-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin: clamp(2.4rem, 6vw, 4rem) auto 4rem;
    padding: clamp(1.8rem, 5vw, 3rem);
    border-radius: 14px;
    background: var(--sage-deep);
    color: var(--cream);
  }
  .journal-cta .lx-eyebrow { color: var(--gold-soft); }
  .journal-cta h2 { margin: .3rem 0; font-size: clamp(2rem, 4.5vw, 3.1rem); }
  .journal-cta p:not(.lx-eyebrow) { max-width: 52ch; color: rgba(247,243,235,.88); font-size: 1rem; }
  .journal-cta > a {
    flex: 0 0 auto;
    padding: .85rem 1.3rem;
    border-radius: 999px;
    background: var(--gold);
    color: #fff;
    min-height: 48px;
    font-size: .92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .journal-featured-card { grid-template-columns: 1fr; }
    .journal-featured-art { min-height: 0; aspect-ratio: 16 / 9; }
    .journal-cta { display: block; }
    .journal-cta > a { display: inline-flex; margin-top: 1.2rem; }
  }

  @media (max-width: 640px) {
    .journal-hero { padding-top: 2.6rem; }
    .journal-hero h1 { font-size: clamp(2.9rem, 13vw, 4rem); }
    .journal-filter {
      flex-wrap: nowrap;
      margin-inline: -17px;
      padding-inline: 17px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
    }
    .journal-filter::-webkit-scrollbar { display: none; }
    .journal-filter a { flex: 0 0 auto; }
    .journal-featured-body { padding: 1.3rem; }
    .journal-card-body { padding: 1.2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-card, .journal-featured-card { transition: none; }
  }
</style>
