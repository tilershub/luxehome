---
import { createServerSupabase } from '../../lib/supabase';
import LuxeLayout from '../../layouts/LuxeLayout.astro';
const sb=createServerSupabase(import.meta.env as any); const {data:db}=sb?await sb.from('blog_posts').select('*').eq('status','published').order('pub_date',{ascending:false}):{data:[]};
const posts=[...(db||[]).map((p:any)=>({slug:p.slug,title:p.title,description:p.excerpt,category:p.category||'Advice',readingTime:p.reading_time||'5 min read',date:new Date(p.pub_date),cover:p.cover_image}))].sort((a,b)=>b.date.valueOf()-a.date.valueOf());
const fallback=[
  {slug:'what-a-fixed-bathroom-quotation-should-include',title:'What a fixed bathroom quotation should actually include',description:'The scope, assumptions, materials and exclusions that make a quotation genuinely useful.',category:'Planning',readingTime:'7 min read',cover:null},
  {slug:'before-the-first-tile',title:'What happens before the first tile is fixed?',description:'The preparation and technical decisions that protect the final result.',category:'Construction',readingTime:'5 min read',cover:null},
  {slug:'bathroom-under-4sqm',title:'How to choose a design for a bathroom under 4m²',description:'Prioritising circulation, storage and light in a compact room.',category:'Design',readingTime:'6 min read',cover:null},
  {slug:'kitchen-storage-first',title:'Storage first: planning a kitchen around real habits',description:'A better kitchen begins with how the household actually cooks and stores.',category:'Kitchen',readingTime:'5 min read',cover:null},
  {slug:'large-format-tile-wall-ready',title:'Large-format tile: beautiful, but is your wall ready?',description:'What substrate tolerance and preparation mean for large-format finishes.',category:'Materials',readingTime:'6 min read',cover:null},
  {slug:'when-to-book-site-inspection',title:'When should you book a site inspection?',description:'The right moment to move from inspiration to a reliable project plan.',category:'Planning',readingTime:'4 min read',cover:null},
]; const articles=posts.length?posts:fallback; const featured=articles[0];
---
<LuxeLayout title="Ideas & Advice — LUXEhome Journal" description="Practical design, construction and renovation guidance from LUXEhome Sri Lanka.">
  <section class="blog-hero"><p class="lx-eyebrow">The LUXEhome journal</p><h1>Better decisions make better homes.</h1><p>Clear advice about design, materials, quotations and construction—written for homeowners.</p></section>
  <section class="featured"><div class="art">Journal</div><div><p class="lx-eyebrow">Featured guide · {featured.readingTime}</p><h2>{featured.title}</h2><p>{featured.description}</p><a href={`/blog/${featured.slug}`}>Read the full guide</a></div></section>
  <section class="articles"><div class="grid">{articles.slice(1).map((post)=><a class="card" href={`/blog/${post.slug}`}><div class="art">{post.category}</div><div class="body"><p class="lx-eyebrow">{post.category} · {post.readingTime}</p><h2>{post.title}</h2><p>{post.description}</p><span>Explore article →</span></div></a>)}</div></section>
</LuxeLayout>
<style>
  .blog-hero,.featured,.articles{width:min(1100px,calc(100% - 34px));margin:auto}.blog-hero{padding:clamp(3.5rem,8vw,6rem) 0 3rem}.blog-hero h1{font-size:clamp(3.4rem,8vw,5.6rem);max-width:900px;margin:.7rem 0 1rem}.blog-hero>p:last-child{font:500 1.3rem/1.45 var(--lx-serif);max-width:680px}.featured{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center;background:#fff;border:1px solid #2b322a16;border-radius:12px;padding:20px}.art{min-height:250px;background:var(--sage-mist);display:grid;place-items:center;font:italic 2rem var(--lx-serif);color:var(--sage-deep)}.featured h2{font-size:clamp(2rem,4vw,3.2rem);margin:.5rem 0}.featured p:not(.lx-eyebrow),.body>p{color:#586057}.featured a,.body span{display:inline-block;margin-top:15px;color:var(--sage-deep)}.articles{padding:3rem 0 5rem}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.card{background:#fff;border:1px solid #2b322a16;border-radius:10px;overflow:hidden;text-decoration:none;color:var(--ink)}.card .art{min-height:170px;font-size:1.4rem}.body{padding:18px}.body h2{font-size:1.55rem;margin:.4rem 0}.body>p{font-size:.88rem}@media(max-width:800px){.featured{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.grid{grid-template-columns:1fr}}
</style>
