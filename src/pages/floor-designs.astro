---
export const prerender = false;
import LuxeLayout from '../layouts/LuxeLayout.astro'; import SpaceDesigns from '../components/luxe/SpaceDesigns.astro'; import { getDesigns } from '../lib/luxe';
const designs = await getDesigns({ spaceSlug: 'floors' });
---
<LuxeLayout
  ogImage="/spaces/floor.webp"
  ogImageAlt="LUXEhome floor designs" title="Sri Lankan Landscape Floor Designs — LUXEhome"><SpaceDesigns space="floors" designs={designs} /></LuxeLayout>
