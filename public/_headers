# Cloudflare Pages cache headers

# Immutable hashed assets (JS, CSS, fonts) — cache 1 year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static images (not content-hashed) — cache 30 days. Image filenames are
# versioned when their content changes, while this TTL remains safe for the few
# stable paths that are updated in place.
/*.webp
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000

# HTML is left to the Cloudflare Pages default (public, max-age=0,
# must-revalidate). A catch-all /* rule here would be appended to the
# rules above, producing a conflicting double Cache-Control on assets.

# robots.txt and sitemap — short cache
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap-index.xml
  Cache-Control: public, max-age=86400

/sitemap-0.xml
  Cache-Control: public, max-age=86400
